rule HaikuImageGetSystemLibs
{
	return
		# libs with special grist
		[ MultiArchDefaultGristFiles libroot.so : revisioned ]
		[ Libstdc++ForImage ]
		# libs with standard grist
		[ MultiArchDefaultGristFiles [ FFilterByBuildFeatures
			libbe.so
			libbsd.so
			libbnetapi.so
			libdebug.so
			libdebugger.so@primary
			libdevice.so
			# The Game Kit. libgame links only libbe + libmedia (both present
			# on arm64), so it builds fine here -- it was simply never listed
			# outside the regular profile. Without it SDL2's native Haiku
			# backend cannot link the relative-mouse recentre
			# (set_mouse_position, <game/WindowScreen.h>) or GameSound, and
			# OpenAL loses its Haiku backend, forcing per-recipe feature cuts.
			libgame.so
			libgnu.so
			# The Media Kit. WebKit links libmedia unconditionally when
			# ENABLE_VIDEO is on (Source/WebCore/PlatformHaiku.cmake), so
			# WebPositive cannot link without it -- and arm64 builds the library
			# fine, it was simply never listed outside the regular profile.
			libmedia.so
			# The MIDI Kit. fluidsynth's Haiku audio driver links libmidi2
			# unconditionally (-lmidi2), so fluidsynth -> sdl2_mixer cannot link
			# without it; the library builds fine on arm64 and was simply never
			# listed outside the regular profile. libmidi.so carries the
			# @fluidlite grist exactly as in regular so it is filtered with that
			# build feature.
			libmidi.so@fluidlite
			libmidi2.so
			libnetwork.so
			libpackage.so
			libtextencoding.so
			libtracker.so
			libtranslation.so
		] ]
		;
}


rule HaikuImageGetPrivateSystemLibs
