cfgversion=2

# The URL of the directory serving the repository data (repo, repo.sha256,
# repo.info) for the DeBeOS package repository. Pre-registered so a fresh boot
# can `pkgman refresh && pkgman install <pkg>` on demand -- no manual add-repo.
#
# HTTP for now: pkgman's HTTPS URL handler is not yet compiled on arm64 (the
# openssl build feature is a separate work item). Flip to https once that lands
# -- no other change needed. Fronted by Cloudflare -> CloudFront -> private S3.
baseurl=http://packages.debene.dev/arm64

# Stable identifier -- MUST equal the published repo.info's `url` field, so a
# later `pkgman add-repo http://packages.debene.dev/arm64` recognises the same
# repo instead of double-registering it. haiku-repo-publish writes the repo.info
# `url` as the baseurl, so we match that here. (A future improvement is to
# standardise both on a tag: URI, which needs the index rebuilt in lockstep.)
identifier=http://packages.debene.dev/arm64

# Deprecated alias of [identifier] for older OS versions.
url=http://packages.debene.dev/arm64

priority=1
