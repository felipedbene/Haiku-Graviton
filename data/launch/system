service x-vnd.Haiku-registrar {
	launch /system/servers/registrar
	port auth {
		capacity 100
	}
}

service x-vnd.Haiku-debug_server {
	launch /system/servers/debug_server
}

service x-vnd.Haiku-package_daemon {
	launch /system/servers/package_daemon
}

service x-vnd.Haiku-SystemLogger {
	launch /system/servers/syslog_daemon
	port logger {
		capacity 256
	}
}

service x-vnd.Haiku-mount_server {
	launch /system/servers/mount_server
}

service x-vnd.Haiku-media_server {
	launch /system/servers/media_server
	no_safemode
	legacy
	on initial_volumes_mounted
}

service x-vnd.Haiku-midi_server {
	launch /system/servers/midi_server
	no_safemode
	on_demand
}

service x-vnd.Haiku-net_server {
	launch /system/servers/net_server
	no_safemode
	legacy
}

service x-vnd.Be-PSRV {
	launch /system/servers/print_server
	no_safemode
	on_demand
}

service x-vnd.Haiku-notification_server {
	launch /system/servers/notification_server
	no_safemode
	on_demand
}

service x-vnd.Haiku-power_daemon {
	launch /system/servers/power_daemon
	no_safemode
	legacy
}

# The remote-desktop front door. Terminates TLS and authenticates clients with a
# shared token before relaying to app_server's loopback session port, so the
# internet-facing surface is not the raw session port. The daemon self-provisions
# on first boot: it writes broker.pem/broker.key/broker.fingerprint and a random
# token (0600) into /system/settings/remote_desktop/ and re-reads app_server's
# per-boot session cookie for every session, so it tolerates starting before the
# remote screen backend is ready. Present only when built with the openssl
# feature (remote_broker@openssl); on an image without it this entry is a no-op.
# Not on_demand: it listens on a raw TCP port (:10902), which launch_daemon's
# port-activation cannot trigger on.
service x-vnd.Haiku-remote_broker {
	launch /system/servers/remote_broker
	no_safemode
}

job x-vnd.Haiku-cddb_lookup {
	launch /system/bin/cddb_lookup
	no_safemode
	on volume_mounted
}

# target login
job x-vnd.Haiku-autologin {
	launch /system/bin/autologin
}
