SUMMARY="Anthropic's agentic coding tool, running on Node.js"
DESCRIPTION="Claude Code is Anthropic's agentic coding tool for the terminal. \
This package runs its JavaScript bundle, extracted from the official \
linux-arm64 release, on Haiku's Node.js 24, with a compatibility layer for \
the Bun runtime APIs it expects. Nothing Linux-specific executes: the bundle's \
platform checks report Haiku, and features that need Linux kernel facilities \
are disabled and documented.

The port's own changes are listed in PATCHES.md and its known limitations in \
LIMITATIONS.md, both installed with the documentation."
HOMEPAGE="https://code.claude.com/"
COPYRIGHT="Anthropic PBC (Claude Code)
	2026 DeBeOS (port tooling and compatibility layer)"
LICENSE="Anthropic Legal Agreements"
REVISION="2"
# The official linux-arm64 npm package; only the JavaScript and asset contents of
# its embedded module graph are used (tools/extract-bun-bundle.py), never the ELF.
SOURCE_URI="https://registry.npmjs.org/@anthropic-ai/claude-code-linux-arm64/-/claude-code-linux-arm64-$portVersion.tgz"
CHECKSUM_SHA256="5a8087f6b0df5796326bb8e58c6e89637c58f28a16aea45434a7e914e854b0dc"
SOURCE_FILENAME="claude-code-linux-arm64-$portVersion.tgz"
SOURCE_DIR="package"
# Pinned runtime/build dependencies (tools/deps.lock).
SOURCE_URI_2="https://registry.npmjs.org/ws/-/ws-8.22.0.tgz"
CHECKSUM_SHA256_2="ca9b3798b2e11ce8fac6713f50ef0501aa12b09b330623c1dc409dff94e7abc8"
SOURCE_DIR_2="package"
SOURCE_URI_3="https://registry.npmjs.org/acorn/-/acorn-8.19.0.tgz"
CHECKSUM_SHA256_3="c6fad21ffa1f2ba20338bf1dde1de911c2093c1aaf7b3af17c477661bd3bfaaf"
SOURCE_DIR_3="package"
SOURCE_URI_4="https://registry.npmjs.org/undici/-/undici-7.30.1.tgz"
CHECKSUM_SHA256_4="c98bd3881137c11341e8be8d2ec509ebf973b6f8b36d0a4c6d2afcda15e0d712"
SOURCE_DIR_4="package"
SOURCE_URI_5="https://registry.npmjs.org/bidi-js/-/bidi-js-1.1.0.tgz"
CHECKSUM_SHA256_5="8a89fce4e2b00c5141929ecde8336e955901e8fa2c7f01c6b5c9732639dd4175"
SOURCE_DIR_5="package"
# The port tooling, compat layer and native helper (graviton/ports/claude-code),
# staged as additional-files/claude-code-port.tar by tools/stage-recipe.sh. Only files
# listed here are copied into the build chroot.
ADDITIONAL_FILES="claude-code-port.tar"

ARCHITECTURES="!x86_gcc2 !x86 !x86_64 arm64"

PROVIDES="
	claude_code = $portVersion
	cmd:claude = $portVersion
	"
# libuv >= 1.52.1-2 carries the Haiku fs-event backend: without it fs.watch throws ENOSYS
# and settings hot reload, the task list and FileChanged hooks stop updating.
REQUIRES="
	haiku
	nodejs24 >= 24.21
	libuv >= 1.52.1-2
	cmd:bash
	cmd:git
	cmd:rg
	"

BUILD_REQUIRES="
	haiku_devel
	"
BUILD_PREREQUIRES="
	cmd:gcc
	cmd:node >= 24
	cmd:openssl
	cmd:python3
	cmd:tar
	"

# Where the files are packaged ($libDir is the packaging location while building) and
# where they are at run time. R1 bakes absolute module paths into the bundle, so the
# relocation prefix must be the run-time path: the package is for system-wide install.
installDir=$libDir/claude-code
runtimeDir=/boot/system/lib/claude-code
runtimeNode=/boot/system/bin/node

BUILD()
{
	local port=$sourceDir/claude-code-port
	rm -rf "$port" && mkdir -p "$port"
	tar -xf "$portDir/additional-files/claude-code-port.tar" -C "$port"

	# The same layout tools/fetch-deps.sh produces, from the checksummed sources.
	local deps=$sourceDir/deps
	rm -rf "$deps" && mkdir -p "$deps"
	cp -R "$sourceDir2" "$deps/ws"
	cp -R "$sourceDir3" "$deps/acorn"
	cp -R "$sourceDir4" "$deps/undici"
	cp -R "$sourceDir5" "$deps/bidi-js"

	# The deterministic pass: extract, relocate to $installDir, restore folds,
	# haiku cases, compat files. Every step asserts its own counts.
	# Native team-info helper (team parent/start time; Haiku has no /proc).
	gcc -O2 -Wall -Werror -o "$sourceDir/cc-teaminfo" "$port/native/cc-teaminfo.c"

	rm -rf "$sourceDir/tree"
	CC_TEAMINFO="$sourceDir/cc-teaminfo" bash "$port/tools/build-tree.sh" \
		"$sourceDir/claude" "$sourceDir/tree" "$runtimeDir" "$(command -v node)" "$deps"
}

INSTALL()
{
	mkdir -p "$installDir" "$binDir" "$docDir"
	cp -a "$sourceDir/tree/." "$installDir/"

	cat > "$binDir/claude" <<EOF
#!/bin/sh
# The bundle's module paths are absolute under $runtimeDir (PATCHES.md R1).
if [ ! -f $runtimeDir/claude.mjs ]; then
	echo "claude: $runtimeDir/claude.mjs not found; the claude_code package must be installed system-wide" >&2
	exit 1
fi
exec $runtimeNode --zero-fill-buffers $runtimeDir/claude.mjs "\$@"
EOF
	chmod 755 "$binDir/claude"

	local port=$sourceDir/claude-code-port
	cp "$port/PATCHES.md" "$port/LIMITATIONS.md" "$port/AUDIT.md" "$docDir/"
}

TEST()
{
	# Smoke test of the built tree. The compat suites compare against vectors
	# recorded from stock Bun 1.4.4 on Linux, so they run in the acceptance pass
	# (RESULTS.md), not here.
	# The tree's module paths point at $runtimeDir, so it is exercised once installed
	# (RESULTS.md); here, the helper and the relocation record.
	"$sourceDir/tree/bin/cc-teaminfo" $$ > /dev/null
	grep -q "\"prefix\": \"$runtimeDir\"" "$sourceDir/tree/RELOCATION.json"
}
