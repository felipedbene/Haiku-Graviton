1ac3032 test: require fs event filenames on haiku
From e380f2bb94582d0597cac085cbd17efe3a93dda8 Mon Sep 17 00:00:00 2001
From: f3 <f3@localhost>
Date: Sun, 1 Nov 2026 06:15:07 +0000
Subject: [PATCH] unix,haiku: implement the process title (proctitle.c +
 rename_thread)

---
 CMakeLists.txt   |  2 +-
 Makefile.am      | 10 +++++-----
 src/unix/haiku.c |  9 +++++++++
 3 files changed, 15 insertions(+), 6 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 8eda577..f7fc4f5 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -417,7 +417,7 @@ if(CMAKE_SYSTEM_NAME STREQUAL "Haiku")
 	  src/unix/haiku.c
 	  src/unix/haiku-fsevents.c
 	  src/unix/bsd-ifaddrs.c
-	  src/unix/no-proctitle.c
+	  src/unix/proctitle.c
 	  src/unix/posix-hrtime.c
 	  src/unix/posix-poll.c)
 endif()
diff --git a/Makefile.am b/Makefile.am
index f7f52a0..6570efd 100644
--- a/Makefile.am
+++ b/Makefile.am
@@ -419,7 +419,7 @@ libuv_la_CFLAGS += -D_GNU_SOURCE
 libuv_la_SOURCES += src/unix/cygwin.c \
                     src/unix/bsd-ifaddrs.c \
                     src/unix/no-fsevents.c \
-                    src/unix/no-proctitle.c \
+                    src/unix/proctitle.c \
                     src/unix/posix-hrtime.c \
                     src/unix/posix-poll.c \
                     src/unix/procfs-exepath.c \
@@ -470,7 +470,7 @@ libuv_la_CFLAGS += -D_BSD_SOURCE
 libuv_la_SOURCES += src/unix/bsd-ifaddrs.c \
                     src/unix/haiku.c \
                     src/unix/haiku-fsevents.c \
-                    src/unix/no-proctitle.c \
+                    src/unix/proctitle.c \
                     src/unix/posix-hrtime.c \
                     src/unix/posix-poll.c
 test_run_tests_LDFLAGS += -lbsd
@@ -480,7 +480,7 @@ if HURD
 uvinclude_HEADERS += include/uv/posix.h
 libuv_la_SOURCES += src/unix/bsd-ifaddrs.c \
                     src/unix/no-fsevents.c \
-                    src/unix/no-proctitle.c \
+                    src/unix/proctitle.c \
                     src/unix/posix-hrtime.c \
                     src/unix/posix-poll.c \
                     src/unix/hurd.c
@@ -502,7 +502,7 @@ libuv_la_CFLAGS += -D_GNU_SOURCE
 libuv_la_SOURCES += src/unix/cygwin.c \
                     src/unix/bsd-ifaddrs.c \
                     src/unix/no-fsevents.c \
-                    src/unix/no-proctitle.c \
+                    src/unix/proctitle.c \
                     src/unix/posix-hrtime.c \
                     src/unix/posix-poll.c \
                     src/unix/procfs-exepath.c \
@@ -536,7 +536,7 @@ uvinclude_HEADERS += include/uv/sunos.h
 libuv_la_CFLAGS += -D__EXTENSIONS__ \
                    -D_XOPEN_SOURCE=500 \
                    -D_REENTRANT
-libuv_la_SOURCES += src/unix/no-proctitle.c \
+libuv_la_SOURCES += src/unix/proctitle.c \
                     src/unix/sunos.c
 endif
 
diff --git a/src/unix/haiku.c b/src/unix/haiku.c
index 22c1659..5211107 100644
--- a/src/unix/haiku.c
+++ b/src/unix/haiku.c
@@ -170,3 +170,12 @@ int uv_cpu_info(uv_cpu_info_t** cpu_infos, int* count) {
 
   return 0;
 }
+
+
+void uv__set_process_title(const char* title) {
+  /* Haiku keeps a team's command line in the kernel (team_info.args), which
+   * userland cannot change; what can be renamed is the main thread, whose id
+   * is the team id. That is the name the Debugger, ProcessController and
+   * `ps -a` show for the main thread. */
+  rename_thread(getpid(), title);
+}
-- 
