     1	// Flags: --expose-internals
     2	'use strict';
     3	const common = require('../common');
     4	const assert = require('assert');
     5	
     6	const { internalBinding } = require('internal/test/binding');
     7	const { TCP, constants: TCPConstants } = internalBinding('tcp_wrap');
     8	const {
     9	  WriteWrap,
    10	  kReadBytesOrError,
    11	  kArrayBufferOffset,
    12	  streamBaseState
    13	} = internalBinding('stream_wrap');
    14	
    15	const server = new TCP(TCPConstants.SOCKET);
    16	
    17	const r = (common.hasIPv6 ?
    18	  server.bind6('::', 0) :
    19	  server.bind('0.0.0.0', 0));
    20	assert.strictEqual(r, 0);
    21	
    22	const port = {};
    23	server.getsockname(port);
    24	
    25	server.listen(128);
    26	
    27	server.onconnection = common.mustCall((err, client) => {
    28	  assert.strictEqual(client.writeQueueSize, 0);
    29	  console.log('got connection');
    30	
    31	  const maybeCloseClient = () => {
    32	    if (client.pendingWrites.length === 0 && client.gotEOF) {
    33	      console.log('close client');
    34	      client.close();
    35	    }
    36	  };
    37	
    38	  client.readStart();
    39	  client.pendingWrites = [];
    40	  client.onread = common.mustCall((arrayBuffer) => {
    41	    if (arrayBuffer) {
    42	      const offset = streamBaseState[kArrayBufferOffset];
    43	      const nread = streamBaseState[kReadBytesOrError];
    44	      const buffer = Buffer.from(arrayBuffer, offset, nread);
    45	      assert.ok(buffer.length > 0);
    46	
    47	      assert.strictEqual(client.writeQueueSize, 0);
    48	
    49	      const req = new WriteWrap();
    50	      req.async = false;
    51	      const returnCode = client.writeBuffer(req, buffer);
    52	      assert.strictEqual(returnCode, 0);
    53	      client.pendingWrites.push(req);
    54	
    55	      console.log(`client.writeQueueSize: ${client.writeQueueSize}`);
    56	      // 11 bytes should flush
    57	      assert.strictEqual(client.writeQueueSize, 0);
    58	
    59	      if (req.async)
    60	        req.oncomplete = common.mustCall(done);
    61	      else
    62	        process.nextTick(done.bind(null, 0, client, req));
    63	
    64	      function done(status, client_, req_) {
    65	        assert.strictEqual(client.pendingWrites.shift(), req);
    66	
    67	        // Check parameters.
    68	        assert.strictEqual(status, 0);
    69	        assert.strictEqual(client_, client);
    70	        assert.strictEqual(req_, req);
    71	
    72	        console.log(`client.writeQueueSize: ${client.writeQueueSize}`);
    73	        assert.strictEqual(client.writeQueueSize, 0);
    74	
    75	        maybeCloseClient();
    76	      }
    77	
    78	    } else {
    79	      console.log('eof');
    80	      client.gotEOF = true;
    81	      server.close();
    82	      maybeCloseClient();
    83	    }
    84	  }, 2);
    85	});
