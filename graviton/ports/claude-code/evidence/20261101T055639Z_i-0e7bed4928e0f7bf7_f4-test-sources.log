    22	'use strict';
    23	const common = require('../common');
    24	const fixtures = require('../common/fixtures');
    25	const fs = require('fs');
    26	const net = require('net');
    27	const path = require('path');
    28	const assert = require('assert');
    29	
    30	// Test if ENOTSOCK is fired when trying to connect to a file which is not
    31	// a socket.
    32	
    33	let emptyTxt;
    34	
    35	if (common.isWindows) {
    36	  // On Win, common.PIPE will be a named pipe, so we use an existing empty
    37	  // file instead
    38	  emptyTxt = fixtures.path('empty.txt');
    39	} else {
    40	  const tmpdir = require('../common/tmpdir');
    41	  tmpdir.refresh();
    42	  // Use a short relative path so that we don't exceed the 108 byte limit for
    43	  // Unix socket paths in long or multibyte CI workspaces. Even though this
    44	  // isn't actually a socket file, the error will be different from the one we
    45	  // are expecting if the path is too long.
    46	  emptyTxt = path.join(path.relative(process.cwd(), tmpdir.path), '0.txt');
    47	
    48	  function cleanup() {
    49	    try {
    50	      fs.unlinkSync(emptyTxt);
    51	    } catch (e) {
    52	      assert.strictEqual(e.code, 'ENOENT');
    53	    }
    54	  }
    55	  process.on('exit', cleanup);
    56	  cleanup();
    57	  fs.writeFileSync(emptyTxt, '');
    58	}
    59	
    60	const notSocketClient = net.createConnection(emptyTxt, function() {
    61	  assert.fail('connection callback should not run');
    62	});
    63	
    64	notSocketClient.on('error', common.mustCall(function(err) {
    65	  assert(err.code === 'ENOTSOCK' || err.code === 'ECONNREFUSED',
    66	         `received ${err.code} instead of ENOTSOCK or ECONNREFUSED`);
    67	}));
    68	
    69	
    70	// Trying to connect to not-existing socket should result in ENOENT error
    71	const noEntSocketClient = net.createConnection('no-ent-file', function() {
    72	  assert.fail('connection to non-existent socket, callback should not run');
    73	});
    74	
    75	noEntSocketClient.on('error', common.mustCall(function(err) {
    76	  assert.strictEqual(err.code, 'ENOENT');
    77	}));
    78	
    79	
    80	// On Windows or IBMi or when running as root,
    81	// a chmod has no effect on named pipes
    82	if (!common.isWindows && !common.isIBMi && process.getuid() !== 0) {
    83	  // Trying to connect to a socket one has no access to should result in EACCES
    84	  const accessServer = net.createServer(
    85	    common.mustNotCall('server callback should not run'));
    86	  accessServer.listen(common.PIPE, common.mustCall(function() {
    87	    fs.chmodSync(common.PIPE, 0);
    88	
    89	    const accessClient = net.createConnection(common.PIPE, function() {
    90	      assert.fail('connection should get EACCES, callback should not run');
    91	    });
    92	
    93	    accessClient.on('error', common.mustCall(function(err) {
    94	      assert.strictEqual(err.code, 'EACCES');
    95	      accessServer.close();
    96	    }));
    97	  }));
    98	}
