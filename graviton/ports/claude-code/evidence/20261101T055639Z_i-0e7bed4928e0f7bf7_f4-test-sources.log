    60	  server.listen(common.PORT + 2, localhost, common.mustCall(() => {
    61	    const address = server.address();
    62	    assert.strictEqual(address.address, localhost);
    63	    assert.strictEqual(address.port, common.PORT + 2);
    64	    assert.strictEqual(address.family, family6);
    65	    server.close();
    66	  }));
    67	}
    68	
