    26	
    27	// Test on IPv4 Server
    28	{
    29	  const family = 'IPv4';
    30	  const server = net.createServer();
    31	
    32	  server.on('error', common.mustNotCall());
    33	
    34	  server
    35	    .listen(common.PORT + 1, common.localhostIPv4, common.mustCall(() => {
    36	      const address4 = server.address();
    37	      assert.strictEqual(address4.address, common.localhostIPv4);
    38	      assert.strictEqual(address4.port, common.PORT + 1);
    39	      assert.strictEqual(address4.family, family);
    40	      server.close();
    41	    }));
    42	}
    43	
    44	if (!common.hasIPv6) {
    45	  common.printSkipMessage('ipv6 part of test, no IPv6 support');
    46	  return;
    47	}
    48	
    49	const family6 = 'IPv6';
    50	const anycast6 = '::';
