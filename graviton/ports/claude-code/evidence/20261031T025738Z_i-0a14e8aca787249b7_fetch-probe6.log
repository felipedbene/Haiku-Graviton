export const TLSOptionsSingleFile = b.union({
  string: b.string,
  buffer: b.bufferSource.arrayBuffer,
  file: b.blob,
});

export const TLSOptionsFile = b.union({
  none: b.null,
  string: b.string,
  buffer: b.bufferSource.arrayBuffer,
  file: b.blob,
  array: b.array(TLSOptionsSingleFile),
});

