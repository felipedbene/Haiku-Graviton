#!/usr/bin/env python3
# suitediff.py <baseline-log> <new-log> <new-tests.txt> <modified-tests.txt>
# Per-test diff of two node suite evidence logs (the "-- every <suite> result" FAIL/TIMEOUT lists).
import re, sys
def fails(path):
    d = {}
    for line in open(path, errors="replace"):
        m = re.match(r"^((parallel|sequential)/\S+) (FAIL|TIMEOUT)$", line.strip())
        if m: d[m.group(1)] = m.group(3)
    return d
def totals(path):
    return [l.rstrip() for l in open(path, errors="replace") if l.startswith("== parallel") or l.startswith("== sequential")]
a, b = fails(sys.argv[1]), fails(sys.argv[2])
new = set(open(sys.argv[3]).read().split()); mod = set(open(sys.argv[4]).read().split())
tag = lambda t: (" [new in 24.22.2]" if t in new else (" [test changed in 24.22.2]" if t in mod else ""))
print("A:", *totals(sys.argv[1]), sep="\n  "); print("B:", *totals(sys.argv[2]), sep="\n  ")
print("A not ok: %d  B not ok: %d" % (len(a), len(b)))
print("-- fail -> pass:"); [print(t + tag(t)) for t in sorted(set(a) - set(b))]
print("-- pass -> fail (tests present in both trees):"); [print(t, b[t] + tag(t)) for t in sorted(set(b) - set(a)) if t not in new]
print("-- failing, new in 24.22.2 (no 24.21.0 result):"); [print(t, b[t]) for t in sorted(set(b) - set(a)) if t in new]
print("-- failing in both:"); [print(t, a[t], b[t] + tag(t)) for t in sorted(set(a) & set(b))]
