    23	for (;;) {
    24	  try {
    25	    openFds.push(fs.openSync(__filename, 'r'));
    26	  } catch (err) {
    27	    assert.strictEqual(err.code, 'EMFILE');
    28	    break;
    29	  }
    30	}
    31	const proc = child_process.spawn(process.execPath, ['-e', '0']);
    32	assert.strictEqual(proc.stdin, undefined);
    33	assert.strictEqual(proc.stdout, undefined);
    34	assert.strictEqual(proc.stderr, undefined);
    35	assert.strictEqual(proc.stdio, undefined);
    36	proc.on('error', common.mustCall(function(err) {
    37	  assert.strictEqual(err.code, 'EMFILE');
    38	}));
    39	proc.on('exit', common.mustNotCall('"exit" event should not be emitted'));
    40	if (openFds.length >= 1) {
    41	  fs.closeSync(openFds.pop());
    42	}
######## parallel/test-worker-memory.js
     1	'use strict';
     2	const common = require('../common');
     3	if (common.isIBMi)
     4	  common.skip('On IBMi, the rss memory always returns zero');
     5	const assert = require('assert');
     6	const util = require('util');
     7	const { Worker } = require('worker_threads');
     8	let numWorkers = +process.env.JOBS || require('os').availableParallelism();
     9	if (numWorkers > 20) {
    10	  numWorkers = 20;
    11	}
    12	function run(n, done) {
    13	  console.log(`run() called with n=${n} (numWorkers=${numWorkers})`);
    14	  if (n <= 0)
    15	    return done();
    16	  const worker = new Worker(
    17	    'require(\'worker_threads\').parentPort.postMessage(2 + 2)',
    18	    { eval: true });
    19	  worker.on('message', common.mustCall((value) => {
    20	    assert.strictEqual(value, 4);
    21	  }));
    22	  worker.on('exit', common.mustCall(() => {
    23	    run(n - 1, done);
    24	  }));
    25	}
    26	const startStats = process.memoryUsage();
    27	let finished = 0;
    28	for (let i = 0; i < numWorkers; ++i) {
    29	  run(60 / numWorkers, common.mustCall(() => {
    30	    console.log(`done() called (finished=${finished})`);
    31	    if (++finished === numWorkers) {
    32	      const finishStats = process.memoryUsage();
    33	      assert.ok(finishStats.rss / startStats.rss < 5,
    34	                'Unexpected memory overhead: ' +
    35	                util.inspect([startStats, finishStats]));
    36	    }
    37	  }));
    38	}
