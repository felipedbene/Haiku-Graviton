    31	  cp.stdout.on('data', (chunk) => {
    32	    stdout += chunk;
    33	  });
    34	  let stderr = '';
    35	  cp.stderr.setEncoding('utf8');
    36	  cp.stderr.on('data', (chunk) => {
    37	    stderr += chunk;
    38	  });
    39	  cp.on('exit', common.mustCall((code, signal) => {
    40	    console.log(`child stdout: ${stdout}\n`);
