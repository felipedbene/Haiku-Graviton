    13	    } else {
    14	      throw new Error(uncaughtExceptionHandlerErrMsg);
    15	    }
    16	  }));
    17	  const d = domain.create();
    18	  d.run(common.mustCall(function() {
    19	    throw new Error(domainErrMsg);
    20	  }));
    21	} else {
    22	  runTestWithoutAbortOnUncaughtException();
    23	  runTestWithAbortOnUncaughtException();
    24	}
    25	function runTestWithoutAbortOnUncaughtException() {
    26	  child_process.exec(
    27	    ...createTestCmdLine(),
    28	    common.mustCall(function onTestDone(err, stdout, stderr) {
    29	      assert(stderr.includes(uncaughtExceptionHandlerErrMsg),
    30	             'stderr output must include proper uncaughtException ' +
    31	             'handler\'s error\'s message');
    32	      assert(!stderr.includes(domainErrMsg),
    33	             'stderr output must not include domain\'s error\'s message');
    34	      assert.notStrictEqual(err.code, 0,
    35	                            'child process should have exited with a ' +
    36	                            'non-zero exit code, but did not');
    37	    }),
    38	  );
    39	}
    40	function runTestWithAbortOnUncaughtException() {
    41	  child_process.exec(...createTestCmdLine({
    42	    withAbortOnUncaughtException: true
    43	  }), common.mustCall(function onTestDone(err, stdout, stderr) {
    44	    assert.notStrictEqual(err.code, RAN_UNCAUGHT_EXCEPTION_HANDLER_EXIT_CODE,
