     5	const domain = require('domain');
     6	const uncaughtExceptionHandlerErrMsg = 'boom from uncaughtException handler';
     7	const domainErrMsg = 'boom from domain';
     8	const RAN_UNCAUGHT_EXCEPTION_HANDLER_EXIT_CODE = 42;
     9	if (process.argv[2] === 'child') {
    10	  process.on('uncaughtException', common.mustCall(function onUncaught() {
    11	    if (process.execArgv.includes('--abort-on-uncaught-exception')) {
