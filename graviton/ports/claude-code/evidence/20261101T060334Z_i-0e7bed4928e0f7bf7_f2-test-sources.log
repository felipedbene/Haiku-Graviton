     1	'use strict';
     2	const common = require('../common');
     3	if (common.isWindows)
     4	  common.skip('no RLIMIT_NOFILE on Windows');
     5	const assert = require('assert');
     6	const child_process = require('child_process');
     7	const fs = require('fs');
     8	const ulimit = Number(child_process.execSync('ulimit -Hn'));
     9	if (ulimit > 64 || Number.isNaN(ulimit)) {
    10	  const [cmd, opts] = common.escapePOSIXShell`ulimit -n 64 && "${process.execPath}" "${__filename}"`;
    11	  const result = child_process.spawnSync(
