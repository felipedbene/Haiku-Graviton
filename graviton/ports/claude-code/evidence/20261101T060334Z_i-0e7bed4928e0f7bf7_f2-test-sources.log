    12	const WORKERCOUNT = 256;
    13	if (process.argv[2] === 'child') {
    14	  const { Worker } = require('worker_threads');
    15	  for (let i = 0; i < WORKERCOUNT; ++i) {
    16	    const worker = new Worker(
    17	      'require(\'worker_threads\').parentPort.postMessage(2 + 2)',
    18	      { eval: true });
    19	    worker.on('message', common.mustCallAtLeast((result) => {
    20	      assert.strictEqual(result, 4);
    21	    }, 0));
    22	    const expected = ['ERR_WORKER_INIT_FAILED', 'EMFILE', 'ENFILE', 'ENOENT'];
    23	    worker.on('error', common.mustCallAtLeast((e) => {
