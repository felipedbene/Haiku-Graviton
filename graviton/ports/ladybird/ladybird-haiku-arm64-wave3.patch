 file(GLOB root_output_files "${CARGO_BUILD_SCRIPT_DIR}/${CRATE_NAME}-*/root-output")
+# DeBeOS/Haiku: this cargo (1.100 nightly) uses the new build-dir layout
+# build/<crate>/<hash>/run/root-output (crate name is a directory), not the
+# old build/<crate>-<hash>/root-output. Match both; the recurse is scoped to
+# the crate dir so sibling crates' RustFFI.h cannot bleed in.
+file(GLOB_RECURSE _ladybird_new_layout_root_outputs "${CARGO_BUILD_SCRIPT_DIR}/${CRATE_NAME}/root-output")
+list(APPEND root_output_files ${_ladybird_new_layout_root_outputs})
 
