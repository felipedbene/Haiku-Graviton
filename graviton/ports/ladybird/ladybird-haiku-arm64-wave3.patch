diff --git a/Meta/CMake/rust_crate.cmake b/Meta/CMake/rust_crate.cmake
index c6efdc78d7..7fe8771551 100644
--- a/Meta/CMake/rust_crate.cmake
+++ b/Meta/CMake/rust_crate.cmake
@@ -275,8 +275,21 @@ function(_rust_crate_common_setup)
     # On Windows, rustc invokes the linker directly with MSVC-style flags, so we must not override it with a
     # compiler driver like clang-cl.
     if (NOT WIN32)
+        # DeBeOS/Haiku: bare clang cannot link a runnable Haiku executable (no
+        # Haiku clang driver toolchain -> missing crt + split-libc default libs),
+        # so Rust host build-scripts/proc-macros linked with it crash at startup
+        # (exit 255). gcc is Haiku's system driver and links them correctly. The
+        # crate here is a staticlib (archived by AR), so this linker only affects
+        # host build artifacts, never the objects linked into Ladybird by lld.
+        set(_ladybird_rust_linker "${CMAKE_C_COMPILER}")
+        if (HAIKU)
+            find_program(_ladybird_haiku_rust_linker cc)
+            if (_ladybird_haiku_rust_linker)
+                set(_ladybird_rust_linker "${_ladybird_haiku_rust_linker}")
+            endif()
+        endif()
         list(APPEND cargo_env
-            "CARGO_TARGET_${target_upper}_LINKER=${CMAKE_C_COMPILER}"
+            "CARGO_TARGET_${target_upper}_LINKER=${_ladybird_rust_linker}"
             "AR_${target_underscore}=${CMAKE_AR}"
         )
     endif()
@@ -293,7 +306,6 @@ function(_rust_crate_common_setup)
         ${cargo_profile_flag}
         --
         -Cdefault-linker-libraries=yes
-        -D warnings
         --emit=dep-info
     )
 
