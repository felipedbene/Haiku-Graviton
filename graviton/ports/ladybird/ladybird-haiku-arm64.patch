+    if ((CMAKE_CXX_COMPILER_ID MATCHES "Clang$" AND (ENABLE_ADDRESS_SANITIZER OR ENABLE_MEMORY_SANITIZER OR ENABLE_THREAD_SANITIZER OR ENABLE_UNDEFINED_SANITIZER OR ENABLE_LAGOM_COVERAGE_COLLECTION)) OR BSD OR HAIKU OR CMAKE_SYSTEM_NAME STREQUAL "Haiku")
         add_link_options(LINKER:--allow-shlib-undefined)
         add_link_options(LINKER:-z,undefs)
     else()
diff --git a/Meta/CMake/rust_crate.cmake b/Meta/CMake/rust_crate.cmake
index c6efdc78d7..ff9d2241f6 100644
--- a/Meta/CMake/rust_crate.cmake
+++ b/Meta/CMake/rust_crate.cmake
@@ -276,7 +276,11 @@ function(_rust_crate_common_setup)
     # compiler driver like clang-cl.
     if (NOT WIN32)
         list(APPEND cargo_env
-            "CARGO_TARGET_${target_upper}_LINKER=${CMAKE_C_COMPILER}"
+            # DeBeOS/Haiku: the clang driver does not emit a PT_INTERP for PIE
+            # executables, so cargo host build-script binaries fail to load
+            # ("Could not map image"). gcc (cc) links them correctly; use it as
+            # the Rust linker driver on Haiku.
+            "CARGO_TARGET_${target_upper}_LINKER=cc"
             "AR_${target_underscore}=${CMAKE_AR}"
         )
     endif()
