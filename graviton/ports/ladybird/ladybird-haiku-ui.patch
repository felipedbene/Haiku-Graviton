@@ -0,0 +1,77 @@
+/*
+ * Copyright (c) 2026, the DeBeOS developers
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <AK/ByteString.h>
+#include <AK/Function.h>
+#include <AK/HashMap.h>
+
+#include <Messenger.h>
+#include <String.h>
+#include <Window.h>
+
+class BButton;
+class BCardLayout;
+class BTextControl;
+
+namespace Ladybird {
+
+class PageView;
+class Tab;
+class TabStrip;
+class WindowModel;
+
+// One browser window. [W] only: pure UI on its own looper thread. It holds no LibWebView pointer; every engine
+// request is a closure posted to the Core thread that re-resolves its WindowModel and Tab by id, and every engine
+// update arrives as a BMessage from the WindowModel.
+class BrowserWindow final : public BWindow {
+public:
+    BrowserWindow(BRect frame, u64 model_id);
+    virtual ~BrowserWindow() override;
+
+    virtual void MessageReceived(BMessage*) override;
+    virtual bool QuitRequested() override;
+    virtual void WindowActivated(bool active) override;
+
+private:
+    struct TabState {
+        PageView* page_view { nullptr };
+        ByteString title;
+        ByteString url;
+        bool can_go_back { false };
+        bool can_go_forward { false };
+        bool loading { false };
+    };
+
+    void post_to_model(Function<void(WindowModel&)>);
+    void post_to_tab(u64 tab_id, Function<void(Tab&)>);
+    void post_to_current_tab(Function<void(Tab&)>);
+
+    void add_tab(BMessage const&);
+    void remove_tab(u64 tab_id);
+    void activate_tab(u64 tab_id, bool activate_window);
+    void apply_current_tab_state();
+    void set_location_text(ByteString const&);
+
+    u64 m_model_id { 0 };
+    Optional<u64> m_current_tab_id;
+    HashMap<u64, TabState> m_tabs;
+
+    TabStrip* m_tab_strip { nullptr };
+    BButton* m_back_button { nullptr };
+    BButton* m_forward_button { nullptr };
+    BButton* m_reload_button { nullptr };
+    BButton* m_new_tab_button { nullptr };
+    BTextControl* m_location { nullptr };
+    BString m_last_location_text; // what set_location_text() last put in the field; anything else is the user's
+    BCardLayout* m_pages { nullptr };
+
+    HashMap<u64, BMessenger> m_open_dialogs; // dialog id -> its panel
+    bool m_may_quit { false };
+};
+
+}
diff --git a/UI/Haiku/CMakeLists.txt b/UI/Haiku/CMakeLists.txt
new file mode 100644
index 0000000..cb13563
--- /dev/null
+++ b/UI/Haiku/CMakeLists.txt
@@ -0,0 +1,48 @@
+# Native Haiku (DeBeOS) chrome for Ladybird.
+#
+# Threading model, which every file here follows (see Application.h):
+#   - the team main thread runs Core::EventLoop and owns every LibWebView/LibIPC
+#     object (the stock EventLoopManagerUnix path headless-shot already uses);
+#   - the BApplication is constructed and Run() on its own spawned thread;
+#   - each BWindow is its own looper thread and only touches BViews.
+add_executable(ladybird main.cpp)
+target_sources(ladybird PRIVATE
+    Application.cpp
+    BrowserWindow.cpp
+    Dialogs.cpp
+    KeyMapping.cpp
+    PageView.cpp
+    Tab.cpp
+    TabStrip.cpp
+    WebViewBridge.cpp
+    WindowModel.cpp
+)
+
+# libbe only: BApplication/BWindow/BView/BBitmap/BTextControl/BAlert/BClipboard.
+# Every NEEDED entry becomes a package requirement, so nothing is linked
+# speculatively (libtracker/libtranslation are not used).
+target_link_libraries(ladybird PRIVATE be LibFileSystem)
+
+# OUTPUT_NAME "Ladybird" (WebDriver launches a binary of that name,
+# Services/WebDriver/main.cpp) and share/Lagom resources in the build tree.
+create_ladybird_bundle(ladybird)
+
+# Application identity: signature, launch flags, version, supported types and
+# the vector icon. rc and xres ship in the base image; mimeset is deliberately
+# not used, because it is a silent no-op without an app_server and BAppFileInfo
+# falls back from attributes to resources anyway.
+find_program(HAIKU_RC_EXECUTABLE rc REQUIRED)
+find_program(HAIKU_XRES_EXECUTABLE xres REQUIRED)
+set(ladybird_haiku_rsrc "${CMAKE_CURRENT_BINARY_DIR}/Ladybird.rsrc")
+add_custom_command(
+    OUTPUT "${ladybird_haiku_rsrc}"
+    COMMAND "${HAIKU_RC_EXECUTABLE}" -o "${ladybird_haiku_rsrc}" "${CMAKE_CURRENT_SOURCE_DIR}/Ladybird.rdef"
+    DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/Ladybird.rdef"
+    VERBATIM
+)
+add_custom_target(ladybird_haiku_resources DEPENDS "${ladybird_haiku_rsrc}")
+add_dependencies(ladybird ladybird_haiku_resources)
+add_custom_command(TARGET ladybird POST_BUILD
+    COMMAND "${HAIKU_XRES_EXECUTABLE}" -o "$<TARGET_FILE:ladybird>" "${ladybird_haiku_rsrc}"
+    VERBATIM
+)
diff --git a/UI/Haiku/Dialogs.cpp b/UI/Haiku/Dialogs.cpp
new file mode 100644
index 0000000..715f3ef
--- /dev/null
+++ b/UI/Haiku/Dialogs.cpp
@@ -0,0 +1,147 @@
+/*
+ * Copyright (c) 2026, the DeBeOS developers
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <UI/Haiku/Dialogs.h>
+#include <UI/Haiku/Messages.h>
+
+#include <Alert.h>
+#include <Button.h>
+#include <Invoker.h>
+#include <LayoutBuilder.h>
+#include <String.h>
+#include <StringView.h>
+#include <TextControl.h>
+#include <Window.h>
+
+namespace Ladybird {
+
+static BString title_for(char const* origin)
+{
+    BString title;
+    title << (origin && *origin ? origin : "Ladybird") << " says";
+    return title;
+}
+
+BMessenger show_alert(BMessenger target, u64 tab_id, u64 dialog_id, char const* origin, char const* message)
+{
+    auto* alert = new BAlert(title_for(origin).String(), message, "OK", nullptr, nullptr, B_WIDTH_AS_USUAL, B_INFO_ALERT);
+    alert->SetShortcut(0, B_ESCAPE);
+    BMessage reply(kMsgAlertClosed);
+    reply.AddUInt64("tab", tab_id);
+    reply.AddUInt64("dialog", dialog_id);
+    BMessenger panel(alert);
+    alert->Go(new BInvoker(new BMessage(reply), target)); // asynchronous: replies, then deletes itself
+    return panel;
+}
+
+BMessenger show_confirm(BMessenger target, u64 tab_id, u64 dialog_id, char const* origin, char const* message)
+{
+    auto* alert = new BAlert(title_for(origin).String(), message, "Cancel", "OK", nullptr, B_WIDTH_AS_USUAL, B_IDEA_ALERT);
+    alert->SetShortcut(0, B_ESCAPE);
+    BMessage reply(kMsgConfirmClosed); // BAlert adds "which": 0 = Cancel, 1 = OK
+    reply.AddUInt64("tab", tab_id);
+    reply.AddUInt64("dialog", dialog_id);
+    BMessenger panel(alert);
+    alert->Go(new BInvoker(new BMessage(reply), target));
+    return panel;
+}
+
+namespace {
+
+// window.prompt(): BAlert has no text field, so a small titled window. Replies exactly once.
+class PromptWindow final : public BWindow {
+public:
+    enum : uint32 {
+        kMsgOk = four_cc('l', 'b', 'P', 'o'),
+        kMsgCancel = four_cc('l', 'b', 'P', 'x'),
+    };
+
+    PromptWindow(BMessenger target, u64 tab_id, u64 dialog_id, char const* origin, char const* message, char const* default_text)
+        : BWindow(BRect(200, 200, 620, 320), title_for(origin).String(), B_TITLED_WINDOW_LOOK, B_FLOATING_ALL_WINDOW_FEEL,
+              B_NOT_ZOOMABLE | B_NOT_MINIMIZABLE | B_AUTO_UPDATE_SIZE_LIMITS | B_ASYNCHRONOUS_CONTROLS | B_CLOSE_ON_ESCAPE)
+        , m_target(target)
+        , m_tab_id(tab_id)
+        , m_dialog_id(dialog_id)
+    {
+        m_text = new BTextControl("prompt text", nullptr, default_text, nullptr);
+        auto* ok = new BButton("ok", "OK", new BMessage(kMsgOk));
+        auto* cancel = new BButton("cancel", "Cancel", new BMessage(kMsgCancel));
+        BLayoutBuilder::Group<>(this, B_VERTICAL, B_USE_DEFAULT_SPACING)
+            .SetInsets(B_USE_WINDOW_SPACING)
+            .Add(new BStringView("prompt message", message))
+            .Add(m_text)
+            .AddGroup(B_HORIZONTAL)
+                .AddGlue()
+                .Add(cancel)
+                .Add(ok)
+            .End();
+        SetDefaultButton(ok);
+        m_text->MakeFocus(true);
+        CenterOnScreen();
+    }
+
+    virtual void MessageReceived(BMessage* message) override
+    {
+        switch (message->what) {
+        case kMsgOk:
+            reply(true);
+            Quit();
+            return;
+        case kMsgCancel:
+            reply(false);
+            Quit();
+            return;
+        default:
+            BWindow::MessageReceived(message);
+        }
+    }
+
+    // Close box, Escape (B_CLOSE_ON_ESCAPE) and an early dismissal from the Core thread all come here.
+    virtual bool QuitRequested() override
+    {
+        reply(false);
+        return true;
+    }
+
+private:
+    void reply(bool accepted)
+    {
+        if (m_replied)
+            return;
+        m_replied = true;
+        BMessage message(kMsgPromptClosed);
+        message.AddUInt64("tab", m_tab_id);
+        message.AddUInt64("dialog", m_dialog_id);
+        message.AddBool("accepted", accepted);
+        message.AddString("text", m_text->Text());
+        m_target.SendMessage(&message);
+    }
+
+    BMessenger m_target;
+    u64 m_tab_id { 0 };
+    u64 m_dialog_id { 0 };
+    BTextControl* m_text { nullptr };
+    bool m_replied { false };
+};
+
+}
+
+BMessenger show_prompt(BMessenger target, u64 tab_id, u64 dialog_id, char const* origin, char const* message, char const* default_text)
+{
+    auto* window = new PromptWindow(target, tab_id, dialog_id, origin, message, default_text);
+    BMessenger panel(window);
+    window->Show();
+    return panel;
+}
+
+void show_quit_confirmation(BMessenger target, char const* reason)
+{
+    auto* alert = new BAlert("Quit Ladybird?", reason, "Cancel", "Quit", nullptr, B_WIDTH_AS_USUAL, B_WARNING_ALERT);
+    alert->SetShortcut(0, B_ESCAPE);
+    alert->Go(new BInvoker(new BMessage(kMsgQuitConfirmed), target)); // "which": 1 = Quit
+}
+
+}
diff --git a/UI/Haiku/Dialogs.h b/UI/Haiku/Dialogs.h
