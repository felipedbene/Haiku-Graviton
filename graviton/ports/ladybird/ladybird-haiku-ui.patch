+
+namespace Ladybird {
+
+static Core::EventLoop* s_core_loop = nullptr;
+static thread_id s_core_thread = -1;
+static Atomic<bool> s_core_accepting { false };
+static Atomic<bool> s_core_has_exited { false };
+
+namespace {
+
+class LadybirdBApplication final : public BApplication {
+public:
+    explicit LadybirdBApplication(status_t* error)
+        // The status_t* constructor reports failure (no app_server, bad signature) instead of calling exit(0)
+        // the way the one-argument constructor does (src/kits/app/Application.cpp:533-540).
+        : BApplication(application_signature, error)
+    {
+    }
+
+    // The registrar hands our own argv back (B_ARGV_RECEIVED). Core::ArgsParser already consumed it in
+    // WebView::Application::initialize(), and a second launch is routed by BrowserProcess, not by the roster.
+    virtual void ArgvReceived(int32, char**) override { }
+
+    // Tracker "Open with Ladybird", or a file dropped on the Deskbar entry.
+    virtual void RefsReceived(BMessage* message) override
+    {
+        entry_ref ref;
+        for (int32 i = 0; message->FindRef("refs", i, &ref) == B_OK; ++i) {
+            BPath path;
+            if (BEntry(&ref, true).GetPath(&path) != B_OK)
+                continue;
+            Application::post_to_core([path = ByteString { path.Path() }] {
+                if (auto url = URL::create_with_file_scheme(path); url.has_value())
+                    Application::the().open_file(*url);
+            });
+        }
+    }
+
+    // Command+Q in any window and Deskbar's "Quit" both land here. The engine is torn down on the Core thread;
+    // the BApplication only goes away once Core has finished, at which point stop_haiku_application() asks again.
+    virtual bool QuitRequested() override
+    {
+        if (s_core_has_exited.load())
+            return true;
+        Application::post_to_core([] { Application::the().request_quit(); });
+        return false;
+    }
+};
+
+}
+
+Application::Application(ByteString application_directory)
+    // platform_init() takes the application *directory* (LibWebCommon/WebView/Utilities.cpp:54-55, 73-94).
+    : WebView::Application(move(application_directory))
+{
+}
+
+Application::~Application()
+{
+    // Normally empty: the last window closing is what ends the loop. If the loop stopped another way (a signal
+    // handler LibWebView installed, for instance), the remaining tabs are destroyed here, on the Core thread and
+    // while the ProcessManager the base class owns is still alive, so each page is still closed properly.
+    m_windows.clear();
+}
+
+bool Application::is_core_thread()
+{
+    return find_thread(nullptr) == s_core_thread;
+}
+
+bool Application::post_to_core(Function<void()> function)
+{
+    if (!s_core_accepting.load())
+        return false;
+    // Must be the loop *object*: the free Core::deferred_invoke targets the calling thread's loop (EventLoop.cpp:148-150).
+    s_core_loop->deferred_invoke(move(function));
+    return true;
+}
+
+void Application::create_platform_options(WebView::BrowserOptions&, WebView::RequestServerOptions&, WebView::WebContentOptions& web_content_options)
+{
+    // Hardware-proven requirement on Haiku: PathFontProvider finds no UiMonospace and FontPlugin VERIFYs
+    // (Services/HeadlessShot/main.cpp:26-32).
+    web_content_options.force_fontconfig = WebView::ForceFontconfig::Yes;
+}
+
+status_t Application::be_application_thread_entry(void* data)
+{
+    auto& self = *static_cast<Application*>(data);
+    auto* be_application = new LadybirdBApplication(&self.m_be_application_status);
+    auto status = self.m_be_application_status;
+    release_sem(self.m_be_application_ready);
+    if (status != B_OK) {
+        delete be_application;
+        return status;
+    }
+    be_application->Run();
+    // ~BApplication force-quits any window still open (src/kits/app/Application.cpp:318), which drops the
+    // PageViews' surface references while the app_server link is still alive.
+    delete be_application;
+    return B_OK;
+}
+
+ErrorOr<void> Application::start_haiku_application()
+{
+    // initialize() created the loop on this thread (WebView::Application::initialize, Application.cpp:696-697).
+    s_core_loop = &Core::EventLoop::current();
+    s_core_thread = find_thread(nullptr);
+    s_core_accepting.store(true);
+
+    m_be_application_ready = create_sem(0, "ladybird be_app ready");
+    if (m_be_application_ready < B_OK)
+        return Error::from_errno(ENOMEM);
+
+    m_be_application_thread = spawn_thread(be_application_thread_entry, "ladybird be_app", B_DISPLAY_PRIORITY, this);
+    if (m_be_application_thread < B_OK) {
+        delete_sem(m_be_application_ready);
+        return Error::from_string_literal("Unable to spawn the BApplication thread");
+    }
+    resume_thread(m_be_application_thread);
+
+    while (acquire_sem(m_be_application_ready) == B_INTERRUPTED) { }
+    delete_sem(m_be_application_ready);
+    m_be_application_ready = -1;
+
+    if (m_be_application_status != B_OK) {
+        status_t ignored;
+        wait_for_thread(m_be_application_thread, &ignored);
+        m_be_application_thread = -1;
+        s_core_accepting.store(false);
+        warnln("Ladybird: cannot connect to the app_server ({}). Use --headless when there is no display.", strerror(m_be_application_status));
+        return Error::from_errno(m_be_application_status);
+    }
+    return {};
+}
+
+void Application::stop_haiku_application()
+{
+    s_core_accepting.store(false);
+    s_core_has_exited.store(true);
+    if (m_be_application_thread < B_OK)
+        return;
+    be_app_messenger.SendMessage(B_QUIT_REQUESTED); // LadybirdBApplication::QuitRequested() now returns true
+    status_t ignored;
+    while (wait_for_thread(m_be_application_thread, &ignored) == B_INTERRUPTED) { }
+    m_be_application_thread = -1;
+}
+
+WindowModel& Application::new_window(Vector<URL::URL> const& initial_urls, Optional<Web::HTML::PreparedNavigationDescriptor> initial_navigation)
+{
+    VERIFY(is_core_thread());
+    auto id = m_next_window_id++;
+    auto model = WindowModel::create(id);
+    auto& model_ref = *model;
+    m_windows.set(id, move(model));
+    m_window_activation_order.append(id);
+
+    if (initial_navigation.has_value()) {
+        model_ref.create_new_tab(Web::HTML::ActivateTab::Yes).view().load(initial_navigation.release_value());
+    } else {
+        for (size_t i = 0; i < initial_urls.size(); ++i)
+            model_ref.new_tab_from_url(initial_urls[i], i == 0 ? Web::HTML::ActivateTab::Yes : Web::HTML::ActivateTab::No);
+    }
+    if (model_ref.tab_count() == 0)
+        model_ref.new_tab_from_url(settings().new_tab_page_url(), Web::HTML::ActivateTab::Yes);
+
+    model_ref.show();
+    return model_ref;
+}
+
+WindowModel* Application::window_model(u64 id)
+{
+    auto it = m_windows.find(id);
+    if (it == m_windows.end())
+        return nullptr;
+    return it->value.ptr();
+}
+
+WindowModel* Application::active_window_if_any() const
+{
+    if (m_window_activation_order.is_empty())
+        return nullptr;
+    auto it = m_windows.find(m_window_activation_order.last());
+    if (it == m_windows.end())
+        return nullptr;
+    return it->value.ptr();
+}
+
+void Application::set_active_window(u64 id)
+{
+    if (!m_windows.contains(id))
+        return;
+    m_window_activation_order.remove_all_matching([id](u64 candidate) { return candidate == id; });
+    m_window_activation_order.append(id);
+}
+
+void Application::window_model_closed(u64 id)
+{
+    VERIFY(is_core_thread());
+    m_window_activation_order.remove_all_matching([id](u64 candidate) { return candidate == id; });
+    // The model may be the caller; destroy it on the next turn of the loop, after its stack frame is gone.
+    if (auto model = m_windows.take(id); model.has_value())
+        Core::deferred_invoke([model = model.release_value()] { });
+
+    // Closing the last window ends the process, as Qt's quit-on-last-window does.
+    if (m_windows.is_empty())
+        begin_shutdown();
+}
+
+void Application::open_file(URL::URL const& url)
+{
+    if (auto* window = active_window_if_any()) {
+        window->new_tab_from_url(url, Web::HTML::ActivateTab::Yes);
+        window->activate();
+        return;
+    }
+    new_window({ url });
+}
+
+void Application::request_quit()
+{
+    if (m_quitting)
+        return;
+    if (file_downloader().has_unresumable_downloads()) {
+        // Mirrors Qt's confirm_stop_active_downloads (UI/Qt/Application.cpp:685-707), asynchronously: the window
+        // shows a BAlert and posts quit_confirmed() back only if the user accepts.
+        if (auto* window = active_window_if_any()) {
+            window->confirm_quit("Downloads in progress cannot be resumed after Ladybird quits."sv);
+            return;
+        }
+    }
+    quit_confirmed();
+}
+
+void Application::quit_confirmed()
+{
+    if (m_quitting)
+        return;
+    m_quitting = true;
+
+    file_downloader().pause_active_downloads(); // as UI/Qt/Application.cpp:706
+    // Before the windows close, or the session is persisted as "closed windows" (Qt Application.cpp:671).
+    default_session().session_store->application_quitting();
+
+    if (m_windows.is_empty()) {
+        begin_shutdown();
+        return;
+    }
+    Vector<u64> ids;
+    for (auto const& entry : m_windows)
+        ids.append(entry.key);
+    for (auto id : ids) {
+        if (auto* model = window_model(id))
+            model->close_for_quit(); // ends in window_model_closed(), the last of which calls begin_shutdown()
+    }
+}
+
+void Application::begin_shutdown()
+{
+    VERIFY(is_core_thread());
+    // On Haiku helpers exit only when their IPC socket closes: die_with_parent is Linux-only
+    // (LibCore/Process.cpp:325-330, 370-373) and the ProcessReaper is macOS-only (LibWebView/Process.cpp:142-172).
+    // Record who they are now, while the ProcessManager still exists, so main() can reap them with a bound.
+    m_helper_pids_at_shutdown = helper_pids();
+    s_core_accepting.store(false);
+    // Queued behind the deferred tab and window destructions (WindowModel::definitely_close_tab,
+    // window_model_closed), so every ViewImplementation is destroyed -- closing its page -- before the loop stops.
+    // process_did_exit() stops respawning once exit is requested (Application.cpp:2107-2110).
+    Core::deferred_invoke([] { Core::EventLoop::current().quit(0); });
+}
+
+Vector<pid_t> Application::helper_pids()
+{
+    Vector<pid_t> pids;
+    process_manager().for_each_process([&](WebView::Process& process) {
+        if (process.type() != WebView::ProcessType::Browser)
+            pids.append(process.pid());
+    });
+    return pids;
+}
+
+Optional<WebView::ViewImplementation&> Application::active_web_view() const
+{
+    if (auto* window = active_window_if_any(); window && window->current_tab())
+        return window->current_tab()->view();
+    return {};
+}
+
+Vector<WebView::ViewImplementation&> Application::active_window_web_views() const
+{
+    Vector<WebView::ViewImplementation&> views;
+    if (auto* window = active_window_if_any())
+        window->for_each_tab([&](Tab& tab) { views.append(tab.view()); });
+    return views;
+}
+
+bool Application::activate_tab_with_url(URL::URL const& url) const
+{
+    auto* window = active_window_if_any();
+    return window && window->activate_tab_with_url(url);
+}
+
+Optional<WebView::ViewImplementation&> Application::open_blank_new_tab(Web::HTML::ActivateTab activate_tab) const
+{
+    auto& self = const_cast<Application&>(*this);
+    if (auto* window = active_window_if_any())
+        return window->create_new_tab(activate_tab).view();
+    auto& window = self.new_window({ settings().new_tab_page_url() });
+    return window.current_tab()->view();
+}
+
+void Application::open_url_in_new_tab(URL::URL const& url, Web::HTML::ActivateTab activate_tab) const
+{
+    if (auto* window = active_window_if_any()) {
+        window->new_tab_from_url(url, activate_tab);
+        return;
+    }
+    const_cast<Application&>(*this).new_window({ url });
+}
+
+void Application::open_urls_in_new_tabs(ReadonlySpan<URL::URL> urls) const
+{
+    if (urls.is_empty())
+        return;
+    auto* window = active_window_if_any();
+    if (!window) {
+        const_cast<Application&>(*this).new_window(Vector<URL::URL> { urls });
+        return;
+    }
+    for (auto const& url : urls)
+        window->new_tab_from_url(url, Web::HTML::ActivateTab::No);
+}
+
+// Private windows are not offered (supports_private_browsing_windows() stays false), so IsPrivate is ignored.
+void Application::open_url_in_new_window(URL::URL const& url, WebView::IsPrivate)
+{
+    new_window({ url });
+}
+
+void Application::open_navigation_in_new_tab(Web::HTML::PreparedNavigationDescriptor navigation, Web::HTML::ActivateTab activate_tab) const
+{
+    if (auto* window = active_window_if_any()) {
+        window->create_new_tab(activate_tab).view().load(move(navigation));
+        return;
+    }
+    const_cast<Application&>(*this).new_window({}, move(navigation));
+}
+
+void Application::open_navigation_in_new_window(Web::HTML::PreparedNavigationDescriptor navigation, WebView::IsPrivate)
+{
+    new_window({}, move(navigation));
+}
+
+void Application::display_error_dialog(StringView error_message) const
+{
+    warnln("{}", error_message);
+    // initialize() can report errors before the BApplication exists (or under --headless); stderr is all there is then.
+    if (!be_app)
+        return;
+    // Go(nullptr) is asynchronous: the BAlert runs its own looper and deletes itself, so Core never blocks.
+    auto* alert = new BAlert("Ladybird", ByteString { error_message }.characters(), "OK", nullptr, nullptr, B_WIDTH_AS_USUAL, B_WARNING_ALERT);
+    alert->Go(nullptr);
+}
+
+// Haiku has one system clipboard; there is no X11-style selection buffer.
+bool Application::supports_clipboard_type(ClipboardType type) const
+{
+    return type == ClipboardType::Text;
+}
+
+Utf16String Application::clipboard_text(ClipboardType) const
+{
+    for (auto const& representation : clipboard_item().system_clipboard_representations) {
+        if (representation.name != "text/plain"sv)
+            continue;
+        if (auto const* data = representation.data.get_pointer<ByteString>())
+            return Utf16String::from_utf8(*data);
+    }
+    return {};
+}
+
+void Application::set_clipboard_text(String text, ClipboardType)
+{
+    Web::Clipboard::SystemClipboardItem item;
+    item.system_clipboard_representations.append({ .name = "text/plain"_string, .data = text.to_byte_string() });
+    insert_clipboard_item(move(item));
+}
+
+Web::Clipboard::SystemClipboardItem Application::clipboard_item() const
+{
+    // No BApplication (headless runs of this binary): fall back to the in-process clipboard.
+    if (!be_clipboard)
+        return WebView::Application::clipboard_item();
+    Web::Clipboard::SystemClipboardItem item;
+    if (!be_clipboard->Lock())
+        return item;
+    if (auto* data = be_clipboard->Data()) {
+        char* name = nullptr;
+        type_code type;
+        for (int32 i = 0; data->GetInfo(B_MIME_TYPE, i, &name, &type) == B_OK; ++i) {
+            void const* bytes = nullptr;
+            ssize_t size = 0;
+            if (data->FindData(name, B_MIME_TYPE, &bytes, &size) != B_OK)
+                continue;
+            auto mime = String::from_utf8(StringView { name, strlen(name) });
+            if (mime.is_error())
+                continue;
+            // Haiku text producers store "text/plain" without a trailing NUL; tolerate one if present.
+            auto length = static_cast<size_t>(size);
+            if (length > 0 && static_cast<char const*>(bytes)[length - 1] == '\0')
+                --length;
+            item.system_clipboard_representations.append({ .name = mime.release_value(), .data = ByteString { static_cast<char const*>(bytes), length } });
+        }
+    }
+    be_clipboard->Unlock();
+    // BClipboard carries bytes only, so SelectedFile representations never reach it: insert_clipboard_item() keeps
+    // them in the base class's in-process item. Merge them back so a pasted file still arrives.
+    auto in_process_item = WebView::Application::clipboard_item();
+    for (auto& representation : in_process_item.system_clipboard_representations) {
+        if (representation.data.has<Web::HTML::SelectedFile>())
+            item.system_clipboard_representations.append(move(representation));
+    }
+    return item;
+}
+
+void Application::insert_clipboard_item(Web::Clipboard::SystemClipboardItem item)
+{
+    if (!be_clipboard || !be_clipboard->Lock()) {
+        WebView::Application::insert_clipboard_item(move(item));
+        return;
+    }
+    be_clipboard->Clear();
+    if (auto* data = be_clipboard->Data()) {
+        for (auto const& representation : item.system_clipboard_representations) {
+            // SelectedFile representations only come from desktop file copies (SystemClipboard.h:23-29); BClipboard
+            // carries bytes, so they stay in-process through the base class below.
+            if (auto const* bytes = representation.data.get_pointer<ByteString>())
+                data->AddData(representation.name.to_byte_string().characters(), B_MIME_TYPE, bytes->characters(), bytes->length());
+        }
+        be_clipboard->Commit();
+    }
+    be_clipboard->Unlock();
+    WebView::Application::insert_clipboard_item(move(item));
+}
+
+}
diff --git a/UI/Haiku/Application.h b/UI/Haiku/Application.h
new file mode 100644
index 0000000..ffc942c
--- /dev/null
+++ b/UI/Haiku/Application.h
@@ -0,0 +1,110 @@
+/*
+ * Copyright (c) 2026, the DeBeOS developers
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <AK/Atomic.h>
+#include <AK/Function.h>
+#include <AK/HashMap.h>
+#include <AK/NonnullOwnPtr.h>
+#include <AK/Vector.h>
+#include <LibURL/URL.h>
+#include <LibWebView/Application.h>
+
+#include <OS.h>
+
+namespace Ladybird {
+
+class Tab;
+class WindowModel;
+
+inline constexpr char const* application_signature = "application/x-vnd.DeBeOS-Ladybird";
+
+// Threading contract for the whole Haiku front end.
+//
+// [C] The Core thread is the team's main thread. It runs the stock Core::EventLoop (EventLoopManagerUnix,
+//     the path headless-shot proved on Haiku) and owns every LibWebView and LibIPC object. That is not a
+//     preference: IPC::ConnectionBase VERIFYs its owner thread (LibIPC/Connection.cpp:79,100,108,152,196) and
+//     ProcessManager its creation loop (LibWebView/ProcessManager.cpp:175-179).
+// [A] The BApplication is constructed and Run() on its own spawned thread. BLooper::Loop() only requires the
+//     constructing thread to be the running one (src/kits/app/Looper.cpp:499-512).
+// [W] Each BWindow is its own looper thread and only touches BViews.
+//
+// [A]/[W] reach [C] only through post_to_core(): EventLoop::deferred_invoke queues under a mutex and wakes the
+// loop when called from another thread (LibCore/EventLoopImplementation.cpp:43-48, ThreadEventQueue.cpp:97-104).
+// [C] reaches [W] only through BMessenger. [W] and [A] never wait for [C], so no lock-order cycle can form.
+class Application final : public WebView::Application {
+    WEB_VIEW_APPLICATION(Application)
+
+public:
+    virtual ~Application() override;
+
+    // [any] Fire-and-forget. Returns false once the Core loop has stopped accepting work.
+    static bool post_to_core(Function<void()>);
+    static bool is_core_thread();
+
+    // [C] Spawns the BApplication thread and waits until the BApplication exists, or failed to.
+    ErrorOr<void> start_haiku_application();
+    // [C] After execute() returned: quits the BApplication and joins its thread.
+    void stop_haiku_application();
+
+    // [C] Window bookkeeping.
+    WindowModel& new_window(Vector<URL::URL> const& initial_urls, Optional<Web::HTML::PreparedNavigationDescriptor> initial_navigation = {});
+    WindowModel* window_model(u64 id);
+    WindowModel* active_window_if_any() const;
+    void set_active_window(u64 id);
+    void window_model_closed(u64 id);
+    void open_file(URL::URL const&);
+
+    // [C] Explicit quit (Command+Q, Deskbar "Quit", B_QUIT_REQUESTED). Asks first if downloads would be lost.
+    void request_quit();
+    void quit_confirmed();
+
+    // [C] Helper pids recorded when shutdown began, for main() to reap after ~Application.
+    Vector<pid_t> const& helper_pids_at_shutdown() const { return m_helper_pids_at_shutdown; }
+    // [C] Every helper the ProcessManager currently knows (everything but the Browser process itself).
+    Vector<pid_t> helper_pids();
+
+private:
+    explicit Application(ByteString application_directory);
+
+    void begin_shutdown();
+
+    virtual void create_platform_options(WebView::BrowserOptions&, WebView::RequestServerOptions&, WebView::WebContentOptions&) override;
+
+    virtual Optional<WebView::ViewImplementation&> active_web_view() const override;
+    virtual Vector<WebView::ViewImplementation&> active_window_web_views() const override;
+    virtual bool activate_tab_with_url(URL::URL const&) const override;
+
+    virtual Optional<WebView::ViewImplementation&> open_blank_new_tab(Web::HTML::ActivateTab) const override;
+    virtual void open_url_in_new_tab(URL::URL const&, Web::HTML::ActivateTab) const override;
+    virtual void open_urls_in_new_tabs(ReadonlySpan<URL::URL>) const override;
+    virtual void open_url_in_new_window(URL::URL const&, WebView::IsPrivate) override;
+    virtual void open_navigation_in_new_tab(Web::HTML::PreparedNavigationDescriptor, Web::HTML::ActivateTab) const override;
+    virtual void open_navigation_in_new_window(Web::HTML::PreparedNavigationDescriptor, WebView::IsPrivate) override;
+
+    virtual void display_error_dialog(StringView error_message) const override;
+
+    virtual bool supports_clipboard_type(ClipboardType) const override;
+    virtual Utf16String clipboard_text(ClipboardType) const override;
+    virtual void set_clipboard_text(String, ClipboardType) override;
+    virtual Web::Clipboard::SystemClipboardItem clipboard_item() const override;
+    virtual void insert_clipboard_item(Web::Clipboard::SystemClipboardItem) override;
+
+    static status_t be_application_thread_entry(void*);
+
+    thread_id m_be_application_thread { -1 };
+    sem_id m_be_application_ready { -1 };
+    status_t m_be_application_status { B_NO_INIT };
+
+    HashMap<u64, NonnullOwnPtr<WindowModel>> m_windows;
+    Vector<u64> m_window_activation_order; // most recently activated last
+    u64 m_next_window_id { 1 };
+    bool m_quitting { false };
+    Vector<pid_t> m_helper_pids_at_shutdown;
+};
+
+}
diff --git a/UI/Haiku/BrowserWindow.cpp b/UI/Haiku/BrowserWindow.cpp
new file mode 100644
index 0000000..46c6f6c
--- /dev/null
+++ b/UI/Haiku/BrowserWindow.cpp
@@ -0,0 +1,413 @@
+/*
+ * Copyright (c) 2026, the DeBeOS developers
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <LibWebView/Application.h>
+#include <UI/Haiku/Application.h>
+#include <UI/Haiku/BrowserWindow.h>
+#include <UI/Haiku/Dialogs.h>
+#include <UI/Haiku/Messages.h>
+#include <UI/Haiku/PageView.h>
+#include <UI/Haiku/Tab.h>
+#include <UI/Haiku/TabStrip.h>
+#include <UI/Haiku/WindowModel.h>
+
+#include <Button.h>
+#include <CardLayout.h>
+#include <GroupView.h>
+#include <LayoutBuilder.h>
+#include <MessageFilter.h>
+#include <String.h>
+#include <TextControl.h>
+#include <TextView.h>
+
+namespace Ladybird {
+
+namespace {
+
+// BTextControl's own Enter handling is unusable for a location field (src/kits/interface/TextInput.cpp): Enter
+// does nothing if the text is unchanged since focus (:99-103), and losing focus with edited text Invokes (:133-134),
+// which would navigate to half-typed text when the user clicks the page. So the control has no message, and this
+// filter on its text view takes Enter and Escape.
+class LocationKeyFilter final : public BMessageFilter {
+public:
+    LocationKeyFilter(BLooper* window, BTextView* text_view)
+        : BMessageFilter(B_ANY_DELIVERY, B_ANY_SOURCE, B_KEY_DOWN)
+        , m_window(window)
+        , m_text_view(text_view)
+    {
+    }
+
+    virtual filter_result Filter(BMessage* message, BHandler**) override
+    {
+        char const* bytes = nullptr;
+        if (message->FindString("bytes", &bytes) != B_OK || !bytes || bytes[0] == '\0' || bytes[1] != '\0')
+            return B_DISPATCH_MESSAGE;
+        if (bytes[0] == B_ENTER) {
+            BMessage navigate(kMsgNavigate);
+            navigate.AddString("text", m_text_view->Text());
+            m_window->PostMessage(&navigate);
+            return B_SKIP_MESSAGE;
+        }
+        if (bytes[0] == B_ESCAPE) {
+            m_window->PostMessage(kMsgFocusLocation); // reselects; the URL is restored from the tab's state
+            return B_SKIP_MESSAGE;
+        }
+        return B_DISPATCH_MESSAGE;
+    }
+
+private:
+    BLooper* m_window { nullptr };
+    BTextView* m_text_view { nullptr };
+};
+
+}
+
+BrowserWindow::BrowserWindow(BRect frame, u64 model_id)
+    : BWindow(frame, "Ladybird", B_DOCUMENT_WINDOW_LOOK, B_NORMAL_WINDOW_FEEL, B_AUTO_UPDATE_SIZE_LIMITS | B_ASYNCHRONOUS_CONTROLS)
+    , m_model_id(model_id)
+{
+    m_tab_strip = new TabStrip();
+    // Text labels, not icons: a generic, font-only toolbar that renders on any DeBeOS image. Words rather than
+    // U+25C0/U+25B6, which Noto Sans (the default UI font) does not contain.
+    m_back_button = new BButton("back", "Back", new BMessage(kMsgBack));
+    m_forward_button = new BButton("forward", "Forward", new BMessage(kMsgForward));
+    m_reload_button = new BButton("reload", "Reload", new BMessage(kMsgReloadOrStop));
+    m_new_tab_button = new BButton("new tab", "+", new BMessage(kMsgNewTab));
+    // Keyboard navigation cycles between the page and the location field only, as in every mainstream browser:
+    // Tab out of the page reaches the URL. Left navigable, Tab from the page landed on the Back button (measured:
+    // Tab, typed URL, Enter -- and Enter pressed Back). Each button has a shortcut instead (Command+[Shift+]Left/
+    // Right, Command+R, Command+T). Cleared before SetEnabled(), which only restores B_NAVIGABLE when it removed it
+    // (src/kits/interface/Control.cpp:351-364).
+    for (auto* button : { m_back_button, m_forward_button, m_reload_button, m_new_tab_button })
+        button->SetFlags(button->Flags() & ~B_NAVIGABLE);
+    m_back_button->SetEnabled(false);
+    m_forward_button->SetEnabled(false);
+    for (auto* button : { m_back_button, m_forward_button, m_new_tab_button })
+        button->SetExplicitMaxSize(BSize(button->PreferredSize().width, B_SIZE_UNSET));
+
+    m_location = new BTextControl("location", nullptr, "", nullptr);
+    m_location->SetMessage(nullptr);
+    m_location->TextView()->AddFilter(new LocationKeyFilter(this, m_location->TextView()));
+
+    m_pages = new BCardLayout();
+    auto* pages_view = new BView("pages", 0, m_pages);
+
+    BLayoutBuilder::Group<>(this, B_VERTICAL, 0)
+        .Add(m_tab_strip)
+        .AddGroup(B_HORIZONTAL, B_USE_SMALL_SPACING)
+            .SetInsets(B_USE_SMALL_SPACING, B_USE_SMALL_SPACING, B_USE_SMALL_SPACING, B_USE_SMALL_SPACING)
+            .Add(m_back_button)
+            .Add(m_forward_button)
+            .Add(m_reload_button)
+            .Add(m_location, 10.0f)
+            .Add(m_new_tab_button)
+        .End()
+        .Add(pages_view, 1.0f);
+
+    // Command+W closes the current tab rather than the window (BWindow binds it to B_QUIT_REQUESTED by default,
+    // src/kits/interface/Window.cpp:2829). Command+Q is left to BWindow, which forwards it to be_app.
+    RemoveShortcut('W', B_COMMAND_KEY);
+    AddShortcut('W', B_COMMAND_KEY, new BMessage(kMsgCloseCurrentTab));
+    AddShortcut('T', B_COMMAND_KEY, new BMessage(kMsgNewTab));
+    AddShortcut('L', B_COMMAND_KEY, new BMessage(kMsgFocusLocation));
+    AddShortcut('R', B_COMMAND_KEY, new BMessage(kMsgReloadOrStop));
+    // Back/forward from anywhere in the window, including the location field (in the page itself, Command+Left/Right
+    // also reach LibWebView's Alt+arrow traversal through KeyMapping's Command -> Alt mapping).
+    AddShortcut(B_LEFT_ARROW, B_COMMAND_KEY | B_SHIFT_KEY, new BMessage(kMsgBack));
+    AddShortcut(B_RIGHT_ARROW, B_COMMAND_KEY | B_SHIFT_KEY, new BMessage(kMsgForward));
+}
+
+BrowserWindow::~BrowserWindow() = default;
+
+void BrowserWindow::post_to_model(Function<void(WindowModel&)> task)
+{
+    Application::post_to_core([model_id = m_model_id, task = move(task)]() mutable {
+        if (auto* model = Application::the().window_model(model_id))
+            task(*model);
+    });
+}
+
+void BrowserWindow::post_to_tab(u64 tab_id, Function<void(Tab&)> task)
+{
+    post_to_model([tab_id, task = move(task)](WindowModel& model) mutable {
+        if (auto* tab = model.tab(tab_id))
+            task(*tab);
+    });
+}
+
+void BrowserWindow::post_to_current_tab(Function<void(Tab&)> task)
+{
+    if (m_current_tab_id.has_value())
+        post_to_tab(*m_current_tab_id, move(task));
+}
+
+void BrowserWindow::add_tab(BMessage const& message)
+{
+    uint64 tab_id = 0;
+    uint64 view_id = 0;
+    void* surface_pointer = nullptr;
+    if (message.FindUInt64("tab", &tab_id) != B_OK || message.FindUInt64("view", &view_id) != B_OK
+        || message.FindPointer("surface", &surface_pointer) != B_OK || !surface_pointer)
+        return;
+    // WindowModel::create_new_tab took one reference for this message; adopt it.
+    auto surface = adopt_ref(*static_cast<PresentSurface*>(surface_pointer));
+    auto* page_view = new PageView(tab_id, view_id, move(surface));
+    m_pages->AddView(page_view);
+    m_tab_strip->add_tab(tab_id);
+    TabState state;
+    state.page_view = page_view;
+    m_tabs.set(tab_id, move(state));
+}
+
+void BrowserWindow::remove_tab(u64 tab_id)
+{
+    auto state = m_tabs.take(tab_id);
+    if (!state.has_value())
+        return;
+    m_tab_strip->remove_tab(tab_id);
+    m_pages->RemoveView(state->page_view);
+    state->page_view->RemoveSelf();
+    delete state->page_view; // the window owns its PageViews; the engine side is already gone or going
+    if (m_current_tab_id == tab_id)
+        m_current_tab_id = {};
+}
+
+void BrowserWindow::activate_tab(u64 tab_id, bool activate_window)
+{
+    auto it = m_tabs.find(tab_id);
+    if (it == m_tabs.end())
+        return;
+    m_current_tab_id = tab_id;
+    m_tab_strip->select(tab_id);
+    if (auto index = m_pages->IndexOfView(it->value.page_view); index >= 0)
+        m_pages->SetVisibleItem(index);
+    bool location_focused = m_location->TextView()->IsFocus();
+    if (!location_focused)
+        it->value.page_view->MakeFocus(true);
+    apply_current_tab_state();
+    // Switching tabs abandons whatever was being typed for the previous one, so the field shows this tab's URL even
+    // while it keeps focus (apply_current_tab_state() leaves a focused field alone; measured: a tab opened from a
+    // second launch otherwise kept the previous tab's "about:newtab").
+    if (location_focused) {
+        m_location->SetText(it->value.url.characters());
+        m_last_location_text = m_location->Text();
+        m_location->TextView()->SelectAll();
+    }
+    if (activate_window)
+        Activate(true);
+}
+
+void BrowserWindow::set_location_text(ByteString const& url)
+{
+    // Never overwrite what the user is typing: a focused field is replaced only while it still holds exactly what
+    // this window last put there (so a URL that arrives after Command+T or a tab switch still shows up).
+    if (m_location->TextView()->IsFocus() && m_last_location_text != m_location->Text())
+        return;
+    bool select = m_location->TextView()->IsFocus();
+    m_location->SetText(url.characters());
+    m_last_location_text = m_location->Text();
+    if (select)
+        m_location->TextView()->SelectAll();
+}
+
+void BrowserWindow::apply_current_tab_state()
+{
+    if (!m_current_tab_id.has_value())
+        return;
+    auto it = m_tabs.find(*m_current_tab_id);
+    if (it == m_tabs.end())
+        return;
+    auto const& state = it->value;
+    BString title;
+    if (state.title.is_empty())
+        title = "Ladybird";
+    else
+        title << state.title.characters() << " - Ladybird"; // the Qt chrome's format (UI/Qt/BrowserWindow.cpp:938-944)
+    SetTitle(title.String());
+    set_location_text(state.url);
+    m_back_button->SetEnabled(state.can_go_back);
+    m_forward_button->SetEnabled(state.can_go_forward);
+    m_reload_button->SetLabel(state.loading ? "Stop" : "Reload");
+}
+
+void BrowserWindow::MessageReceived(BMessage* message)
+{
+    uint64 tab_id = 0;
+    message->FindUInt64("tab", &tab_id);
+    auto is_current = m_current_tab_id == tab_id;
+
+    switch (message->what) {
+    // ---- From the WindowModel (Core thread) ----
+    case kMsgTabAdded:
+        add_tab(*message);
+        return;
+    case kMsgTabRemoved:
+        remove_tab(tab_id);
+        return;
+    case kMsgTabActivated:
+        activate_tab(tab_id, message->GetBool("activate_window", false));
+        return;
+    case kMsgTabTitle:
+        if (auto it = m_tabs.find(tab_id); it != m_tabs.end()) {
+            it->value.title = message->GetString("title", "");
+            m_tab_strip->set_label(tab_id, it->value.title);
+            if (is_current)
+                apply_current_tab_state();
+        }
+        return;
+    case kMsgTabUrl:
+        if (auto it = m_tabs.find(tab_id); it != m_tabs.end()) {
+            it->value.url = message->GetString("url", "");
+            if (is_current)
+                set_location_text(it->value.url);
+        }
+        return;
+    case kMsgTabNavState:
+        if (auto it = m_tabs.find(tab_id); it != m_tabs.end()) {
+            it->value.can_go_back = message->GetBool("back", false);
+            it->value.can_go_forward = message->GetBool("forward", false);
+            if (is_current)
+                apply_current_tab_state();
+        }
+        return;
+    case kMsgTabLoading:
+        if (auto it = m_tabs.find(tab_id); it != m_tabs.end()) {
+            it->value.loading = message->GetBool("loading", false);
+            if (is_current)
+                apply_current_tab_state();
+        }
+        return;
+    case kMsgCloseWindowNow:
+        m_may_quit = true;
+        PostMessage(B_QUIT_REQUESTED);
+        return;
+    case kMsgShowAlert:
+    case kMsgShowConfirm:
+    case kMsgShowPrompt: {
+        auto dialog_id = message->GetUInt64("dialog", 0);
+        auto const* origin = message->GetString("origin", "");
+        auto const* text = message->GetString("message", "");
+        BMessenger panel;
+        if (message->what == kMsgShowAlert)
+            panel = show_alert(BMessenger(this), tab_id, dialog_id, origin, text);
+        else if (message->what == kMsgShowConfirm)
+            panel = show_confirm(BMessenger(this), tab_id, dialog_id, origin, text);
+        else
+            panel = show_prompt(BMessenger(this), tab_id, dialog_id, origin, text, message->GetString("default", ""));
+        m_open_dialogs.set(dialog_id, panel);
+        return;
+    }
+    case kMsgDismissDialogs:
+        // Already resolved on the Core side (tab closing, WebDriver); take the panel down.
+        if (auto panel = m_open_dialogs.take(message->GetUInt64("dialog", 0)); panel.has_value() && panel->IsValid())
+            panel->SendMessage(B_QUIT_REQUESTED);
+        return;
+    case kMsgConfirmQuit:
+        show_quit_confirmation(BMessenger(this), message->GetString("reason", ""));
+        return;
+
+    // ---- Dialog replies ----
+    case kMsgAlertClosed: {
+        auto dialog_id = message->GetUInt64("dialog", 0);
+        m_open_dialogs.remove(dialog_id);
+        post_to_tab(tab_id, [dialog_id](Tab& tab) { tab.alert_closed(dialog_id); });
+        return;
+    }
+    case kMsgConfirmClosed: {
+        auto dialog_id = message->GetUInt64("dialog", 0);
+        auto accepted = message->GetInt32("which", 0) == 1;
+        m_open_dialogs.remove(dialog_id);
+        post_to_tab(tab_id, [dialog_id, accepted](Tab& tab) { tab.confirm_closed(dialog_id, accepted); });
+        return;
+    }
+    case kMsgPromptClosed: {
+        auto dialog_id = message->GetUInt64("dialog", 0);
+        Optional<String> text;
+        if (message->GetBool("accepted", false)) {
+            if (auto utf8 = String::from_utf8(StringView { message->GetString("text", ""), strlen(message->GetString("text", "")) }); !utf8.is_error())
+                text = utf8.release_value();
+        }
+        m_open_dialogs.remove(dialog_id);
+        post_to_tab(tab_id, [dialog_id, text = move(text)](Tab& tab) mutable { tab.prompt_closed(dialog_id, move(text)); });
+        return;
+    }
+    case kMsgQuitConfirmed:
+        if (message->GetInt32("which", 0) == 1)
+            Application::post_to_core([] { Application::the().quit_confirmed(); });
+        return;
+
+    // ---- Controls and shortcuts ----
+    case kMsgBack:
+        post_to_current_tab([](Tab& tab) { tab.go_back(); });
+        return;
+    case kMsgForward:
+        post_to_current_tab([](Tab& tab) { tab.go_forward(); });
+        return;
+    case kMsgReloadOrStop:
+        post_to_current_tab([](Tab& tab) { tab.reload_or_stop(); });
+        return;
+    case kMsgNewTab:
+        post_to_model([](WindowModel& model) {
+            model.new_tab_from_url(WebView::Application::settings().new_tab_page_url(), Web::HTML::ActivateTab::Yes);
+        });
+        m_location->MakeFocus(true);
+        return;
+    case kMsgCloseCurrentTab:
+        post_to_model([](WindowModel& model) { model.request_close_current_tab(); });
+        return;
+    case kMsgCloseTab:
+        post_to_model([tab_id](WindowModel& model) { model.request_close_tab(tab_id); });
+        return;
+    case kMsgSelectTab:
+        post_to_model([tab_id](WindowModel& model) { model.activate_tab(tab_id); });
+        return;
+    case kMsgFocusLocation:
+        if (m_current_tab_id.has_value()) {
+            if (auto it = m_tabs.find(*m_current_tab_id); it != m_tabs.end()) {
+                m_location->SetText(it->value.url.characters());
+                m_last_location_text = m_location->Text();
+            }
+        }
+        m_location->MakeFocus(true);
+        m_location->TextView()->SelectAll();
+        return;
+    case kMsgNavigate: {
+        auto const* text = message->GetString("text", "");
+        auto input = String::from_utf8(StringView { text, strlen(text) });
+        if (input.is_error() || input.value().is_empty())
+            return;
+        // Hand focus to the page first, so the URL the navigation reports can replace the typed text.
+        if (m_current_tab_id.has_value()) {
+            if (auto it = m_tabs.find(*m_current_tab_id); it != m_tabs.end())
+                it->value.page_view->MakeFocus(true);
+        }
+        post_to_current_tab([input = input.release_value()](Tab& tab) { tab.navigate_from_user_input(input); });
+        return;
+    }
+    default:
+        BWindow::MessageReceived(message);
+    }
+}
+
+bool BrowserWindow::QuitRequested()
+{
+    if (m_may_quit)
+        return true;
+    // Whether a tab may close (beforeunload) is a LibWebView question, so the Core thread decides. It runs Qt's
+    // request_close() per tab and, once the model has no tabs, sends kMsgCloseWindowNow.
+    post_to_model([](WindowModel& model) { model.request_close_window(); });
+    return false;
+}
+
+void BrowserWindow::WindowActivated(bool active)
+{
+    BWindow::WindowActivated(active);
+    if (!active)
+        return;
+    Application::post_to_core([model_id = m_model_id] { Application::the().set_active_window(model_id); });
+}
+
+}
diff --git a/UI/Haiku/BrowserWindow.h b/UI/Haiku/BrowserWindow.h
