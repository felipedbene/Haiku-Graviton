+/*
+ * Copyright (c) 2026, Felipe De Bene <felipe@debene.dev>
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include "PlaybackStream.h"
+#include <AK/Error.h>
+#include <AK/NonnullRefPtr.h>
+
+namespace Audio {
+
+class HaikuAudioState;
+
+class PlaybackStreamHaiku final : public PlaybackStream {
+public:
+    static NonnullRefPtr<CreatePromise> create(OutputState initial_output_state, u32 target_latency_ms, AudioDataRequestCallback&&);
+
+    virtual SampleSpecification sample_specification() const override;
+
+    virtual NonnullRefPtr<Core::ThreadedPromise<AK::Duration>> resume() override;
+    virtual NonnullRefPtr<Core::ThreadedPromise<void>> drain_buffer_and_suspend() override;
+    virtual NonnullRefPtr<Core::ThreadedPromise<void>> discard_buffer_and_suspend() override;
+
+    virtual void notify_data_available() override;
+
+    virtual AK::Duration total_time_played() const override;
+
+    virtual NonnullRefPtr<Core::ThreadedPromise<void>> set_volume(double) override;
+
+private:
+    explicit PlaybackStreamHaiku(NonnullRefPtr<HaikuAudioState>);
+    ~PlaybackStreamHaiku();
+
+    NonnullRefPtr<HaikuAudioState> m_state;
+};
+
+}
diff --git a/Libraries/LibMedia/CMakeLists.txt b/Libraries/LibMedia/CMakeLists.txt
index 315fe0b1..22630173 100644
--- a/Libraries/LibMedia/CMakeLists.txt
+++ b/Libraries/LibMedia/CMakeLists.txt
@@ -160,6 +160,16 @@ elseif(LADYBIRD_AUDIO_BACKEND STREQUAL "WASAPI")
     target_sources(LibMedia PRIVATE Audio/PlaybackStreamWasapi.cpp)
     target_compile_definitions(LibMedia PRIVATE LIBMEDIA_AUDIO_BACKEND=1)
     target_link_libraries(LibMedia PRIVATE ole32 avrt winmm)
+elseif(LADYBIRD_AUDIO_BACKEND STREQUAL "HAIKU")
+    target_sources(LibMedia PRIVATE Audio/PlaybackStreamHaiku.cpp)
+    target_compile_definitions(LibMedia PRIVATE LIBMEDIA_AUDIO_BACKEND=1)
+    target_link_libraries(LibMedia PRIVATE media)
 elseif (DEFINED LADYBIRD_AUDIO_BACKEND)
     message(FATAL_ERROR "Please update ${CMAKE_CURRENT_LIST_FILE} for audio backend ${LADYBIRD_AUDIO_BACKEND}")
+else()
+    # Not a warning: with no backend every stream becomes a NullPlaybackStream
+    # and the browser plays nothing, which is indistinguishable from broken
+    # audio at runtime. Fail the configure so a new platform has to say what
+    # it wants.
+    message(FATAL_ERROR "No audio backend was selected for this platform. Add one in Meta/CMake/audio.cmake and a branch here.")
 endif()
