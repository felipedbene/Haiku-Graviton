+
+#pragma once
+
+// Shrinks the damage Ladybird reports to what actually changed on screen, and finds vertical scrolls that the
+// window can replay as a blit. Pure functions over 32-bit pixel buffers: no Haiku, AK or LibGfx dependency, so the
+// logic is unit-testable on any host.
+//
+// Why this exists (Haiku-Graviton #622): Compositor's damage_since_last_raster() reports the whole viewport on every
+// scroll (by design) and on text edits whose display-list diff is unbounded. On a local display that costs a memcpy;
+// over the remote desktop every DrawBitmap goes on the wire, so one keystroke cost 2.7 MB and one scroll notch 2.7-5.4 MB.
+//
+// Correctness never depends on Ladybird's damage, on a hash, or on the guessed scroll distance: a row or span is left
+// out of the damage only after memcmp() has proven it byte-identical to what the window will show.
+
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+namespace Ladybird::DamageRefinement {
+
+static constexpr size_t bytes_per_pixel = 4;
+
+struct Rect {
+    int x { 0 };
+    int y { 0 };
+    int width { 0 };
+    int height { 0 };
+
+    bool is_empty() const { return width <= 0 || height <= 0; }
+};
+
+// Destination rows [top, bottom) of the new frame are byte-identical to rows [top + dy, bottom + dy) of the old one.
+struct VerticalShift {
+    int dy { 0 };
+    int top { 0 };
+    int bottom { 0 };
+
+    bool is_valid() const { return dy != 0 && bottom > top; }
+};
+
+// Copies every pixel of `rect` that differs between `source` and `destination` into `destination`, and returns the
+// bounding box of the pixels that differed: exactly the pixels whose on-screen value changes. Pixels outside the box
+// were byte-identical before the copy, so the window already shows them.
+//
+// Rows in [skip_top, skip_bottom) are still copied but not reported: the caller replays them with a blit. Pass an
+// empty range (skip_top >= skip_bottom) to report every row.
+//
+// The alpha byte is compared too. Display ignores it, so a difference only in alpha reports a pixel that did not
+// visibly change: the error is in the conservative direction.
+inline Rect copy_changed(uint8_t* destination, size_t destination_pitch, uint8_t const* source, size_t source_pitch,
+    Rect rect, int skip_top = 0, int skip_bottom = 0)
+{
+    int top = -1;
+    int bottom = -1;
+    int left = rect.x + rect.width;
+    int right = rect.x;
+    if (rect.is_empty())
+        return {};
+    size_t const row_bytes = static_cast<size_t>(rect.width) * bytes_per_pixel;
+    for (int y = rect.y; y < rect.y + rect.height; ++y) {
+        auto* destination_row = destination + static_cast<size_t>(y) * destination_pitch + static_cast<size_t>(rect.x) * bytes_per_pixel;
+        auto const* source_row = source + static_cast<size_t>(y) * source_pitch + static_cast<size_t>(rect.x) * bytes_per_pixel;
+        if (memcmp(destination_row, source_row, row_bytes) == 0)
+            continue;
+        bool const reported = y < skip_top || y >= skip_bottom;
+        if (reported) {
+            // First and last differing pixel of this row; the memcmp above guarantees both exist.
+            int first = 0;
+            while (memcmp(destination_row + static_cast<size_t>(first) * bytes_per_pixel, source_row + static_cast<size_t>(first) * bytes_per_pixel, bytes_per_pixel) == 0)
+                ++first;
+            int last = rect.width - 1;
+            while (memcmp(destination_row + static_cast<size_t>(last) * bytes_per_pixel, source_row + static_cast<size_t>(last) * bytes_per_pixel, bytes_per_pixel) == 0)
+                --last;
+            if (top < 0)
+                top = y;
+            bottom = y + 1;
+            if (rect.x + first < left)
+                left = rect.x + first;
+            if (rect.x + last + 1 > right)
+                right = rect.x + last + 1;
+        }
+        memcpy(destination_row, source_row, row_bytes);
+    }
+    if (top < 0)
+        return {};
+    return { left, top, right - left, bottom - top };
+}
+
+// A deterministic row hash. Equal rows always hash equal, so a hash mismatch proves the rows differ; a hash match is
+// only a candidate and is confirmed with memcmp().
+inline uint64_t hash_row(uint8_t const* row, size_t bytes)
+{
+    uint64_t hash = 0xcbf29ce484222325ull ^ bytes;
+    size_t i = 0;
+    for (; i + 8 <= bytes; i += 8) {
+        uint64_t word;
+        memcpy(&word, row + i, 8);
+        hash = (hash ^ word) * 0x9e3779b97f4a7c15ull;
+        hash ^= hash >> 29;
+    }
+    for (; i < bytes; ++i)
+        hash = (hash ^ row[i]) * 0x100000001b3ull;
+    return hash ^ (hash >> 32);
+}
+
+// Looks for a vertical shift of the whole frame (a scroll) between `old_frame` (what the window shows) and
+// `new_frame`. Both are `width` x `height`, full rows. `scratch` must hold 2 * height values.
+//
+// Candidate shifts are voted for by rows whose hash matches the old frame at that offset; rows identical to the row
+// above (blank bands) carry no information about the offset and do not vote. The winner is then verified row by row
+// with memcmp, and the longest run of exactly matching rows is returned, if it is at least `minimum_rows` tall.
+// A wrong vote can therefore only cost a missed blit, never a wrong pixel.
+inline VerticalShift find_vertical_shift(uint8_t const* old_frame, size_t old_pitch, uint8_t const* new_frame, size_t new_pitch,
+    int width, int height, uint64_t* scratch, int minimum_rows)
+{
+    if (width <= 0 || height <= 0 || minimum_rows <= 0 || height <= minimum_rows)
+        return {};
+    size_t const row_bytes = static_cast<size_t>(width) * bytes_per_pixel;
+    uint64_t* old_hashes = scratch;
+    uint64_t* new_hashes = scratch + height;
+    for (int y = 0; y < height; ++y) {
+        old_hashes[y] = hash_row(old_frame + static_cast<size_t>(y) * old_pitch, row_bytes);
+        new_hashes[y] = hash_row(new_frame + static_cast<size_t>(y) * new_pitch, row_bytes);
+    }
+    // A blit can only save rows that changed in place; with fewer than that, there is nothing to win.
+    int changed_rows = 0;
+    for (int y = 0; y < height; ++y)
+        changed_rows += new_hashes[y] != old_hashes[y];
+    if (changed_rows < minimum_rows)
+        return {};
+
+    int best_dy = 0;
+    int best_votes = 0;
+    int const reach = height - minimum_rows;
+    for (int dy = -reach; dy <= reach; ++dy) {
+        if (dy == 0)
+            continue; // an unshifted match is copy_changed()'s business
+        int const first = dy < 0 ? -dy : 0;
+        int const end = dy > 0 ? height - dy : height;
+        int votes = 0;
+        for (int y = first; y < end; ++y) {
+            if (new_hashes[y] != old_hashes[y + dy])
+                continue;
+            if (y > 0 && new_hashes[y] == new_hashes[y - 1])
+                continue;
+            ++votes;
+        }
+        // Ties go to the smaller distance.
+        if (votes > best_votes || (votes == best_votes && votes > 0 && (dy < 0 ? -dy : dy) < (best_dy < 0 ? -best_dy : best_dy))) {
+            best_votes = votes;
+            best_dy = dy;
+        }
+    }
+    if (best_votes == 0)
+        return {};
+
+    int const first = best_dy < 0 ? -best_dy : 0;
+    int const end = best_dy > 0 ? height - best_dy : height;
+    VerticalShift best {};
+    int run_top = -1;
+    for (int y = first; y <= end; ++y) {
+        bool matches = y < end
+            && new_hashes[y] == old_hashes[y + best_dy]
+            && memcmp(new_frame + static_cast<size_t>(y) * new_pitch, old_frame + static_cast<size_t>(y + best_dy) * old_pitch, row_bytes) == 0;
+        if (matches) {
+            if (run_top < 0)
+                run_top = y;
+            continue;
+        }
+        if (run_top >= 0 && y - run_top > best.bottom - best.top)
+            best = { best_dy, run_top, y };
+        run_top = -1;
+    }
+    if (best.bottom - best.top < minimum_rows)
+        return {};
+    return best;
+}
+
+}
