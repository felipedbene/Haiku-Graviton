         auto* destination = static_cast<u8*>(m_surface->bitmap->Bits());
         auto destination_pitch = static_cast<size_t>(m_surface->bitmap->BytesPerRow());
-        auto row_bytes = static_cast<size_t>(copy_rect.width()) * 4;
-        for (int y = copy_rect.top(); y < copy_rect.bottom(); ++y)
-            __builtin_memcpy(destination + y * destination_pitch + copy_rect.left() * 4, bitmap->scanline_u8(y) + copy_rect.left() * 4, row_bytes);
-        m_surface->damage = m_surface->damage.is_empty() ? copy_rect : m_surface->damage.united(copy_rect);
+        Gfx::IntRect changed;
+        if (m_present_needs_full_copy) {
+            // A new BBitmap holds no frame the window has shown, so nothing in it can be compared against.
+            auto row_bytes = static_cast<size_t>(copy_rect.width()) * 4;
+            for (int y = copy_rect.top(); y < copy_rect.bottom(); ++y)
+                __builtin_memcpy(destination + y * destination_pitch + copy_rect.left() * 4, bitmap->scanline_u8(y) + copy_rect.left() * 4, row_bytes);
+            changed = copy_rect;
+            m_surface->scroll_pending = false; // the full repaint below supersedes a blit [W] has not run yet
+        } else {
+            // #622. Invariant: once [W] has run any pending blit and invalidated `damage`, the window shows exactly
+            // this BBitmap. So a pixel that is byte-identical in the new frame needs no repaint, whatever Ladybird
+            // reported, and only the pixels memcmp() proves different become damage.
+            DamageRefinement::VerticalShift shift;
