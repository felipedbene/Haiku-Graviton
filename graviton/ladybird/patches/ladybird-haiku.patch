diff --git a/Meta/CMake/compile_options.cmake b/Meta/CMake/compile_options.cmake
index ec92bb9543..889085e6cc 100644
--- a/Meta/CMake/compile_options.cmake
+++ b/Meta/CMake/compile_options.cmake
@@ -219,6 +219,44 @@
     add_compile_definitions(_DEFAULT_SOURCE)
     add_compile_definitions(_GNU_SOURCE)
     add_compile_definitions(__USE_GNU)
+    # DeBeOS/Haiku: libc is split across libroot/libnetwork/libbsd/libgnu. BSD
+    # compat (getprogname, arc4random_buf, ...) lives in libbsd and sockets/
+    # getaddrinfo in libnetwork; without these every Lagom .so trips the
+    # --no-undefined/-z,defs link below. Link them globally.
+    link_libraries(bsd network)
+    # clang emits unsupported R_AARCH64_TLSDESC relocs for thread_local;
+    # emulated TLS (__emutls_get_address, from libgcc) uses only relocs
+    # Haiku's arm64 runtime_loader supports.
+    add_compile_options(-femulated-tls)
+    include_directories(SYSTEM /boot/home/lbdeps/include)
+    # Haiku has no separate PIE link mode: clang's Haiku driver links *every*
+    # executable with `ld.lld -shared` (Haiku executables are ET_DYN, entered
+    # through start_dyn.o), and lld then treats every default-visibility
+    # definition in the output as preemptible. CMake's PIE flag (-fPIE) tells
+    # clang the opposite -- that nothing in the link can be interposed -- so it
+    # emits direct ADRP/ADD for COMDAT vtables and template instantiations that
+    # a linked .so also exports, and lld rejects them:
+    #   ld.lld: error: relocation R_AARCH64_ADR_PREL_PG_HI21 cannot be used
+    #   against symbol 'vtable for Core::Socket'; recompile with -fPIC
+    # It cannot fall back to a copy relocation or canonical PLT either, because
+    # under -shared lld is in PIC mode. Haiku's clang already defaults to full
+    # PIC (-mrelocation-model pic -pic-level 2, no -pic-is-pie), so -fPIE is a
+    # downgrade from the correct default; override the flag CMake substitutes
+    # for POSITION_INDEPENDENT_CODE rather than appending and relying on the
+    # order the two end up in on the command line.
+    set(CMAKE_C_COMPILE_OPTIONS_PIE -fPIC)
+    set(CMAKE_CXX_COMPILE_OPTIONS_PIE -fPIC)
+    # lld lays arm64 PT_LOADs out at its default 64 KB max-page-size and emits
+    # four of them (.rodata, text, RELRO, post-RELRO .data), so every linked
+    # image carries three ~60 KB inter-segment holes. DeBeOS arm64 pages are
+    # 4 KB, and the runtime_loader refuses an image whose reserved span exceeds
+    # the sum of its mapped segments by more than two 64 KB pages
+    # (src/system/runtime_loader/images.cpp:341) -- a budget that fits GNU ld's
+    # two-segment output and nothing wider:
+    #   runtime_loader: .../bin/WebDriver: Could not map image: Bad data
+    # Lay the segments out at the page size the system actually uses, which
+    # shrinks each hole below a page and keeps the image loadable.
+    add_link_options(LINKER:-z,max-page-size=4096)
 endif()
 
