 ladybird_lib(LibCompositing compositing EXPLICIT_SYMBOL_EXPORT)
+
+# WebGL/WebGLCommandList.cpp includes the generated WebGLCommands.h, which in turn includes
+# the generated <LibCompositing/WebGL/GLFunctions.h> (emitted by
+# Meta/Generators/generate_libweb_webgl_commands.py). That second header is NOT in this
+# library's GENERATED_SOURCES: GLFunctions.cpp is deliberately compiled into the Compositor
+# instead (Services/Compositor/CMakeLists.txt), so ladybird_generated_sources() never emits
+# an edge to the generate_GLFunctions.cpp target, and nothing else in the tree asks for it.
+# A build that does not also link compositorservice therefore never runs the generator at
+# all and fails with "LibCompositing/WebGL/GLFunctions.h: No such file or directory" --
+# `ninja WebContent WebDriver`, the headless render path, is exactly such a build. Depend on
+# the generator target directly; this has to come after ladybird_lib(), which is what
+# creates the LibCompositing target.
+add_dependencies(LibCompositing generate_GLFunctions.cpp)
+
 target_link_libraries(LibCompositing PUBLIC LibWebCommon)
 target_link_libraries(LibCompositing PRIVATE LibCore LibGfx LibIPC LibMedia LibThreading skia libcompositing_rust)

