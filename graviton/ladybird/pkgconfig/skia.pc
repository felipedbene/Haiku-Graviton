prefix=/boot/home/skia
libdir=/boot/home/skia/out/haiku-arm64
includedir=/boot/home/skia

Name: skia
Description: Skia (DeBeOS arm64-Haiku CPU raster build, chrome/m148, ganesh no-GPU)
Version: 148
Libs: -L${libdir} -lskia -lz -lpng
Cflags: -I${includedir} -I${includedir}/include -DSK_GANESH -DSK_GAMMA_APPLY_TO_A8 -DSK_R32_SHIFT=16 -DSK_TYPEFACE_FACTORY_FREETYPE -DSK_FONTMGR_FREETYPE_DIRECTORY_AVAILABLE -DSK_FONTMGR_FREETYPE_EMBEDDED_AVAILABLE -DSK_FONTMGR_FREETYPE_EMPTY_AVAILABLE -DSK_HAS_WUFFS_LIBRARY -DSK_CODEC_DECODES_BMP -DSK_CODEC_DECODES_WBMP -DSK_CODEC_DECODES_GIF -DSK_DISABLE_TRACING
