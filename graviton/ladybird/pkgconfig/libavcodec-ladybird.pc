prefix=/boot/home/lbdeps
exec_prefix=${prefix}
libdir=/boot/home/lbdeps/lib
includedir=/boot/home/lbdeps/include

Name: libavcodec
Description: FFmpeg codec library
Version: 61.19.100
Requires: 
Requires.private: libswresample >= 5.3.100, libavutil >= 59.39.100
Conflicts:
Libs: -L${libdir}  -lavcodec 
Libs.private: -pthread -liconv -lm -latomic -L/packages/zlib-1.3.2-1/.self/develop/lib -L/packages/zlib-1.3.2-1/.self/lib -lz
Cflags: -I${includedir}
