is_official_build = true
target_os = "linux"
target_cpu = "arm64"
cc = "clang"
cxx = "clang++"
ar = "/boot/system/bin/ar"
skia_use_gl = false
skia_use_vulkan = false
skia_use_metal = false
skia_use_direct3d = false
skia_enable_ganesh = true
skia_enable_graphite = false
# LibGfx's skia_font_manager() calls SkFontMgr_New_FontConfig() on every
# platform that is not Android, Windows or macOS -- Haiku included
# (Libraries/LibGfx/Font/TypefaceSkia.cpp:115) -- and that entry point only
# exists when Skia compiles src/ports/SkFontMgr_fontconfig.cpp, which is gated
# here (gn/skia.gni:168, skia_enable_fontmgr_fontconfig). With it off,
# liblagom-gfx links (the Haiku build needs -z undefs) and then cannot be
# loaded at all:
#   runtime_loader: .../liblagom-gfx.so.0.1.0: Troubles relocating:
#       Symbol not found
#       SkFontMgr_New_FontConfig(_FcConfig*, std::unique_ptr<SkFontScanner, ...>)
# DeBeOS has fontconfig 2.18 and Ladybird already links it directly
# (LibGfx/Font/GlobalFontConfig.cpp), so this adds no new dependency.
skia_use_fontconfig = true
skia_use_freetype = true
skia_use_harfbuzz = true
skia_use_icu = true
skia_use_expat = false
skia_enable_svg = false
skia_enable_skottie = false
skia_enable_pdf = false
skia_enable_tools = false
skia_use_system_freetype2 = false
skia_use_system_harfbuzz = false
skia_use_system_icu = false
skia_use_system_zlib = true
skia_use_libpng_decode = false
skia_use_libpng_encode = false
skia_use_libjpeg_turbo_decode = false
skia_use_libjpeg_turbo_encode = false
skia_use_libwebp_decode = false
skia_use_libwebp_encode = false
skia_use_dng_sdk = false
