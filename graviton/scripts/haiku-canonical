#!/usr/bin/env bash
#
# Enforce the invariant: exactly ONE self-owned AMI tagged canonical=true.
#
# Wire `promote` into your AMI bake step so the new image atomically becomes the
# sole canonical (the tag is removed from every prior holder, then set on the new
# one). `check` verifies the invariant and exits non-zero if it is broken.
#
# Usage:
#   haiku-canonical check                # report + exit 0 iff exactly one canonical
#   haiku-canonical promote <ami-id>     # make <ami-id> the one and only canonical
#   haiku-canonical prune [--apply]      # keep newest N candidate AMIs, retire rest
#                        [--keep N]      #   (default N=3; dry-run unless --apply)
#                        [--tag K=V]     #   select on K=V instead of candidate=true
#
# `promote` accepts ANY self-owned AMI id, deliberately. Images from the test-only
# "oven" pipeline (tagged oven=true, and candidate=true like every other bake) are
# first-class promotion targets: the oven bakes and hardware-tests candidates
# continuously but cannot promote, so moving canonical means picking the best
# already-tested image and naming it here, instead of starting a fresh bake and
# waiting an hour for it to reach an approval gate. `--tag oven=true` is how those
# throwaway images get reaped without touching trunk candidates.
#
# Region defaults to us-west-2; override with AWS_REGION.
set -euo pipefail

REGION="${AWS_REGION:-us-west-2}"
TAG_KEY="canonical"
TAG_VAL="true"
# Candidate AMIs (freshly baked, tagged candidate=true) accumulate every bake.
# Retention policy: keep the newest CANDIDATE_KEEP by CreationDate, deregister
# the rest and delete their backing snapshots. The canonical AMI is ALWAYS
# protected even though it also carries candidate=true.
CAND_KEY="candidate"
CAND_VAL="true"
CANDIDATE_KEEP="${HG_CANDIDATE_KEEP:-3}"
# SSM Parameter Store mirror of the canonical AMI id, so tooling can resolve it
# without an ec2 describe-images tag query. Kept in sync by promote (below).
SSM_PARAM="${HAIKU_CANONICAL_SSM_PARAM:-/haiku-graviton/canonical-ami-id}"

list_canonical() {
	aws ec2 describe-images --region "$REGION" --owners self \
		--filters "Name=tag:${TAG_KEY},Values=${TAG_VAL}" \
		--query 'Images[].ImageId' --output text
}

cmd_check() {
	local ids count rc=0 ssm_val
	ids="$(list_canonical)"
	count="$(printf '%s\n' $ids | grep -c . || true)"
	echo "canonical AMIs in ${REGION} (${count}): ${ids:-<none>}"
	if [ "$count" -ne 1 ]; then
		echo "INVARIANT VIOLATED: expected exactly 1 canonical, found ${count}" >&2
		rc=1
	fi
	# Cross-check the SSM mirror -- if promote succeeded the two must agree.
	# A silent drift here previously misdirected consumers to the wrong AMI
	# (issue #59). Read is best-effort: a missing parameter is a warning, not
	# a hard fail, but a present-and-disagreeing parameter is a violation.
	ssm_val="$(aws ssm get-parameter --region "$REGION" --name "$SSM_PARAM" \
		--query 'Parameter.Value' --output text 2>/dev/null || true)"
	if [ -z "$ssm_val" ] || [ "$ssm_val" = "None" ]; then
		echo "ssm: ${SSM_PARAM} not set (warning: consumers resolving via SSM will fail)" >&2
	elif [ "$count" -eq 1 ] && [ "$ssm_val" != "$ids" ]; then
		echo "INVARIANT VIOLATED: tag canonical=${ids} but ssm ${SSM_PARAM}=${ssm_val}" >&2
		rc=1
	else
		echo "ssm: ${SSM_PARAM} = ${ssm_val} (agrees)"
	fi
	return $rc
}

# prune: enforce the candidate retention policy. Lists candidate=true images
# newest-first, keeps CANDIDATE_KEEP, and retires the rest (deregister image +
# delete its snapshots). Dry-run by default; pass apply=1 to actually delete.
# The current canonical is never a deletion target.
cmd_prune() {
	local apply="$1" keep="$2"
	# Selection tag. Defaults to candidate=true (the historical behaviour); pass
	# `--tag oven=true` to reap only the test-only pipeline's throwaway images and
	# leave trunk candidates alone. The canonical protection below is unconditional
	# and applies whatever the selector is.
	local sel_key="${3:-$CAND_KEY}" sel_val="${4:-$CAND_VAL}"
	local canonical rows candidates=() protect_note

	canonical="$(list_canonical)"

	# newest-first list of candidate images with their creation date and snaps.
	# One row per image: <CreationDate> <ImageId> <snap,snap,...>
	rows="$(aws ec2 describe-images --region "$REGION" --owners self \
		--filters "Name=tag:${sel_key},Values=${sel_val}" \
		--query 'reverse(sort_by(Images,&CreationDate))[].[CreationDate,ImageId,join(`,`,BlockDeviceMappings[?Ebs].Ebs.SnapshotId)]' \
		--output text)"

	if [ -z "$rows" ]; then
		echo "prune: no images tagged ${sel_key}=${sel_val}; nothing to do"
		return 0
	fi

	local total kept=0 retired=0
	total="$(printf '%s\n' "$rows" | grep -c . || true)"
	echo "prune: ${total} ${sel_key}=${sel_val} AMI(s); keeping newest ${keep}; canonical=${canonical:-<none>} (protected)"

	# Iterate rows in order (newest first). Keep the first `keep` non-canonical
	# images; retire the remainder. The canonical is always kept and does not
	# consume a keep slot.
	local line date ami snaps
	while IFS=$'\t' read -r date ami snaps; do
		[ -n "$ami" ] || continue
		if [ "$ami" = "$canonical" ]; then
			echo "  KEEP  ${ami}  ${date}  (canonical)"
			continue
		fi
		if [ "$kept" -lt "$keep" ]; then
			kept=$((kept + 1))
			echo "  KEEP  ${ami}  ${date}"
			continue
		fi
		retired=$((retired + 1))
		if [ "$apply" = "1" ]; then
			echo "  RETIRE ${ami}  ${date}  -> deregister + delete snaps [${snaps}]"
			aws ec2 deregister-image --region "$REGION" --image-id "$ami" \
				|| echo "    warning: deregister ${ami} failed" >&2
			# snapshots can only be deleted after the image is deregistered.
			local snap
			for snap in ${snaps//,/ }; do
				[ -n "$snap" ] || continue
				aws ec2 delete-snapshot --region "$REGION" --snapshot-id "$snap" \
					|| echo "    warning: delete-snapshot ${snap} failed (may be in use)" >&2
			done
		else
			echo "  RETIRE ${ami}  ${date}  -> would deregister + delete snaps [${snaps}]"
		fi
	done <<< "$rows"

	echo "prune: kept ${kept} ${sel_key}=${sel_val} AMI(s) + canonical; retired ${retired}$([ "$apply" = 1 ] || echo ' (dry-run; pass --apply to delete)')"
}

cmd_promote() {
	local target="$1"
	if ! aws ec2 describe-images --region "$REGION" --owners self \
			--image-ids "$target" --query 'Images[0].ImageId' \
			--output text >/dev/null 2>&1; then
		echo "error: ${target} is not a self-owned image in ${REGION}" >&2
		return 1
	fi
	# Strip canonical from any prior holder(s) that are not the target.
	local id
	for id in $(list_canonical); do
		if [ "$id" != "$target" ]; then
			echo "un-canonical: ${id}"
			aws ec2 delete-tags --region "$REGION" --resources "$id" \
				--tags "Key=${TAG_KEY},Value=${TAG_VAL}"
		fi
	done
	# Set canonical on the target (idempotent).
	echo "canonical: ${target}"
	aws ec2 create-tags --region "$REGION" --resources "$target" \
		--tags "Key=${TAG_KEY},Value=${TAG_VAL}"
	# Protect the new canonical from SpringClean, which reaps AMIs/snapshots in
	# this account and reads the retain tag "auto-delete=no" (NOT "off"). Without
	# this, every promotion births an unprotected canonical that SpringClean
	# eventually deletes -- exactly how ami-05cf86c1c19e3ca58 ended up untagged.
	# Tag the AMI AND its backing snapshot(s): SpringClean deletes a snapshot
	# separately, and losing it corrupts the AMI even if the image record lives.
	local protect_snaps
	protect_snaps="$(aws ec2 describe-images --region "$REGION" \
		--image-ids "$target" \
		--query 'Images[0].BlockDeviceMappings[?Ebs].Ebs.SnapshotId' \
		--output text 2>/dev/null)"
	if aws ec2 create-tags --region "$REGION" \
			--resources "$target" ${protect_snaps} \
			--tags Key=auto-delete,Value=no >/dev/null 2>&1; then
		echo "protected (auto-delete=no): ${target} ${protect_snaps}"
	else
		echo "warning: failed to tag ${target} auto-delete=no; protect it by hand" \
			"or SpringClean may reap the canonical" >&2
	fi
	# Mirror the id into SSM so consumers can resolve the canonical AMI without a
	# tag query. Non-fatal: the ec2 tag remains the source of truth.
	if aws ssm put-parameter --region "$REGION" --name "$SSM_PARAM" \
			--type String --overwrite --value "$target" >/dev/null 2>&1; then
		echo "ssm: ${SSM_PARAM} = ${target}"
	else
		echo "warning: failed to update SSM parameter ${SSM_PARAM}" >&2
	fi
	# Keep the DeBeOS repo's version-locked `haiku_devel` matched to the new
	# canonical's base `haiku` hrev, so native dev (cargo/cc) on the lean image
	# resolves a compatible develop package instead of being forced to change the
	# base (the brick vector). Idempotent + cheap: haiku-devel-publish is a no-op
	# (one S3 ls, no metal spin-up) when the repo already serves this hrev, and it
	# only does the heavy publish when the base hrev actually moved.
	#
	# Gated on HG_REPO_S3 so it runs ONLY where the repo env is configured (the
	# maintainer workstation). The in-pipeline Promote stage leaves it unset, so
	# that CodeBuild role needs no repo/SSM/CloudFront permissions -- promotion
	# there stays a pure tag operation. Best-effort by contract: a failure here
	# must never undo the canonical tag we just set, so it cannot abort promote.
	if [ -n "${HG_REPO_S3:-}" ] && [ -x "$(dirname "$0")/haiku-devel-publish" ]; then
		echo "== keeping repo haiku_devel matched to ${target} =="
		AWS_REGION="$REGION" "$(dirname "$0")/haiku-devel-publish" "$target" \
			|| echo "warning: haiku_devel publish did not complete; run haiku-devel-publish ${target} by hand (canonical tag is set regardless)" >&2
	fi
	cmd_check
	# Enforce candidate retention as the last step of a promote. Best-effort:
	# a prune failure must never fail the promote (the tag move already
	# succeeded). Skipped in the in-pipeline Promote stage, which sets
	# HG_SKIP_PRUNE=1 so that CodeBuild role needs no deregister/delete rights.
	if [ "${HG_SKIP_PRUNE:-0}" != "1" ]; then
		echo "== enforcing candidate retention (keep ${CANDIDATE_KEEP}) =="
		cmd_prune 1 "$CANDIDATE_KEEP" \
			|| echo "warning: prune did not complete; run haiku-canonical prune --apply by hand" >&2
	fi
}

case "${1:-}" in
	check)
		cmd_check
		;;
	promote)
		shift
		[ $# -eq 1 ] || { echo "usage: $(basename "$0") promote <ami-id>" >&2; exit 2; }
		cmd_promote "$1"
		;;
	prune)
		shift
		apply=0
		keep="$CANDIDATE_KEEP"
		sel_key="$CAND_KEY"
		sel_val="$CAND_VAL"
		while [ $# -gt 0 ]; do
			case "$1" in
				--apply) apply=1; shift ;;
				--keep)  keep="$2"; shift 2 ;;
				--tag)
					case "${2:-}" in
						*=*) sel_key="${2%%=*}"; sel_val="${2#*=}" ;;
						*) echo "error: --tag expects KEY=VALUE" >&2; exit 2 ;;
					esac
					# Selecting on canonical=true would make every match the
					# protected image, i.e. a guaranteed no-op that reads like a
					# working command. Refuse it rather than pretend.
					[ "$sel_key" != "$TAG_KEY" ] \
						|| { echo "error: --tag must not select on the '${TAG_KEY}' tag" >&2; exit 2; }
					[ -n "$sel_key" ] && [ -n "$sel_val" ] \
						|| { echo "error: --tag expects KEY=VALUE" >&2; exit 2; }
					shift 2 ;;
				*) echo "usage: $(basename "$0") prune [--apply] [--keep N] [--tag K=V]" >&2; exit 2 ;;
			esac
		done
		case "$keep" in
			''|*[!0-9]*) echo "error: --keep must be a non-negative integer" >&2; exit 2 ;;
		esac
		cmd_prune "$apply" "$keep" "$sel_key" "$sel_val"
		;;
	*)
		echo "usage: $(basename "$0") {check | promote <ami-id> | prune [--apply] [--keep N] [--tag K=V]}" >&2
		exit 2
		;;
esac
