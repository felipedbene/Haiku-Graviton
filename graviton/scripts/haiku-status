#!/usr/bin/env bash
#
# haiku-status -- one-shot snapshot of the Graviton/arm64 work in flight.
#
# Why this exists: none of the work lives on the workstation. Package builds run
# on native Graviton Haiku EC2 instances (haiku-nativebuild over SSM), images are
# baked by the CodePipeline bakers, and the canonical AMI is the source of truth --
# so a workstation reboot (they happen for patching) costs no work but costs all
# *context*, and reconstructing it by hand from SSM history takes many round trips.
# This prints the whole picture in one shot, cheaply, and is safe to run from a
# SessionStart hook. (There is no longer a persistent shared "metal" builder; the
# optional builder probe at the end is kept only for an opt-in $BUILDER_NAME host.)
#
# Read-only by construction: describe/list calls plus one shell probe on the
# builder. It never starts, stops, or modifies anything.
#
# Exit code is always 0 -- a snapshot that cannot be taken must not break a
# session or a hook. Missing credentials degrade to a one-line hint.

set -uo pipefail

REGION="${HAIKU_GRAVITON_REGION:-us-west-2}"
# Directory holding this script, so sibling helpers (haiku-canonical) can be
# invoked no matter what cwd a hook runs us from.
HERE="$(cd -- "$(dirname -- "$0")" && pwd)"
PROJECT_TAG="${HAIKU_GRAVITON_TAG:-haiku-graviton}"
BUILDER_NAME="${HAIKU_GRAVITON_BUILDER:-haiku-builder}"
# Total wall-clock budget. A hook must not hang a session start.
BUDGET="${HAIKU_GRAVITON_TIMEOUT:-45}"

say() { printf '%s\n' "$*"; }
aws_q() { timeout 15 aws --region "$REGION" "$@" 2>/dev/null; }

# The account's creds come from a self-refreshing `credential_process` profile, not
# from ambient env vars or a `default` profile -- so a hook that calls plain `aws`
# sees nothing and misreports "expired" while working creds sit one variable away.
# Adopt the project profile unless the caller has already chosen one.
if [ -z "${AWS_PROFILE:-}" ] && [ -z "${AWS_ACCESS_KEY_ID:-}" ]; then
	export AWS_PROFILE="${HAIKU_GRAVITON_PROFILE:-haiku-graviton}"
fi

say "=== Haiku/Graviton status ($(date -u '+%Y-%m-%d %H:%M UTC')) ==="

# ---------------------------------------------------------------- credentials
ident=$(timeout 12 aws sts get-caller-identity --query Account --output text 2>/dev/null)
if [ -z "$ident" ] || [ "$ident" = "None" ]; then
	say "credentials: NONE / expired -- refresh with your org's credential tool"
	say "  (exact command is in the maintainer's local, unpublished notes)"
	exit 0
fi
say "account: $ident   region: $REGION"

# ------------------------------------------------------------------ instances
say ""
say "--- instances (Project=$PROJECT_TAG) ---"
aws_q ec2 describe-instances \
	--filters "Name=tag:Project,Values=$PROJECT_TAG" \
	          "Name=instance-state-name,Values=running,stopped,pending,stopping" \
	--query 'Reservations[].Instances[].[Tags[?Key==`Name`]|[0].Value,InstanceId,InstanceType,State.Name]' \
	--output text | sort | while read -r name id type state; do
		printf '  %-22s %-20s %-13s %s\n' "$name" "$id" "$type" "$state"
	done

# The golden image is whichever AMI carries canonical=true -- never the newest.
say ""
say "--- canonical AMI (tag canonical=true) ---"
aws_q ec2 describe-images --owners self \
	--filters "Name=tag:canonical,Values=true" \
	--query 'Images[].[ImageId,Name,CreationDate]' --output text \
	| while read -r id nm created; do printf '  %s  %s  %s\n' "$id" "$nm" "$created"; done
cand=$(aws_q ec2 describe-images --owners self \
	--filters "Name=tag:candidate,Values=true" \
	--query 'length(Images)' --output text)
[ -n "$cand" ] && say "  untested candidate AMIs: ${cand:-0}"

# Assert the invariant rather than just printing the tag. Two ways this has bitten:
# the tag existing on zero or several AMIs, and -- the quiet one -- the
# /haiku-graviton/canonical-ami-id SSM mirror disagreeing with the tag. On
# 2026-08-31 that mirror was left pointing at an AMI a candidate prune had just
# DEREGISTERED, so anything resolving canonical the documented way (via SSM)
# would have launched a dead pointer while the tag looked perfectly healthy. A
# board that prints the tag alone cannot show that; `haiku-canonical check`
# compares both and exits non-zero on either failure, so surface its verdict
# here. Best-effort and never fatal: this snapshot must not block a session.
if [ -x "$HERE/haiku-canonical" ]; then
	if canon_out=$(AWS_REGION="$REGION" "$HERE/haiku-canonical" check 2>&1); then
		printf '%s\n' "$canon_out" | grep -q '^ssm:' \
			&& say "  invariant: OK (tag and SSM agree)" \
			|| say "  invariant: OK (one canonical)"
	else
		say "  invariant: ** VIOLATED ** -- run haiku-canonical check"
		printf '%s\n' "$canon_out" | sed 's/^/    /' | head -4
	fi
fi

# ------------------------------------------------------------------ dashboard
# The native-EC2 build path (haiku-nativebuild over SSM) and the bake pipelines
# are where the work lives now; surface them so a cold session has the whole
# picture without hand-querying. Bucket is derived from the account id ($ident)
# so no account-scoped name is baked into this tracked file.
say ""
say "--- native builders (tag role=native-builder) ---"
aws_q ec2 describe-instances \
	--filters "Name=tag:role,Values=native-builder" \
	          "Name=instance-state-name,Values=running,pending" \
	--query 'Reservations[].Instances[].InstanceType' --output text \
	| tr '\t' '\n' | sort | uniq -c \
	| while read -r n t; do [ -n "$t" ] && printf '  %3s x %s\n' "$n" "$t"; done
online=$(timeout 15 aws --region "$REGION" ssm describe-instance-information \
	--max-results 50 \
	--query 'length(InstanceInformationList[?PingStatus==`Online`])' --output text 2>/dev/null)
say "  SSM nodes online: ${online:-?}"

say ""
say "--- bake pipelines (in-flight stage / Approve-gate) ---"
for pl in haiku-graviton-bake haiku-graviton2-bake haiku-graviton3-bake haiku-graviton4-bake; do
	inflight=$(aws_q codepipeline get-pipeline-state --name "$pl" \
		--query 'stageStates[?latestExecution.status==`InProgress`].stageName' --output text)
	appr=$(aws_q codepipeline get-pipeline-state --name "$pl" \
		--query 'stageStates[?stageName==`Approve`].actionStates[0].latestExecution.status' \
		--output text)
	printf '  %-22s inflight:%-12s approve:%s\n' "$pl" "${inflight:-idle}" "${appr:-n/a}"
done

say ""
say "--- package repo (debeos-repo/arm64) ---"
cnt=$(timeout 20 aws --region "$REGION" s3 ls \
	"s3://haiku-graviton-hpkg-${ident}/debeos-repo/arm64/packages/" 2>/dev/null \
	| awk '{print $4}' | sed -E 's/-[0-9].*//' \
	| grep -vE '_devel$|_debuginfo$|_tools$|_doc$|_source$|_bin$' | sort -u | wc -l)
say "  published base packages: ${cnt:-?}"

# ----------------------------------------------------- debeos-devops: build-wave
# The autonomous package-maintenance path (DebeosOpsStack, see graviton/ops/SOPs.md).
# Durable state is DynamoDB debeos-package-state (PK pkg, GSI by-build-state);
# the state machine is debeos-build-wave. Surface the backlog histogram, the
# builder AMI the plan will launch, and the most recent execution -- so a cold
# session knows the queue depth and whether a wave is in flight, without hand-
# querying. Every AWS call is best-effort; a missing stack degrades to blanks.
say ""
say "--- debeos-devops (build-wave + state) ---"
b_ami=$(aws_q ssm get-parameter --name /haiku-graviton/builder-ami-id \
	--query Parameter.Value --output text)
say "  builder AMI: ${b_ami:-<unset>}"
# One scan is cheaper than N Query calls, and the table is small (~hundreds).
hist=$(timeout 20 aws --region "$REGION" dynamodb scan \
	--table-name debeos-package-state \
	--projection-expression "build_state" --output json 2>/dev/null \
	| python3 -c '
import json, sys, collections
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
c = collections.Counter(
    i.get("build_state", {}).get("S", "<none>") for i in d.get("Items", []))
if not c:
    sys.exit(0)
parts = [f"{k}={v}" for k, v in c.most_common()]
print("total=" + str(sum(c.values())) + "  " + "  ".join(parts))
' 2>/dev/null)
say "  backlog: ${hist:-<no DDB access>}"
# The histogram above comes from a Scan, but the wave driver and the triage census
# read the by-build-state GSI -- and DynamoDB silently omits from a GSI any row
# missing its `queued_at` range key. That divergence hid 88 rows (incl. two `queued`
# ports a wave could never pick up) until #487. Assert the two agree, here, because
# this is the one thing that runs on every session start. Read-only; never fatal.
inv=$(timeout 25 "$HERE/haiku-state-guard" check --quiet 2>/dev/null)
say "  ${inv:-state-board invariant: NOT VERIFIED (haiku-state-guard unavailable)}"
# Newest execution across all history -- SUCCEEDED/RUNNING/FAILED/ABORTED all
# meaningful in a cold-session snapshot.
sm_arn="arn:aws:states:${REGION}:${ident}:stateMachine:debeos-build-wave"
last=$(aws_q stepfunctions list-executions --state-machine-arn "$sm_arn" \
	--max-results 1 \
	--query 'executions[0].[name,status,startDate]' --output text)
if [ -n "$last" ] && [ "$last" != "None" ]; then
	say "  last wave: $last"
else
	say "  last wave: (none / no state machine access)"
fi
# In-flight is what a maintainer actually reacts to; count RUNNING separately.
running=$(aws_q stepfunctions list-executions --state-machine-arn "$sm_arn" \
	--status-filter RUNNING --max-results 10 \
	--query 'length(executions)' --output text)
say "  waves running now: ${running:-0}"

say ""
say "--- open issues (gh, newest first) ---"
if command -v gh >/dev/null 2>&1; then
	timeout 20 gh issue list --repo felipedbene/Haiku-Graviton --state open --limit 60 \
		--json number,title,labels \
		--jq '.[] | "  #\(.number) [\(.labels|map(.name)|join(","))] \(.title)"' 2>/dev/null \
		| head -40 || say "  (gh query failed)"
else
	say "  (gh not installed)"
fi

# -------------------------------------------------------------- builder probe
builder=$(aws_q ec2 describe-instances \
	--filters "Name=tag:Name,Values=$BUILDER_NAME" "Name=instance-state-name,Values=running" \
	--query 'Reservations[].Instances[0].InstanceId' --output text)

say ""
if [ -z "$builder" ] || [ "$builder" = "None" ]; then
	say "--- builder ($BUILDER_NAME) is not running: no guest/build state to report ---"
	exit 0
fi
say "--- builder $builder: guests, builds, packages ---"

# One round trip. Everything the builder knows about its own in-flight work.
# shellcheck disable=SC2016
probe='
echo "host: $(uptime | sed "s/^ *//")"
echo
echo "KVM guests (a workstation reboot does NOT stop these):"
pgrep -af qemu-system-aarch64 2>/dev/null | while read -r pid rest; do
    img=$(echo "$rest" | grep -o "file=[^,]*\.img" | head -1 | cut -d= -f2)
    port=$(echo "$rest" | grep -o "hostfwd=tcp::[0-9]*" | head -1 | sed "s/.*:://")
    printf "  pid %-8s port %-6s %s\n" "$pid" "${port:-none}" "${img:-?}"
    if [ -n "$port" ]; then
        # ssh -n is load-bearing: without it ssh reads this loop'"'"'s stdin and eats
        # the remaining pgrep lines, so only the first guest is ever reported.
        if timeout 6 ssh -n -p "$port" -o StrictHostKeyChecking=no \
             -o UserKnownHostsFile=/dev/null -o ConnectTimeout=5 \
             -i /home/ubuntu/.ssh/haiku-ed25519 baron@127.0.0.1 true 2>/dev/null; then
            echo "      ssh: OK"
        else
            echo "      ssh: NO (guest netless, sshd down, or still booting)"
        fi
    fi
done
[ -z "$(pgrep -f qemu-system-aarch64 2>/dev/null)" ] && echo "  (none running)"
echo
echo "builds in flight:"
pgrep -af "[j]am " 2>/dev/null | head -5 || true
pgrep -af "[h]aikuporter" 2>/dev/null | head -5 || true
[ -z "$(pgrep -f "[j]am |[h]aikuporter" 2>/dev/null)" ] && echo "  (none)"
echo
echo "native packages built (hpkg-out):"
find /opt/haiku/hpkg-out -name "*.hpkg" 2>/dev/null | wc -l | sed "s/^/  count: /"
find /opt/haiku/hpkg-out -name "*.hpkg" -printf "  %TY-%Tm-%Td %TH:%TM %f\n" 2>/dev/null \
    | sort | tail -8
echo
echo "most recent run dirs / logs:"
ls -1dt /opt/haiku/run*/ /opt/hnet/ 2>/dev/null | head -4 | while read -r d; do
    printf "  %s\n" "$d"
    ls -1t "$d" 2>/dev/null | grep -E "\.(log|done)$" | head -4 | sed "s/^/      /"
done
'
# Pass the probe as real JSON, not CLI shorthand: the shorthand parser splits on
# commas, and this script contains them (e.g. grep -o "file=[^,]*\.img"), which
# silently mangles the command into nonsense.
req=$(mktemp -t haiku-status-probe.XXXXXX.json) || exit 0
trap 'rm -f "$req"' EXIT
INSTANCE="$builder" PROBE="$probe" python3 -c '
import json, os, sys
json.dump({
    "InstanceIds": [os.environ["INSTANCE"]],
    "DocumentName": "AWS-RunShellScript",
    "Parameters": {"commands": [os.environ["PROBE"]]},
}, open(sys.argv[1], "w"))
' "$req" || exit 0

cid=$(aws_q ssm send-command --cli-input-json "file://$req" \
	--query 'Command.CommandId' --output text)

if [ -z "$cid" ] || [ "$cid" = "None" ]; then
	say "  (could not start SSM probe -- is the SSM agent up?)"
	exit 0
fi

deadline=$((SECONDS + BUDGET))
while [ $SECONDS -lt $deadline ]; do
	sleep 4
	st=$(aws_q ssm get-command-invocation --command-id "$cid" \
		--instance-id "$builder" --query Status --output text)
	case "$st" in
		Success|Failed|Cancelled|TimedOut)
			aws_q ssm get-command-invocation --command-id "$cid" \
				--instance-id "$builder" --query StandardOutputContent --output text \
				| sed 's/^/  /'
			exit 0
			;;
	esac
done
say "  (probe still running after ${BUDGET}s -- re-run: graviton/scripts/haiku-status)"
exit 0
