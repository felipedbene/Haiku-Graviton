#!/bin/sh
# haiku-nativebuild-selftest [--mutate]
#
# Offline self-test for haiku-nativebuild's dependency diagnostic (#485/#486), its
# failure-log CAPTURE (#505 §E -- see "the log-capture arms" below) and its CAPACITY
# classification (#769 -- see "the capacity arms"). Runs
# ANYWHERE -- Linux dev host or Haiku builder -- because it never calls the real
# pkgman: it puts a stub pkgman on PATH that replays pkgman's own wording, taken from
# the DeBeOS sources that print it:
#
#   src/kits/package/manager/PackageManager.cpp  DIE(..., "Failed to find a match for
#                                                \"%s\"")  -> no match for a specifier
#   src/bin/pkgman/command_install.cpp           "%s from %s is already installed."
#   src/bin/pkgman/pkgman.cpp                    "*** %s: %s" / "Nothing to do."
#   src/bin/pkgman/PackageManager.cpp            "Encountered problems:" / "problem N:"
#   src/bin/pkgman/command_search.cpp            "No matching packages found."
#
# WHY IT EXISTS. The defect it guards is not a crash, it is a MESSAGE that named a
# cause ("UNRESOLVABLE (not in repo, build it first)") which the code had never
# measured -- and which was wrong for 149 of the 350 ports filed under it. A diagnostic
# is only worth trusting if something checks that it can still tell its cause apart
# from the alternatives, so each case below asserts BOTH the verdict that should appear
# AND the verdict that must not.
#
#   --mutate   Re-run the suite against the ORIGINAL, evidence-discarding code: the
#              old install_dep (`pkgman install ... >/dev/null 2>&1`) AND the old
#              capture (pre-#505 narrow lexicon, no first-error window), and the
#              pre-issue-702 absence of a ports-tree mutex (a no-op nb_lock_acquire,
#              which is exactly what the driver did when two runs clobbered one
#              chroot). The suite MUST go red: if it stays green it is not testing the
#              mechanism. Exit 0 means "mutation detected" (test is alive); exit 1
#              means it is vacuous.
set -u
MUTATE=0
[ "${1:-}" = "--mutate" ] && MUTATE=1

here=$(cd "$(dirname "$0")" && pwd)
SUT="$here/haiku-nativebuild"
[ -f "$SUT" ] || { echo "cannot find $SUT"; exit 2; }

work=$(mktemp -d "${TMPDIR:-/tmp}/nbselftest.XXXXXX") || exit 2
trap 'rm -rf "$work"' EXIT INT TERM
mkdir -p "$work/bin" "$work/dep"

# ---- the stub pkgman -------------------------------------------------------
# One stub, keyed off the requirement, so a case cannot accidentally be answered by
# the wrong script. Requirement -> behaviour:
#   devel:libabsent     install: no match          search: nothing      (true absence)
#   devel:liblua        install: no match          search: 8 providers  (ambiguity)
#   devel:libmikmod     install: already installed                      (present)
#   devel:libssl >= 3   install: no match; bare devel:libssl installs   (constraint)
#   devel:libbar        install: solver problem, transitive absence     (other error)
cat > "$work/bin/pkgman" <<'STUB'
#!/bin/sh
cmd="$1"; shift
case "$cmd" in
install)
	req="$1"
	case "$req" in
	"devel:libabsent"|"devel:liblua")
		echo "*** Failed to find a match for \"$req\": No such file or directory" >&2
		exit 1 ;;
	"devel:libmikmod")
		echo "libmikmod-3.3.11-2 from repository DeBeOS-green is already installed." >&2
		echo "Nothing to do." >&2
		exit 0 ;;
	"devel:libssl >= 3")
		echo "*** Failed to find a match for \"$req\": No such file or directory" >&2
		exit 1 ;;
	"devel:libssl")
		echo "The following changes will be made:"
		echo "  in /boot/system:"
		echo "    install package openssl_devel-1.1.1w-1 from repository DeBeOS-green"
		exit 0 ;;
	"devel:libbar")
		echo "Encountered problems:"
		echo "problem 1: nothing provides devel:libxyz needed by bar-1.0-1"
		echo "  solution 1:"
		echo "    - do not install bar-1.0-1"
		exit 1 ;;
	*)
		echo "The following changes will be made:"
		echo "    install package $req from repository DeBeOS-green"
		exit 0 ;;
	esac ;;
search)
	# accept -D / -a style flags, take the last argument as the search string
	for a in "$@"; do pat="$a"; done
	case "$pat" in
	"devel:liblua")
		echo "Status  Name         Description"
		for v in 5.1 5.2 5.3 5.4 jit 5.1_devel 5.3_devel 5.4_devel; do
			echo "        lua$v _devel  Lua devel package"
		done
		exit 0 ;;
	*)
		echo "No matching packages found."
		exit 0 ;;
	esac ;;
refresh) exit 0 ;;
*) echo "stub pkgman: unhandled command $cmd" >&2; exit 2 ;;
esac
STUB
chmod +x "$work/bin/pkgman"

# ---- load the functions under test ----------------------------------------
# Source haiku-nativebuild's definitions only: everything from the repo-refresh line
# down is its main body (it would run a build and exit).
sed '/^# Refresh the pkgman repo caches/,$d' "$SUT" > "$work/sut.sh"
if [ "$MUTATE" = 1 ]; then
	# The mutations: put back the original evidence-discarding install_dep, and the
	# capture as it stood before #505 §E -- the narrow lexicon (verbatim, this is the
	# pattern that was in emit_log_capture) and no first-error window. That pairing is
	# precisely what left `pnet` with a two-line grep block and no cause. Plus the
	# pre-issue-769 absence of any notion of capacity: no ENOSPC classifier and no
	# free-space reading at all, which is exactly the code that recorded `texlive` and
	# `gri` as broken recipes when the builder's volume was what had failed.
	cat >> "$work/sut.sh" <<'MUT'
install_dep() { feed | pkgman install "$1" >/dev/null 2>&1; }
NB_DIAG_RE='error:|Error [0-9]+|CMake Error|fatal error:|cannot find -l|command not found|No such file or directory|undefined reference|multiple definition of|does not name a type|ModuleNotFoundError|No module named|Read-only file system|not supported|unsupported|unknown word-size|guess (build|host) type|required file .* not found|unable to resolve|could not be resolved|is not available, please install|prepareInstalledDevelLib|possibly undefined macro|narrowing conversion|CHECKSUM|checksum'
emit_first_error_window() { :; }
have_hpkg() { ls "$GP/${1}"-[0-9]*.hpkg >/dev/null 2>&1; }
nb_lock_acquire() { return 0; }
nb_log_is_enospc() { return 1; }
nb_free_mib() { return 1; }
MUT
fi
PATH="$work/bin:$PATH"
export PATH
DEPDIR="$work/dep"
# shellcheck disable=SC1090
. "$work/sut.sh"
attempt=2   # report_no_progress quotes the round number it was called in

pass=0; fail=0
# run_case <name> <requirement-set> <expect...> -- <forbid...>
run_case() {
	name="$1"; miss="$2"; shift 2
	rm -rf "$DEPDIR"; mkdir -p "$DEPDIR"
	printf '%s\n' "$miss" | while IFS= read -r d; do
		[ -n "$d" ] || continue
		install_dep "$d"
	done
	out=$(report_no_progress "selftest_$name" "$miss" 2>&1)
	mode=expect
	for pat in "$@"; do
		if [ "$pat" = "--" ]; then mode=forbid; continue; fi
		if printf '%s' "$out" | grep -q -- "$pat"; then hit=1; else hit=0; fi
		if [ "$mode" = expect ] && [ "$hit" = 1 ]; then
			pass=$((pass+1)); echo "  ok    $name: found   '$pat'"
		elif [ "$mode" = forbid ] && [ "$hit" = 0 ]; then
			pass=$((pass+1)); echo "  ok    $name: absent  '$pat'"
		else
			fail=$((fail+1))
			[ "$mode" = expect ] \
				&& echo "  FAIL  $name: MISSING '$pat'" \
				|| echo "  FAIL  $name: PRESENT (must not be) '$pat'"
		fi
	done
	# Set NB_SELFTEST_SHOW=1 to see each case's diagnostic verbatim -- the point of the
	# change is what the operator reads, so make it readable.
	[ -n "${NB_SELFTEST_SHOW:-}" ] && printf '%s\n' "$out" | sed 's/^/       | /'
	return 0
}

echo "haiku-nativebuild dependency-diagnostic self-test$([ "$MUTATE" = 1 ] && echo ' [MUTATED]')"

# 1. TRUE ABSENCE -- the only case in which the historical wording is earned.
run_case absent "devel:libabsent" \
	"ABSENT_CONFIRMED" "UNRESOLVABLE (measured" "No matching packages found" \
	-- "DEP_NO_PROGRESS"

# 2. PRESENT YET UNRESOLVED -- pkgman says it is already installed. This is the 149-port
#    case: it must NOT be reported as absent.
run_case present "devel:libmikmod" \
	"ALREADY_PRESENT" "DEP_NO_PROGRESS" "is already installed" \
	-- "UNRESOLVABLE" "ABSENT_CONFIRMED"

# 3. VERSION CONSTRAINT -- name present, relation unsatisfiable. Also proves the
#    requirement survived as ONE token (a word-split would have installed ">=" and "3").
run_case constraint "devel:libssl >= 3" \
	"CONSTRAINT_UNSATISFIED" "retried without the version relation (devel:libssl)" \
	"requirement: devel:libssl >= 3" \
	-- "UNRESOLVABLE" "requirement: >=" "requirement: 3"

# 4. SOME OTHER PKGMAN ERROR -- quote pkgman, do not translate it.
run_case pkgman_error "devel:libbar" \
	"PKGMAN_ERROR" "nothing provides devel:libxyz needed by bar-1.0-1" \
	-- "UNRESOLVABLE" "ABSENT_CONFIRMED"

# 5. MULTI-PROVIDER AMBIGUITY -- install found no match, but the pool offers candidates.
#    Reporting absence here is exactly the mistake the 45 multi-provider ports hit.
run_case ambiguous "devel:liblua" \
	"NO_MATCH_BUT_CANDIDATES_EXIST" "lua5.4_devel" \
	-- "UNRESOLVABLE" "ABSENT_CONFIRMED"

# ---- the log-capture arms (#505 §E) ---------------------------------------
# WHAT THESE GUARD. The capture is the only thing that decides which log content
# leaves the scratch builder, and the builder is destroyed after the wave: a line this
# function drops is gone for good. `pnet`'s log was 416 720 lines, so the bounded path
# kept head+grep+tail and discarded the middle 415 300 -- and the grep lexicon could
# not see the one line in there that stated a reason. What came back was a checksum
# notice and make's cascade, which is why #505 recorded it as "cause lost in the
# discarded middle".
#
# THE FIXTURE IS REAL, and that matters more than convenience here: a fabricated log
# had to be removed from this tree once already. graviton/testdata/ffcall-wd-492-nodiag.log
# is the inner haikuporter log of the #492 re-wave's `ffcall` failure, carved out of
# that run's own captured window (lines 4-763 of the gunzipped
# s3://haiku-graviton-668984504585-us-west-2/logs/wd-492-nodiag/ffcall.log.gz).
# `ffcall` is the right stand-in because its log is COMPLETE (760 lines -- it fit under
# the cap and was kept whole, so nothing about it is inferred) and it carries the same
# shape of cause as `pnet`: a `No rule to make target` in the body, at line 338. Scale
# the caps down and the bounded path runs over real content whose true first reason
# line is known -- which is pnet's failure mode, reproduced without inventing text.
# The fixture is verbatim and its LINE NUMBERS are load-bearing (the arms below name
# 338 and the window 258-418): do not reflow, annotate or prepend a header to it.
#
# AND THE WARNING, repeated here because this is where someone will come looking:
# recovering that line is NOT diagnosing the build. `No rule to make target` is a
# downstream symptom -- something that should have produced the file failed earlier --
# and reading it as the cause is the mistake #505 §E exists to prevent. These arms
# assert the capture CARRIES the evidence; they make no claim about what it means.
FIXTURE="$here/../testdata/ffcall-wd-492-nodiag.log"
FFCALL_ROOT="No rule to make target 'avcall/avcall.lo'"

# cap_case <name> <capture-output> <expect...> -- <forbid...>
# Fixed-string matching: every pattern below is literal log text, and `make: ***` is
# not something to have to escape for a regex.
cap_case() {
	name="$1"; got="$2"; shift 2
	mode=expect
	for pat in "$@"; do
		if [ "$pat" = "--" ]; then mode=forbid; continue; fi
		if printf '%s\n' "$got" | grep -qF -- "$pat"; then hit=1; else hit=0; fi
		if [ "$mode" = expect ] && [ "$hit" = 1 ]; then
			pass=$((pass+1)); echo "  ok    $name: found   '$pat'"
		elif [ "$mode" = forbid ] && [ "$hit" = 0 ]; then
			pass=$((pass+1)); echo "  ok    $name: absent  '$pat'"
		else
			fail=$((fail+1))
			[ "$mode" = expect ] \
				&& echo "  FAIL  $name: MISSING '$pat'" \
				|| echo "  FAIL  $name: PRESENT (must not be) '$pat'"
		fi
	done
	return 0
}

if [ ! -f "$FIXTURE" ]; then
	# Do not quietly skip: a missing fixture is a suite that stopped testing the
	# capture, and that is the state #505 §E was in.
	fail=$((fail+1)); echo "  FAIL  capture: fixture missing: $FIXTURE"
else

# 6. THE PREMISE. Before asserting the fix, assert the fixture really does reproduce
#    pnet: with these caps the root diagnostic is in neither the head nor the tail, so
#    head+tail alone cannot carry it. No SUT code involved -- this is the control.
head_tail=$( { head -n 150 "$FIXTURE"; tail -n 50 "$FIXTURE"; } )
cap_case premise "$head_tail" -- "$FFCALL_ROOT"

# 7. THE BOUNDED PATH, with the caps scaled so 760 lines overflows them. The window
#    must be centred on line 338 (the first reason line that is not boilerplate) and
#    the capture must carry the diagnostic the head+tail of arm 6 cannot.
bounded=$( ( NB_LOG_FULL_LINES=500; NB_LOG_HEAD=150; NB_LOG_TAIL=50; NB_LOG_CTX=80
	emit_log_capture "$FIXTURE" ) )
cap_case bounded "$bounded" \
	"$FFCALL_ROOT" \
	"first error window: lines 258-418 around the first reason line (338)" \
	"338:make: *** $FFCALL_ROOT" \
	"not necessarily the root cause" \
	"head+window+grep+tail capture" \
	-- "NO non-boilerplate reason line"

# 8. THE WIDENED LEXICON, separately from the window: the grep block itself must now
#    list line 338. Before #505 §E this block was two lines -- a checksum notice and
#    make's cascade -- which is the exact shape pnet came back with.
grepblock=$(printf '%s\n' "$bounded" | awk '/^---- diagnostic lines/,/^---- build log TAIL/')
cap_case lexicon "$grepblock" \
	"338:make: *** $FFCALL_ROOT" \
	-- "---- first error window"

# 9. THE NOISE LIST IS LOAD-BEARING. ffcall's FIRST line matching the lexicon is line
#    4, `Validating checksum of libffcall-2.5.tar.gz` -- which is printed by every run
#    and states nothing. Blank the noise list and the window centres there instead of
#    on 338: that one arm is what makes the window land on evidence. (The remaining arms
#    are not exercised by THIS fixture -- arm 9b brings a second real log for the
#    git-source arm; per #505's own lesson -- "inert" is a property of the corpus, not
#    the regex -- the rest are recorded as untested here, not as proof they are
#    unnecessary. The git-source arm is what came of taking that seriously: it was added
#    only because a real builder produced a log the ffcall corpus had no case for.)
nonoise=$( ( NB_LOG_FULL_LINES=500; NB_LOG_HEAD=150; NB_LOG_TAIL=50; NB_LOG_CTX=80
	NB_NOISE_RE='^\{no arm can match this\}$'
	emit_log_capture "$FIXTURE" ) )
cap_case noise_needed "$nonoise" \
	"around the first reason line (4)" \
	-- "around the first reason line (338)"

# 9b. THE GIT-SOURCE BOILERPLATE, which is the arm the ffcall fixture cannot exercise
#     and which the fixed capture hit the first time it ran on a real builder. Second
#     real fixture, and it is the whole inner haikuporter log of the #492 re-wave's
#     `libavlduptree` failure -- 63 lines, kept whole by the capture, so again nothing
#     about it is inferred (verbatim lines 4-66 of the gunzipped
#     s3://haiku-graviton-668984504585-us-west-2/logs/wd-492-nodiag/libavlduptree.log.gz).
#     ITS LINE NUMBERS ARE LOAD-BEARING: 4 is haikuporter's `PLEASE MOVE TO A TAG OR
#     COMMIT WITH CHECKSUM ASAP!` advice about the recipe's unchecksummed git source,
#     printed during the download before a compiler runs, and 52 is the reason the build
#     actually failed. Do not reflow or prepend a header to the fixture.
#
#     Why this one matters more than its one-in-96 incidence suggests: a git source is
#     exactly what #505 §C unblocked (`have_hpkg`'s old `-[0-9]*` glob could never match
#     `<port>-git-N-arm64.hpkg`), so the port class whose window this line steals is the
#     class that is only now reaching a build at all.
GITFIX="$here/../testdata/libavlduptree-wd-492-nodiag.log"
AVL_ROOT="No targets specified and no makefile found"
if [ ! -f "$GITFIX" ]; then
	fail=$((fail+1)); echo "  FAIL  capture: fixture missing: $GITFIX"
else
gitcaps="NB_LOG_FULL_LINES=40 NB_LOG_HEAD=10 NB_LOG_TAIL=10 NB_LOG_CTX=20"
gitbounded=$( ( eval "$gitcaps"; emit_log_capture "$GITFIX" ) )
cap_case git_boilerplate "$gitbounded" \
	"around the first reason line (52)" \
	"52:make: *** $AVL_ROOT" \
	-- "around the first reason line (4)"

# 9c. AND THAT ARM IS LOAD-BEARING TOO: drop just it from the noise list -- leaving the
#     rest intact, so this is not arm 9 restated -- and the window goes back to centring
#     on line 4, which is the defect as observed.
gitnoarm=$( ( eval "$gitcaps"
	NB_NOISE_RE=$(printf '%s' "$NB_NOISE_RE" | sed 's/|\^Warning: PLEASE MOVE TO A TAG//')
	case "$NB_NOISE_RE" in
	*"PLEASE MOVE TO A TAG"*) echo "SELFTEST BUG: could not remove the arm" ;;
	esac
	emit_log_capture "$GITFIX" ) )
cap_case git_boilerplate_needed "$gitnoarm" \
	"around the first reason line (4)" \
	-- "around the first reason line (52)" "SELFTEST BUG"
fi

# 10. NOTHING BUT NOISE. A log in which every matching line is boilerplate must say so
#     in as many words. An empty window and a window that was never attempted are
#     different findings, and #492's `ffcall` was filed as "emitted no reason" when in
#     fact the capture had dropped it. Fixture built from the real log's own lines:
#     every line that states no reason, plus the real boilerplate lines.
{ grep -vE "$NB_DIAG_RE" "$FIXTURE"; grep -E "$NB_NOISE_RE" "$FIXTURE"; } > "$work/noise.log"
noiseonly=$( ( NB_LOG_FULL_LINES=100; NB_LOG_HEAD=20; NB_LOG_TAIL=20
	emit_log_capture "$work/noise.log" ) )
cap_case noise_only "$noiseonly" \
	"first error window: NO non-boilerplate reason line in" \
	-- "around the first reason line"

# 11. THE WHOLE-LOG PATH is untouched: under the cap the log is still emitted entire,
#     with no window (there is nothing to recover from a log that was fully kept).
whole=$(emit_log_capture "$FIXTURE")
cap_case whole_log "$whole" \
	"---- full build log (760 lines)" \
	"$FFCALL_ROOT" \
	-- "---- first error window" "build log HEAD"

fi

# ---- the success rule (#505 §C, driver half) -------------------------------
# `have_hpkg` IS the success rule ("success = the hpkg exists", SOP §7), and it got
# `cmake_haiku` recorded `failed` after a build that worked: the old glob was
# `<port>-[0-9]*.hpkg`, so the real `cmake_haiku-git-4-arm64.hpkg` did not match a
# version that starts with a letter. The hpkg was harvested to the pool all the same,
# which is how the row ended up `failed` with its package published. Both directions
# are asserted, because the digit was there to stop a sibling package satisfying the
# test and widening the glob must not give that up.
GP="$work/packages"
mkdir -p "$GP"

# hpkg_case <name> <port> <yes|no>
hpkg_case() {
	if have_hpkg "$2"; then got=yes; else got=no; fi
	if [ "$got" = "$3" ]; then
		pass=$((pass+1)); echo "  ok    $1: have_hpkg $2 -> $got"
	else
		fail=$((fail+1)); echo "  FAIL  $1: have_hpkg $2 -> $got, wanted $3"
	fi
}

: > "$GP/cmake_haiku-git-4-arm64.hpkg"
hpkg_case hpkg_git cmake_haiku yes
# A sibling whose name merely STARTS with the port name must not count.
rm -f "$GP/cmake_haiku-git-4-arm64.hpkg"
: > "$GP/cmake_haiku_tools-1.2-3-arm64.hpkg"
hpkg_case hpkg_sibling cmake_haiku no
# And a numerically versioned hpkg still counts, which is the common case.
: > "$GP/sdl2-2.30.9-1-arm64.hpkg"
hpkg_case hpkg_numeric sdl2 yes
hpkg_case hpkg_absent nosuchport no

# 13. THE PORTS-TREE MUTEX (issue 702). Two haikuporter runs over one $HP is what
#     turned a healthy texlive_core build into `mkdir: cannot create directory
#     '/packages/texlive_core-2026-1': Read-only file system` six hours in: the second
#     run's chroot-setup stripped the first run's build packages, then aborted on
#     `unmount: unmounting failed: Device/File/Resource busy` before it could remount
#     packagefs. Three arms matter and they pull in opposite directions, which is why
#     each is asserted separately -- a guard that only ever refuses wedges the builder
#     after one killed driver, and a guard that only ever reclaims is not a guard.
lock_rc_case() {
	if [ "$2" = "$3" ]; then
		pass=$((pass+1)); echo "  ok    $1: rc=$2"
	else
		fail=$((fail+1)); echo "  FAIL  $1: rc=$2, wanted $3"
	fi
}
lock_bool_case() {
	if [ "$2" = yes ]; then
		pass=$((pass+1)); echo "  ok    $1"
	else
		fail=$((fail+1)); echo "  FAIL  $1"
	fi
}
HP="$work/hp"; mkdir -p "$HP"
NB_LOCK="$HP/.nativebuild.lock"
NB_LOCK_WAIT_SECS=0   # a test never waits: refuse or reclaim immediately

# (a) A free tree is taken, and the lock records WHO holds it -- the stale check is
#     only ever as good as that record.
NB_LOCK_HELD=""
nb_lock_acquire >/dev/null 2>&1; rc=$?
lock_rc_case lock_free "$rc" 0
[ "$(cat "$NB_LOCK/pid" 2>/dev/null)" = "$$" ] && g=yes || g=no
lock_bool_case "lock_owner: the lock names this process" "$g"

# (b) Held by a LIVE process: refuse, say so, and leave the holder's lock alone.
mkdir -p "$NB_LOCK"
sleep 120 & livepid=$!
echo "$livepid" > "$NB_LOCK/pid"
NB_LOCK_HELD=""
out=$(nb_lock_acquire 2>&1); rc=$?
lock_rc_case lock_live_refused "$rc" 1
printf '%s' "$out" | grep -q "REFUSING TO RUN" && g=yes || g=no
lock_bool_case "lock_live_banner: the operator is told which pid holds the tree" "$g"
[ -d "$NB_LOCK" ] && g=yes || g=no
lock_bool_case "lock_live_kept: the holder's lock survives a refused acquire" "$g"
kill "$livepid" 2>/dev/null
wait "$livepid" 2>/dev/null

# (c) Held by a pid that is GONE: reclaim, so one killed driver cannot wedge the box.
mkdir -p "$NB_LOCK"
echo "$livepid" > "$NB_LOCK/pid"
NB_LOCK_HELD=""
out=$(nb_lock_acquire 2>&1); rc=$?
lock_rc_case lock_stale_reclaimed "$rc" 0
printf '%s' "$out" | grep -q "reclaiming stale" && g=yes || g=no
lock_bool_case "lock_stale_banner: the reclaim is reported, not silent" "$g"

# nb_lock_acquire installs its own EXIT trap; put the suite's cleanup back.
rm -rf "$NB_LOCK"
trap 'rm -rf "$work"' EXIT INT TERM

# ---- the capacity arms (issue 769) ----------------------------------------
# WHAT THESE GUARD. `haiku-nativebuild` had no notion of "the builder ran out of disk",
# so an out-of-disk build took the one path available for "no hpkg and no missing
# dependency" and came out as `<port>: FAILED, no missing-dep` -- which build-wave
# records as a defect in the RECIPE. Then the loop moved on to the next port on the same
# full volume and manufactured another one. Measured on i-092201b33570a801d on
# 2026-10-16: `app-text/texlive` unpacked a 7.1 GiB texmf tree onto a 20 GiB root and
# died, and `gri` "failed" two seconds after it started, having compiled nothing. Two
# false `failed` rows, one capacity event.
#
# So there are two separate things to pin down and they need different arms: build_one
# must not mislabel the port it happened to, and run_ports must not keep going. The
# second is why the port loop is a function at all -- the fan-out is invisible from a
# single port.
#
# THE df FIXTURE IS REAL and that is the whole point of it: nb_free_mib exists because
# Haiku's `df` given a PATH prints a detailed block rather than a POSIX line, so there
# is nothing to cut a column from and the function has to parse. Below is `df -k /boot`
# verbatim from i-07e146b4785a17da8 (a live Graviton Haiku builder, 2026-10-16). The
# two lines nb_free_mib reads are `Block Size:` and `Free Blocks:`, and it reads the
# PARENTHESISED integers, not the rendered "11.0 GiB" beside them -- at the point this
# check matters the difference between "0.0 GiB" and 112 KiB is the entire question, so
# an arm that accepted the pretty column would be asserting the one field that cannot
# answer it. Do not reflow or re-space this fixture; the spacing is what a real df
# emits and tolerating it is part of what is under test.
cat > "$work/df-real.txt" <<'DFREAL'
   Device No.: 3
   Mounted at: /boot
  Volume Name: "Haiku"
  File System: bfs
       Device: /dev/disk/nvme/0/1
        Flags: QAM-P-W
     I/O Size:   64.0 KiB (65536 byte)
   Block Size:    2.0 KiB (2048 byte)
 Total Blocks:   20.0 GiB (10467319 blocks)
  Used Blocks:    9.0 GiB (4693236 blocks)
  Free Blocks:   11.0 GiB (5774083 blocks)
      Usage %:   44.8 %
  Total Nodes: 0
   Used Nodes: 0
   Free Nodes: 0
   Root Inode: 524288
DFREAL

# The variants are DERIVED from that block by substituting its Free Blocks line, and
# only that line, so the provenance of every other field stays visible in the sed:
#  - full:  56 blocks x 2048 = 112.0 KiB, which is what the wedged builder reported at
#           the moment SSM and sshd stopped answering (issue 770). 0 MiB.
#  - edge:  1572864 blocks x 2048 = exactly 3072 MiB -- the floor itself, which must be
#           ACCEPTED. `-lt` and `-le` are one character apart and the wrong one turns
#           the guard into a refusal to build at a size that still builds.
#  - under: 1572863 blocks, i.e. one block less, = 3071 MiB. Must be refused. The pair
#           is what makes the boundary tested rather than asserted.
dfvar() {
	sed "s|^  Free Blocks:.*|  Free Blocks:    0.0 GiB ($1 blocks)|" \
		"$work/df-real.txt" > "$work/df-$2.txt"
}
dfvar 56 full
dfvar 1572864 edge
dfvar 1572863 under
printf 'Filesystem 1024-blocks Used Available Capacity Mounted on\n/dev/sda1 20971520 9386472 11548166 45%% /\n' \
	> "$work/df-posix.txt"

# `df` and `haikuporter` stubs. df replays whichever fixture $NBTEST_DF_PTR names, so a
# port can FILL THE DISK as a side effect of its own build -- which is what actually
# happens and is the only way the loop arm can observe the fan-out. An empty or missing
# pointer means df itself failed, which is the case nb_free_mib must report as UNKNOWN:
# a df this code cannot parse must not become a refusal to build.
export NBTEST_DF_PTR="$work/df.ptr"
cat > "$work/bin/df" <<'DFSTUB'
#!/bin/sh
p=$(cat "$NBTEST_DF_PTR" 2>/dev/null)
[ -n "$p" ] && [ -f "$p" ] || exit 1
cat "$p"
DFSTUB
cat > "$work/bin/haikuporter" <<'HPSTUB'
#!/bin/sh
# Records that it ran (the loop arm asserts a compiler was never invoked for the ports
# after the abort), optionally produces an hpkg, optionally fills the disk, and always
# exits non-zero -- build_one never reads this exit code, it asks have_hpkg.
port=""
for a in "$@"; do case "$a" in -*) ;; *) port="$a" ;; esac; done
echo "$port" >> "$NBTEST_HP_CALLS"
[ -n "${NBTEST_HP_MAKES_HPKG:-}" ] && : > "$GP/$port-1.0-1-arm64.hpkg"
[ -n "${NBTEST_HP_FILLS:-}" ] && printf '%s\n' "$NBTEST_HP_FILLS" > "$NBTEST_DF_PTR"
[ -n "${NBTEST_HP_OUT:-}" ] && [ -f "$NBTEST_HP_OUT" ] && cat "$NBTEST_HP_OUT"
exit 1
HPSTUB
chmod +x "$work/bin/df" "$work/bin/haikuporter"

# 14. nb_free_mib: the parse. Asserted as exact integers, because this is arithmetic on
#     numbers a real df printed and "roughly 11 GiB" is not a thing a floor check can
#     compare against.
free_case() {
	printf '%s\n' "$2" > "$NBTEST_DF_PTR"
	got=$(nb_free_mib "$HP" 2>/dev/null || true)
	if [ "${got:-}" = "$3" ]; then
		pass=$((pass+1)); echo "  ok    $1: nb_free_mib -> '${got:-}' MiB"
	else
		fail=$((fail+1)); echo "  FAIL  $1: nb_free_mib -> '${got:-}', wanted '$3'"
	fi
}
free_case free_real  "$work/df-real.txt"  11277
free_case free_full  "$work/df-full.txt"  0
free_case free_edge  "$work/df-edge.txt"  3072
free_case free_under "$work/df-under.txt" 3071
# A df this function does not understand yields NOTHING, which build_one treats as
# "unknown, proceed". Both the POSIX-shaped output of a non-Haiku df and an outright
# failed df are asserted, since the function runs on whatever the image ships.
free_case free_posix   "$work/df-posix.txt" ""
free_case free_df_fail "$work/nonexistent"  ""

# 15. nb_log_is_enospc: the classifier. The ENOSPC line is VERBATIM from the 702 chain's
#     own run on i-092201b33570a801d -- `[Errno -2147459065] No space left on device`,
#     which is Haiku's B_DEVICE_FULL printed through haikuporter's Python. It carries
#     both spellings at once, which is why the regex has to; the POSIX-only arms cover
#     make/configure/cp reporting the same errno without the Haiku code.
ENOSPC_HAIKU='[Errno -2147459065] No space left on device'
enospc_case() {
	printf '%s\n' "$2" > "$work/el.log"
	if nb_log_is_enospc "$work/el.log"; then got=yes; else got=no; fi
	if [ "$got" = "$3" ]; then
		pass=$((pass+1)); echo "  ok    $1: enospc -> $got"
	else
		fail=$((fail+1)); echo "  FAIL  $1: enospc -> $got, wanted $3"
	fi
}
enospc_case enospc_haiku  "$ENOSPC_HAIKU" yes
enospc_case enospc_posix  "cp: error writing 'x': No space left on device" yes
enospc_case enospc_errno  "tar: x: Cannot write: [Errno -2147459065]" yes
# And it must stay NARROW: a capacity verdict excuses a port from the failure tally, so
# a port that merely talks about disks is not one. `ffcall`'s real log is the strongest
# negative available -- it is a genuine build failure, 760 lines, and if the regex fires
# on it the classifier would be laundering real defects as infrastructure.
enospc_case enospc_not_a_space_error \
	"checking for available disk space... yes" no
if [ -f "$FIXTURE" ]; then
	if nb_log_is_enospc "$FIXTURE"; then
		fail=$((fail+1)); echo "  FAIL  enospc_real_failure: fired on ffcall's real log"
	else
		pass=$((pass+1)); echo "  ok    enospc_real_failure: silent on ffcall's real log"
	fi
fi

# 16. build_one: THE CASE THAT USED TO MISCLASSIFY. This is the arm issue 769 asks for by
#     name. A log that died on a write carries no `build-requires "..."` line, so the
#     missing-dep grep comes back empty and the old code fell through to the catch-all --
#     so both directions are asserted, and the absent one is the actual defect.
HP="$work/hp2"; GP="$work/pkgs2"; NB_LOG_DIR="$work/logs"
mkdir -p "$HP" "$GP" "$NB_LOG_DIR"
export GP
MAX_ATTEMPTS=1
BUILT_OK=""
NBTEST_HP_CALLS="$work/hpcalls"; export NBTEST_HP_CALLS
: > "$NBTEST_HP_CALLS"
unset NBTEST_HP_MAKES_HPKG NBTEST_HP_FILLS 2>/dev/null || true
export NBTEST_HP_OUT=""

bo_case() {
	name="$1"; want_rc="$2"; shift 2
	out=$(build_one testport 2>&1); rc=$?
	if [ "$rc" = "$want_rc" ]; then
		pass=$((pass+1)); echo "  ok    $name: rc=$rc"
	else
		fail=$((fail+1)); echo "  FAIL  $name: rc=$rc, wanted $want_rc"
	fi
	cap_case "$name" "$out" "$@"
}

# (a) The disk fills DURING the build: capacity verdict, capacity rc, and emphatically
#     not the port-defect verdict.
printf '%s\n' "$work/df-real.txt" > "$NBTEST_DF_PTR"
printf '%s\n' "$ENOSPC_HAIKU" > "$work/hp-enospc.log"
export NBTEST_HP_OUT="$work/hp-enospc.log"
bo_case build_one_enospc "$NB_RC_CAPACITY" \
	"testport: BUILD_ABORTED_ENOSPC" \
	"is NOT a port defect" \
	"$ENOSPC_HAIKU" \
	-- "FAILED, no missing-dep" "DEP_NO_PROGRESS"

# (b) The same thing buried in a long real log, so the classification does not depend on
#     the log being one line. Fixture is ffcall's real log with the measured errno line
#     appended -- which is where it appears in a real run, haikuporter prints it last.
if [ -f "$FIXTURE" ]; then
	{ cat "$FIXTURE"; printf '%s\n' "$ENOSPC_HAIKU"; } > "$work/hp-enospc-long.log"
	export NBTEST_HP_OUT="$work/hp-enospc-long.log"
	bo_case build_one_enospc_buried "$NB_RC_CAPACITY" \
		"testport: BUILD_ABORTED_ENOSPC" \
		-- "FAILED, no missing-dep"
fi

# (c) THE CONTROL, and the arm that keeps (a) honest: a real failure must still be a
#     failure. ffcall's unmodified log is a true build failure with no ENOSPC and no
#     missing-dep line -- exactly the shape that legitimately belongs in the catch-all.
#     Without this arm, `nb_log_is_enospc() { return 0; }` would pass the suite.
if [ -f "$FIXTURE" ]; then
	export NBTEST_HP_OUT="$FIXTURE"
	bo_case build_one_real_failure 1 \
		"testport: FAILED, no missing-dep" \
		-- "BUILD_ABORTED_ENOSPC" "CAPACITY_ABORT"
fi

# (d) The floor: already below it before the port starts, so the port is NOT STARTED.
#     Asserting the rc is not enough -- the point is that no compiler runs, because the
#     alternative (issue 770) is a volume at 0 free that takes sshd and the SSM agent
#     with it and strands the run's artifacts. So the stub's call log is asserted too.
printf '%s\n' "$work/df-full.txt" > "$NBTEST_DF_PTR"
: > "$NBTEST_HP_CALLS"
export NBTEST_HP_OUT=""
bo_case build_one_floor "$NB_RC_CAPACITY" \
	"testport: CAPACITY_ABORT" \
	"0 MiB free" \
	"NOT STARTED" \
	-- "BUILD_ABORTED_ENOSPC" "FAILED, no missing-dep"
if [ -s "$NBTEST_HP_CALLS" ]; then
	fail=$((fail+1)); echo "  FAIL  build_one_floor_no_exec: haikuporter ran anyway"
else
	pass=$((pass+1)); echo "  ok    build_one_floor_no_exec: haikuporter was never invoked"
fi

# (e) The boundary, both sides, through build_one rather than through nb_free_mib -- the
#     comparison lives in build_one and that is where off-by-one would hide. At exactly
#     the floor the port must START (and here reach the catch-all, since the stub log
#     says nothing), one block below it must not.
printf '%s\n' "$work/df-edge.txt" > "$NBTEST_DF_PTR"
: > "$work/hp-silent.log"
export NBTEST_HP_OUT="$work/hp-silent.log"
bo_case build_one_at_floor 1 \
	"testport: FAILED, no missing-dep" -- "CAPACITY_ABORT"
printf '%s\n' "$work/df-under.txt" > "$NBTEST_DF_PTR"
bo_case build_one_below_floor "$NB_RC_CAPACITY" \
	"testport: CAPACITY_ABORT" "3071 MiB free" -- "FAILED, no missing-dep"

# (f) An UNPARSEABLE df must not stop the build. The floor check is a guard against a
#     known failure mode, not a gate, and a driver that refuses to build because it
#     could not read df is a worse driver than the one 769 describes.
printf '%s\n' "$work/df-posix.txt" > "$NBTEST_DF_PTR"
bo_case build_one_df_unknown 1 \
	"testport: FAILED, no missing-dep" -- "CAPACITY_ABORT"

# 17. run_ports: THE FAN-OUT, which is the other half of 769's title ("the run keeps
#     going and manufactures more"). Three ports; the first one's own build fills the
#     volume, as texlive's did. What must happen: port 1 is a real BUILD_OK, port 2 is
#     refused rather than attempted, port 3 is never looked at, the run's rc is the
#     capacity code, and -- the assertion that matters most -- haikuporter is invoked
#     exactly ONCE across all three. Ports 2 and 3 are the two false `failed` rows that
#     this is here to prevent, and `gri`'s two-second "failure" is what they look like.
: > "$NBTEST_HP_CALLS"
printf '%s\n' "$work/df-real.txt" > "$NBTEST_DF_PTR"
export NBTEST_HP_MAKES_HPKG=1
export NBTEST_HP_FILLS="$work/df-full.txt"
export NBTEST_HP_OUT=""
BUILT_OK=""
# NOT a command substitution: run_ports reports through the globals BUILT_OK,
# capacity_abort and not_attempted, and `$(...)` would run it in a subshell where every
# one of those assertions would read the parent's stale value and pass for free.
run_ports portone porttwo portthree > "$work/rp.out" 2>&1; rc=$?
out=$(cat "$work/rp.out")
lock_rc_case run_ports_capacity_rc "$rc" "$NB_RC_CAPACITY"
cap_case run_ports "$out" \
	"portone: BUILD_OK" \
	"porttwo: CAPACITY_ABORT" \
	-- "portthree" "FAILED, no missing-dep" "porttwo: BUILD_ABORTED_ENOSPC"
case "$BUILT_OK" in
*portone*) pass=$((pass+1)); echo "  ok    run_ports_built: portone is recorded built" ;;
*) fail=$((fail+1)); echo "  FAIL  run_ports_built: BUILT_OK='$BUILT_OK'" ;;
esac
case "$BUILT_OK" in
*porttwo*|*portthree*)
	fail=$((fail+1)); echo "  FAIL  run_ports_built_clean: BUILT_OK='$BUILT_OK'" ;;
*) pass=$((pass+1)); echo "  ok    run_ports_built_clean: only portone is claimed" ;;
esac
# not_attempted is what the operator re-queues from, so it has to be complete AND it has
# to exclude the port the abort happened on -- that one is named separately, because it
# was refused rather than skipped and the distinction is the difference between "re-queue
# this" and "this was never even looked at".
case "$not_attempted" in
*portthree*) pass=$((pass+1)); echo "  ok    run_ports_requeue: portthree is listed to re-queue" ;;
*) fail=$((fail+1)); echo "  FAIL  run_ports_requeue: not_attempted='$not_attempted'" ;;
esac
case "$capacity_abort" in
porttwo) pass=$((pass+1)); echo "  ok    run_ports_abort_port: porttwo named as the abort point" ;;
*) fail=$((fail+1)); echo "  FAIL  run_ports_abort_port: capacity_abort='$capacity_abort'" ;;
esac
ncalls=$(wc -l < "$NBTEST_HP_CALLS" | tr -d ' ')
if [ "$ncalls" = 1 ]; then
	pass=$((pass+1)); echo "  ok    run_ports_no_further_exec: haikuporter ran once, for portone"
else
	fail=$((fail+1)); echo "  FAIL  run_ports_no_further_exec: haikuporter ran $ncalls time(s)"
fi
unset NBTEST_HP_MAKES_HPKG NBTEST_HP_FILLS

echo "----"
echo "pass=$pass fail=$fail"
if [ "$MUTATE" = 1 ]; then
	if [ "$fail" -gt 0 ]; then
		echo "MUTATION DETECTED: the suite goes red without the captured pkgman"
		echo "evidence, without the widened lexicon + first-error window, and without"
		echo "the capacity classifier -- so it is testing the mechanisms and not just"
		echo "their wording. Note what the mutated run_ports arm reports: all three"
		echo "ports claimed, haikuporter run three times on a full volume. That is"
		echo "issue 769 reproduced, not a stand-in for it."
		exit 0
	fi
	echo "VACUOUS SUITE: the mutation did not break any assertion."
	exit 1
fi
[ "$fail" -eq 0 ] || exit 1
echo "all assertions hold"
exit 0
