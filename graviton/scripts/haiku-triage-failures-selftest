# A pseudo-arm: the NO_DIAGNOSTIC machinery is not a RULES entry, so it is mutated by
# disarming its two line classifiers directly.
NODIAG_ARM = "nodiag"

# #505: and each WIDENED lexicon arm gets its own mutation, because a widened detector is
# only known to work if every token can be shown to be the thing that recovered its port.
# (arm name, table, arm name in that table, [(label, fixture, expected has_diagnostic)]).
# Every expectation here is False: disarm the token and the window that token rescued must
# go back to looking empty. An arm that cannot be made to fail was never doing the work.
LINE_ARMS = [
    ("line-cmake-frame", "reason", "cmake-frame", [("efte", CMAKE_FRAME_ONLY)]),
    ("line-ld-wrong-format", "reason", "ld-wrong-format", [("becasso", WRONG_FORMAT_OBJECT)]),
    ("line-errno-frame", "reason", "errno-frame",
     [("wifi firmwares", HAIKUPORTER_BAD_VALUE), ("openboardview", ERRNO_FRAME_ONLY)]),
    ("line-make-build-graph", "reason", "make-build-graph",
     [("libavlduptree", NO_MAKEFILE), ("ffcall", NO_RULE_FOR_ONE_FILE)]),
    ("line-syntax-error", "reason", "syntax-error", [("libeditline", SYNTAX_ERROR_ONLY)]),
    ("line-perl-inc", "reason", "perl-inc", [("ne", PERL_INC_ONLY)]),
    ("line-archive-open", "reason", "archive-open", [("helpviewer", ARCHIVE_OPEN_ONLY)]),
    ("line-enoent", "reason", "enoent", [("hwloc2 objcopy", SHORT_ENOENT_ONLY)]),
    ("line-no-such-user", "reason", "no-such-user", [("privoxy", NO_SUCH_USER_ONLY)]),
    ("line-enotallowed", "reason", "enotallowed", [("timezone_data", NOT_ALLOWED_ONLY)]),
]

# The one contentless arm whose mutation is EXPECTED TO CHANGE NOTHING, stated as a test
# rather than as a comment -- which is the whole lesson of #505. Before #505 the make arm
# swallowed every `make: *** ...` line and carried a comment saying "inert today, measured
# over the 639-log cache"; that measurement was true of the OLD corpus and became a defect
# on the new one, and the comment is what made it invisible, because a reader takes
# "inert" for a property of the regex.
#
# After the narrowing the two make arms are redundant AGAIN, for a different and much
# narrower reason: no _REASON_ARMS token matches `make: *** [<target>] Error N`, so
# suppressing it changes no verdict. They are kept as insurance -- if a future reason arm
# ever does match that line, every truncated window would silently read as diagnosed -- and
# THIS ARM IS THE MEASUREMENT, in executable form. When it fails, a reason arm has started
# matching make's exit-status recursion: go and decide which side is right. Do NOT "fix" it
# by deleting the assertion.
NODIAG_MAKE_ARM = "nodiag-make"

