# A capped log that ALSO has a genuine compile error must still be filed by the compile
# error: the ruleset's standing rule is that a real build failure wins first-match.
CAPPED_WITH_REAL_ERROR = CAPPED + """
/boot/home/haikuports/media-libs/x/src/x.c:12:5: error: 'foo' undeclared
CMake Error at CMakeLists.txt:3 (cmake_minimum_required):
  Compatibility with CMake < 3.5 has been removed from CMake.
"""

# --- #488 fixtures ---------------------------------------------------------------
# 27. The aranym shape, INCLUDING the chatter of the autoreconf/automake run that
# SUCCEEDED. That chatter is the reason class 15 is ordered ahead of the autotools
# classes: "installing './compile'" / "installing './missing'" is one reword away from
# looking like class 10's missing-aux-file diagnosis, and here it means the opposite.
CFLAGS_GUARD = fx("aranym", """done.
 + Running autoheader: done.
 + Running automake: configure.ac:358: installing './compile'
configure.ac:23: installing './missing'
src/Makefile.am: installing './depcomp'
done.
all done
runConfigure: Must specify optimization flags when overriding CFLAGS.
\t(autotools configure will not use the default ones in that case.)""",
                  cat="app-emulation",
                  preamble="aranym: attempt 1 installing: devel:libsdl_1.2 \n"
                           "aranym: FAILED, no missing-dep to install -- see /boot/home/nb-aranym.log\n")

# The SAME guard, CXXFLAGS spelling. farmhash and libnpupnp only ever log this form; a
# CFLAGS-only regex misses them, which is exactly what the issue's proposed signature did.
CXXFLAGS_GUARD = fx("farmhash", """configure.ac:13: installing './missing'
src/Makefile.am: installing './depcomp'
runConfigure: Must specify optimization flags when overriding CXXFLAGS.
\t(autotools configure will not use the default ones in that case.)""", cat="dev-libs")

MULTIDEF = fx("nethack", """/boot/system/develop/tools/bin/../lib/gcc/aarch64-unknown-haiku/13.3.0/../../../../aarch64-unknown-haiku/bin/ld: windows.o:/sources/nethack-3.6.2/src/windows.c:863: multiple definition of `WIN_STATUS'; decl.o:/sources/nethack-3.6.2/src/decl.c:273: first defined here
collect2: error: ld returned 1 exit status
make: *** [Makefile:118: nethack] Error 1""", cat="games-roguelike")

# A missing -l must beat a duplicate symbol: the link never resolved its INPUTS, so
# there is nothing to say about duplicate symbols yet.
MULTIDEF_PLUS_MISSING_LIB = MULTIDEF.replace(
