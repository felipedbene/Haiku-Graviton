# UNMATCHED residue over this cache, and its split, AFTER #505. Was 129 / 105 / 24 before:
# the six new classes take 11 (all of them previously no-diagnostic or gap), and the widened
# detector moves 22 more out of NO_DIAGNOSTIC into the ruleset gap without reclassifying
# anything. The gap GROWING is the honest direction: those logs always stated a reason and
# the detector could not read it.
CACHED_UNMATCHED = 118
CACHED_NODIAG = 83

# --- the #492 DEEP-capture corpus (--deep-logs) -----------------------------------------
# The 105 re-waved ports as they came back with the current deep capture. This is the corpus
# on which #505's headline was measured, and asserting the EXACT no-diagnostic set here is
# what turns "NO_DIAGNOSTIC fell 32 -> 5" from a claim in a PR body into a test.
#
# Arm 1 of the three-arm test (the detector AS SHIPPED BEFORE #505 reading 32/32 on this same
# corpus) is deliberately NOT asserted here: that detector no longer exists in the tree, so
# the assertion would have to carry a copy of it. It is re-derivable instead --
#   git show <pre-505>:graviton/scripts/haiku-triage-failures
# -- and its only job was to prove the harness reproduced the census, which arm 2 inherits.
DEEP_EXPECT = {
    35: "bebuilder ftgl gri qemacs",       # rssavers is in the older cache, not this one
    36: "becasso fasm sdljoytest",
    37: "canna chmlib nspr redis",         # unrar likewise
    38: "intel_wifi_firmwares ralink_wifi_firmwares realtek_wifi_firmwares",
    39: "libavlduptree opensound slunkcrypt",
    40: "doxygen2docset fish libmysqlclient",
}
# The whole point, as an exact set. Two groups, and the distinction is the finding:
#   * blis graphicsmagick lbreakouthd squashfs_tools tk -- these BUILT in the re-wave, so
#     their logs are SUCCESS logs and carry no failure reason. Reading them as
#     "no diagnostic" is correct, and their presence here is a consistency check on the
#     detector rather than a residue.
#   * camlp5 cmake_haiku di libimagequant stockfish -- the five genuine residue. None is a
#     truncation artifact; see the playbook's #505 section for what each one actually is.
DEEP_NODIAG = ("blis camlp5 cmake_haiku di graphicsmagick lbreakouthd libimagequant "
               "squashfs_tools stockfish tk")


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--mutate", nargs="*", metavar="ARM", default=None,
                    help="run the mutation arms (all of them with no argument)")
    ap.add_argument("--logs", default="")
    ap.add_argument("--deep-logs", default="",
                    help="a cache of DEEP-capture logs (*.log.gz) from the #492 re-wave; "
                         "asserts #505's arm 2. Skipped when absent.")
    ap.add_argument("--list-arms", action="store_true")
    args = ap.parse_args()

    if args.list_arms:
        for name, cls, substr, checks in ARMS:
            print("%-14s disarm class %-3s %-24s -> %s"
                  % (name, cls, substr or "(all patterns)",
                     ", ".join(lbl for lbl, _, _ in checks)))
        for name, table, arm, checks in LINE_ARMS:
            print("%-22s disarm %s arm %-20s -> %s falls back to NO_DIAGNOSTIC"
                  % (name, table, arm, ", ".join(lbl for lbl, _ in checks)))
        print("%-22s disarm _CONTENTLESS_LINE / _REASON_LINE -> the NO_DIAGNOSTIC split"
              % NODIAG_ARM)
        print("%-22s disarm both make suppressors -> asserts they are REDUNDANT today"
              % NODIAG_MAKE_ARM)
        return 0

    fails = passes = 0

    def check(label, got, want):
        nonlocal fails, passes
        if got == want:
            passes += 1
            print("  ok    %-30s -> class %s" % (label, got))
        else:
            fails += 1
            print("  FAIL  %-30s -> class %s (expected %s)" % (label, got, want))

    def check_not(label, got, unwanted):
        nonlocal fails, passes
        if got != unwanted:
            passes += 1
            print("  ok    %-30s -> class %s (not %s)" % (label, got, unwanted))
        else:
            fails += 1
            print("  FAIL  %-30s -> class %s, which it must NOT be" % (label, got))

    if args.mutate is None:
        # ---------------- base run: positives, negatives, NO_DIAGNOSTIC -----------
        mod = load()
        print("classifier ruleset test -- positive")
        for label, text, want in POSITIVE:
            check(label, mod.classify(text)[0], want)
        print("classifier ruleset test -- negative (ordering)")
        for label, text, unwanted in NEGATIVE:
            check_not(label, mod.classify(text)[0], unwanted)

        # The NO_DIAGNOSTIC split (#488). A window whose only error-shaped lines are
        # make's exit-status recursion states no reason, and must be reported as an
        # evidence-capture artifact rather than as a ruleset gap.
        print("captured-diagnostic split")
        for label, text, want in (
                ("narrowing-warning window", NARROWING_WARNING_ONLY, False),
                ("real compile error", NARROWING_ERROR, True),
                ("configure abort", CONFIGURE_NO_EXE, True),
                ("missing lib", MISSING_LIB_BY_PATH, True),
                # a window that is ONLY driver preamble + epilogue: the extreme form of
                # the truncated capture. This one also covers the load-bearing
                # `Error: Build has failed` arm of _CONTENTLESS_LINE -- that line is in
                # EVERY log, so without it nothing would ever be no-diagnostic.
                ("boilerplate only", fx("someport", "make: *** [Makefile:1: all] Error 2"),
                 False),
                # covers the other load-bearing arm: collect2 says ld gave up, never why.
                ("collect2 exit status only",
                 fx("someport", "collect2: error: ld returned 1 exit status\n"
                                "make: *** [Makefile:1: all] Error 2"), False),
                # the two non-compiler REASON tokens, each the only reason line in its
                # window so the arm is tested rather than masked by `error:`.
                ("ENOSPC",
                 fx("someport", "cp: error writing 'x.o': No space left on device"), True),
                ("EACCES",
                 fx("someport", "/bin/sh: ./configure: Permission denied"), True),
                # --- #505: one positive per widened arm, each window carrying that arm's
                # token as its ONLY reason line, so the arm is tested and not masked.
                ("cmake frame", CMAKE_FRAME_ONLY, True),
                ("wrong-format object", WRONG_FORMAT_OBJECT, True),
                ("haikuporter B_BAD_VALUE", HAIKUPORTER_BAD_VALUE, True),
                ("python errno", ERRNO_FRAME_ONLY, True),
                ("no makefile", NO_MAKEFILE, True),
                ("no rule for one file", NO_RULE_FOR_ONE_FILE, True),
                ("configure syntax error", SYNTAX_ERROR_ONLY, True),
                ("perl module missing", PERL_INC_ONLY, True),
                ("unzip cannot find/open", ARCHIVE_OPEN_ONLY, True),
                ("objcopy short ENOENT", SHORT_ENOENT_ONLY, True),
                ("id: no such user", NO_SUCH_USER_ONLY, True),
                ("zic: Operation not allowed", NOT_ALLOWED_ONLY, True),
                # --- and the negative that keeps the widening honest. stockfish's window is
                # WHOLE (112 lines) and still states no reason: its Makefile's config-sanity
                # test exits non-zero silently. A lexicon wide enough to call this diagnosed
                # has stopped discriminating, and the bucket stops meaning anything.
                ("genuinely silent build", SILENT_BUILD, False)):
            got = mod.has_captured_diagnostic(text)
            check("diagnostic? %s" % label, got, want)
    else:
        # ---------------- mutation runs -------------------------------------------
        all_arms = ({n for n, _, _, _ in ARMS} | {n for n, _, _, _ in LINE_ARMS}
                    | {NODIAG_ARM, NODIAG_MAKE_ARM})
        want_arms = set(args.mutate) or all_arms
        # A bogus arm name must exit 1, never pass vacuously: `--mutate nonsense` running
        # zero checks and printing "MUTATIONS CONFIRMED" is exactly the false green this
        # whole file exists to prevent.
        unknown = want_arms - all_arms
        if unknown:
            sys.exit("unknown mutation arm(s): %s (see --list-arms)" % ", ".join(sorted(unknown)))
        for name, cls, substr, checks in ARMS:
            if name not in want_arms:
                continue
            print("MUTATED [%s]: class %s%s disarmed in place"
                  % (name, cls, (" pattern ~ %r" % substr) if substr else ""))
            mod = load()
            n = neutralize(mod, cls, substr)
            # Guard against a vacuous arm: the fixtures must have depended on this rule.
            for label, text, want in checks:
                check("%s/%s" % (name, label), mod.classify(text)[0], want)
            print("        (%d pattern(s) disarmed)" % n)

        # A mutation of the NO_DIAGNOSTIC machinery too: if make's exit-status recursion
        # stops being treated as contentless, the truncated windows all look diagnosed
        # and the split silently stops splitting.
        if NODIAG_ARM in want_arms:
            mod = load()
            mod._CONTENTLESS_LINE = NEVER
            check("nodiag/contentless disarmed",
                  mod.has_captured_diagnostic(NARROWING_WARNING_ONLY), True)
            mod = load()
            mod._REASON_LINE = NEVER
            check("nodiag/reason disarmed",
                  mod.has_captured_diagnostic(NARROWING_ERROR), False)

        # #505: the per-token mutations. Each disarms ONE widened _REASON_ARMS arm, leaving
        # every other arm and the whole ruleset intact, and asserts that the port that arm
        # was added for goes back to reading NO_DIAGNOSTIC. This is what makes the
        # "32 -> 5" recovery attributable arm by arm instead of collectively.
        for name, table, arm, checks in LINE_ARMS:
            if name not in want_arms:
                continue
            print("MUTATED [%s]: %s arm %r disarmed, all others intact" % (name, table, arm))
            mod = load()
            neutralize_line_arm(mod, table, arm)
            for label, text in checks:
                check("%s/%s" % (name, label), mod.has_captured_diagnostic(text), False)

        # ... and the one whose mutation must change NOTHING -- see NODIAG_MAKE_ARM.
        if NODIAG_MAKE_ARM in want_arms:
            print("MUTATED [%s]: both make suppressors disarmed" % NODIAG_MAKE_ARM)
            mod = load()
            neutralize_line_arm(mod, "contentless", "make-recursion")
            neutralize_line_arm(mod, "contentless", "make-jobserver")
            check("%s/boilerplate stays silent" % NODIAG_MAKE_ARM,
                  mod.has_captured_diagnostic(
                      fx("someport", "make: *** [Makefile:1: all] Error 2")), False)
            check("%s/narrowing warning stays silent" % NODIAG_MAKE_ARM,
                  mod.has_captured_diagnostic(NARROWING_WARNING_ONLY), False)

    # ---------------- real cached logs (optional) --------------------------------
    if args.logs and os.path.isdir(args.logs):
        mod = load()
        got = {}
        for p in sorted(glob.glob(os.path.join(args.logs, "*.log"))):
            text = open(p, errors="replace").read()
            c = mod.classify(text)[0]
            got.setdefault(c, set()).add(os.path.basename(p)[:-4])
        print("real cached logs: %d" % sum(len(v) for v in got.values()))
        if args.mutate is None:
            for cls, names in sorted(CACHED_EXPECT.items()):
                want = set(names.split())
                have = got.get(cls, set())
                if have == want:
                    passes += 1
                    print("  ok    class %-3s %3d ports, exact set" % (cls, len(have)))
                else:
                    fails += 1
                    print("  FAIL  class %-3s want-not-got=%s got-not-want=%s"
                          % (cls, sorted(want - have) or "-", sorted(have - want) or "-"))
            un = got.get(None, set())
            check("cached UNMATCHED total", len(un), CACHED_UNMATCHED)
            nd = sum(1 for n in un
                     if not mod.has_captured_diagnostic(
                         open(os.path.join(args.logs, n + ".log"), errors="replace").read()))
            check("cached NO_DIAGNOSTIC", nd, CACHED_NODIAG)
            check("cached ruleset gap", len(un) - nd, CACHED_UNMATCHED - CACHED_NODIAG)
        else:
            # under mutation the capped logs must land in class 20 -- the #486 finding,
            # asserted over real logs and not only the fixture.
            if "25" in want_arms:
                m = load()
                neutralize(m, 25)
                caps = {}
                for p in sorted(glob.glob(os.path.join(args.logs, "*.log"))):
                    text = open(p, errors="replace").read()
                    if re.search(r"gave up after \d+ attempts", text):
                        caps[os.path.basename(p)[:-4]] = m.classify(text)[0]
                bad = {k: v for k, v in caps.items() if v != 20}
                if caps and not bad:
                    passes += 1
                    print("  ok    all %d capped logs fall to class 20" % len(caps))
                elif caps:
                    fails += 1
                    print("  FAIL  capped logs not falling to 20: %s" % bad)

    # ---------------- the #492 deep-capture corpus (optional) --------------------
    # Arms 2 and 3 of #505's three-arm test, as assertions: arm 3 is the block above (the
    # `tail -20` cache), arm 2 is this one (the same ports re-waved with the deep capture).
    # Running both in one invocation is the control -- the widened lexicon has to see MORE on
    # the deep corpus than on the truncated one, or it is matching boilerplate that is in
    # every log rather than reasons that are only in some.
    if args.deep_logs and os.path.isdir(args.deep_logs) and args.mutate is None:
        mod = load()
        texts, got = {}, {}
        for p in sorted(glob.glob(os.path.join(args.deep_logs, "*.log.gz"))
                        + glob.glob(os.path.join(args.deep_logs, "*.log"))):
            name = os.path.basename(p)
            name = name[:-7] if name.endswith(".log.gz") else name[:-4]
            if p.endswith(".gz"):
                texts[name] = gzip.open(p, "rt", errors="replace").read()
            else:
                texts[name] = open(p, errors="replace").read()
            got.setdefault(mod.classify(texts[name])[0], set()).add(name)
        print("deep-capture logs: %d" % len(texts))
        for cls, names in sorted(DEEP_EXPECT.items()):
            want, have = set(names.split()), got.get(cls, set())
            if have == want:
                passes += 1
                print("  ok    class %-3s %3d ports, exact set" % (cls, len(have)))
            else:
                fails += 1
                print("  FAIL  class %-3s want-not-got=%s got-not-want=%s"
                      % (cls, sorted(want - have) or "-", sorted(have - want) or "-"))
        nd = {n for n in got.get(None, set()) if not mod.has_captured_diagnostic(texts[n])}
        want_nd = set(DEEP_NODIAG.split())
        if nd == want_nd:
            passes += 1
            print("  ok    deep NO_DIAGNOSTIC %d ports, exact set" % len(nd))
        else:
            fails += 1
            print("  FAIL  deep NO_DIAGNOSTIC want-not-got=%s got-not-want=%s"
                  % (sorted(want_nd - nd) or "-", sorted(nd - want_nd) or "-"))

    print("----")
    print("pass=%d fail=%d" % (passes, fails))
    if args.mutate is not None:
        if fails == 0:
            print("MUTATIONS CONFIRMED: every disarmed signature changed the verdict in "
                  "the predicted way, so each pass in the base run is caused by that "
                  "signature and its position -- not by something incidental.")
            return 0
        print("MUTATION NOT CONFIRMED -- a fixture did not fall through as predicted; "
              "the ordering claim for that arm needs re-deriving.")
        return 1
    return 1 if fails else 0


if __name__ == "__main__":
    sys.exit(main())
