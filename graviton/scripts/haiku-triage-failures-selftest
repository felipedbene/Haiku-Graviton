collect2: error: ld returned 1 exit status""", cat="haiku-apps")

X86_INTRIN_HEADER = fx("sdl_gfx", """libtool: compile:  gcc -DPACKAGE=\\"SDL_gfx\\" -g -O2 -O -DUSE_MMX -I/packages/libsdl-1.2.15-19/.self/develop/headers/SDL -c SDL_imageFilter.c
