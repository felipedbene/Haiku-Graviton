#!/usr/bin/env python3
"""haiku-triage-failures-selftest [--mutate [ARM ...]] [--logs DIR] [--deep-logs DIR]
                                 [--list-arms]

Offline test for haiku-triage-failures' ruleset -- above all for its ORDER. No AWS, no
network: it imports the classifier and runs it over synthetic logs assembled from
verbatim lines taken from real build logs.

WHY IT EXISTS. A signature's worth here is mostly a function of where it sits. A capped
run ends at haikuporter's resolve step, so its log also contains class 20's "could not be
resolved" wording -- and class 20 was silently collecting all 22 capped ports, which is
how the census came to overstate "dependency not published" by 22 (#486). Ordering is
invisible in a diff and easy to lose in a later edit, so it gets a test that fails when
it is lost. #488 added ten more classes and three extensions to existing ones, each with
its own ordering claim, so each gets an arm here.

THREE KINDS OF ASSERTION, and the second and third are the ones that catch real bugs:

  1. POSITIVE -- a verbatim fixture lands in the class it should.
  2. NEGATIVE -- a fixture that must NOT land in a given class doesn't. Ordering bugs
     show up here and nowhere else: `libmcrypt` has to stay in class 10 even though it
     also matches class 29, `cpuid` has to be class 32 and not class 33, a `-mcpu`
     typo must not be read as an x86 flag.
  3. MUTATION -- neutralize exactly one rule (or one pattern of one rule) in the loaded
     ruleset, leaving the ORDER intact, and assert the fixture falls through to the
     stated class. A signature that cannot be made to fail is not known to work: if a
     fixture still lands in class N after class N has been disarmed, the pass was
     coming from somewhere else and the test proved nothing.

The mutation works on the loaded RULES list rather than on the file's text, so a reword
of a regex does not silently make an arm vacuous -- neutralize() raises when it finds
nothing to disarm, which is the loud failure a text-anchor gave us before.

#488 covered the RULES ruleset. #505 added a third subject: the NO_DIAGNOSTIC detector's own
lexicon. That lexicon was widened from 5 tokens to 15 named arms, and a widened detector is
only known to work if EACH arm can be shown to be the thing that recovered its port -- so
each gets its own `line-*` mutation arm (disarm one arm, all others intact, assert the port
it was added for falls back to reading no-diagnostic). One arm, `nodiag-make`, exists to
assert that a mutation changes NOTHING: see its comment, which is the #505 lesson in
executable form.

  --mutate [ARM ...]  run the mutation arms (all of them with no argument). Exits 0 when
                      every mutation is DETECTED, i.e. every fixture fell through as
                      predicted. A bogus arm name exits 1 rather than passing vacuously.
  --logs DIR          additionally classify every *.log in DIR (a local cache of real
                      backlog logs) and assert the measured per-class membership -- the
                      counts from the #488 census. Skipped when the directory is absent,
                      so the test still runs on a machine with no cache.
  --deep-logs DIR     the same, over a cache of DEEP-capture logs (*.log.gz) from the #492
                      re-wave: #505's arm 2. Pass BOTH --logs and --deep-logs to get the
                      control in one run -- the widened lexicon must see MORE on the deep
                      corpus than on the truncated one, or it is matching boilerplate that
                      is in every log instead of reasons that are only in some.
  --list-arms         print the mutation arms and exit.
"""
import argparse
import glob
import gzip
import os
import re
import sys
import types


HERE = os.path.dirname(os.path.abspath(__file__))
CLASSIFIER = os.path.join(HERE, "haiku-triage-failures")
NEVER = re.compile(r"(?!x)x")  # a compiled regex that cannot match anything


def load():
    """Import haiku-triage-failures as a module."""
    mod = types.ModuleType("tf")
    mod.__dict__["__name__"] = "tf"
    # `__file__` must be the classifier's real path, not this file's: the classifier
    # locates `pkgkey` (the #487 key contract) by walking up from its own
    # `os.path.abspath(__file__)`, and a synthesised module namespace has no
    # `__file__` at all -- so omitting it raised NameError as soon as #487 and #488
    # were both applied, while each passed alone.
    mod.__dict__["__file__"] = CLASSIFIER
    exec(compile(open(CLASSIFIER).read(), CLASSIFIER, "exec"), mod.__dict__)
    return mod


def neutralize_line_arm(mod, table, name):
    """Disarm exactly ONE named arm of the NO_DIAGNOSTIC line classifiers (#505), leaving
    every other arm in place, and rebuild the compiled regex from what is left.

    `table` is "reason" or "contentless". This is the mutation the #505 fix needs and the
    old whole-regex mutation could not express: a widened lexicon is only known to work if
    each token can be shown to be the thing that recovered its port. Raises when the name
    is unknown -- a renamed arm must break this test loudly, not pass it vacuously."""
    attr = "_REASON_ARMS" if table == "reason" else "_CONTENTLESS_ARMS"
    arms = getattr(mod, attr)
    if name not in {n for n, _ in arms}:
        sys.exit("line-arm mutation point not found: %s/%s -- the arm was renamed or "
                 "removed; update this test rather than deleting it" % (table, name))
    kept = tuple((n, p) for n, p in arms if n != name)
    setattr(mod, attr, kept)
    rebuilt = mod._join(kept) if kept else NEVER
    if table == "reason":
        mod._REASON_LINE = rebuilt
    else:
        mod._CONTENTLESS_LINE = rebuilt


def neutralize(mod, cls, substr=None):
    """Disarm one rule in the loaded ruleset WITHOUT moving it: replace its patterns
    (or only those whose source contains `substr`) with a regex that never matches. The
    rule keeps its position, so what the mutation measures is purely "what claims this
    log once class `cls` cannot". Raises when nothing was disarmed -- that means the
    regex was reworded and the arm would otherwise pass vacuously."""
    n = 0
    rules = []
    for c, slug, auto, pats, note in mod.RULES:
        if c == cls:
            new = []
            for p in pats:
                if substr is None or substr in p.pattern:
                    new.append(NEVER)
                    n += 1
                else:
                    new.append(p)
            pats = new
        rules.append((c, slug, auto, pats, note))
    mod.RULES = rules
    if not n:
        sys.exit("mutation point not found: class %s%s -- the regex was reworded or the "
                 "class removed; update this test rather than deleting it"
                 % (cls, (" / %r" % substr) if substr else ""))
    return n


# --- fixtures ---------------------------------------------------------------------
# Verbatim shapes from real logs, wrapped in the driver preamble and haikuporter's fixed
# epilogue so that a fixture looks like what the classifier is actually handed -- which
# matters for the NO_DIAGNOSTIC tests at the bottom, whose whole subject is how much of a
# real window is boilerplate.
EPILOGUE = """Warning: Command '['bash', '-c', '. /wrapper-script']' returned non-zero exit status 1.
cleaning 'chroot/boot' folder
keeping chroot folder /boot/home/haikuports/%(cat)s/%(pkg)s/work-1.0 intact for inspection
Checking if any dependency-infos need to be updated ...
Looking for stale dependency-infos ...
Looking for stale cached recipes ...
----------------------------------------------------------------------
%(cat)s::%(pkg)s-1.0
\t/boot/home/haikuports/%(cat)s/%(pkg)s/%(pkg)s-1.0.recipe
----------------------------------------------------------------------
Error: Build has failed - stopping.
===== nativebuild done 2026-09-15T14:42:56Z rc=1 =====
"""


def fx(pkg, body, cat="app-misc", preamble=None):
    """Assemble a realistic log: driver preamble + body + haikuporter epilogue."""
    head = "===== %s : start 2026-09-15T14:42:30Z =====\n" % pkg
    head += preamble if preamble is not None else (
        "%s: FAILED, no missing-dep to install -- see /boot/home/nb-%s.log\n" % (pkg, pkg))
    return head + body.rstrip("\n") + "\n" + EPILOGUE % {"cat": cat, "pkg": pkg}


