NARROWING_ERROR = fx("sawteeth", """/sources/Sawteeth-1.4.1/Source/stTrackerEntry.cpp:20:18: error: narrowing conversion of '-1' from 'int' to 'char' [-Wnarrowing]
   20 | char noteBuf[] = { -1 };
make[2]: *** [Source/CMakeFiles/Sawteeth.dir/build.make:289: stTrackerEntry.cpp.o] Error 1""",
                     cat="media-sound")

# Only WARNINGS, and (as in colors) in a different translation unit from the object that
# actually failed. This MUST stay unclassified: filing it as class 27 would name a line
# that did not fail the build. It is a truncated window, i.e. NO_DIAGNOSTIC.
NARROWING_WARNING_ONLY = fx("colors", """      |                            ^~~~~~~~~~~~~~~~~
ColorPickerView.cpp:629:47: warning: narrowing conversion of '(int)(fGreen * 255)' from 'int' to 'uint8' {aka 'unsigned char'} [-Wnarrowing]
