CPUSET_AT_COMPILE = fx("util_linux", """      |                                                ^~~~~~~~
./include/cpuset.h:80:21: note: in expansion of macro 'CPU_ISSET_S'
   80 |                 if (CPU_ISSET_S(cpu, setsize, ary[i])) {
make[2]: *** [Makefile:8605: libblkid/src/la-devname.lo] Error 1""", cat="sys-apps")

# cpuid's own patchset tried `#define CPU_ZERO CPUSET_ZERO` against a name Haiku does not
# export, so the Linux-affinity gap surfaces at LINK time through class 33's wording.
# Class 32 must win: an understood, named porting gap beats an anonymous missing symbol.
CPUSET_AT_LINK = fx("cpuid", """threads.c:(.text+0x70): undefined reference to `CPUSET_ZERO'
collect2: error: ld returned 1 exit status
make: *** [Makefile:70: cpuid] Error 1""", cat="sys-apps")

UNDEF_REF = fx("kbuild", """/sources/kbuild-upstream-0.1.9998svn3572+dfsg/src/kash/jobs.c:424:(.text+0x9f8): undefined reference to `WCOREDUMP'
