#!/bin/sh
# haiku-nativebuild <port> [<port> ...]
#
# Canonical native-EC2 package build driver. RUNS ON a native Graviton Haiku builder
# (launched from the builder-canonical AMI: `aws ssm get-parameter --name
# /haiku-graviton/builder-ami-id`). Drive it over SSM, e.g.:
#     graviton/scripts/ssm-run <builder-iid> <<'EOF'
#     /boot/home/haiku-nativebuild sdl2_ttf
#     EOF
#
# For each port it: builds with haikuporter, auto-installing any missing repo dependency
# it reports (BUILD_REQUIRES/BUILD_PREREQUIRES as devel:/cmd:/lib:/pkg-name resolvables),
# retrying until the build succeeds or stops making progress; then harvests the produced
# *.hpkg to the shared S3 pool. See graviton/docs/native-ec2-builds.md for the why.
#
# WHY THIS SHAPE (learned building glib2 -> harfbuzz -> sdl2_ttf on native EC2):
#  - NO `--all-dependencies`: it hits "Port X depends on itself" when a subpackage (e.g.
#    gobject_introspection) is also a build-require. Install deps from the repo instead;
#    haikuporter compiles only the requested leaf.
#  - pkgman accepts `devel:`/`cmd:` resolvables directly, but a wrong package name aborts a
#    BATCH -- so install one at a time and tolerate misses.
#  - The lean base ships bootstrap "Haiku Project" libs that collide with DeBeOS repo
#    versions, so every install needs an "allow vendor change" (solution 1); we feed it.
#  - Success is asserted by the .hpkg EXISTING, never by an exit code.
set -u
export PATH=/boot/home/config/non-packaged/bin:/boot/system/non-packaged/bin:$PATH
# Driver version marker (#506). This string is the single source of truth for "which
# haiku-nativebuild is this": the ops stack reads it at synth and hands it to the
# build Lambda, which refuses to build unless the copy staged onto the builder carries
# the SAME version (run_ssm._refresh_and_assert). It is also echoed as the first line
# of every per-port log so a wave's output records exactly which driver produced it --
# a stale copy can no longer masquerade as the current one (memory checks-that-stopped-
# checking). BUMP THIS whenever a driver change must reach a wave; then republish the
# script to s3://<bucket>/bake-scripts/haiku-nativebuild (graviton/scripts/haiku-publish-driver)
# and redeploy the ops stack. Format: YYYY-MM-DD.<serial>.
NATIVEBUILD_VERSION="2026-10-15.2"
HP=/boot/home/haikuports
GP=$HP/packages
AGENT=/boot/system/bin/debeos-ssm-agent
BUCKET="${HAIKU_GRAVITON_BUCKET:-haiku-graviton-668984504585-us-west-2}"
S3="s3://$BUCKET/hpkg/arm64"
# DeBeOS-owned HaikuPorts source mirror prefix (issue #172). After a port builds
# OK we promote its fetched source archives here, laid out as <recipeDir>/<file>
# to match the fallback URI haikuporter builds from DOWNLOAD_MIRROR. Empty = skip.
MIRROR_S3="${MIRROR_S3:-s3://$BUCKET/download-mirror}"
# Round cap for the dependency-install loop below. This is NOT a timeout: the loop
# discovers the requirements haikuporter reports, and haikuporter aborts at its FIRST
# unresolved requirement, so in practice each round clears one requirement. At the old
# default of 10 the cap was therefore a ceiling on *dependency count* -- a port with 11
# unresolved build-requires could never build however healthy the pool was (#486; 22
# backlog ports logged `gave up after 10 attempts`, ffmpeg6 among them, whose ten rounds
# each resolved a different dep and were still making progress when the cap hit).
# Genuine non-progress is already detected exactly, and cheaply, by the prev_miss check
# in build_one -- so the round cap only has to bound pathological oscillation.
MAX_ATTEMPTS="${MAX_ATTEMPTS:-60}"
# Names of ports whose build produced an hpkg this run (space-separated). Only
# these get their sources mirrored -- a successful build means haikuporter has
# already fetched AND checksum-validated every source, so the files in the port's
# download/ dir are verified. Never mirror sources for a port that did not build.
BUILT_OK=""

# feed pkgman: accept "allow vendor change" (solution 1) then confirm the transaction.
feed() { i=0; while [ $i -lt 60 ]; do echo 1; i=$((i+1)); done; echo yes; }

# ---------------------------------------------------------------------------
# Dependency installs, and the evidence they leave behind (#485).
#
# This used to be one line -- `feed | pkgman install "$1" >/dev/null 2>&1` -- which
# threw away stdout, stderr AND the exit status. The build loop then inferred
# "UNRESOLVABLE (not in repo, build it first)" from the only thing it had left: the
# unresolved set not shrinking. That is a root cause it never measured, and it was
# wrong at scale -- 149 of the 350 ports filed under that message name a dependency
# that is in the pool right now (#485).
#
# So every install now keeps pkgman's own combined output and its exit status, and the
# failure path is only allowed to name a cause it can read back out of them. The rule
# this file is now held to: A MESSAGE THAT NAMES A CAUSE MUST BE ABLE TO DISTINGUISH
# THAT CAUSE FROM ITS ALTERNATIVES. Where it cannot, it reports the observation
# ("the set did not shrink; pkgman said: ...") and stops.
DEPDIR="${DEPDIR:-/boot/home/.nb-depinstall}"
# build_one starts each port with `rm -rf "$DEPDIR"`, and this runs as root on the
# builder, so refuse an override that would delete something that matters.
case "$DEPDIR" in
	""|/|/boot|/boot/home|/boot/system|/boot/home/haikuports)
		echo "haiku-nativebuild: refusing DEPDIR='$DEPDIR'" >&2; exit 2 ;;
esac

# Transcript filename for one requirement. Case is PRESERVED and nothing here folds
# it: `pkgman install` matches provides case-SENSITIVELY, so `devel:libSDL2_2.0` and
# `devel:libsdl2_2.0` are different requests and must not share one transcript.
dep_slug() { printf '%s' "$1" | tr -c 'A-Za-z0-9._+' '_'; }

# The requirement with any trailing version relation removed:
#   "devel:libssl >= 3" -> "devel:libssl"      "cmd:cmake" -> "cmd:cmake"
dep_base() {
	printf '%s' "$1" \
		| sed -E 's/[[:space:]]*(<=|>=|==|=|<|>)[[:space:]]*[^[:space:]]+[[:space:]]*$//'
}

# Install ONE requirement (a haikuporter resolvable, which may carry a version
# relation such as `devel:libssl >= 3`) and record a one-word verdict the diagnostic
# below reads back. Verdicts, and what each is evidence OF:
#   INSTALLED               pkgman exited 0 having applied a transaction
#   ALREADY_PRESENT         pkgman exited 0 saying the package is already installed
#   CONSTRAINT_UNSATISFIED  the versioned requirement matched nothing, but the BARE
#                           name installed -- so the package is present and it is the
#                           version relation that is unsatisfied, not the package
#   NO_MATCH                pkgman itself reported no match (absence is still only a
#                           candidate explanation here -- see dep_candidates)
#   PKGMAN_ERROR            pkgman failed for some other reason; quote it, never
#                           translate it
#
# WHY the bare-name retry exists: libsolv matches the whole `name op version` string
# (SELECTION_REL), so a requirement whose name IS in the pool at too low a version
# fails with exactly the same "Failed to find a match" as a name that is absent. The
# retry is what tells those two apart, and it is the distinction the old code could
# not draw and reported as "not in repo".
#
# (The old loop also word-split `$miss`, turning `devel:libssl >= 3` into three
# "dependencies" and running `pkgman install >=` and `pkgman install 3`, silently
# failing both -- while the bare name got installed at whatever version was on offer.
# 95 of the 639 backlog logs contain such a requirement. build_one now iterates one
# requirement per LINE, so the relation reaches pkgman intact.)
install_dep() {
	_dreq="$1"
	_df="$DEPDIR/$(dep_slug "$_dreq")"
	# Stamp the requirement next to its transcript so the reader can prove the
	# transcript it is quoting belongs to the requirement it is reporting on.
	printf '%s\n' "$_dreq" > "$_df.req"
	feed | pkgman install "$_dreq" > "$_df.out" 2>&1
	_drc=$?
	echo "$_drc" > "$_df.rc"
	if [ "$_drc" -eq 0 ]; then
		if grep -q 'is already installed\.' "$_df.out" 2>/dev/null; then
			echo ALREADY_PRESENT > "$_df.verdict"
		else
			echo INSTALLED > "$_df.verdict"
		fi
	elif grep -q 'Failed to find a match for' "$_df.out" 2>/dev/null; then
		_dbase=$(dep_base "$_dreq")
		if [ "$_dbase" != "$_dreq" ]; then
			feed | pkgman install "$_dbase" > "$_df.bare.out" 2>&1
			if [ $? -eq 0 ]; then
				echo CONSTRAINT_UNSATISFIED > "$_df.verdict"
			else
				echo NO_MATCH > "$_df.verdict"
			fi
		else
			echo NO_MATCH > "$_df.verdict"
		fi
	else
		echo PKGMAN_ERROR > "$_df.verdict"
	fi
	return "$_drc"
}

# The interesting lines of a pkgman transcript, verbatim and bounded. pkgman puts its
# fatal line on stderr ("*** Failed to find a match for ...") and its solver problems
# on stdout ("Encountered problems:" / "problem 1: nothing provides ..."), which is why
# install_dep captures both streams into one file.
#
# The `grep -v` is not cosmetic. feed() answers every prompt with "1" sixty times
# before "yes", and "1" is not valid at a [yes/no] prompt -- so a perfectly successful
# install emits sixty `*** please enter 'yes' or 'no'` lines, which (being `***` lines)
# filled the whole excerpt on the first hardware run and pushed out the one line that
# mattered: `install package openssl3_devel-3.5.7-1 from repository DeBeOS`. An excerpt
# that crowds out the evidence is the same failure mode as discarding it.
dep_pkgman_said() {
	_pf="$1"
	[ -f "$_pf" ] || { echo "(no pkgman transcript)"; return 0; }
	_pl=$(grep -E '^\*\*\*|^Encountered problems|^problem [0-9]+:|^ +solution [0-9]+:|nothing provides|is already installed\.|^Nothing to do\.|conflict|install package |upgrade package ' \
		"$_pf" 2>/dev/null \
		| grep -vE "^\*\*\* please enter |^\*\*\* invalid input" \
		| head -n "${NB_DEP_SAID:-14}")
	if [ -n "$_pl" ]; then
		printf '%s\n' "$_pl"
	else
		tail -n "${NB_DEP_SAID_TAIL:-8}" "$_pf"
	fi
}

# READ-ONLY cross-check for a requirement pkgman could not match: does ANY configured
# repository carry a plausible provider at all? `pkgman search` matches
# case-INSENSITIVELY across name, summary and provides (B_FIND_CASE_INSENSITIVE |
# B_FIND_IN_NAME | B_FIND_IN_SUMMARY | B_FIND_IN_PROVIDES), while `pkgman install`
# matches provides case-SENSITIVELY. That asymmetry is exactly the point:
#   * search finds nothing either -> absence is now MEASURED, not assumed;
#   * search lists candidates     -> the failure is a name-form/case/ambiguity/version
#                                    problem and we must NOT call the dependency absent.
# It deliberately stops at listing candidates: search is a case-insensitive substring
# match over three fields, so a hit does not prove the resolvable is provided. It can
# refute absence; it cannot confirm presence, and it does not pretend to. This also
# keeps the multi-provider case honest -- `devel:liblua` is provided by several packages
# (five lua*_devel in the DeBeOS repo when this was measured; #485 counted eight in the
# green pool), and a list of candidates can never read as "absent".
dep_candidates() {
	pkgman search -D "$1" 2>&1 | head -n "${NB_DEP_CANDIDATES:-12}"
}

# Resolve a caller-supplied port arg to the actual haikuporter port name -- the
# recipe filename base -- rather than trusting the DDB/ports-tree directory name.
# See issue #53: upstream state-sync writes directory-style names (gdk-pixbuf,
# p11-kit, boost) but haikuporter keys off the recipe basename (gdk_pixbuf,
# p11_kit, boost1.90). Passing the directory name through makes haikuporter
# split on hyphens ('gdk not found') or miss version-suffixed variants
# ('boost not found in repository').
#
# Strategy, in order of preference:
#   1. exact <arg>-<ver>.recipe under any port dir
#   2. same with hyphens rewritten as underscores (gdk-pixbuf -> gdk_pixbuf)
#   3. any *.recipe *inside* the directory named <arg> or <arg-underscored>
#      (this catches multi-version ports where the dir is `boost` but the
#      recipes are `boost1.90-1.90.0.recipe`, `boost1.83-1.83.0.recipe`, ...)
# When multiple recipes match, `sort -V | tail -1` picks the newest by version.
# When nothing matches, echo the input untouched -- haikuporter will produce
# the real error and this stays a no-op on already-correct inputs (idempotent).
resolve_port_name() {
	arg="$1"
	alt=$(echo "$arg" | tr '-' '_')
	for cand in "$arg" "$alt"; do
		# recipe files matching <cand>-<version>.recipe under any port dir
		matches=$(cd "$HP" 2>/dev/null && ls -1 */"${cand}"-[0-9]*.recipe 2>/dev/null \
			| sed -E 's|.*/||; s|-[0-9][^/]*\.recipe$||' | sort -u)
		if [ -n "$matches" ]; then
			echo "$matches" | sort -V | tail -1
			return 0
		fi
	done
	for dir in "$arg" "$alt"; do
		[ -d "$HP/$dir" ] || continue
		matches=$(cd "$HP/$dir" 2>/dev/null && ls -1 *.recipe 2>/dev/null \
			| sed -E 's|-[0-9][^/]*\.recipe$||' | sort -u)
		if [ -n "$matches" ]; then
			echo "$matches" | sort -V | tail -1
			return 0
		fi
	done
	echo "$arg"
}

# The lexicon of lines that STATE A REASON for a failure, as one ERE. This is the
# same subject as `_REASON_ARMS` in graviton/scripts/haiku-triage-failures, and the
# two must stay in step for a reason that cost #505 a port: the classifier can only
# ever read what this grep decided to keep, so a wording the DETECTOR understands and
# this pattern does not is thrown away on the builder and is gone when it is reaped.
#
# MEASURED, and this is why the arms below were added (#505 §E). Of the 105 logs from
# the #492 re-wave, 89 carry a line the fixed detector reads as a reason -- and for 18
# of those 89 the pattern as it stood could not see that line:
#   becasso fasm sdljoytest     ld: ... error adding symbols / relocations in generic ELF
#   ffcall opensound pnet       make: *** No rule to make target '<file>'
#   libavlduptree slunkcrypt    make: *** No targets specified and no makefile found
#   helpviewer yoshi            unzip: cannot find/open "<archive>"
#   hwloc2                      objcopy: '<path>': No such file   (no "or directory")
#   intel/ralink/realtek_*_firmwares  [Errno -2147483643] Invalid Argument
#   libeditline                 ./configure: line N: syntax error near unexpected token
#   ne                          Can't locate <Module>.pm in @INC
#   privoxy                     id: 'user': no such user
#   timezone_data               ./zic: Can't link A to B: Operation not allowed
# Those 18 survived only because their logs fit under NB_LOG_FULL_LINES and were kept
# whole. `pnet` did not fit (416 720 lines) and its reason line was discarded -- the
# grep block it got back was two lines long, a checksum notice and make's cascade.
# ERE only (no \b, \d, \S): this is POSIX `grep -E` on Haiku, not PCRE.
NB_DIAG_RE='error:|Error [0-9]+|Error: |CMake Error|fatal error:|error adding symbols|relocations in generic ELF|cannot find -l|command not found|No rule to make target|No targets specified and no makefile found|\[Errno -?[0-9]+\]|syntax error near|Can.t locate [^[:space:]]* in @INC|cannot find/open|No such file|[Nn]o such user|undefined reference|multiple definition of|Permission denied|No space left|Operation not allowed|does not name a type|ModuleNotFoundError|No module named|Read-only file system|not supported|unsupported|unknown word-size|guess (build|host) type|required file .* not found|unable to resolve|could not be resolved|is not available, please install|prepareInstalledDevelLib|possibly undefined macro|narrowing conversion|CHECKSUM|checksum'

# Lines that match NB_DIAG_RE and still say nothing but "a step gave up", or that are
# printed by every run whether it failed or not. Used ONLY to pick WHICH match the
# first-error window centres on -- never to drop a line from the capture, so being
# wrong here costs context, not evidence.
#
# This is the mirror of `_CONTENTLESS_ARMS` in the classifier, and #505's lesson
# applies to it with full force: that arm was once documented "inert today", measured
# against the `tail -20` corpus, and on the deep corpus it ate three ports' entire
# diagnostic. "Inert" is a property of the CORPUS, not of the regex. So every arm here
# is one that says only that something stopped (make's exit-status recursion, its
# jobserver notice, collect2's summary, haikuporter's epilogue, our own verdict lines)
# or that a routine step ran (the two checksum notices, which appear in every log and
# are the reason `pnet`'s grep block opened with a line about a tarball). Each is
# asserted by the selftest, not asserted in this comment.
#
# The `PLEASE MOVE TO A TAG` arm was added after the fixed capture was run on a real
# builder: it is haikuporter's advice about RECIPE hygiene for a git source carrying no
# checksum, printed during the download, before anything is built, on success as much as
# on failure. It reaches NB_DIAG_RE through the `CHECKSUM` arm, and because it is printed
# near the TOP of the log it wins the "first match" race against the actual reason. On
# `libavlduptree` -- the fixture below -- it put the window on line 4 and left the real
# `No targets specified and no makefile found` at line 52 outside it. That is the git-
# sourced port class #505 §C has just made buildable, so it is worth an arm.
NB_NOISE_RE='^(make|gmake)(\[[0-9]+\])?: \*\*\* (\[[^]]*\] )?Error [0-9]+|^(make|gmake)(\[[0-9]+\])?: \*\*\* Waiting for unfinished jobs|^collect2: error: ld returned|^Error: Build has failed|^Validating checksum of|^Skipping checksum validation of|^[^[:space:]]*: FAILED, no missing-dep|^Warning: Command |^Warning: PLEASE MOVE TO A TAG'

# Emit a capture of the haikuporter log to STDOUT on failure. This is load-bearing
# for triage: run_ssm._wrapper gzips this process's stdout and uploads it as the
# S3 build log (log_url), so whatever we DON'T print here is lost when the scratch
# builder dies. An earlier `tail -20 "$log"` kept only the make/haikuporter
# cascade at the very end and threw away the TOP of the log, where the first
# compiler/configure/link error actually is -- which is why the pattern-miner
# found 35% of UNMATCHED logs were "truncated tail" with no root cause captured
# (#136/#90). We now keep enough to always carry the root error: the HEAD (early
# configure/arch errors), every diagnostic line anywhere in the log (grep -- the
# root error wherever it scrolled to), the WINDOW around the first such line, and
# the TAIL (the cascade + verdict).
# Bounded so a huge ninja build (llvm) doesn't balloon the uploaded log: the whole
# log when small, else head+window+grep+tail. All caps are env-overridable.
#
# WHY THE WINDOW EXISTS (#505 §E). head+grep+tail still lost a cause, and `pnet` is the
# worked example: 416 720 lines, so the middle 415 300 were discarded, and the single
# `grep -n` hit in them was make's cascade. Two defects, not one:
#   1. the lexicon was narrower than the detector's -- see NB_DIAG_RE; and
#   2. even where grep DID hit, it returned that one line and nothing around it, so the
#      command that produced the error, its arguments and its own output were dropped.
# A matched line on its own is frequently not a diagnosis. The window carries the
# context lines either side of the first match that is not NB_NOISE_RE, which is where
# the cause actually is when the matched line is a consequence.
#
# AND A WARNING FOR WHOEVER READS THE OUTPUT. Recovering a line is not diagnosing the
# failure. `pnet`'s recovered line is `make: *** No rule to make target 'cg_ainit.c'`,
# and that is a SYMPTOM: something that should have generated `cg_ainit.c` failed
# earlier. Reading it as the cause is the specific mistake #505 §E exists to prevent --
# which is why the window is labelled "first error window", not "root cause".
emit_log_capture() {
	f="$1"
	[ -f "$f" ] || { echo "(no log file $f)"; return 0; }
	lines=$(wc -l < "$f" 2>/dev/null | tr -d ' '); : "${lines:=0}"
	if [ "$lines" -le "${NB_LOG_FULL_LINES:-4000}" ]; then
		echo "---- full build log ($lines lines): $f ----"
		cat "$f"
		echo "---- end build log ----"
		return 0
	fi
	echo "---- build log HEAD (first ${NB_LOG_HEAD:-1200} of $lines lines): $f ----"
	head -n "${NB_LOG_HEAD:-1200}" "$f"
	emit_first_error_window "$f" "$lines"
	echo "---- diagnostic lines (grep; root cause wherever it scrolled to) ----"
	grep -nE "$NB_DIAG_RE" "$f" 2>/dev/null | head -n "${NB_LOG_GREP:-400}"
	echo "---- build log TAIL (last ${NB_LOG_TAIL:-200} lines) ----"
	tail -n "${NB_LOG_TAIL:-200}" "$f"
	echo "---- end build log ($lines lines total; head+window+grep+tail capture) ----"
}

# Print the NB_LOG_CTX lines either side of the FIRST reason line that is not just
# "something gave up". Line numbers are printed so the window can be placed in the
# original log. Only called on the bounded path -- on the whole-log path there is
# nothing to recover.
emit_first_error_window() {
	f="$1"
	lines="$2"
	ctx="${NB_LOG_CTX:-80}"
	# `grep -v` on the NUMBERED output, so a noise arm anchored at ^ still has to match
	# the line itself: strip the "N:" prefix for the test, keep it for the result.
	first=$(grep -nE "$NB_DIAG_RE" "$f" 2>/dev/null \
		| while IFS= read -r hit; do
			n=${hit%%:*}
			case "$n" in ''|*[!0-9]*) continue ;; esac
			printf '%s\n' "${hit#*:}" | grep -qE "$NB_NOISE_RE" && continue
			echo "$n"
			break
		done)
	case "$first" in
		''|*[!0-9]*)
			# Nothing but noise matched. Say so: an empty window and a window that was
			# never attempted are different findings, and #505's `ffcall` was read as
			# "the build emitted no reason" when the capture had simply dropped it.
			echo "---- first error window: NO non-boilerplate reason line in $lines lines ----"
			return 0 ;;
	esac
	from=$((first - ctx)); [ "$from" -lt 1 ] && from=1
	to=$((first + ctx))
	echo "---- first error window: lines $from-$to around the first reason line ($first) ----"
	echo "---- (this is the FIRST error, not necessarily the root cause -- read upwards) ----"
	sed -n "${from},${to}p" "$f" 2>/dev/null \
		| awk -v b="$from" '{ printf "%d:%s\n", NR + b - 1, $0 }'
	echo "---- end first error window ----"
}

# Report a round that made no progress. Everything printed here is either an
# OBSERVATION (the set did not shrink) or a quote from pkgman -- the two verdict lines
# at the end are the only interpretation, and each one names only what the evidence
# above it can distinguish (#485).
report_no_progress() {
	_port="$1"
	_miss="$2"
	_tally="$DEPDIR/_tally"
	: > "$_tally"
	echo "$_port: NO PROGRESS at attempt $attempt -- installing the missing set left it unchanged."
	echo "  unresolved requirement set, one per line, as haikuporter reported it:"
	printf '%s\n' "$_miss" | sed 's/^/    /'
	printf '%s\n' "$_miss" | while IFS= read -r _dep; do
		[ -n "$_dep" ] || continue
		_f="$DEPDIR/$(dep_slug "$_dep")"
		_v=NO_TRANSCRIPT
		if [ -f "$_f.verdict" ] \
			&& [ "$(cat "$_f.req" 2>/dev/null)" = "$_dep" ]; then
			_v=$(cat "$_f.verdict")
		fi
		echo "  requirement: $_dep"
		echo "    pkgman verdict: $_v (pkgman exit $(cat "$_f.rc" 2>/dev/null || echo '?'))"
		echo "    pkgman said, verbatim:"
		dep_pkgman_said "$_f.out" | sed 's/^/      /'
		if [ -f "$_f.bare.out" ]; then
			echo "    retried without the version relation ($(dep_base "$_dep")); pkgman said:"
			dep_pkgman_said "$_f.bare.out" | sed 's/^/      /'
		fi
		if [ "$_v" = NO_MATCH ]; then
			dep_candidates "$(dep_base "$_dep")" > "$_f.cand" 2>&1
			echo "    read-only candidate probe, case-insensitive (pkgman search -D $(dep_base "$_dep")):"
			sed 's/^/      /' "$_f.cand"
			if grep -q 'No matching packages found' "$_f.cand"; then
				_v=ABSENT_CONFIRMED
			else
				_v=NO_MATCH_BUT_CANDIDATES_EXIST
			fi
			echo "    verdict after the candidate probe: $_v"
		fi
		echo "$_v" >> "$_tally"
	done
	# Requirements can contain spaces ("devel:libssl >= 3"), so join them with "; ".
	_flat=$(printf '%s\n' "$_miss" | sed 's/[[:space:]]*$//' | tr '\n' ';' \
		| sed 's/;/; /g; s/; *$//')
	_kinds=$(sort -u "$_tally" 2>/dev/null | tr '\n' ',' | sed 's/,$//')
	# NB: `grep -c` prints its count and exits 1 when that count is zero, so it must
	# NOT be wrapped in `|| echo 0` -- that appends a second line and the arithmetic
	# test below then fails with "integer expression expected".
	_n=$(grep -c . "$_tally" 2>/dev/null); : "${_n:=0}"
	_absent=$(grep -c '^ABSENT_CONFIRMED$' "$_tally" 2>/dev/null); : "${_absent:=0}"
	if [ "$_n" -gt 0 ] && [ "$_absent" -eq "$_n" ]; then
		# The ONE case in which the historical wording is earned: pkgman itself
		# reported no match, and a case-insensitive search of every configured
		# repository offered no candidate either.
		echo "$_port: UNRESOLVABLE (measured: pkgman found no match and no repository"
		echo "  offers any candidate, case-insensitively) -- build and publish it first: $_flat"
	else
		# Deliberately NOT an absence claim, and deliberately not a new diagnosis
		# either: the verdict names what was observed per requirement and points at
		# the pkgman evidence above.
		echo "$_port: DEP_NO_PROGRESS [$_kinds] -- the requirement set did not shrink, and"
		echo "  pkgman did NOT report absence for all of it; per-requirement evidence above: $_flat"
	fi
}

# Did this port produce an hpkg? This predicate IS the success rule the file header
# states ("Success is asserted by the .hpkg EXISTING, never by an exit code"), so it is
# the one place that decides whether a build failed, and it has to agree with the SOP's
# §7 wording rather than with a guess about how versions are spelled.
#
# IT USED TO READ `"$GP/${port}"-[0-9]*.hpkg`, AND THAT DIGIT COST #505 A PORT. The glob
# demanded a numeral immediately after the dash, i.e. a numeric version. `cmake_haiku`'s
# version is `git`: haikuporter really built `cmake_haiku-git-4-arm64.hpkg` (14 465 B,
# still in the pool under hpkg/arm64-incoming/), this test did not match it, build_one
# returned 1, the driver exited rc=1, and the wave recorded `failed` for a package that
# had succeeded -- while `harvest` below, which globs `$GP/*.hpkg` with no such
# restriction, pushed the good hpkg to the pool regardless. A git-versioned port could
# therefore never be recorded built. `-*` matches any version spelling; the literal `-`
# still keeps `cmake_haiku` from being satisfied by a `cmake_haiku_tools-*` hpkg, which
# is the only thing the digit was protecting against.
have_hpkg() {
	ls "$GP/${1}"-*.hpkg >/dev/null 2>&1
}

build_one() {
	port="$1"
	log="/boot/home/nb-$port.log"
	echo "===== $port : start $(date -u +%FT%TZ) ====="
	rm -rf "$DEPDIR" 2>/dev/null
	mkdir -p "$DEPDIR" 2>/dev/null || true
	attempt=1
	prev_miss=""
	while [ "$attempt" -le "$MAX_ATTEMPTS" ]; do
		( cd "$HP" && haikuporter -y "$port" ) > "$log" 2>&1
		# success = an hpkg for this port now exists
		if have_hpkg "$port"; then
			echo "$port: BUILD_OK (attempt $attempt)"
			return 0
		fi
		# collect every resolvable haikuporter said it could not resolve
		miss=$(grep -oE '(build-requires|build-prerequires|requires) "[^"]+"' "$log" \
			| sed -E 's/.*"([^"]+)".*/\1/' | sort -u)
		if [ -z "$miss" ]; then
			echo "$port: FAILED, no missing-dep to install -- see $log"; emit_log_capture "$log"; return 1
		fi
		# If the unresolved set is identical to last round, the previous round of
		# installs made no progress. That is ALL this comparison establishes -- it is
		# an observation about our own loop, not a fact about the repository. What the
		# dependency's actual state is comes from pkgman's transcripts, which
		# report_no_progress reads back and quotes (#485). Stop now either way, rather
		# than burn the remaining rounds on the same no-op install.
		if [ "$miss" = "$prev_miss" ]; then
			report_no_progress "$port" "$miss"
			emit_log_capture "$log"
			return 1
		fi
		echo "$port: attempt $attempt installing: $(echo $miss | tr '\n' ' ')"
		prev_miss="$miss"
		# ONE REQUIREMENT PER LINE, never per word: `devel:libssl >= 3` is a single
		# requirement and libsolv accepts it whole, whereas word-splitting it asks
		# pkgman to install ">=" and "3" (#485). All per-install state lives in files
		# under $DEPDIR, so running the loop in a pipeline subshell is fine.
		printf '%s\n' "$miss" | while IFS= read -r d; do
			[ -n "$d" ] || continue
			install_dep "$d"
		done
		attempt=$((attempt + 1))
	done
	# The round cap, not a stall: every round reached here had an unresolved set that
	# DIFFERED from the previous round's, because an unchanged set returns above. So
	# this port was still making progress when it ran out of rounds (#486).
	echo "$port: gave up after $MAX_ATTEMPTS attempts (MAX_ATTEMPTS round cap, not a"
	echo "  stall: each round's unresolved set differed from the previous round's, which"
	echo "  is what the NO PROGRESS check above would otherwise have caught). Raise"
	echo "  MAX_ATTEMPTS and re-wave -- this is a driver limit, not a port defect."
	emit_log_capture "$log"; return 1
}

harvest() {
	# push every *.hpkg newer than the marker to the pool (never the build-input haiku*.hpkg)
	for f in "$GP"/*.hpkg; do
		[ -e "$f" ] || continue
		case "$(basename "$f")" in haiku.hpkg|haiku_*|haiku-*) continue ;; esac
		"$AGENT" s3 cp "$f" "$S3/$(basename "$f")" >/dev/null 2>&1 \
			&& echo "harvested $(basename "$f")"
	done
}

# Promote the sources of every port that built OK to the DeBeOS download mirror
# (issue #172), so a later wave whose primary upstream has since rotated can fall
# back to a live host instead of the dead ports-mirror.haiku-os.org default.
#
# WHY gated on a successful build, not on the fetch: haikuporter validates each
# source against the recipe's pinned CHECKSUM_SHA256 immediately after fetching;
# a mismatch aborts the build. So a port that produced an hpkg has, by
# construction, only checksum-verified files in its download/ dir -- we never
# upload an unverified/mismatching source to the mirror. (haikuporter also
# re-verifies whatever it fetches FROM the mirror, so this is belt-and-braces.)
#
# LAYOUT: haikuporter's fallback URI is "$DOWNLOAD_MIRROR/<recipeDir>/<basename>"
# where recipeDir = the port's directory name (HaikuPorter/Source.py). The port
# dir is $HP/<category>/<port>; we upload each download/ file under <port>/<file>,
# which is exactly that path. (Recipes that rename via SOURCE_FILENAME are rare;
# the on-disk name then differs from the URI basename haikuporter requests and
# that one file simply won't be found on the mirror -- upstream is still tried.)
mirror_sources() {
	[ -n "$MIRROR_S3" ] || return 0
	[ -n "$BUILT_OK" ] || return 0
	for port in $BUILT_OK; do
		# The recipe dir is $HP/<category>/<port>; find its download/ dir.
		for dd in "$HP"/*/"$port"/download; do
			[ -d "$dd" ] || continue
			for f in "$dd"/*; do
				[ -f "$f" ] || continue
				b=$(basename "$f")
				# Skip haikuporter's own bookkeeping files, only ship archives.
				case "$b" in .*|*.part|*.tmp) continue ;; esac
				if "$AGENT" s3 cp "$f" "$MIRROR_S3/$port/$b" >/dev/null 2>&1; then
					echo "mirrored $port/$b"
				else
					echo "mirror-store failed $port/$b (non-fatal)" >&2
				fi
			done
		done
	done
}

# Refresh the pkgman repo caches so deps published since this builder booted resolve
# (otherwise pkgman installs against a stale index).
#
# CORRECTED (#485). This comment used to claim "intermediate deps built THIS wave are
# resolved from the local packages/ dir, so keep each dep-chain on one builder". That
# is false for the install path used here, and the false comment is how the mistaken
# "not in repo" diagnosis survived: `install_dep` runs `pkgman install <name>`, which
# resolves only from the CONFIGURED REPOSITORIES. harvest() pushes freshly built hpkgs
# to an S3 staging prefix, not to the repo, and the repo index is rebuilt only by the
# separate haiku-repo-publish* step. A wave therefore cannot consume what it just
# built, by construction -- keeping a dep-chain on one builder does not help, and an
# intra-wave dependency edge fails however healthy the pool is. Either order the wave
# so dependencies are published before their consumers, or publish incrementally
# (still to be designed -- see #485).
feed | pkgman refresh >/dev/null 2>&1 || true

# Provenance stamp (#506): first meaningful line of every per-port log names the driver
# that produced it, so a wrong run is detectable retroactively from the log alone.
echo "===== haiku-nativebuild NATIVEBUILD_VERSION=$NATIVEBUILD_VERSION $(date -u +%FT%TZ) ====="

rc=0
for p in "$@"; do
	# Normalize directory-style input (gdk-pixbuf) to recipe-basename form
	# (gdk_pixbuf) before invoking haikuporter -- see resolve_port_name.
	resolved=$(resolve_port_name "$p")
	if [ "$resolved" != "$p" ]; then
		echo "resolved port name: $p -> $resolved"
	fi
	if build_one "$resolved"; then
		BUILT_OK="$BUILT_OK $resolved"
	else
		rc=1
	fi
done
harvest
mirror_sources
echo "===== nativebuild done $(date -u +%FT%TZ) rc=$rc ====="
exit $rc
