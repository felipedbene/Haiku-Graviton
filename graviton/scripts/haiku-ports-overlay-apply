#!/bin/sh
#
# haiku-ports-overlay-apply -- install the DeBeOS recipe overlay into a ports tree.
#
# RUNS ON a native Haiku arm64 builder (or anywhere with the tree on local disk).
#
# Why this exists: a builder gets its ports tree from a plain `git clone` of
# upstream HaikuPorts, which knows nothing about arm64 Haiku. Every arm64 recipe
# fix this project has made lives in graviton/haikuports-patches/ and was, until
# this script, applied BY HAND to one guest at a time -- so a freshly baked
# builder AMI, and therefore every build-wave builder launched from it, had NONE
# of them. Ports that this project has already fixed would fail again on a clean
# builder, which is the difference between a pipeline that can chew through the
# backlog and one that stalls on solved problems.
#
# What it installs, and what it deliberately does not:
#
#   * `recipes/*.recipe` -- COPIED OVER the tree's copy. These are complete recipe
#     files and are the overlay's source of truth (see recipes/README.md).
#   * `recipes/*.patchset` -- COPIED into the port's `patches/` dir, which is where
#     haikuporter looks for the file a recipe's PATCHES= line names. Installed only
#     alongside the matching recipe, so the pair moves as a unit.
#   * `*.patch` at the overlay root -- NOT applied. Those files are explanatory
#     notes, not inputs to patch(1): two of them do not parse at all, and none is
#     verified to apply to a pristine recipe. They document WHY a recipe in
#     recipes/ looks the way it does. Read them; apply the recipes.
#
# A recipe's tree location is found by BASENAME, not by port name, because the two
# disagree: llvm21-21.1.8.recipe lives in sys-devel/llvm/, not sys-devel/llvm21/.
# When the exact basename is absent (the overlay carries a version the tree does
# not), fall back to the directory holding that port's other versions, so a
# version bump lands beside its siblings rather than being silently skipped.
#
# Idempotent: re-running copies identical bytes over identical bytes. A recipe
# whose port directory cannot be located at all is reported and counted, never
# guessed at -- a misplaced recipe is invisible to haikuporter, which is exactly
# the silent-no-op failure this script exists to end.
#
# THE STAGE-1 EXCLUSION IS THE POINT OF THIS SCRIPT'S CARE.
#
# Some overlay recipes are deliberately FEATURE-CAPPED bootstrap expedients: they
# cut docs, use bundled libraries, or drop a build system to break a dependency
# cycle. graviton/haikuports-patches/README.md is explicit that "Stage-1 artifacts
# go to hpkg-out/arm64/stage1/, never to a shipping repo", and singles out cmake's
# bundled curl as security-relevant. A build-wave builder publishes to the shipping
# DeBeOS repo, so blanket-applying the overlay would ship capped packages -- exactly
# what the project's no-feature-cap rule forbids ("Never ship feature-capped builds
# -- fix the blocker", AGENTS.md; SOPs.md 2b.3).
#
# So stage-1 recipes are EXCLUDED by default and only installed with --stage1, which
# is for bootstrapping a toolchain, never for a publishing wave. The exclusion list
# is spelled out here rather than inferred: a capped recipe that leaks into a wave is
# not a build failure, it is a silently degraded package in the repo, and that is far
# more expensive than a skipped recipe.
#
# Usage:
#   haiku-ports-overlay-apply [--stage1] [<overlay-dir>] [<ports-tree>]
#     --stage1     ALSO install the feature-capped bootstrap recipes. Output of a
#                  builder running these must NOT be published to the shipping repo.
#     overlay-dir  default /boot/home/haikuports-patches
#     ports-tree   default /boot/home/haikuports
#
set -u

# Ports whose overlay recipe is a stage-1 expedient. Matched on the basename's port
# component, which covers every version of these ports on purpose -- verified by
# reading the recipes themselves rather than trusting the filenames:
#
#   autoconf-2.72  HTMLS emptied so install-html cannot invoke makeinfo (no docs)
#   cmake-4.1.6    bundled cmcurl/cmexpat/cmlibrhash/cmlibuv; bundled curl is the
#                  security-relevant one README.md says to keep out of shipping repos
#   zstd-1.5.6     upstream Makefile instead of cmake, to break the
#                  cmake -> libcurl -> openssl3 -> libzstd -> zstd cycle
#   zstd-1.5.7     SAME cap as 1.5.6 -- "find_package(zstd CONFIG) will not work".
#                  Version-scoping the denylist to 1.5.6 would have shipped this one.
#
# gettext-1.0 is NOT on this list. It used to be: the checked-in recipe still carried
# "STAGE-1 NOTE (graviton): cmd:groff removed from BUILD_PREREQUIRES" even though
# README.md's table marked that patch RETIRED 2026-08-24 with the line restored --
# a guest-side fix that was proven (RC=0) but never harvested back into the recipe
# file (issue #132). cmd:groff is restored in recipes/gettext-1.0.recipe, groff-1.23.0
# is confirmed published in the DeBeOS repo, so applying this recipe now ships nothing
# capped -- it is functionally the pristine recipe again.
STAGE1_PORTS="autoconf cmake zstd"

# Genuinely-new ports the overlay introduces that upstream HaikuPorts does NOT
# carry, so neither an exact-basename match nor a same-name sibling locates a
# directory for them. Each entry is `portname:category`; the recipe is dropped into
# a freshly created <category>/<portname>/ dir. Deliberately explicit -- recipes
# carry no CATEGORY field, and a guessed category is an invisible mis-file, exactly
# the silent-no-op this script exists to prevent. Keep it short: a flavor of an
# EXISTING port (ffmpeg_x264, llama_cpp_g3) does NOT belong here -- the flavor-prefix
# fallback below places it beside its base port, matching the tree's own
# llvm21-in-sys-devel/llvm and gcc_syslibs-in-sys-devel/gcc convention. Nor does a
# NEW VERSION SERIES of an existing port (ffmpeg7, icu78): the version-series
# fallback below finds the base port's directory, which is where the tree keeps
# every series of a port.
#
#   simde  dev-libs  -- header-only SIMD-intrinsics library (ARCHITECTURES=any),
#                       not in upstream HaikuPorts.
#   aom    media-libs -- the AV1 reference codec, authored from scratch for arm64
#                       (issue 337 / PR #383). Upstream media-libs/ carries dav1d and
#                       svt-av1 but no aom port of any version, so no sibling search
#                       can find it a home; it was unplaced from the day it landed.
NEW_PORT_DIRS="simde:dev-libs aom:media-libs"

WITH_STAGE1=0
if [ "${1:-}" = "--stage1" ]; then
	WITH_STAGE1=1
	shift
fi

OVERLAY="${1:-/boot/home/haikuports-patches}"
TREE="${2:-/boot/home/haikuports}"

[ -d "$OVERLAY/recipes" ] || { echo "overlay-apply: no $OVERLAY/recipes" >&2; exit 1; }
[ -d "$TREE" ] || { echo "overlay-apply: no ports tree at $TREE" >&2; exit 1; }

applied=0; placed=0; missing=0; skipped=0; patchsets=0

# Install the patchset that belongs to a recipe we just placed, if the overlay
# carries one, into <portdir>/patches/ -- where haikuporter looks for the file a
# recipe's PATCHES= line names.
#
# This is NOT the same thing as the `*.patch` files at the overlay ROOT, which are
# explanatory notes and stay unapplied (see the header). `recipes/*.patchset` are
# real patch(1) inputs. Most overlay recipes declare PATCHES= and get the file from
# the upstream tree's own patches/ dir, which the clone already provides; the few
# patchsets carried HERE are precisely the ones upstream cannot supply -- a flavor
# port with no upstream directory (ffmpeg_x264, llama_cpp_g3), or a port where this
# project added a PATCHES= line upstream does not have (libavif, issue 709).
#
# Omitting them was a silent-no-op of the exact kind this script exists to end: the
# pipeline's staging path already places patchsets correctly
# (graviton/pipeline/ops-lambdas/run_ssm.py), so the manual path disagreed with the
# automated one and a fix verified through a build wave would vanish on a
# hand-driven builder.
#
# Keyed off the recipe's own basename, so the pair is installed or skipped as a
# unit: a stage-1 recipe that was skipped never has its patchset placed either, and
# a patchset can never land next to a recipe that did not.
place_patchset() {
	_base=$1
	_dir=$2
	_ps="$OVERLAY/recipes/${_base%.recipe}.patchset"
	[ -f "$_ps" ] || return 0
	_psbase=$(basename "$_ps")
	mkdir -p "$_dir/patches"
	cp "$_ps" "$_dir/patches/$_psbase"
	echo "overlay-apply:   + $_dir/patches/$_psbase"
	patchsets=$((patchsets + 1))
}

# The syntax gate in the loop needs a real bash. Resolve it ONCE and degrade to a
# warning if there is none, rather than letting `bash -n` fail-to-run read as
# "every recipe is broken" and abort the whole overlay -- that would turn a missing
# interpreter into a dead builder. Haiku's base ships bash as its login shell, so
# the empty case is the unexpected one and says so.
RECIPE_SYNTAX_BASH=$(command -v bash 2>/dev/null || true)
if [ -z "$RECIPE_SYNTAX_BASH" ]; then
	echo "overlay-apply: WARNING no bash on PATH, so recipes are placed WITHOUT a" \
		"syntax check. haikuporter sources recipes with bash, so a recipe that" \
		"does not parse will fail on the builder instead of here." >&2
fi

for src in "$OVERLAY"/recipes/*.recipe; do
	[ -f "$src" ] || continue
	base=$(basename "$src")

	# Syntax gate. haikuporter SOURCES a recipe with bash, so a recipe that
	# does not parse is not a bad dependency declaration -- it is no recipe at
	# all: `Warning: skipping <port>, as the recipe is broken` followed by
	# `Error: No version of <port> can be built`, with the parse error pointing
	# into work-*/port.recipe rather than at anything in this repo.
	#
	# Measured, issue 702: gri-2.12.23.recipe carried a 21-line explanatory
	# comment block INSIDE the BUILD_REQUIRES="..." value. Inside double quotes
	# `#` is not a comment, so the block became literal resolvable content, and
	# an unpaired backtick in the quoted phrase "`tex.fmt'" opened a command
	# substitution that ran to end-of-file:
	#   port.recipe: line 96: unexpected EOF while looking for matching ``'
	# That shipped through a merge and sat in the overlay until a builder tried
	# to use it, which is precisely the failure mode this script exists to
	# prevent (see the header note on a misplaced recipe being invisible).
	#
	# FATAL, not a skip: placing a recipe that cannot be parsed is strictly
	# worse than leaving the tree's own copy alone, and silently leaving it
	# alone would be the #764 shape again -- a builder that is not what the
	# tracker says it is.
	if [ -n "$RECIPE_SYNTAX_BASH" ] && ! "$RECIPE_SYNTAX_BASH" -n "$src" 2>/dev/null; then
		echo "overlay-apply: FATAL $base does not parse as bash, so haikuporter" \
			"cannot source it and the port cannot be built at all:" >&2
		"$RECIPE_SYNTAX_BASH" -n "$src" 2>&1 | sed 's/^/overlay-apply:   /' >&2
		echo "overlay-apply:   (a '#' line inside a double-quoted value is NOT a" \
			"comment -- keep prose above the assignment)" >&2
		exit 1
	fi

	# Stage-1 gate, before anything touches the tree.
	portname=${base%-*}
	portname=${portname%.recipe}
	if [ "$WITH_STAGE1" -eq 0 ]; then
		is_stage1=0
		for s in $STAGE1_PORTS; do
			[ "$portname" = "$s" ] && is_stage1=1
		done
		if [ "$is_stage1" -eq 1 ]; then
			echo "overlay-apply: SKIP $base (stage-1 feature-capped; --stage1 to force)"
			skipped=$((skipped + 1))
			continue
		fi
	fi

	# 1) exact basename already in the tree -> overwrite in place.
	dst=$(find "$TREE" -name "$base" -not -path "*/work-*" 2>/dev/null | head -1)
	if [ -n "$dst" ]; then
		cp "$src" "$dst"
		echo "overlay-apply: updated $dst"
		applied=$((applied + 1))
		place_patchset "$base" "$(dirname "$dst")"
		continue
	fi

	# 2) otherwise place it beside the port's other versions. Strip the trailing
	# -<version> to get the port name; the tree dir is whatever holds a recipe
	# starting with that name.
	port=${base%-*}
	port=${port%.recipe}
	sibling=$(find "$TREE" -name "$port-*.recipe" -not -path "*/work-*" 2>/dev/null | head -1)
	if [ -n "$sibling" ]; then
		dir=$(dirname "$sibling")
		cp "$src" "$dir/$base"
		echo "overlay-apply: placed $dir/$base (new version)"
		placed=$((placed + 1))
		place_patchset "$base" "$dir"
		continue
	fi

	# 3) FLAVOR fallback: an ISA/codec flavor package (llama_cpp_g3, ffmpeg_x264)
	# has no directory of its own -- it lives beside its base port, the same way
	# llvm21 lives in sys-devel/llvm/ and gcc_syslibs in sys-devel/gcc/. Strip the
	# trailing _<component> from the port name and retry the sibling search, longest
	# base first, so llama_cpp_g3 -> llama_cpp and ffmpeg_x264 -> ffmpeg.
	flavor_base="$port"
	flavor_dir=""
	while [ "${flavor_base%_*}" != "$flavor_base" ]; do
		flavor_base=${flavor_base%_*}
		fsib=$(find "$TREE" -name "$flavor_base-*.recipe" -not -path "*/work-*" 2>/dev/null | head -1)
		if [ -n "$fsib" ]; then flavor_dir=$(dirname "$fsib"); break; fi
	done
	if [ -n "$flavor_dir" ]; then
		cp "$src" "$flavor_dir/$base"
		echo "overlay-apply: placed $flavor_dir/$base (flavor of $flavor_base)"
		placed=$((placed + 1))
		place_patchset "$base" "$flavor_dir"
		continue
	fi

	# 4) VERSION-SERIES fallback: a new major series of an existing port lives in
	# that port's directory, not in one of its own -- icu77-77.1.recipe sits in
	# dev-libs/icu/ exactly as llvm21-21.1.8.recipe sits in sys-devel/llvm/. Step 2
	# locates that directory only when the tree already carries the SAME series
	# number, which for a series upstream skipped (ffmpeg7 -- upstream has ffmpeg6
	# and ffmpeg8) or has not reached (icu78 -- upstream stops at icu77) it does not.
	# So strip the trailing numeric series off the port name and retry the sibling
	# search. Issue 734: without this, those two recipes were unplaceable, and since
	# an unplaced recipe is fatal below, the builder bake could not finish at all.
	#
	# This does not guess a category: the search pattern pins the found recipe's own
	# port component, so a hit is always a directory that demonstrably holds that base
	# port's recipes. The >= 3 char floor stops a mostly-numeric name (x264 -> "x")
	# from reaching for some unrelated short port. Deliberately AFTER the flavor
	# fallback, which must get first refusal on names like libgit2_1.9 (flavor base
	# libgit2 is right; a numeric strip would reach for "libgit").
	series_base="$port"
	while :; do
		case "$series_base" in
			*[0-9]|*.) series_base=${series_base%?} ;;
			*) break ;;
		esac
	done
	if [ "$series_base" != "$port" ] && [ ${#series_base} -ge 3 ]; then
		ssib=$(find "$TREE" -name "$series_base-*.recipe" -not -path "*/work-*" 2>/dev/null | head -1)
		if [ -n "$ssib" ]; then
			sdir=$(dirname "$ssib")
			cp "$src" "$sdir/$base"
			echo "overlay-apply: placed $sdir/$base (new $series_base version series)"
			placed=$((placed + 1))
			place_patchset "$base" "$sdir"
			continue
		fi
	fi

	# 5) genuinely-new port: create <category>/<portname>/ from the explicit
	# NEW_PORT_DIRS map. Only ports named there get a directory conjured -- an
	# unlisted unplaced recipe is still a hard failure (see below).
	newcat=""
	for m in $NEW_PORT_DIRS; do
		case "$m" in
			"$port:"*) newcat=${m#*:} ;;
		esac
	done
	if [ -n "$newcat" ]; then
		newdir="$TREE/$newcat/$port"
		mkdir -p "$newdir"
		cp "$src" "$newdir/$base"
		echo "overlay-apply: created $newdir/$base (new port)"
		placed=$((placed + 1))
		place_patchset "$base" "$newdir"
		continue
	fi

	echo "overlay-apply: WARNING no port directory found for $base -- NOT installed" >&2
	missing=$((missing + 1))
done

echo "overlay-apply: $applied updated, $placed placed, $patchsets patchset(s), $skipped stage-1 skipped, $missing unplaced"
[ "$WITH_STAGE1" -eq 1 ] && echo "overlay-apply: WARNING --stage1 used; do NOT publish this builder's output to the shipping repo" >&2
# Unplaced recipes are a real defect (the fix silently would not be used), so fail
# loudly rather than let a bake bake them away.
[ "$missing" -eq 0 ] || exit 1
