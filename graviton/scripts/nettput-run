#!/usr/bin/env bash
#
# nettput-run -- drive a throughput A/B across MTUs against a Haiku node.
#
# Runs ON the metal builder, which is both the peer for the transfers and the
# only host that can reach the Haiku node over ssh (corporate egress blocks :22
# from the workstation). It starts nettput-peer.py, then drives the Haiku side
# over ssh through the whole matrix and prints one table.
#
# The A/B is done by changing the MTU on a single running node rather than by
# baking two images. Same kernel, same driver, same boot, same instance, same
# credit balance -- so a difference in the result is the MTU and not the weather.
# It also exercises the MTU-down path on a live interface, which is where the
# ethernet_set_mtu underflow used to be.
#
# Each cell is repeated and the median reported: a single run on a shared virtual
# NIC tells you very little, and the mean would let one outlier tell the story.
#
# Usage: nettput-run <haiku-ip> [-n bytes] [-r reps] [-i iface] [-u user]

set -uo pipefail

PEER_SCRIPT="${PEER_SCRIPT:-/opt/haiku/nettput/nettput-peer.py}"
PEER_PORT="${PEER_PORT:-5301}"
KEY="${KEY:-/home/ubuntu/.ssh/haiku-ed25519}"
IFACE="/dev/net/ena/0"
BYTES="256M"
REPS=3
USERS="baron root user"
MTUS="9001 1500"

[ $# -ge 1 ] || { echo "usage: nettput-run <haiku-ip> [-n bytes] [-r reps] [-i iface] [-u user]" >&2; exit 1; }
HAIKU_IP="$1"; shift
while getopts "n:r:i:u:m:" opt; do
	case "$opt" in
		n) BYTES="$OPTARG" ;;
		r) REPS="$OPTARG" ;;
		i) IFACE="$OPTARG" ;;
		u) USERS="$OPTARG" ;;
		m) MTUS="$OPTARG" ;;
		*) exit 1 ;;
	esac
done

PEER_IP=$(ip -4 -o addr show scope global | awk '{print $4}' | cut -d/ -f1 | head -1)
echo "peer (this host): $PEER_IP    haiku node: $HAIKU_IP"

SSH_OPTS="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null
	-o ConnectTimeout=10 -o LogLevel=ERROR -i $KEY"

# ------------------------------------------------------------------ find a user
HAIKU_USER=""
for candidate in $USERS; do
	# -n matters: without it ssh consumes this loop's stdin. That bug once made a
	# perfectly healthy guest look dead.
	if timeout 20 ssh -n $SSH_OPTS "$candidate@$HAIKU_IP" true 2>/dev/null; then
		HAIKU_USER="$candidate"
		break
	fi
done
if [ -z "$HAIKU_USER" ]; then
	echo "FATAL: cannot ssh to $HAIKU_IP as any of: $USERS" >&2
	echo "  (node still booting, sshd down, or no intra-SG :22 rule)" >&2
	exit 1
fi
echo "ssh as: $HAIKU_USER"

hssh() { timeout 300 ssh -n $SSH_OPTS "$HAIKU_USER@$HAIKU_IP" "$@"; }

# ------------------------------------------------------------------- start peer
pkill -f "nettput-peer.py" 2>/dev/null
sleep 1
PEER_LOG=/tmp/nettput-peer.log
nohup python3 "$PEER_SCRIPT" -p "$PEER_PORT" > "$PEER_LOG" 2>&1 &
PEER_PID=$!
sleep 2
if ! kill -0 "$PEER_PID" 2>/dev/null; then
	echo "FATAL: peer failed to start:" >&2; cat "$PEER_LOG" >&2; exit 1
fi
echo "peer running as pid $PEER_PID on port $PEER_PORT"
trap 'kill "$PEER_PID" 2>/dev/null' EXIT

# ------------------------------------------------------------------ sanity gate
echo
echo "=== node state before ==="
hssh "ifconfig $IFACE" 2>&1 | head -12
echo "--- can the node reach the peer at all? ---"
if hssh "ping -c 2 $PEER_IP" 2>&1 | tail -3; then :; fi
# Haiku's minimum image has no `which`, so ask the binary itself. Its usage text
# goes to stdout on -h, which is enough to prove it is there and runnable.
echo "--- is nettput present in the image? ---"
if hssh "nettput -h" 2>&1 | grep -q "Usage: nettput"; then
	echo "  present"
else
	echo "FATAL: nettput is not in this image -- wrong AMI" >&2
	exit 1
fi

# ------------------------------------------------------------------- the matrix
RESULTS=/tmp/nettput-results.txt
: > "$RESULTS"

run_cell() {
	local mtu="$1" dir="$2" flag="$3" rep="$4"
	local out
	out=$(hssh "nettput -c $PEER_IP -p $PEER_PORT -n $BYTES $flag -L 'mtu $mtu'" 2>&1)
	local rate cost
	rate=$(printf '%s' "$out" | sed -n 's/.*throughput *: *\([0-9.]*\) Mbit.*/\1/p' | head -1)
	cost=$(printf '%s' "$out" | sed -n 's/.*cost per MiB *: *\([0-9.]*\) us.*/\1/p' | head -1)
	if [ -z "$rate" ]; then
		echo "  mtu $mtu $dir rep $rep: FAILED"
		printf '%s\n' "$out" | sed 's/^/      /' | tail -6
		return 1
	fi
	printf '  mtu %-5s %-8s rep %s: %8s Mbit/s   %8s us/MiB\n' \
		"$mtu" "$dir" "$rep" "$rate" "${cost:-n/a}"
	printf '%s %s %s %s\n' "$mtu" "$dir" "$rate" "${cost:-0}" >> "$RESULTS"
}

for mtu in $MTUS; do
	echo
	echo "=== MTU $mtu ==="
	hssh "ifconfig $IFACE mtu $mtu" 2>&1 | head -3
	sleep 3
	actual=$(hssh "ifconfig $IFACE" 2>&1 | sed -n 's/.*MTU: *\([0-9]*\).*/\1/p' | head -1)
	echo "  interface reports MTU: ${actual:-unknown}"
	if [ "${actual:-0}" != "$mtu" ]; then
		echo "  WARNING: asked for $mtu, interface reports ${actual:-unknown}"
		echo "  -- results for this row describe MTU ${actual:-unknown}, not $mtu"
	fi

	for rep in $(seq 1 "$REPS"); do
		run_cell "$mtu" "transmit" ""   "$rep"
		run_cell "$mtu" "receive"  "-r" "$rep"
	done
done

# ---------------------------------------------------------------------- summary
echo
echo "=== medians ==="
python3 - "$RESULTS" <<'PY'
import statistics, sys
from collections import defaultdict

rows = defaultdict(list)
with open(sys.argv[1]) as handle:
    for line in handle:
        parts = line.split()
        if len(parts) == 4:
            rows[(parts[0], parts[1])].append((float(parts[2]), float(parts[3])))

print("  %-6s %-9s %12s %14s" % ("mtu", "direction", "Mbit/s", "us of cpu/MiB"))
table = {}
for key in sorted(rows, key=lambda k: (-int(k[0]), k[1])):
    rates = [r for r, _ in rows[key]]
    costs = [c for _, c in rows[key] if c > 0]
    rate = statistics.median(rates)
    cost = statistics.median(costs) if costs else 0.0
    table[key] = (rate, cost)
    print("  %-6s %-9s %12.1f %14.0f" % (key[0], key[1], rate, cost))

# The comparison is the entire point, so state it rather than leaving it to be
# eyeballed -- and report rate and cost separately, because a larger MTU can
# leave the rate untouched while cutting the cost, and that still counts.
for direction in ("transmit", "receive"):
    hi, lo = ("9001", direction), ("1500", direction)
    if hi in table and lo in table:
        rate_hi, cost_hi = table[hi]
        rate_lo, cost_lo = table[lo]
        print()
        print("  %s: jumbo vs 1500" % direction)
        if rate_lo > 0:
            print("    rate      %.1f -> %.1f Mbit/s  (%+.1f%%)"
                  % (rate_lo, rate_hi, 100.0 * (rate_hi - rate_lo) / rate_lo))
        if cost_lo > 0 and cost_hi > 0:
            print("    cpu/MiB   %.0f -> %.0f us       (%+.1f%%)"
                  % (cost_lo, cost_hi, 100.0 * (cost_hi - cost_lo) / cost_lo))
            print("    per byte moved, jumbo costs %.2fx what 1500 costs"
                  % (cost_hi / cost_lo))
PY

# ------------------------------------------------------------------- aftermath
echo
echo "=== node state after (MTU restored to 9001) ==="
hssh "ifconfig $IFACE mtu 9001" >/dev/null 2>&1
sleep 2
hssh "ifconfig $IFACE" 2>&1 | head -12
echo
echo "--- driver complaints in the syslog, if any ---"
hssh "tail -n 400 /var/log/syslog | grep -i 'ena\|error\|reset' | tail -20" 2>&1
echo
echo "--- peer's own view (a large disagreement means undelivered buffering) ---"
tail -n 30 "$PEER_LOG"
