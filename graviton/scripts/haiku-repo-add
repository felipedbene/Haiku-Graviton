#!/usr/bin/env bash
#
# haiku-repo-add -- add one or more freshly-built .hpkg to the LIVE DeBeOS
# package repository, in place, and refresh the CDN. This is the automated,
# incremental counterpart to haiku-repo-publish (which rebuilds a repo from a
# whole pool): it pulls the current published repo, re-stamps only the NEW
# package(s) to vendor "DeBeOS", rebuilds the index over the full set, uploads
# the new package(s) + index, and invalidates the CloudFront index paths.
#
# It runs on a *Haiku host* (the dev AMI or a spun-up native Graviton builder)
# because `package` and `package_repo` are Haiku-build artifacts. Normally you do
# not run this by hand -- it is invoked from the publish host as part of the
# `haiku-repo-publish` flow. See that script and the SOP. (The former
# haiku-repo-publish-remote, which shipped this to the shared metal host over SSM,
# is retired -- that host no longer exists.)
#
# Why it exists: the DeBeOS repo is single-vendor (package_repo create refuses a
# set whose packages disagree with repo.info's vendor), so every hpkg is
# re-stamped to "DeBeOS". A package missing from the repo makes pkgman fall back
# to the baked, unreachable HaikuPorts-BuildPackages repo and fail
# "Resource not found" -- adding it here is the fix.
#
# Config (env only -- NO account-scoped names live in this tracked file):
#   HG_REPO_S3      s3://<bucket>/<prefix>/<arch>   the live repo prefix (required)
#   HG_INCOMING_S3  s3://<bucket>/<prefix>          new *.hpkg to add (required; consumed)
#   HG_CF_DIST      CloudFront distribution id to invalidate /<arch>/repo* (optional)
#   HG_REPO_URL     public base URL baked into repo.info (default packages.debene.dev)
#   HG_PUBLISHED_LIST_OUT  path to write the incoming basenames this run ACTUALLY
#                   published, one per line (optional; see "report what we
#                   published" below -- a caller that prunes a durable staging
#                   area after the add MUST drive it from this file, not from its
#                   own listing of what it offered)
#   HG_REQUIRE_PUBLISH_LOCK  1 => a missing haiku-publish-lock.sh is FATAL rather
#                   than a warning (set it on automated paths, where the library's
#                   absence is a packaging bug)
#   HAIKU_BUILD_SYSTEM_DATA_DIRECTORY  dir containing licenses/, for the re-stamp's
#                   license check off a Haiku host. RESOLVED AND SET HERE when unset
#                   (see "licenses directory" below, #502); validated either way
#   HG_ALLOW_NO_LICENSE_DIR  1 => proceed with NO usable licenses dir (only sane for
#                   a batch whose every package bundles its own licenses)
#   HG_STRICT_PARTIAL  1 => exit 2 when SOME packages published and some failed
#                   (default: exit 0 -- the publish did complete -- with a PARTIAL line)
#   ARCH            packaging arch (default arm64)
#   AWS_DEFAULT_REGION / AWS_REGION (default us-west-2)
#   PKG_TOOL / PACKAGE_REPO_TOOL   tool paths (auto-detected under /opt/haiku if unset)
#
# Exit status:
#   0  every offered package published (or some did and HG_STRICT_PARTIAL is unset)
#   1  a precondition failed, OR NOTHING published while packages were offered (#502)
#   2  partial publish and HG_STRICT_PARTIAL=1
#
set -euo pipefail

VENDOR="DeBeOS"
# Canonical DeBeOS packager. The pool must be single-packager as well as
# single-vendor (issue #41): packages built through the bootstrap/native path
# inherited assorted packager strings ("Haiku Graviton <graviton@haiku-os.org>",
# "DeBeOS <debeos@example.invalid>", ...), which misattribute DeBeOS-vended
# packages. Re-stamping the packager here, in the same metadata pass as the
# vendor, keeps every freshly-added package canonical so #41 does not regrow.
PACKAGER="${HG_PACKAGER:-DeBeOS <packages@debene.dev>}"
REPO_NAME="DeBeOS"
ARCH="${ARCH:-arm64}"
PKG_URL="${HG_REPO_URL:-http://packages.debene.dev/$ARCH}"
region="${AWS_DEFAULT_REGION:-${AWS_REGION:-us-west-2}}"

# The vendor+packager re-stamp (step 3) is METADATA-ONLY (issue #41/#164): it
# edits only the .PackageInfo and splices it back with `package add -f -i`, never
# unpacking a package's contents. So there is no decompression-bomb / ENOSPC
# exposure and the former #168 size guard -- which pre-flighted the whole-tree
# `package extract` -- is gone: a package's uncompressed size is irrelevant when
# its contents are never written out. See step 3 for why the old extract+create
# approach failed on the publisher's ext4.

die() { echo "haiku-repo-add: $*" >&2; exit 1; }
: "${HG_REPO_S3:?set HG_REPO_S3=s3://<bucket>/<prefix>/$ARCH}"
: "${HG_INCOMING_S3:?set HG_INCOMING_S3=s3://<bucket>/<prefix> (new *.hpkg)}"

# ---- locate the Haiku host tools -----------------------------------------
# On a native Haiku host `package`/`package_repo` are on PATH (/bin/...); on a
# Linux cross-build host they live under generated.$ARCH/objects/linux. Default
# to the PATH command, fall back to the Linux cross-build path, and accept
# either a bare command (resolved on PATH) or an absolute executable.
PKG_TOOL="${PKG_TOOL:-$(command -v package 2>/dev/null || ls /opt/haiku/haiku/generated.$ARCH/objects/linux/*/release/tools/package/package 2>/dev/null | head -1)}"
PACKAGE_REPO_TOOL="${PACKAGE_REPO_TOOL:-$(command -v package_repo 2>/dev/null || ls /opt/haiku/haiku/generated.$ARCH/objects/linux/*/release/tools/package_repo/package_repo 2>/dev/null | head -1)}"
have_tool() { command -v "$1" >/dev/null 2>&1 || [ -x "${1:-}" ]; }
have_tool "${PKG_TOOL:-}" || die "no 'package' tool (set PKG_TOOL; run on a Haiku host)"
have_tool "${PACKAGE_REPO_TOOL:-}" || die "no 'package_repo' tool (set PACKAGE_REPO_TOOL; run on a Haiku host)"

# ---- resolve the S3 / CloudFront client (#68) -----------------------------
# Bulk S3 + CloudFront used to force this whole script onto an Ubuntu peer with
# awscli. It now runs natively on Haiku by routing every `aws s3`/`aws cloudfront`
# call through `haiku-aws`, which prefers the native `debeos-aws` client and
# falls back to the stock `aws` when debeos-aws is absent (a Linux builder). The
# publish host ships haiku-aws beside this script; a Linux builder without it
# falls straight through to the stock `aws`. (Pin the debeos-aws-vs-aws backend
# via HG_AWS, which haiku-aws itself honours.)
HERE_RA="$(cd "$(dirname "$0")" 2>/dev/null && pwd || echo .)"
if [ -x "$HERE_RA/haiku-aws" ]; then
	AWS=("$HERE_RA/haiku-aws")
elif command -v haiku-aws >/dev/null 2>&1; then
	AWS=(haiku-aws)
else
	AWS=(aws)
fi

# ---- licenses directory for the metadata re-stamp (issue #502) -------------
# `package add` validates every name in the package's `licenses { ... }` list
# (src/kits/package/hpkg/PackageWriterImpl.cpp::_CheckLicenses): the name must
# either resolve under <system data dir>/licenses or be bundled in the package as
# data/licenses/<name>, else the whole add fails B_BAD_DATA with
# "License 'X' isn't contained in package!". Declaring a standard license without
# bundling a copy of it is normal and correct, so on a host where the system
# licenses directory does not resolve, perfectly good packages are rejected.
#
# On a Haiku host the tool calls find_directory(B_SYSTEM_DATA_DIRECTORY) and
# IGNORES the environment. Off Haiku (a Linux cross-build host, the CodeBuild
# publisher) the path is compiled in at build time, and the tool honours a
# HAIKU_BUILD_SYSTEM_DATA_DIRECTORY override. This script used to neither set nor
# check it, and golang-1.26.1-1-arm64 was lost to a bare `restamp-add-failed`
# whose real cause was discarded (#502).
#
# We SET it when it is unset and resolvable rather than merely demanding it: the
# tree ships data/system/data/licenses, the banked-tools layout ships data/licenses
# beside the tool, so on every host that can publish at all the answer is already
# to hand and making the operator type it buys nothing. What we do NOT do is run a
# license check that cannot work: whatever directory ends up in effect -- ours or
# the caller's -- is validated HERE, before the lock and before the pool is pulled,
# so an unusable one fails loudly up front instead of reappearing as a per-package
# skip after several GB of sync. HG_ALLOW_NO_LICENSE_DIR=1 is the escape hatch.
LICENSE_DIR_NOTE=""
if [ "$(uname -s 2>/dev/null || echo unknown)" = Haiku ]; then
	if [ -d /boot/system/data/licenses ]; then
		LICENSE_DIR_NOTE="/boot/system/data/licenses (native; find_directory, env ignored)"
	else
		echo "haiku-repo-add: WARNING: /boot/system/data/licenses is missing on this Haiku host -- the re-stamp will REJECT any package that declares a license it does not bundle (#502). HAIKU_BUILD_SYSTEM_DATA_DIRECTORY cannot help: the native tool ignores it." >&2
		LICENSE_DIR_NOTE="<missing: /boot/system/data/licenses>"
	fi
else
	_probed=""
	if [ -z "${HAIKU_BUILD_SYSTEM_DATA_DIRECTORY:-}" ]; then
		_pkg_dir="$(dirname "$(command -v "$PKG_TOOL" 2>/dev/null || echo "$PKG_TOOL")")"
		for cand in \
			"$HERE_RA/../../data/system/data" \
			"$_pkg_dir/data" \
			/opt/haiku-tools/data \
			/opt/haiku/haiku/data/system/data
		do
			_probed="$_probed $cand"
			[ -d "$cand/licenses" ] || continue
			HAIKU_BUILD_SYSTEM_DATA_DIRECTORY="$(cd "$cand" && pwd)"
			export HAIKU_BUILD_SYSTEM_DATA_DIRECTORY
			echo "haiku-repo-add: resolved HAIKU_BUILD_SYSTEM_DATA_DIRECTORY=$HAIKU_BUILD_SYSTEM_DATA_DIRECTORY (#502)"
			break
		done
	fi
	if [ -n "${HAIKU_BUILD_SYSTEM_DATA_DIRECTORY:-}" ] \
		&& [ -d "${HAIKU_BUILD_SYSTEM_DATA_DIRECTORY}/licenses" ]; then
		LICENSE_DIR_NOTE="$HAIKU_BUILD_SYSTEM_DATA_DIRECTORY/licenses"
	elif [ "${HG_ALLOW_NO_LICENSE_DIR:-0}" = 1 ]; then
		echo "haiku-repo-add: WARNING: no usable licenses directory (HAIKU_BUILD_SYSTEM_DATA_DIRECTORY=${HAIKU_BUILD_SYSTEM_DATA_DIRECTORY:-<unset>}) and HG_ALLOW_NO_LICENSE_DIR=1 -- every package that declares a license it does not bundle WILL be skipped (#502)" >&2
		LICENSE_DIR_NOTE="<none; HG_ALLOW_NO_LICENSE_DIR=1>"
	else
		if [ -n "${HAIKU_BUILD_SYSTEM_DATA_DIRECTORY:-}" ]; then
			_why="HAIKU_BUILD_SYSTEM_DATA_DIRECTORY=$HAIKU_BUILD_SYSTEM_DATA_DIRECTORY has no licenses/ subdirectory (set by the caller, so it was used as given and NOT second-guessed)"
		else
			_why="HAIKU_BUILD_SYSTEM_DATA_DIRECTORY is unset and no fallback has a licenses/ subdirectory (probed:$_probed)"
		fi
		die "no licenses directory for the metadata re-stamp (#502): $_why. Point HAIKU_BUILD_SYSTEM_DATA_DIRECTORY at a directory containing licenses/ -- the DeBeOS tree ships data/system/data -- or set HG_ALLOW_NO_LICENSE_DIR=1 if every package in this batch bundles its own licenses. Failing here, before the lock and the pool sync, rather than skipping packages one by one later."
	fi
fi
echo "haiku-repo-add: license check against $LICENSE_DIR_NOTE"

WORK="$(mktemp -d)"; RO="$WORK/repo-out"
trap 'rm -rf "$WORK"' EXIT
mkdir -p "$RO/packages" "$WORK/incoming"

# ---- publish concurrency lock (#164) --------------------------------------
# Everything from "pull the current pool" (step 1) through the index upload
# (step 5) is one read-modify-write critical section on the live repo. Two of
# these running against the same prefix clobber each other: the second
# `s3 sync --delete` mirrors its stale pool view over the first's, stranding the
# packages the first just added. Hold an S3-object advisory lock beside the repo
# for the whole section so a second publisher waits (or aborts) instead. The lock
# lib installs its own EXIT trap; fold the WORK cleanup back into a combined trap
# so both run on exit. Sourced from beside this script; it uses the same ${AWS[@]}
# client, so it works on a Haiku box (debeos-aws) and a Linux builder (aws) alike.
HERE_LOCK="$(cd "$(dirname "$0")" 2>/dev/null && pwd || echo .)"
if [ -f "$HERE_LOCK/haiku-publish-lock.sh" ]; then
	. "$HERE_LOCK/haiku-publish-lock.sh"
	publish_lock_acquire || die "could not acquire the publish lock (rc=$?); another publisher holds $HG_REPO_S3 -- refusing to clobber it"
	trap 'publish_lock_release; rm -rf "$WORK"' EXIT
elif [ "${HG_REQUIRE_PUBLISH_LOCK:-0}" = 1 ]; then
	# Automated callers (the pipeline publish job, the blue->green promote) bank the
	# lock library beside this script deliberately, so on those paths a missing
	# library is a PACKAGING bug -- and degrading to an unlocked publish of the live
	# pool is the one outcome the #164 lock exists to prevent. Issue #453: the
	# pipeline publish had been printing the warning below on every run, unnoticed,
	# because nothing failed. Fail instead, and fail where the cause is obvious.
	die "haiku-publish-lock.sh not found beside this script ($HERE_LOCK) and HG_REQUIRE_PUBLISH_LOCK=1 -- refusing to publish WITHOUT the #164 concurrency lock"
else
	# Left non-fatal for the by-hand case (an operator running a copy of this file
	# from somewhere odd); set HG_REQUIRE_PUBLISH_LOCK=1 to make it fatal.
	echo "haiku-repo-add: WARNING: haiku-publish-lock.sh not found beside this script -- publishing WITHOUT the #164 concurrency lock" >&2
fi

# ---- report the set we ACTUALLY publish (issue #452) ----------------------
# A caller that prunes a DURABLE staging area after a successful add must prune
# the set this script published, not the set it offered: step 3 below SKIPS a
# package whose metadata cannot be read or re-stamped (unreadable-hpkg,
# restamp-extract-failed, restamp-add-failed), and such a package never enters
# the repo. The pipeline publish pruned its harvest from its own listing of the
# incoming snapshot, so a skipped package had its only copy deleted while the
# repo never gained it -- silently losing build output. Truncate the file NOW so
# a stale list from an earlier step can never be mistaken for this run's result,
# including on the "everything was skipped" exit below, which publishes nothing.
if [ -n "${HG_PUBLISHED_LIST_OUT:-}" ]; then
	: > "$HG_PUBLISHED_LIST_OUT" \
		|| die "cannot write HG_PUBLISHED_LIST_OUT=$HG_PUBLISHED_LIST_OUT"
fi

echo "== 1. pull current repo packages from $HG_REPO_S3/packages/ =="
"${AWS[@]}" s3 sync "${HG_REPO_S3%/}/packages/" "$RO/packages/" --region "$region" --only-show-errors
before="$(ls -1 "$RO/packages" 2>/dev/null | wc -l)"
echo "   $before package(s) currently published"

echo "== 2. pull incoming new packages from $HG_INCOMING_S3 =="
"${AWS[@]}" s3 sync "${HG_INCOMING_S3%/}/" "$WORK/incoming/" --region "$region" --only-show-errors --exclude "*" --include "*.hpkg"
ls "$WORK/incoming"/*.hpkg >/dev/null 2>&1 || die "no incoming *.hpkg at $HG_INCOMING_S3"

# canonical repo filename for an hpkg: <name>-<version>-<architecture>.hpkg,
# independent of whatever the incoming file happened to be called. Staging under
# the canonical name (overwriting) makes re-publishing idempotent and prevents
# the "package <x> has already been added!" duplicate that a differently-named
# copy of an already-published package would otherwise cause.
canonical_name() {
	"$PKG_TOOL" list -i "$1" 2>/dev/null | awk '
		/^[[:space:]]*name:/         {n=$2}
		/^[[:space:]]*version:/      {v=$2}
		/^[[:space:]]*architecture:/ {a=$2}
		END { if (n && v && a) printf "%s-%s-%s.hpkg", n, v, a }'
}

echo "== 3. re-stamp incoming to vendor $VENDOR + packager $PACKAGER and stage under canonical names =="
added=0
skipped=0
dup=0
skipped_list=""
# How many packages this run was ASKED to publish. The final accounting checks
# added + skipped + dup == offered, so a package can never fall out of the report
# unnoticed, and "published nothing" cannot be reported as success (#502).
offered="$(ls -1 "$WORK/incoming"/*.hpkg 2>/dev/null | wc -l | tr -d ' ')"
SKIPS="$WORK/skips"; : > "$SKIPS"
# Canonical names staged SO FAR this run, one per line. `added` must count
# canonical names, not incoming files: two incoming files can resolve to the same
# canonical name (an upstream build that emitted the package twice), and the
# second `mv` below would silently OVERWRITE the first while both were counted --
# "PUBLISHED 2 ... repo now has 1", a number that contradicts the repo, and a
# duplicate input passing in silence (#509). Dedupe here and WARN on a collision.
SEEN_CANON="$WORK/seen.canon"; : > "$SEEN_CANON"

# ---- surface what the TOOL said, verbatim (issue #502) --------------------
# The defect #502 records is not a missing environment variable: it is that this
# script ran a tool with `>/dev/null 2>&1`, then printed a reason code of its own
# invention ("restamp-add-failed") in place of the diagnosis the tool had already
# written. `package add` said "License 'BSD (3-clause)' isn't contained in
# package!" -- an exact, actionable sentence -- and it was thrown away, so the
# cause took a by-hand re-run to recover. Every tool invocation in this loop now
# keeps its stderr (and stdout) and replays it, unedited and attributed, beside
# the skip. Our reason codes stay, because callers grep them, but they are now a
# LABEL on the tool's message rather than a substitute for it.
tool_said() {
	local what="$1"; shift
	local any=0 f
	for f in "$@"; do
		[ -s "$f" ] || continue
		any=1
		sed -e "s|^|       $what: |" "$f" >&2
	done
	[ "$any" = 1 ] || echo "       $what: (said nothing)" >&2
}

# The one skip cause that is a HOST configuration problem rather than a bad
# package gets a line the operator can act on directly.
license_hint() {
	grep -q "isn't contained in package" "$1" 2>/dev/null || return 0
	echo "       HINT: that license is neither bundled in the package nor present in the licenses directory in use ($LICENSE_DIR_NOTE). Point HAIKU_BUILD_SYSTEM_DATA_DIRECTORY at a directory containing licenses/ -- the DeBeOS tree ships data/system/data -- and re-run (#502)." >&2
}

# Record a skip once, in one place: the counter, the human list, and the machine
# readable reason+message replayed in the final summary.
note_skip() {
	skipped=$((skipped + 1))
	skipped_list="$skipped_list $1"
	printf '%s\t%s\t%s\n' "$1" "$2" "${3:-}" >> "$SKIPS"
}

first_line() { [ -s "$1" ] && head -1 "$1" || echo ""; }

# heap_compression is a big-endian uint16 at offset 18 of the hpkg header
# (headers/os/package/hpkg/HPKGDefs.h; 0 = none, 1 = zlib, 2 = zstd). The
# re-stamp is supposed to leave the heap alone -- measured on golang-1.26.1,
# where original and re-stamped headers both read heap_compression=1 -- and it
# MATTERS that it does: a package silently converted to zstd installs fine on a
# full image and fails on the lean base, which has no zstd reader. So the one
# configuration we actually ship is the one such a regression would break, and it
# would not show up on the machine doing the re-stamp. Reading two bytes with od
# costs nothing, so compare them.
hpkg_heap_compression() {
	local hex
	hex="$(od -An -tx1 -j18 -N2 "$1" 2>/dev/null | tr -d ' \n')" || return 1
	case "$hex" in
		[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]) printf '%d\n' "$((0x$hex))" ;;
		*) return 1 ;;
	esac
}
# One published incoming basename per LINE, rather than the former space-joined
# string: this is the set reported to HG_PUBLISHED_LIST_OUT (#452) and a delete
# candidate list must not depend on word-splitting to be read back correctly.
PUBLISHED_BASES="$WORK/published.bases"
: > "$PUBLISHED_BASES"
for f in "$WORK/incoming"/*.hpkg; do
	base="$(basename "$f")"
	# Read the package's info ONCE, and treat an unreadable package the same way
	# the re-stamp failures below do: skip it, name it, keep going. This used to
	# be two `package list -i ... 2>/dev/null | sed` pipelines, which under
	# `set -euo pipefail` aborted the ENTIRE batch the moment one package failed
	# to parse -- and silently, because the tool's diagnosis went to /dev/null.
	# One truncated hpkg in the harvest (a half-finished upload) therefore blocked
	# every publish with no indication of which package or why. The tool's own
	# message is now surfaced.
	if ! info="$("$PKG_TOOL" list -i "$f" 2>"$WORK/list.err")"; then
		echo "   ! SKIP $base: package list -i failed (unreadable-hpkg); the tool said:" >&2
		tool_said "package list" "$WORK/list.err"
		note_skip "$base" unreadable-hpkg "$(first_line "$WORK/list.err")"
		continue
	fi
	cur="$(printf '%s\n' "$info" | sed -nE 's/^[[:space:]]*vendor:[[:space:]]*"?([^"]*)"?[[:space:]]*$/\1/p' | head -1)"
	cur_packager="$(printf '%s\n' "$info" | sed -nE 's/^[[:space:]]*packager:[[:space:]]*"?(.*[^"])"?[[:space:]]*$/\1/p' | head -1)"
	# Always stage a plain copy first; any re-stamp then edits the copy IN PLACE.
	# A copy is cheap and carries NO ENOSPC risk regardless of the package's
	# uncompressed size, so there is no size guard to trip.
	staged="$WORK/staged.hpkg"; rm -f "$staged"
	cp -p "$f" "$staged"
	if [ "$cur" = "$VENDOR" ] && [ "$cur_packager" = "$PACKAGER" ]; then
		# Already canonical (vendor AND packager): the staged copy is final.
		:
	else
		# METADATA-ONLY re-stamp (issue #41/#164): extract ONLY the .PackageInfo,
		# edit the vendor + packager fields, and splice it back with
		# `package add -f -i`, which rewrites just the package's info attribute
		# WITHOUT round-tripping any file contents. This mirrors
		# haiku-repo-restamp-packager (#285).
		#
		# The former approach -- `package extract` (whole tree) + `package create`
		# -- wrote every entry's BeOS attributes onto the publisher's ext4 and
		# FAILED there: setting a user xattr on a symlink is EPERM, and a large
		# icon attribute overflows ext4's xattr block ("No space left on device").
		# instead-3.5.0-1-arm64 failed exactly this way (restamp-extract-failed)
		# even at a 100 GiB root -- it is the extract, not the disk size. Extracting
		# only the .PackageInfo touches none of those attributed entries.
		tmp="$(mktemp -d -p "$WORK")"
		# `package extract ... .PackageInfo` may exit non-zero after writing the
		# file (it also touches a later entry's attribute), so gate on the file
		# existing, not on the exit code. A genuine failure is escalated for this
		# one package (skip+report) rather than aborting the batch under `set -e`.
		"$PKG_TOOL" extract -C "$tmp" "$staged" .PackageInfo \
			>"$WORK/extract.out" 2>"$WORK/extract.err" || true
		if [ ! -f "$tmp/.PackageInfo" ]; then
			echo "   ! SKIP $base: could not extract .PackageInfo (restamp-extract-failed); the tool said:" >&2
			tool_said "package extract" "$WORK/extract.err" "$WORK/extract.out"
			rm -rf "$tmp"
			note_skip "$base" restamp-extract-failed "$(first_line "$WORK/extract.err")"
			continue
		fi
		if grep -qE '^[[:space:]]*vendor[[:space:]]' "$tmp/.PackageInfo"; then
			sed -i -E "s/^([[:space:]]*vendor[[:space:]]+).*/\1\"$VENDOR\"/" "$tmp/.PackageInfo"
		else
			printf '\nvendor\t"%s"\n' "$VENDOR" >> "$tmp/.PackageInfo"
		fi
		# Normalise the packager in the same pass (#41). PACKAGER may contain & and
		# / so use a non-/ sed delimiter.
		if grep -qE '^[[:space:]]*packager[[:space:]]' "$tmp/.PackageInfo"; then
			sed -i -E "s|^([[:space:]]*packager[[:space:]]+).*|\1\"$PACKAGER\"|" "$tmp/.PackageInfo"
		else
			printf '\npackager\t"%s"\n' "$PACKAGER" >> "$tmp/.PackageInfo"
		fi
		# Splice the edited .PackageInfo back into the staged copy in place.
		comp_before="$(hpkg_heap_compression "$staged" || echo "")"
		# `|| rc=$?` rather than `if ! ...`: inside an `if !` branch $? is the
		# NEGATED status (always 0), so the tool's real exit code has to be taken
		# here. Reporting the status a tool actually returned is the other half of
		# not discarding what it said.
		rc=0
		"$PKG_TOOL" add -f -q -i "$tmp/.PackageInfo" -C "$tmp" "$staged" .PackageInfo \
			>"$WORK/add.out" 2>"$WORK/add.err" || rc=$?
		if [ "$rc" -ne 0 ]; then
			echo "   ! SKIP $base: package add (metadata re-stamp) failed rc=$rc (restamp-add-failed); the tool said:" >&2
			tool_said "package add" "$WORK/add.err" "$WORK/add.out"
			license_hint "$WORK/add.err"
			rm -rf "$tmp"
			note_skip "$base" restamp-add-failed "$(first_line "$WORK/add.err")"
			continue
		fi
		rm -rf "$tmp"
		# Heap compression must survive a METADATA-only re-stamp; see
		# hpkg_heap_compression above for why a silent zstd conversion would only
		# break the configuration we ship. Refuse to publish a package whose heap
		# encoding changed under us.
		comp_after="$(hpkg_heap_compression "$staged" || echo "")"
		if [ -n "$comp_before" ] && [ -n "$comp_after" ] && [ "$comp_before" != "$comp_after" ]; then
			echo "   ! SKIP $base: re-stamp CHANGED heap_compression $comp_before -> $comp_after (restamp-compression-changed); 1=zlib, 2=zstd -- a zstd heap installs on a full image and FAILS on the lean base, so this package is not published" >&2
			note_skip "$base" restamp-compression-changed "heap_compression $comp_before -> $comp_after"
			rm -f "$staged"
			continue
		fi
		if [ -z "$comp_before" ] || [ -z "$comp_after" ]; then
			echo "   note: could not read heap_compression for $base (od unavailable?) -- compression-preservation UNCHECKED for this package" >&2
		fi
	fi
	# `|| true` so a failing `package list` inside canonical_name cannot abort the
	# batch through `set -e` before the explicit diagnosis below can run.
	canon="$(canonical_name "$staged" || true)"
	[ -n "$canon" ] || die "could not derive canonical name for $base"
	# Dedupe by CANONICAL NAME, not by incoming filename (#509). If an earlier
	# incoming file in THIS run already staged this canonical name, the two files
	# are the same published package: counting both as `added` prints a total that
	# contradicts the repo, and a duplicate input -- usually an upstream build that
	# emitted the package twice -- would pass in silence. Keep the copy already
	# staged (first wins, deterministically), count the canonical name once, and
	# WARN so the duplicate is surfaced. The base is still reported as published so
	# the caller's prune removes BOTH harvest copies from incoming; either copy is
	# a legitimate delete candidate, being the same published package.
	if grep -qxF "$canon" "$SEEN_CANON"; then
		echo "   ! DUPLICATE $base: canonical name '$canon' was already published this run by an earlier incoming file -- the copies collapse to one repo entry (duplicate-canonical). Two incoming files for one canonical name usually mean an upstream build produced the package twice; check the harvest. Counting it once, keeping the copy already staged." >&2
		dup=$((dup + 1))
		printf '%s\n' "$base" >> "$PUBLISHED_BASES"
		rm -f "$staged"
		continue
	fi
	printf '%s\n' "$canon" >> "$SEEN_CANON"
	# Drop any other on-disk version of the same package name so the repo does
	# not accumulate stale versions of a package we are (re)publishing.
	pkgname="${canon%%-*}"
	find "$RO/packages" -maxdepth 1 -name "$pkgname-*.hpkg" ! -name "$canon" -delete 2>/dev/null || true
	mv -f "$staged" "$RO/packages/$canon"
	echo "   + $canon (from '$base', vendor '$cur' -> '$VENDOR', packager '$cur_packager' -> '$PACKAGER')"
	added=$((added + 1))
	printf '%s\n' "$base" >> "$PUBLISHED_BASES"
done

if [ "$skipped" -gt 0 ]; then
	echo "   NOTE: skipped $skipped package(s), left in incoming for human handling:$skipped_list" >&2
fi

# Replay every skip with the tool's own first line, compactly, at the end of the
# run: the per-package output above is thousands of lines back in a wave log.
print_skip_summary() {
	local b reason msg
	while IFS="$(printf '\t')" read -r b reason msg; do
		[ -n "$b" ] || continue
		echo "   FAILED $b [$reason]${msg:+: $msg}" >&2
	done < "$SKIPS"
}

# ---- account for every package we were asked to publish (issue #502/#509) --
# Totality first: a package is either staged (added), collapsed onto a canonical
# name already staged this run (dup, #509), or skipped WITH a recorded reason. If
# those do not sum to what was offered, the report is wrong in a way we cannot
# characterise, which is the whole family of bug this guard exists for -- so say
# so and fail rather than print a number nobody can trust.
if [ $((added + skipped + dup)) -ne "$offered" ]; then
	die "internal accounting error: offered $offered package(s), counted $added added + $skipped skipped + $dup duplicate -- refusing to report a result that does not add up"
fi
if [ "$added" -eq 0 ]; then
	# EVERY package this run was asked to publish failed. There is no "nothing to
	# do" case to confuse this with: step 2 dies when incoming holds no *.hpkg, and
	# the totality check above proves each offered package was either added or
	# skipped -- so added == 0 with offered > 0 means the batch published NOTHING it
	# was asked to. That used to exit 0 and print "Repo unchanged", which is how
	# #502 stayed invisible for 30 minutes: an operator (and an automated caller)
	# read a green publish over an empty one. Nothing about the repo changes here --
	# no index rebuild, no upload, no invalidation, and the packages stay in
	# incoming, so this still fails CLOSED. Only the report changes, and it is now
	# a failure, because that is what it is.
	echo "PUBLISH FAILED: 0 of $offered offered package(s) published; all $skipped failed. The repo is UNCHANGED and every package is still in $HG_INCOMING_S3." >&2
	print_skip_summary
	exit 1
fi

echo "== 4. rebuild repo.info + index over $(ls -1 "$RO/packages" | wc -l) package(s) =="
cat > "$RO/repo.info" <<EOF
name $REPO_NAME
vendor "$VENDOR"
summary "DeBeOS package repository ($ARCH)"
priority 1
url $PKG_URL
architecture $ARCH
EOF
( cd "$RO" && "$PACKAGE_REPO_TOOL" create repo.info packages/*.hpkg )
[ -f "$RO/repo" ] || die "package_repo produced no 'repo' index"
( cd "$RO" && sha256sum repo | awk '{print $1}' > repo.sha256 )
echo "   index sha256=$(cat "$RO/repo.sha256")"

echo "== 5. upload packages (new, immutable) then index (last) =="
# --delete mirrors the local set, which is authoritative: step 1 pulled the
# ENTIRE published packages/ set, and step 3 only added the new canonical name(s)
# and dropped superseded versions of the same package. Without --delete a version
# bump (e.g. rust_bin -2 -> -3) leaves the old hpkg orphaned in S3. That orphan
# is NOT harmless: `package_repo create packages/*.hpkg` refuses a pool holding two
# versions of the same package, so a later full-pool index rebuild FAILS on the
# duplicate (this bricked the #268 haiku_devel republish: libsdl3 3.2.28-2 + 3.4.16-1
# both present -> "package libsdl3 has already been added!"). --delete keeps S3 ==
# the local (pruned) set so full rebuilds never see duplicates. Requires
# s3:DeleteObject on the repo bucket, granted to the publisher role in the CDK
# (DebeosOpsStack BuilderRole, PR #273).
"${AWS[@]}" s3 sync "$RO/packages/" "${HG_REPO_S3%/}/packages/" --region "$region" --only-show-errors --delete
for k in repo repo.info repo.sha256; do
	"${AWS[@]}" s3 cp "$RO/$k" "${HG_REPO_S3%/}/$k" --region "$region" --only-show-errors
done

# The published set is durable in the repo only now -- packages mirrored AND the
# index that references them uploaded -- so this is the first point at which it is
# safe for a caller to drop its own copies (issue #452). Written here rather than
# beside the counter in step 3 so the file can never name a package that was
# staged locally but not uploaded.
if [ -n "${HG_PUBLISHED_LIST_OUT:-}" ]; then
	# Non-fatal, for the same reason the caller's prune is non-fatal: the publish is
	# already COMPLETE here, and reporting a completed publish as FAILED sinks a
	# wave's publish leg over bookkeeping. A short write is safe by construction --
	# any prefix of this file is a SUBSET of what was published, so a caller can
	# only ever prune too little, never too much.
	if cp "$PUBLISHED_BASES" "$HG_PUBLISHED_LIST_OUT"; then
		echo "   reported $added published package name(s) to $HG_PUBLISHED_LIST_OUT"
	else
		echo "haiku-repo-add: WARNING: could not write HG_PUBLISHED_LIST_OUT=$HG_PUBLISHED_LIST_OUT -- the publish itself SUCCEEDED; a caller pruning from that list will prune less than it could, which is the safe direction" >&2
	fi
fi

if [ -n "${HG_CF_DIST:-}" ]; then
	echo "== 6. invalidate CloudFront /$ARCH/repo* on $HG_CF_DIST =="
	"${AWS[@]}" cloudfront create-invalidation --distribution-id "$HG_CF_DIST" \
		--paths "/$ARCH/repo" "/$ARCH/repo.info" "/$ARCH/repo.sha256" \
		--query 'Invalidation.Id' --output text
else
	echo "note: HG_CF_DIST unset -- skipping CloudFront invalidation (index may serve stale until TTL)" >&2
fi

echo "== 7. clear consumed incoming (only packages we published) =="
# Remove only the incoming *.hpkg we actually published; a skipped package (one
# whose .PackageInfo could not be read/rewritten) stays in incoming so it is not
# silently lost before a human handles it. Delete per-basename rather than the
# whole prefix recursively.
while IFS= read -r b; do
	[ -n "$b" ] || continue
	# </dev/null so a client that touches stdin cannot eat the rest of the list the
	# loop is reading (the former space-joined `for` had no such exposure).
	"${AWS[@]}" s3 rm "${HG_INCOMING_S3%/}/$b" --region "$region" --only-show-errors \
		>/dev/null 2>&1 </dev/null || true
done < "$PUBLISHED_BASES"

dupnote=""
[ "$dup" -gt 0 ] && dupnote="; folded $dup duplicate canonical name(s)"
echo "PUBLISHED $added new package(s); skipped $skipped$dupnote; repo now has $(ls -1 "$RO/packages" | wc -l) (was $before)."
if [ "$skipped" -gt 0 ]; then
	# A PARTIAL publish: the packages that made it are durable in the live repo and
	# the index references them, so the publish itself COMPLETED -- which is why the
	# default status stays 0. A caller's post-publish bookkeeping (the harvest prune,
	# driven by HG_PUBLISHED_LIST_OUT) must still run, and it prunes only the set we
	# actually published, so a skipped package keeps its only copy. What must not
	# happen is a partial publish reading as a clean one, so it gets its own labelled
	# line and its own reason list; HG_STRICT_PARTIAL=1 turns it into exit 2 for a
	# caller that wants all-or-nothing.
	echo "PARTIAL: $added of $offered offered package(s) published; $skipped FAILED and remain in $HG_INCOMING_S3." >&2
	print_skip_summary
	if [ "${HG_STRICT_PARTIAL:-0}" = 1 ]; then
		echo "haiku-repo-add: HG_STRICT_PARTIAL=1 -- exiting 2. The publish itself COMPLETED (packages + index uploaded); this status reports the $skipped package(s) that did not make it." >&2
		exit 2
	fi
fi
