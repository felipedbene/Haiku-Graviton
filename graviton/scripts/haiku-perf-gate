#!/usr/bin/env bash
#
# haiku-perf-gate -- boot a candidate AMI on real hardware, measure it, and fail
# the build if it regressed.
#
# This exists because the manual approval gate it sits in front of could only
# ever mean "I tested this out of band and I vouch for it". Nothing in the
# pipeline knew whether the image worked at all, let alone whether it was as fast
# as the last one. Now Approve means the numbers are already on the screen.
#
# It is a *regression* gate, not a benchmark. The thresholds are deliberately far
# below the measured figures (receive ~4900 and transmit ~3850 Mbit/s at MTU 9001
# on a c7g.large), because a gate that trips on ordinary variance gets disabled
# by whoever it wakes up, and then it protects nothing. It is here to catch "the
# network is broken" and "we lost a factor of two", not to police 10%.
#
# Shape of the run, and why:
#   - c7g.large, never a t-family instance: T instances throttle CPU to a
#     baseline when credits run out, and CPU cost per byte is half of what is
#     being measured.
#   - The peer and the driver of the test is an SSM-managed builder: it holds the
#     ssh key for the Haiku nodes, the nettput peer script and a jumbo-capable
#     interface, so nothing has to be installed on the candidate for a
#     measurement to happen. There is no longer a persistent builder to lean on --
#     the shared metal one this used to assume was terminated -- so by default the
#     gate launches its OWN ephemeral peer and tears it down in the same EXIT trap
#     as the candidate (see launch_peer and cleanup). That peer is a freshly
#     bootstrapped Ubuntu arm64 host, NOT the Haiku canonical AMI: every peer-side
#     command here is Linux (`sudo -u ubuntu`, an ssh client at
#     /home/ubuntu/.ssh/haiku-ed25519, `python3 .../nettput-peer.py`), so the peer
#     has to be a Linux box for them to find the right user, key and interpreter.
#     Its AMI is resolved at runtime from Canonical's public SSM parameter
#     (HG_PEER_AMI_PARAM, default the Ubuntu 24.04 arm64 param) -- never a
#     hardcoded id -- and a base64 user-data script bootstraps it on first boot:
#     it installs awscli + python3, fetches baron's ssh key from Secrets Manager
#     (HG_BARON_SECRET) into /home/ubuntu/.ssh/haiku-ed25519, pulls the nettput
#     peer script from S3 (HG_TOOLS_S3) into /opt/haiku/nettput/, and drops a
#     /var/lib/haiku-peer-ready sentinel when it is done. A caller may still pass
#     HG_BUILDER_INSTANCE to point at an always-on builder, in which case the gate
#     uses it as-is and never terminates it. Because everything the gate learns
#     about the candidate is learned *through* that builder -- readiness is "sshd
#     answers, asked from the builder" and the throughput peer is the builder
#     itself -- a builder that is not answering SSM makes the candidate
#     unobservable. That is a fault in the apparatus, not in the image, so it is
#     checked up front (see ensure_builder_reachable) and, if it recurs mid-run,
#     reported as an apparatus failure rather than misread as "the candidate never
#     booted". The original version had no such check: with the builder stopped,
#     ssm-run returned nothing, and the gate concluded the candidate had failed to
#     bring sshd up and failed a perfectly healthy image.
#   - The instance is terminated by an EXIT trap, so a failure part way through
#     cannot leak a running instance. That matters more than usual here: this is
#     unattended, and the failure path is the likely path.
#   - Before the numbers, a two-second behavioural check that `mimeset` still
#     writes a MIME type. That defect was a *silent* no-op returning rc 0, so it
#     is invisible to every other check here; see the long comment on that
#     section. It runs first because it is cheap and because failing in seconds
#     beats failing after 45 minutes.
#   - Then `mprotect_probe`, also before the numbers. An unprivileged mprotect()
#     could panic the arm64 kernel, and the probe that reproduces it shipped
#     inside the canonical AMI for hours without ever being run against the
#     kernel it was written for. Merging is not verifying and promoting is not
#     verifying, so it is checked here on every candidate. An image that lacks
#     the probe warns rather than passes: "cannot check" must not read as "fine".
#   - After the numbers are in, the instance is stopped and started again and
#     asked for sshd a second time. Throughput is measured on a machine that
#     never went down, so it says nothing about whether the image's writes
#     actually reached the disk; a stop/start is the only thing that does. See
#     the long comment on that section for the bug this exists to catch.
#
# Usage: haiku-perf-gate <ami-id>
#
# Environment (defaults suitable for this project except where marked required;
# the pipeline's Test stage sets all of these, so "required" only bites a manual
# run -- see graviton/pipeline/lib/haiku-graviton-pipeline-stack.ts):
#   HG_BUILDER_INSTANCE   SSM-managed builder that acts as peer and driver.
#                         Empty or the literal 'self' (the default) -> the gate
#                         self-provisions an ephemeral Ubuntu arm64 peer and
#                         terminates it on exit; there is no persistent builder
#                         to assume any more. Pass a real instance id to reuse an
#                         always-on builder instead -- a caller-supplied id is used
#                         as-is and is never terminated (backward compat).
#   HG_PEER_INSTANCE_PROFILE  instance profile attached to the self-provisioned
#                         peer; it must carry AmazonSSMManagedInstanceCore so the
#                         peer answers SSM, plus read on the baron secret and the
#                         nettput tools object and write on the ssm-out prefix (the
#                         pipeline creates a dedicated least-priv profile for this
#                         -- see haiku-graviton-pipeline-stack.ts).
#   HG_PEER_AMI_PARAM     SSM parameter the peer's Ubuntu arm64 AMI id is read from
#                         (default Canonical's public
#                         /aws/service/canonical/ubuntu/server/24.04/stable/current/arm64/hvm/ebs-gp3/ami-id).
#   HG_BARON_SECRET       Secrets Manager secret id holding baron's PRIVATE ssh key,
#                         which the peer fetches at boot into
#                         /home/ubuntu/.ssh/haiku-ed25519 (default
#                         haiku-graviton/baron-ssh-key).
#   HG_TOOLS_S3           s3:// URL of the nettput peer script the peer fetches at
#                         boot into /opt/haiku/nettput/nettput-peer.py. Empty -> it
#                         is derived as s3://haiku-graviton-<account>-<region>/tools/nettput-peer.py.
#   HG_BUILDER_WAIT_SECS  budget for the builder to become reachable over SSM at
#                         the start of a run (default 300); a run cannot proceed
#                         until it does, but this is patient in case the peer is
#                         mid-boot (a freshly launched peer needs to boot, run its
#                         bootstrap user-data and register SSM within this budget --
#                         raise it if the Ubuntu image is slow to come up)
#   HG_TEST_SUBNET        subnet to launch the candidate in
#   HG_TEST_SG            security group for the candidate (**required**)
#   HG_TEST_TYPE          instance type (default c7g.large)
#   HG_MIN_RX_MBPS        receive floor in Mbit/s (default 3000)
#   HG_MIN_TX_MBPS        transmit floor in Mbit/s (default 2000)
#   HG_TEST_BYTES         bytes per run (default 512M)
#   HG_BOOT_WAIT_SECS     budget for one "does sshd answer" wait (default 420)
#   HG_STOP_WAIT_SECS     budget for reaching 'stopped' (default 600)
#   HG_START_WAIT_SECS    budget for reaching 'running' again (default 300)
#   HG_CLEAN_STOP_SECS    a stop at or past this looks like a hard power-off
#                         rather than a handled ACPI power button (default 180)
#
# Every wait is bounded by a wall-clock budget rather than an attempt count, so
# the script has a knowable ceiling and the CodeBuild timeout can be set from it
# instead of guessed at. Worst case is roughly boot + measure + stop + start +
# boot again, about 45 min; the typical run is a few minutes.

set -uo pipefail

REGION="${AWS_REGION:-${AWS_DEFAULT_REGION:-us-west-2}}"
BUILDER="${HG_BUILDER_INSTANCE:-}"
PEER_PROFILE="${HG_PEER_INSTANCE_PROFILE:-AWSSupportPatchwork-SSMRoleForInstances}"
PEER_AMI_PARAM="${HG_PEER_AMI_PARAM:-/aws/service/canonical/ubuntu/server/24.04/stable/current/arm64/hvm/ebs-gp3/ami-id}"
BARON_SECRET="${HG_BARON_SECRET:-haiku-graviton/baron-ssh-key}"
TOOLS_S3="${HG_TOOLS_S3:-}"
# No baked-in subnet id. This used to default to a hand-made subnet that a VPC
# consolidation later deleted, and because a dead id only fails at run-instances
# time the whole Test stage broke AFTER CrossBuild and Register had already spent
# ~25 minutes. Resolved from the build VPC by name when unset (see below).
SUBNET="${HG_TEST_SUBNET:-}"
TEST_VPC_NAME="${HG_TEST_VPC_NAME:-DebeosOpsStack/BuildVpc}"
TEST_SG="${HG_TEST_SG:-}"
TEST_TYPE="${HG_TEST_TYPE:-c7g.large}"
MIN_RX="${HG_MIN_RX_MBPS:-3000}"
MIN_TX="${HG_MIN_TX_MBPS:-2000}"
BYTES="${HG_TEST_BYTES:-512M}"
KEY_NAME="${HG_TEST_KEY:-haiku-uaf-ed25519}"
BOOT_WAIT="${HG_BOOT_WAIT_SECS:-420}"
BUILDER_WAIT="${HG_BUILDER_WAIT_SECS:-300}"
STOP_WAIT="${HG_STOP_WAIT_SECS:-600}"
START_WAIT="${HG_START_WAIT_SECS:-300}"
CLEAN_STOP="${HG_CLEAN_STOP_SECS:-180}"

here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
SSM_RUN="$here/ssm-run"

die() { printf 'perf-gate: %s\n' "$*" >&2; exit 1; }
say() { printf 'perf-gate: %s\n' "$*"; }

AMI="${1:-}"
[ -n "$AMI" ] || die "usage: haiku-perf-gate <ami-id>"
[ -x "$SSM_RUN" ] || die "ssm-run not found next to this script"
[ -n "$TEST_SG" ] || die "HG_TEST_SG must be set (the test security group)"

# Resolve the subnet up front, before anything is launched, so a network problem
# is reported in the first seconds rather than as a run-instances failure minutes
# in. Private subnets only: the peer reaches Secrets Manager / S3 / SSM through the
# VPC's NAT and gateway endpoint, and the candidate is driven from the peer and
# read over the EC2 console API, so neither needs a public address.
if [ -z "$SUBNET" ]; then
	TEST_VPC_ID=$(aws --region "$REGION" ec2 describe-vpcs \
		--filters "Name=tag:Name,Values=$TEST_VPC_NAME" \
		--query 'Vpcs[0].VpcId' --output text 2>/dev/null)
	case "$TEST_VPC_ID" in
		vpc-*) ;;
		*) die "no VPC tagged Name='$TEST_VPC_NAME'; set HG_TEST_SUBNET or HG_TEST_VPC_NAME" ;;
	esac
	# One --filters with both conditions: repeating the flag makes the LAST one win
	# and would silently match a subnet in some other VPC.
	SUBNET=$(aws --region "$REGION" ec2 describe-subnets \
		--filters "Name=vpc-id,Values=$TEST_VPC_ID" \
		          "Name=tag:aws-cdk:subnet-type,Values=Private" \
		--query 'Subnets[0].SubnetId' --output text 2>/dev/null)
	case "$SUBNET" in
		subnet-*) say "resolved test subnet $SUBNET in $TEST_VPC_ID ('$TEST_VPC_NAME')" ;;
		*) die "no private subnet in VPC '$TEST_VPC_NAME' ($TEST_VPC_ID); set HG_TEST_SUBNET" ;;
	esac
fi
# Fail now, not at run-instances, if the ids do not actually exist -- both were
# silently deleted once by a VPC consolidation.
#
# CAREFUL: a failed describe is NOT evidence of absence. The first version of this
# check discarded stderr and treated any non-zero exit as "does not exist", so when
# the CodeBuild role turned out to lack ec2:DescribeSubnets it reported a perfectly
# healthy subnet as deleted and failed the stage. Only NotFound means missing; a
# permissions error means we cannot tell, and the right response to "cannot tell"
# is to proceed and let run-instances give the authoritative answer.
preflight_exists() {
	local what="$1" out
	shift
	out=$(aws --region "$REGION" "$@" 2>&1) && return 0
	case "$out" in
		*NotFound*|*does\ not\ exist*)
			die "$what does not exist (deleted VPC? override with the matching HG_* var)" ;;
		*UnauthorizedOperation*|*AccessDenied*|*not\ authorized*)
			say "cannot verify $what (no describe permission); continuing" ; return 0 ;;
		*)
			say "cannot verify $what ($(printf '%s' "$out" | tail -1)); continuing" ; return 0 ;;
	esac
}
preflight_exists "test subnet $SUBNET" ec2 describe-subnets --subnet-ids "$SUBNET"
preflight_exists "test security group $TEST_SG" ec2 describe-security-groups --group-ids "$TEST_SG"
# No persistent builder is required any more. If HG_BUILDER_INSTANCE is empty or
# the literal 'self', the gate launches its own ephemeral peer below (see
# launch_peer); if a real instance id is supplied, that machine is used as-is and
# is never terminated. Either way BUILDER holds the id the rest of the gate drives.

INSTANCE=""
# The peer this run launched, if any. Tracked separately from INSTANCE (the
# candidate) so cleanup terminates a self-provisioned peer but never a
# caller-supplied HG_BUILDER_INSTANCE.
PEER_LAUNCHED=0

# Warnings are non-fatal but must survive to the verdict, so the counter is declared
# here rather than beside the first check that happens to use it.
warn=0
# Best effort and idempotent: a terminate that 4xx's (already gone, never
# created) must never turn a green run red, so every AWS call here swallows its
# status. The trap runs on every exit path, so a failure part way through cannot
# leak either the candidate or a self-provisioned peer.
cleanup() {
	if [ -n "$INSTANCE" ]; then
		say "terminating candidate $INSTANCE"
		aws --region "$REGION" ec2 terminate-instances --instance-ids "$INSTANCE" \
			--query 'TerminatingInstances[].CurrentState.Name' --output text 2>&1 | sed 's/^/  /' || true
	fi
	if [ "$PEER_LAUNCHED" = 1 ] && [ -n "$BUILDER" ]; then
		# We launched this peer, so we own tearing it down.
		say "terminating ephemeral peer $BUILDER"
		aws --region "$REGION" ec2 terminate-instances --instance-ids "$BUILDER" \
			--query 'TerminatingInstances[].CurrentState.Name' --output text 2>&1 | sed 's/^/  /' || true
	elif [ -n "$BUILDER" ]; then
		# Caller-supplied persistent builder: do NOT terminate it, just make sure
		# no peer process is left running on it.
		"$SSM_RUN" "$BUILDER" -t 90 -q >/dev/null 2>&1 <<-'STOP' || true
			pkill -f nettput-peer.py 2>/dev/null || true
		STOP
	fi
	return 0
}
trap cleanup EXIT

# ----------------------------------------------------- builder reachability
# Everything this gate learns about the candidate travels through the builder:
# readiness is an ssh from the builder to the candidate, and the throughput peer
# is the builder itself. So a builder that is stopped, or whose SSM agent is not
# answering, does not make the candidate look slow or broken -- it makes the
# candidate *invisible*, and every downstream check reads a silence it cannot
# distinguish from a dead node.
#
# That is exactly the failure that fell through before: with the builder stopped,
# ssm-run returned no output, wait_for_sshd timed out, and the gate failed a
# healthy image with "candidate never brought sshd up". A verdict about the image
# was drawn from a fact about the apparatus.
#
# So confirm the channel before launching the candidate. Two conditions, because
# both are prerequisites and they fail differently: the instance must be `running`
# (checked with DescribeInstances, which the role already has), and an ssm-run
# round trip must actually complete (the SSM agent can lag the EC2 state by a
# minute or two after a start). This is patient rather than instant -- a freshly
# launched peer is still mid-boot when this runs -- but it is bounded, and it runs
# *before* the candidate is launched, so a builder that never comes back cannot
# leak the candidate and cannot be mistaken for a candidate that never booted.
#
# This same round-trip is what confirms a self-provisioned peer has come up: after
# launch_peer sets BUILDER to the new instance, ensure_builder_reachable is what
# waits for it to answer SSM before the candidate is launched.
ensure_builder_reachable() {
	local deadline=$((SECONDS + BUILDER_WAIT)) state out
	say "checking the builder $BUILDER is up and answering SSM (it drives and peers every check)"
	while [ "$SECONDS" -lt "$deadline" ]; do
		state=$(aws --region "$REGION" ec2 describe-instances --instance-ids "$BUILDER" \
			--query 'Reservations[0].Instances[0].State.Name' --output text 2>/dev/null)
		if [ "$state" = "running" ]; then
			# EC2 says running; now prove the SSM channel actually round-trips,
			# because ssm-run silently returning nothing is the precise shape of the
			# original bug. A trivial echo is enough -- what matters is that output
			# comes back at all.
			out=$("$SSM_RUN" "$BUILDER" -t 60 -q 2>/dev/null <<-'PING'
				echo GATE_BUILDER_OK
			PING
			)
			printf '%s' "$out" | grep -q GATE_BUILDER_OK && { say "builder reachable over SSM"; return 0; }
		fi
		say "  builder not reachable yet (state ${state:-unknown}, $((deadline - SECONDS))s of budget left)"
		sleep 15
	done
	if [ "$PEER_LAUNCHED" = 1 ]; then
		die "the self-provisioned peer $BUILDER never answered SSM within ${BUILDER_WAIT}s
  (last EC2 state ${state:-unknown}). This is an APPARATUS failure, NOT a verdict on
  $AMI: the gate reaches the candidate only through this peer, so with it silent
  nothing can be observed. No candidate was launched; the peer is torn down on
  exit. Raise HG_BUILDER_WAIT_SECS if the Ubuntu peer image is slow to register SSM,
  and re-run; do not read this as a failed image."
	fi
	die "the builder $BUILDER is not reachable over SSM (last EC2 state ${state:-unknown}).
  This is an APPARATUS failure, NOT a verdict on $AMI: the gate reaches the
  candidate only through this builder, so with it down nothing can be observed.
  No candidate was launched. Confirm HG_BUILDER_INSTANCE is up (or leave it unset
  to self-provision a peer) and re-run; do not read this as a failed image."
}

# --------------------------------------------------------------- peer launch
# There is no persistent builder to assume any more, so unless the caller points
# HG_BUILDER_INSTANCE at an always-on machine, the gate launches its own peer.
#
# The peer is a freshly bootstrapped UBUNTU arm64 host, not the Haiku canonical
# AMI, because every peer-side command in this gate is Linux: it becomes the
# `ubuntu` user (`sudo -u ubuntu`), uses an ssh *client* at
# /home/ubuntu/.ssh/haiku-ed25519 to reach the candidate, and runs the nettput
# peer with `python3 /opt/haiku/nettput/nettput-peer.py`. None of that exists on a
# Haiku image. The AMI id is resolved at runtime from Canonical's public SSM
# parameter (PEER_AMI_PARAM) -- never hardcoded -- and everything the peer needs
# is installed by a base64 user-data script that runs once on first boot:
#   - installs python3 and awscli (apt, with a snap fallback);
#   - fetches baron's PRIVATE ssh key from Secrets Manager (BARON_SECRET) into
#     /home/ubuntu/.ssh/haiku-ed25519 (0600, owned by ubuntu) -- this is the key
#     whose public half is baked into the candidate's authorized_keys;
#   - copies the nettput peer script from S3 (TOOLS_S3) into /opt/haiku/nettput/;
#   - drops /var/lib/haiku-peer-ready last, so readiness can be confirmed.
# The peer is launched into the test subnet/SG, tagged ephemeral so the pipeline
# role is allowed to terminate it, and carries an instance profile that grants
# SSM (so ssm-run can drive it) plus the secret/S3 reads its user-data needs.
# PEER_LAUNCHED marks it as ours to tear down; cleanup does that.
#
# The launch and the SSM wait are deliberately split: BUILDER and PEER_LAUNCHED
# are set the instant run-instances returns an id, so a failure during the SSM
# wait still hands the instance to the EXIT trap rather than leaking it.
launch_peer() {
	local ami acct
	say "no persistent builder supplied; self-provisioning an ephemeral Ubuntu arm64 peer"
	ami=$(aws --region "$REGION" ssm get-parameter --name "$PEER_AMI_PARAM" \
		--query 'Parameter.Value' --output text 2>&1)
	case "$ami" in
		ami-*) ;;
		*) die "could not resolve the Ubuntu arm64 peer AMI from SSM param $PEER_AMI_PARAM: $ami" ;;
	esac

	# Derive the nettput tools object if the caller did not name it outright. The
	# account id is never written down in this (public) tree, so it is resolved
	# from the caller's own credentials, exactly as ssm-run does for its bucket.
	if [ -z "$TOOLS_S3" ]; then
		acct=$(aws --region "$REGION" sts get-caller-identity --query Account --output text 2>/dev/null)
		case "$acct" in
			""|*[!0-9]*) die "cannot resolve the AWS account id to derive HG_TOOLS_S3; set HG_TOOLS_S3 to the nettput-peer.py object" ;;
		esac
		TOOLS_S3="s3://haiku-graviton-$acct-$REGION/tools/nettput-peer.py"
	fi

	# First-boot bootstrap. Runtime shell metacharacters are escaped (\$) so they
	# run ON the peer; REGION/BARON_SECRET/TOOLS_S3 are expanded HERE so the peer
	# does not need to know them. set -e aborts the boot if any step fails, which
	# surfaces as the sentinel never appearing rather than as a half-provisioned
	# peer that measures nothing.
	local userdata
	userdata=$(base64 -w0 <<-UD
		#!/bin/bash
		set -e
		export DEBIAN_FRONTEND=noninteractive
		# cloud-init may still hold the apt/dpkg lock on a fresh boot; wait it out.
		for _ in \$(seq 1 60); do
			fuser /var/lib/dpkg/lock-frontend >/dev/null 2>&1 || break
			sleep 5
		done
		apt-get update -y
		# awscli lives in Ubuntu 24.04 'universe' (enabled by default on Canonical's
		# images); fall back to the snap if the apt package is somehow unavailable.
		if ! apt-get install -y python3 awscli; then
			apt-get install -y python3
			snap install aws-cli --classic
			ln -sf /snap/bin/aws /usr/local/bin/aws
		fi
		install -d -m700 -o ubuntu -g ubuntu /home/ubuntu/.ssh
		aws secretsmanager get-secret-value --region $REGION \\
			--secret-id $BARON_SECRET --query SecretString --output text \\
			> /home/ubuntu/.ssh/haiku-ed25519
		chmod 600 /home/ubuntu/.ssh/haiku-ed25519
		chown ubuntu:ubuntu /home/ubuntu/.ssh/haiku-ed25519
		mkdir -p /opt/haiku/nettput
		aws s3 cp $TOOLS_S3 /opt/haiku/nettput/nettput-peer.py
		touch /var/lib/haiku-peer-ready
	UD
	)

	say "launching Ubuntu arm64 peer $TEST_TYPE from $ami (profile $PEER_PROFILE)"
	say "  peer will fetch baron key from Secrets Manager $BARON_SECRET and nettput from $TOOLS_S3"
	local id
	id=$(aws --region "$REGION" ec2 run-instances \
		--image-id "$ami" --instance-type "$TEST_TYPE" \
		--key-name "$KEY_NAME" --subnet-id "$SUBNET" --security-group-ids "$TEST_SG" \
		--iam-instance-profile "Name=$PEER_PROFILE" \
		--user-data "$userdata" \
		--tag-specifications "ResourceType=instance,Tags=[{Key=Project,Value=haiku-graviton},{Key=Name,Value=haiku-perf-gate-peer},{Key=ephemeral,Value=true}]" \
		--query 'Instances[0].InstanceId' --output text 2>&1)
	case "$id" in
		i-*) ;;
		*) die "run-instances (peer) failed: $id" ;;
	esac
	BUILDER="$id"
	PEER_LAUNCHED=1
	say "peer instance $BUILDER launched; waiting for it to answer SSM"
}

# --------------------------------------------------------- peer bootstrap wait
# ensure_builder_reachable proves the SSM channel round-trips, but on a
# self-provisioned peer that only means the SSM agent is up -- the user-data
# bootstrap (key fetch, nettput copy, package install) may still be running. The
# nettput measurement and the ssh-to-candidate both fail confusingly if they race
# it, so wait for the /var/lib/haiku-peer-ready sentinel the user-data drops last.
# Bounded by the same budget as the SSM wait; only meaningful for a peer we
# launched (a caller-supplied builder is assumed already provisioned).
wait_for_peer_ready() {
	local deadline=$((SECONDS + BUILDER_WAIT)) out
	say "waiting for the peer's first-boot bootstrap to finish (/var/lib/haiku-peer-ready)"
	while [ "$SECONDS" -lt "$deadline" ]; do
		out=$("$SSM_RUN" "$BUILDER" -t 60 -q 2>/dev/null <<-'READY'
			test -f /var/lib/haiku-peer-ready \
				&& test -s /home/ubuntu/.ssh/haiku-ed25519 \
				&& test -s /opt/haiku/nettput/nettput-peer.py \
				&& echo GATE_PEER_READY
		READY
		)
		printf '%s' "$out" | grep -q GATE_PEER_READY && { say "peer bootstrap complete"; return 0; }
		say "  peer still bootstrapping ($((deadline - SECONDS))s of budget left)"
		sleep 15
	done
	die "the self-provisioned peer $BUILDER never finished its first-boot bootstrap
  within ${BUILDER_WAIT}s (no /var/lib/haiku-peer-ready, or the baron key / nettput
  script never landed). This is an APPARATUS failure, NOT a verdict on $AMI: the peer
  drives and peers every check, so a half-provisioned peer measures nothing. Check the
  peer's /var/log/cloud-init-output.log, confirm the peer profile can read
  $BARON_SECRET and $TOOLS_S3, and re-run."
}

case "$BUILDER" in
	""|self) launch_peer ;;
	*) say "using caller-supplied builder $BUILDER (will not terminate it)" ;;
esac
ensure_builder_reachable
# A peer we launched is not usable until its first-boot bootstrap has fetched the
# baron key and the nettput script; wait for the sentinel before measuring. A
# caller-supplied builder is assumed already provisioned, so skip the wait for it.
[ "$PEER_LAUNCHED" = 1 ] && wait_for_peer_ready

# ------------------------------------------------------------------ launch
say "launching $TEST_TYPE from $AMI"
INSTANCE=$(aws --region "$REGION" ec2 run-instances \
	--image-id "$AMI" --instance-type "$TEST_TYPE" \
	--key-name "$KEY_NAME" --subnet-id "$SUBNET" --security-group-ids "$TEST_SG" \
	--tag-specifications "ResourceType=instance,Tags=[{Key=Project,Value=haiku-graviton},{Key=Name,Value=haiku-perf-gate},{Key=ephemeral,Value=true}]" \
	--query 'Instances[0].InstanceId' --output text 2>&1)
case "$INSTANCE" in
	i-*) ;;
	*) INSTANCE=""; die "run-instances failed: $INSTANCE" ;;
esac

IP=$(aws --region "$REGION" ec2 describe-instances --instance-ids "$INSTANCE" \
	--query 'Reservations[0].Instances[0].PrivateIpAddress' --output text 2>/dev/null)
[ -n "$IP" ] && [ "$IP" != "None" ] || die "no private IP for $INSTANCE"
say "instance $INSTANCE at $IP"

# ------------------------------------------------------- wait for the node
# Haiku has no SSM agent, so readiness means "sshd answers", asked from the
# builder. A node that never answers is a boot failure and must fail the gate --
# that is arguably the single most valuable thing this stage catches.
#
# Factored into a function because it is needed twice: once for the first boot,
# and again after the stop/start check below. Bounded by a wall-clock budget
# rather than a fixed attempt count so the caller knows the ceiling it is buying.
# A cold stop/start, used only for the case where the node shows no sign of life at
# all. A cold cycle gets fresh placement and a fresh boot, so it clears both a
# placement problem and a once-per-boot software one.
#
# This exists so that "we could not tell" does not have to resolve to either "ship
# it" or "block it". It is deliberately *not* justified by a failure rate: this was
# once written around a "roughly one warm reboot in six loses the NIC" figure, and
# a later attempt to reproduce it saw 0 failures in 125 warm reboots across two
# hosts. Retrying is still right for a no-evidence outcome, but the retry count is
# a budget, not a probability calculation, and nothing here should be read as
# characterising a hardware intermittent.
recycle_instance() {
	local why="$1" s ip
	say "$why: recycling the instance (cold stop/start)"

	aws --region "$REGION" ec2 stop-instances --instance-ids "$INSTANCE" \
		>/dev/null 2>&1
	local deadline=$((SECONDS + STOP_WAIT))
	s=""
	while [ "$SECONDS" -lt "$deadline" ]; do
		sleep 5
		s=$(aws --region "$REGION" ec2 describe-instances --instance-ids "$INSTANCE" \
			--query 'Reservations[0].Instances[0].State.Name' --output text 2>/dev/null)
		[ "$s" = "stopped" ] && break
	done
	[ "$s" = "stopped" ] || { say "  recycle: never reached 'stopped'"; return 1; }

	aws --region "$REGION" ec2 start-instances --instance-ids "$INSTANCE" \
		>/dev/null 2>&1
	deadline=$((SECONDS + START_WAIT))
	s=""
	while [ "$SECONDS" -lt "$deadline" ]; do
		sleep 5
		s=$(aws --region "$REGION" ec2 describe-instances --instance-ids "$INSTANCE" \
			--query 'Reservations[0].Instances[0].State.Name' --output text 2>/dev/null)
		[ "$s" = "running" ] && break
	done
	[ "$s" = "running" ] || { say "  recycle: never returned to 'running'"; return 1; }

	ip=$(aws --region "$REGION" ec2 describe-instances --instance-ids "$INSTANCE" \
		--query 'Reservations[0].Instances[0].PrivateIpAddress' --output text 2>/dev/null)
	if [ -n "$ip" ] && [ "$ip" != "None" ]; then
		[ "$ip" != "$IP" ] && say "  recycle: private IP moved $IP -> $ip"
		IP="$ip"
	fi
	return 0
}


# WAIT_CHANNEL_OK records whether the builder's SSM channel answered at all during
# the most recent wait, regardless of what the candidate did. A silent channel and
# a candidate with no sshd are indistinguishable in the raw output -- both leave
# `out` empty -- yet they demand opposite verdicts: one is an apparatus fault, the
# other a failed image. The remote script therefore always ends with a sentinel
# the builder echoes even when the ssh to the candidate fails, so its presence
# means "the builder ran this" and its absence means "the channel is dead".
WAIT_CHANNEL_OK=0
wait_for_sshd() {
	local why="$1" budget="$2"
	local deadline=$((SECONDS + budget)) attempt=0 out
	WAIT_CHANNEL_OK=0
	while [ "$SECONDS" -lt "$deadline" ]; do
		attempt=$((attempt + 1))
		out=$("$SSM_RUN" "$BUILDER" -t 120 -q 2>/dev/null <<-EOF
			SO="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=8 -o LogLevel=ERROR -i /home/ubuntu/.ssh/haiku-ed25519"
			sudo -u ubuntu ssh -n \$SO baron@$IP 'uname -a' 2>/dev/null && echo GATE_READY
			echo GATE_CHANNEL_OK
		EOF
		)
		printf '%s' "$out" | grep -q GATE_CHANNEL_OK && WAIT_CHANNEL_OK=1
		if printf '%s' "$out" | grep -q GATE_READY; then
			say "$why: node answers -- $(printf '%s' "$out" | head -1)"
			return 0
		fi
		if [ "$WAIT_CHANNEL_OK" = 1 ]; then
			say "  $why: not ready yet (attempt $attempt, $((deadline - SECONDS))s of budget left)"
		else
			say "  $why: builder channel gave no output (attempt $attempt, $((deadline - SECONDS))s of budget left)"
		fi
		sleep 20
	done
	return 1
}

say "waiting for sshd (a node that never answers is a boot failure)"
if ! wait_for_sshd "first boot" "$BOOT_WAIT"; then
	# Only a builder that was answering the whole time makes a silent candidate a
	# statement about the image. If the channel itself never spoke, the builder
	# went away after the up-front check and this run measured nothing -- an
	# apparatus failure, not a failed image.
	[ "$WAIT_CHANNEL_OK" = 1 ] \
		|| die "the builder stopped answering over SSM during the first-boot wait.
  This is an APPARATUS failure, NOT a verdict on $AMI: with the builder gone the
  candidate cannot be reached at all. Confirm the builder is up and re-run; do not
  read this as a failed image."
	die "candidate $AMI never brought sshd up -- treating as a failed image"
fi

# ------------------------------------------------------ mimeset regression check
# `mimeset` was a complete silent no-op on every headless Haiku: it constructs a
# BApplication before its file loop, and BApplication::_InitData() calls exit(0)
# -- a *success* status -- when app_server is absent. So it terminated in the
# constructor reporting success, and haikuporter's packaging step, which checks
# only the exit status, saw rc 0 and moved on. 145 of 262 packages in the pool
# ended up with no MIME types and no resource-to-attribute icon copy.
#
# This check exists because that regression is invisible everywhere else. The
# failure is silent by construction: nothing errors, nothing logs, exit statuses
# are 0, and the packages look fine until someone reads their attributes. An
# image built from a tree without the fix would sail through every other check in
# this script -- it boots, it does jumbo, it survives a stop/start -- and quietly
# produce untyped packages for as long as it stayed in service.
#
# It is a *behavioural* check on the running artifact, not a hash or a version
# comparison, because what matters is whether mimeset writes the attribute on
# this image, and because the same binary can be present and still not be the one
# that runs. It is cheap (a couple of seconds) and it is placed before the
# measurement so a broken image fails in seconds instead of after 45 minutes.
say "----------------------------------------"
say "mimeset regression check (a silent no-op here costs every package built on this image)"
ms=$("$SSM_RUN" "$BUILDER" -t 180 -q 2>&1 <<-EOF
	set -uo pipefail
	SO="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=8 -o LogLevel=ERROR -i /home/ubuntu/.ssh/haiku-ed25519"
	sudo -u ubuntu ssh -n \$SO baron@$IP '
		set -u
		d=/boot/home/.gate-mimeset
		rm -rf \$d && mkdir -p \$d && cd \$d

		# Sniffable content, so the assertion does not depend on the
		# extension-vs-sniffer precedence in the MIME database.
		printf "<html><body>x</body></html>\n" > probe.html

		# The before-state is part of the evidence: a fresh file on BFS carries
		# no attributes, so "present afterwards" means mimeset wrote it rather
		# than something having been inherited from a copy.
		catattr BEOS:TYPE probe.html >/dev/null 2>&1 \
			&& echo "GATE_MIMESET_BASELINE_DIRTY" \
			|| echo "GATE_MIMESET_BASELINE_CLEAN"

		out=\$(mimeset --all . 2>&1); rc=\$?
		echo "GATE_MIMESET_RC \$rc"
		echo "GATE_MIMESET_TYPE \$(catattr -d BEOS:TYPE probe.html 2>/dev/null)"

		# Diagnostics that make a PASS interpretable rather than merely green.
		# If app_server were somehow running, even an unfixed mimeset would work
		# and the check would be vacuous -- so record which world we are in.
		ps 2>/dev/null | grep -q "[a]pp_server" \
			&& echo "GATE_MIMESET_APPSERVER present" \
			|| echo "GATE_MIMESET_APPSERVER absent"
		case "\$out" in
			*"continuing without it"*) echo "GATE_MIMESET_WARNING present" ;;
			*)                         echo "GATE_MIMESET_WARNING absent"  ;;
		esac
		cd /; rm -rf \$d
	' 2>/dev/null
EOF
)
printf '%s\n' "$ms" | grep '^GATE_MIMESET' | sed 's/^/  /'

ms_field() { printf '%s' "$ms" | sed -n "s/^GATE_MIMESET_$1 //p" | tail -1; }
ms_type=$(ms_field TYPE)
ms_appserver=$(ms_field APPSERVER)
ms_warning=$(ms_field WARNING)

if ! printf '%s' "$ms" | grep -q GATE_MIMESET_BASELINE_CLEAN; then
	die "mimeset check is invalid: the probe file already had a BEOS:TYPE before mimeset ran"
fi
if [ -z "$ms_type" ]; then
	say "FAIL: mimeset wrote no BEOS:TYPE at all (app_server $ms_appserver, warning $ms_warning)"
	say "  This is the headless exit(0) defect. Every package built on this image"
	say "  loses its MIME types and its resource-to-attribute icon copy, silently,"
	say "  with rc 0 from haikuporter. Check that src/bin/mimeset.cpp still passes a"
	say "  status_t* to BApplication, and that this image was built from a tree that has it."
	die "mimeset regression gate failed for $AMI"
fi
if [ "$ms_type" != "text/html" ]; then
	say "FAIL: mimeset typed the probe as '$ms_type', expected text/html"
	say "  mimeset ran, so this is not the exit(0) defect -- suspect the MIME database"
	say "  in the image (data/mime_db) rather than the tool."
	die "mimeset regression gate failed for $AMI"
fi
say "mimeset OK: typed a fresh file as $ms_type (app_server $ms_appserver, headless warning $ms_warning)"
if [ "$ms_appserver" = "present" ]; then
	say "  NOTE: app_server is running, so this pass does not prove the headless path works."
	say "  On Graviton there is no display device at all, so that is unexpected -- look into it."
fi

# ------------------------------------------------ mprotect / VM regression check
# An unprivileged mprotect() used to panic the arm64 kernel: Query() set PAGE_PRESENT
# with no valid-bit test, so a slot for a never-faulted page reported "present,
# pa=0", and _user_set_memory_protection() fed that zero to vm_lookup_page() and
# panicked. Any process protecting a range that mixes faulted-in and untouched pages
# could take the machine down; it was found because ruby's miniruby did exactly that.
#
# `mprotect_probe` ships in the image next to ena_fault and reproduces it in a few
# lines of unprivileged C. It was shipping inside the canonical AMI for hours without
# ever being run against the kernel it was written for -- merging is not verifying,
# and promoting is not verifying either. So it runs here, on every candidate.
#
# Cheap and unambiguous: on a fixed kernel all four probes return and it prints PASS;
# on a broken one the node drops into KDL and stops answering, which this catches as a
# lost connection rather than a wrong string. Both failure shapes are handled below,
# because "no output" and "wrong output" need different messages to be actionable.
say "----------------------------------------"
say "mprotect regression check (a panic here means any process can down the kernel)"
mp=$("$SSM_RUN" "$BUILDER" -t 180 -q 2>&1 <<-EOF
	SO="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=8 -o LogLevel=ERROR -i /home/ubuntu/.ssh/haiku-ed25519"
	# Report the kernel's own build identity first, so a PASS is attributable to a
	# specific kernel rather than to "some image".
	sudo -u ubuntu ssh -n \$SO baron@$IP '
		echo "GATE_MP_KERNEL \$(grep "kernel build" /var/log/syslog 2>/dev/null | tail -1)"
		if [ ! -x /bin/mprotect_probe ]; then echo "GATE_MP_RESULT absent"; exit 0; fi
		out=\$(/bin/mprotect_probe 2>&1); rc=\$?
		echo "GATE_MP_RC \$rc"
		case "\$out" in
			*"PASS (all probes returned"*) echo "GATE_MP_RESULT pass" ;;
			*)                             echo "GATE_MP_RESULT partial" ;;
		esac
		echo "GATE_MP_RETURNED \$(printf "%s" "\$out" | grep -c ": returned")"
	' 2>/dev/null || echo "GATE_MP_RESULT unreachable"
	EOF
)
printf '%s\n' "$mp" | grep '^GATE_MP' | sed 's/^/  /'
mp_field() { printf '%s' "$mp" | sed -n "s/^GATE_MP_$1 //p" | tail -1; }
mp_result=$(mp_field RESULT)
mp_returned=$(mp_field RETURNED)
mp_kernel=$(mp_field KERNEL)

case "$mp_result" in
	pass)
		say "mprotect OK: all 4 probes returned and the kernel survived"
		say "  kernel: ${mp_kernel:-<no build banner -- kernel predates the stamp>}"
		;;
	absent)
		# Not a pass. An image without the probe cannot be checked, and silently
		# treating "cannot check" as "fine" is how the original defect survived.
		say "WARNING: /bin/mprotect_probe is not in this image, so the VM check did not run."
		say "  It is wired into build/jam/packages/Haiku next to ena_fault -- an image"
		say "  without it was built from a tree predating that, and is unverified here."
		warn=$((warn + 1))
		;;
	unreachable)
		say "FAIL: the node stopped answering while running mprotect_probe."
		say "  That is the signature of the kernel panicking into KDL, which is exactly"
		say "  what this check exists to catch. Confirm with:"
		say "    aws ec2 get-console-output --latest --instance-id $INSTANCE"
		say "  (--latest is required; without it you get the cached boot snapshot and"
		say "  the panic is simply absent from the output.)"
		die "mprotect regression gate failed for $AMI"
		;;
	*)
		say "FAIL: mprotect_probe ran but did not reach its PASS line"
		say "  probes that returned: ${mp_returned:-0} of 4"
		say "  A partial run means one specific probe shape is still broken. Check that"
		say "  VMSAv8TranslationMap::Query() tests kPteValidMask, and that ProcessRange()"
		say "  returns early when the root table is unallocated."
		die "mprotect regression gate failed for $AMI"
		;;
esac

# --------------------------------------------------------------- measure
# The peer is the builder, so the address the Haiku node must dial is the
# *builder's* private IP. Resolve it here rather than inside the remote script:
# `hostname -I` there would be right, but this heredoc is expanded locally and it
# would silently substitute the CodeBuild container's address instead.
PEER_IP=$(aws --region "$REGION" ec2 describe-instances --instance-ids "$BUILDER" \
	--query 'Reservations[0].Instances[0].PrivateIpAddress' --output text 2>/dev/null)
[ -n "$PEER_IP" ] && [ "$PEER_IP" != "None" ] || die "cannot resolve the builder's private IP"

say "measuring against peer $PEER_IP (MTU 9001, $BYTES per run)"
results=$("$SSM_RUN" "$BUILDER" -t 900 -q 2>&1 <<-EOF
	set -uo pipefail
	SO="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=8 -o LogLevel=ERROR -i /home/ubuntu/.ssh/haiku-ed25519"
	S="sudo -u ubuntu ssh -n \$SO baron@$IP"

	pkill -f nettput-peer.py 2>/dev/null
	sleep 1
	sudo -u ubuntu nohup python3 /opt/haiku/nettput/nettput-peer.py -p 5301 > /tmp/perf-gate-peer.log 2>&1 &
	sleep 2

	echo "MTU: \$(\$S 'ifconfig /dev/net/ena/0' 2>&1 | sed -n 's/.*MTU: *\([0-9]*\).*/\1/p' | head -1)"

	for dir in "" "-r"; do
	    label=TX; [ -n "\$dir" ] && label=RX
	    for rep in 1 2; do
	        out=\$(\$S "nettput -c $PEER_IP -p 5301 -n $BYTES \$dir" 2>&1)
	        r=\$(printf '%s' "\$out" | sed -n 's/.*throughput *: *\([0-9.]*\) Mbit.*/\1/p' | head -1)
	        c=\$(printf '%s' "\$out" | sed -n 's/.*cost per MiB *: *\([0-9.]*\) us.*/\1/p' | head -1)
	        echo "SAMPLE \$label \${r:-0} \${c:-0}"
	    done
	done
	pkill -f nettput-peer.py 2>/dev/null
EOF
)
printf '%s\n' "$results" | sed 's/^/  /'

# ----------------------------------------------------------------- assert
# Take the best of the repeats per direction. This is a floor check, so one
# unlucky run on a shared virtual NIC must not fail an otherwise good image.
best_of() {
	printf '%s' "$results" | awk -v want="$1" '
		$1 == "SAMPLE" && $2 == want && $3+0 > best { best = $3+0 }
		END { if (best > 0) printf "%.1f", best }'
}
rx=$(best_of RX)
tx=$(best_of TX)
mtu=$(printf '%s' "$results" | sed -n 's/^MTU: \([0-9]*\).*/\1/p' | tail -1)

say "----------------------------------------"
say "MTU $mtu   receive ${rx:-none} Mbit/s (floor $MIN_RX)   transmit ${tx:-none} Mbit/s (floor $MIN_TX)"

fail=0
[ -n "$rx" ] || { say "FAIL: no receive result at all"; fail=1; }
[ -n "$tx" ] || { say "FAIL: no transmit result at all"; fail=1; }
if [ "${mtu:-0}" != "9001" ]; then
	say "FAIL: interface came up at MTU ${mtu:-unknown}, expected 9001 -- jumbo negotiation regressed"
	fail=1
fi
if [ -n "$rx" ] && ! awk -v a="$rx" -v b="$MIN_RX" 'BEGIN{exit !(a>=b)}'; then
	say "FAIL: receive $rx Mbit/s is below the $MIN_RX floor"
	fail=1
fi
if [ -n "$tx" ] && ! awk -v a="$tx" -v b="$MIN_TX" 'BEGIN{exit !(a>=b)}'; then
	say "FAIL: transmit $tx Mbit/s is below the $MIN_TX floor"
	fail=1
fi

[ "$fail" = 0 ] || die "performance gate failed for $AMI"
say "throughput OK: boots, negotiates jumbo, and meets both floors"

# ------------------------------------------------- stop/start regression check
# Haiku could not survive an EC2 stop/start, and nothing above would ever have
# noticed. The instance came back answering ping in 0.17 ms with nothing
# listening on :22. The cause was a generic kernel bug: vm_page_writer.cpp read
# BinarySemaphore::Wait() returning false on *timeout* as "nothing to do" -- but
# that timeout **is** the periodic flush, so a modified-page queue holding fewer
# than 256 pages was never written to disk at all. BFS journals the inode but not
# file data, so the sshd host key came back with the correct size, mode and mtime
# and 411 bytes of zeros, and sshd_boot.sh only regenerated it `if [ ! -f ]` -- a
# zeroed file exists. Ping answered because the kernel was healthy; only the disk
# had lied. The decisive experiment was that the same AMI, given a single `sync`
# before the stop, came back with :22 open in ~15 s.
#
# The measurement above runs on a machine that has been up the whole time, so it
# cannot see any of that. The only way to see it is to actually cycle the
# instance. This costs minutes, and it is worth them: before the fix it failed
# 100% of the time, so it is a real test and not a coin toss. Deliberately no
# `sync` anywhere here -- the point is to test the image as it will be shipped.
say "----------------------------------------"
say "stop/start regression check (an unflushed root filesystem is invisible until now)"

stop_started=$SECONDS
state=$(aws --region "$REGION" ec2 stop-instances --instance-ids "$INSTANCE" \
	--query 'StoppingInstances[].CurrentState.Name' --output text 2>&1)
case "$state" in
	stopping|stopped) ;;
	*) die "stop-instances failed: $state" ;;
esac

stopped=0
deadline=$((SECONDS + STOP_WAIT))
while [ "$SECONDS" -lt "$deadline" ]; do
	sleep 5
	s=$(aws --region "$REGION" ec2 describe-instances --instance-ids "$INSTANCE" \
		--query 'Reservations[0].Instances[0].State.Name' --output text 2>/dev/null)
	[ "$s" = "stopped" ] && { stopped=1; break; }
done
stop_secs=$((SECONDS - stop_started))
[ "$stopped" = 1 ] || die "instance never reached 'stopped' within ${STOP_WAIT}s"
say "reached 'stopped' in ${stop_secs}s"

# A second, independent signal, free now that we are stopping the thing anyway:
# how long the stop took tells us whether the guest handled the power button.
#
# EC2 asks a guest to shut down by pressing the virtual ACPI power button and
# allows roughly 3-4 minutes before it cuts power regardless. So the duration
# discriminates cleanly between the two outcomes: tens of seconds means the guest
# received the event and shut itself down (the new pl061_acpi_event driver did its
# job), whereas consuming the entire grace period means nobody answered and EC2
# pulled the plug.
#
# This is deliberately a WARNING and not a failure. pl061_acpi_event is brand new
# and has never run on hardware, and an unclean stop does not by itself produce a
# bad image -- the stop/start assertion below is what actually protects the data,
# and it stays a hard failure. Failing on the timing instead would let a new
# driver block every bake, and a gate that blocks every bake gets switched off,
# which would cost us the assertion that does matter. Promote this to a failure
# once the driver has a few clean bakes behind it.
#
# The threshold keeps the same margin philosophy as the throughput floors: a
# handled power button shuts down in well under a minute and an unhandled one
# takes 3-4 min, so 180s sits far from both and cannot be reached by variance.
if [ "$stop_secs" -ge "$CLEAN_STOP" ]; then
	warn=1
	say "WARNING ============================================================"
	say "WARNING: the stop took ${stop_secs}s, at or past the ${CLEAN_STOP}s mark."
	say "WARNING: EC2 allows ~3-4 min after the ACPI power button before it cuts"
	say "WARNING: power, so this is the signature of a hard power-off -- the guest"
	say "WARNING: never handled the event. Suspect pl061_acpi_event."
	say "WARNING: NOT failing the build: that driver is new and the data-loss"
	say "WARNING: assertion below is the one that guards the image."
	say "WARNING ============================================================"
else
	say "clean shutdown: ${stop_secs}s is well inside EC2's ~3-4 min ACPI grace period,"
	say "  so the guest handled the power button rather than being force-stopped"
fi

say "starting $INSTANCE again"
state=$(aws --region "$REGION" ec2 start-instances --instance-ids "$INSTANCE" \
	--query 'StartingInstances[].CurrentState.Name' --output text 2>&1)
case "$state" in
	pending|running) ;;
	*) die "start-instances failed: $state" ;;
esac

running=0
deadline=$((SECONDS + START_WAIT))
while [ "$SECONDS" -lt "$deadline" ]; do
	sleep 5
	s=$(aws --region "$REGION" ec2 describe-instances --instance-ids "$INSTANCE" \
		--query 'Reservations[0].Instances[0].State.Name' --output text 2>/dev/null)
	[ "$s" = "running" ] && { running=1; break; }
done
[ "$running" = 1 ] || die "instance never returned to 'running' within ${START_WAIT}s"

# A stop/start keeps the primary ENI, so this is the same private address -- but
# re-resolve instead of assuming. If it ever did change, the symptom would be
# "sshd never came back", and the next reader would go hunting for a filesystem
# bug that was not there.
IP2=$(aws --region "$REGION" ec2 describe-instances --instance-ids "$INSTANCE" \
	--query 'Reservations[0].Instances[0].PrivateIpAddress' --output text 2>/dev/null)
if [ -n "$IP2" ] && [ "$IP2" != "None" ] && [ "$IP2" != "$IP" ]; then
	say "note: private IP moved $IP -> $IP2 across the stop/start"
	IP="$IP2"
fi

# Retries only the case that deserves it. An ICMP-answering node is a real
# verdict either way and is decided immediately; a node with no ICMP at all is the
# apparatus, and gets up to two more cold cycles before anything is concluded.
# "We could not tell" must resolve to neither "ship it" nor "block it" without
# having tried again.
sshd_ok=0
icmp=unknown
tcp=unknown
probe_log=""
attempt=0
while [ "$attempt" -lt 3 ]; do
	attempt=$((attempt + 1))

	if wait_for_sshd "after stop/start (attempt $attempt)" "$BOOT_WAIT"; then
		sshd_ok=1
		break
	fi

	# "Nothing on :22" had one cause when this gate was written and now has at
	# least three, so probe before naming one. The message used to assert the
	# instance was "reachable at the network level" without checking it, which
	# points the reader at the page writer even when the NIC is gone.
	#
	# The three separate by measurement rather than by reasoning: during the
	# page-writer starvation ICMP answered and :22 accepted the connection at
	# every one of ~72 samples and only the banner never arrived, whereas a lost
	# NIC gives no ICMP at all.
	#
	# Probe from the builder over SSM, not from here. This script runs in a
	# CodeBuild container with no VpcConfig, so it has no route into the test
	# subnet: probing from here read "fail" for every candidate regardless of what
	# the node was doing, which made the ICMP fast path below unreachable and left
	# the verdict at the end asserting a cause it had not measured. The builder is
	# also the origin the sshd wait uses, so the probe and the thing it explains
	# now agree about whose network path they are describing.
	#
	# "unknown" is a third outcome and not folded into "fail": if the probe channel
	# itself does not answer, that is a fact about this gate and not about the
	# image, and it must not be reported as a dead NIC -- which is precisely the
	# error the CodeBuild-side probe committed silently.
	probe=$("$SSM_RUN" "$BUILDER" -t 120 -q 2>/dev/null <<-EOF
		i=fail
		ping -c 3 -W 2 $IP >/dev/null 2>&1 && i=ok
		t=fail
		timeout 8 bash -c "cat < /dev/null > /dev/tcp/$IP/22" 2>/dev/null && t=ok
		echo "GATE_PROBE icmp=\$i tcp=\$t"
	EOF
	)
	probe_line=$(printf '%s' "$probe" | grep -o 'GATE_PROBE icmp=[a-z]* tcp=[a-z]*' | tail -1)
	if [ -n "$probe_line" ]; then
		icmp=fail; tcp=fail
		case "$probe_line" in *icmp=ok*) icmp=ok ;; esac
		case "$probe_line" in *tcp=ok*) tcp=ok ;; esac
		say "probe from the builder after the failed sshd wait: ICMP=$icmp TCP:22=$tcp banner=no"
	else
		icmp=unknown; tcp=unknown
		say "probe from the builder did not report (ssm-run gave no GATE_PROBE line);"
		say "  treating ICMP/TCP as unknown rather than as failed"
	fi
	probe_log="$probe_log attempt$attempt:ICMP=$icmp,TCP=$tcp"

	# ICMP answering means the guest is alive and this is a genuine verdict about
	# the image. Do not retry it -- retrying a real failure is how a gate learns
	# to pass bad images.
	[ "$icmp" = ok ] && break

	if [ "$attempt" -lt 3 ]; then
		recycle_instance "ICMP=$icmp on attempt $attempt" \
			|| say "  recycle failed; will decide on the evidence so far"
	fi
done

if [ "$sshd_ok" != 1 ]; then
	if [ "$icmp" = unknown ]; then
		die "FAIL: $AMI never brought sshd up, and the ICMP/TCP probe could not be
  run at all -- ssm-run to the builder returned no GATE_PROBE line on any attempt.
  So this run carries NO evidence about the node: it is not a NIC verdict, not a
  storage verdict, and not a page-writer verdict. Fix the probe path (or the
  builder) before reading anything into it, and capture the console output.
  Do not promote, and do not record this as a diagnosed failure."
	fi

	if [ "$icmp" = fail ]; then
		die "FAIL: $AMI never answered ICMP after 3 stop/start attempts.
  The guest is not reachable at all, so this is NOT the data-loss signature and
  NOT a storage verdict -- there is no evidence either way about the filesystem.
  Probed from the builder:$probe_log. Capture the console output and find out why
  the node has no network before promoting anything. Do not promote."
	fi

	if [ "$tcp" = ok ]; then
		die "FAIL: $AMI answers ICMP and accepts TCP on :22 but never sends an
  ssh banner. The kernel, the interrupt path and the NIC are alive and userland is
  not making progress -- this is the page-writer starvation signature, NOT the
  present-but-zeroed data-loss one. Check the console for 'quota wait timed out'
  and run page_writer_quota in KDL. Do not promote this image."
	fi

	die "FAIL: $AMI answers ICMP but refuses TCP on :22 after a stop/start.
  The network stack is up and sshd is not listening. The likeliest cause remains
  the data-loss signature this gate was built for: the sshd host key, or whatever
  else was still sitting in a short modified-page queue, is present-but-zeroed, so
  sshd cannot start. See the page-writer periodic-flush fix. Do not promote this
  image."
fi

if [ "$attempt" -gt 1 ]; then
	warn=1
	say "WARNING: sshd only answered on attempt $attempt. What the earlier attempts"
	say "WARNING: actually measured, and nothing more:$probe_log"
	say "WARNING: A recovered boot has more than one possible cause -- among them a"
	say "WARNING: /dev scan that latched an empty result, which leaves the adapter"
	say "WARNING: undiscovered on an otherwise healthy boot. Read the probe readings"
	say "WARNING: above and the console log; do not assume a hardware intermittent."
fi

# ------------------------------------------------------------------- verdict
say "----------------------------------------"
if [ "$warn" = 1 ]; then
	# Deliberately does not name a cause: there is now more than one thing that
	# sets warn, and asserting the wrong one is exactly the failure this gate's
	# stop/start message already made once.
	say "PASS WITH WARNINGS: $AMI boots, negotiates jumbo, meets both floors and"
	say "  survives a stop/start. See the WARNING lines above for what was off."
	exit 0
fi
say "PASS: $AMI boots, negotiates jumbo, meets both floors, types files with"
say "  mimeset, survives the mprotect probe, shuts down cleanly in ${stop_secs}s, and comes back from a"
say "  stop/start with sshd answering"
exit 0
