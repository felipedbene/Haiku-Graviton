#!/usr/bin/env bash
#
# ssm-run -- run a shell script on a Graviton instance and get all of its output.
#
# Three traps this exists to avoid, each of which has already cost a wrong
# conclusion at least once:
#
#  1. `--parameters commands=...` uses the CLI shorthand parser, which splits on
#     commas. Any script containing a comma (a grep character class, an awk
#     field list, a C expression) is silently mangled into nonsense that still
#     "succeeds". The script is therefore base64-encoded and decoded on the far
#     side, so the transport carries no shell metacharacters at all.
#  2. get-command-invocation truncates StandardOutputContent at 24 KB. A build
#     log read that way ends mid-sentence and looks like a build that stopped.
#     Output goes to S3 and is fetched from there, so it is complete or the
#     script says so.
#  3. A polling loop with no deadline hangs a session on an instance whose SSM
#     agent has gone away.
#  4. SendCommand caps its document plus parameters at 97 KB, so a large script
#     cannot ride in the request at all. Past a threshold the script is staged in
#     S3 and the request carries only a fetch-and-exec. See kInlinePayloadMax.
#
# Usage:
#   ssm-run <instance-id> <<'EOF'          # script on stdin
#   ...commands...
#   EOF
#   ssm-run <instance-id> -f script.sh
#
#   -t <seconds>   wall-clock deadline (default 900)
#   -q             print only the command output, no progress chatter
#
# Exit code is the remote script's exit code where SSM reports one, 1 on a
# transport or timeout failure -- so `ssm-run ... && echo ok` means what it looks
# like it means.

set -uo pipefail

# Resolve this account's credentials the same way every tool here does: obey an
# explicit choice, keep working ambient credentials, else adopt the project
# profile. Shared so a tool cannot report "no AWS credentials" while valid ones
# sit one variable away.
. "$(cd -- "$(dirname -- "$0")" && pwd)/haiku-aws-env.sh"

REGION="${HAIKU_GRAVITON_REGION:-us-west-2}"
BUCKET="${HAIKU_GRAVITON_BUCKET:-}"
PREFIX="${HAIKU_GRAVITON_SSM_PREFIX:-ssm-out}"
DEADLINE_SECS=900
QUIET=0
SCRIPT_FILE=""

die() { printf 'ssm-run: %s\n' "$*" >&2; exit 1; }
chatter() { [ "$QUIET" = 1 ] || printf 'ssm-run: %s\n' "$*" >&2; }

# The bucket this project routes command output through is named
# haiku-graviton-<account>-<region>. The account id is not written down anywhere
# in the tree -- this is a public repository -- so it is resolved once, here, from
# whatever credentials the caller already has, and every other script in
# graviton/ follows the same convention. HAIKU_GRAVITON_BUCKET names a different
# bucket outright and skips the lookup.
#
# The account id is checked rather than interpolated blind. A failed or empty
# lookup would otherwise compose "haiku-graviton--us-west-2": a syntactically
# valid bucket name that belongs to nobody, so the run would fail later with an
# access error pointing at the wrong thing. Failing here names the real problem.
if [ -z "$BUCKET" ]; then
	ACCOUNT=$(aws --region "$REGION" sts get-caller-identity \
		--query Account --output text) || ACCOUNT=""
	case "$ACCOUNT" in
		"" | *[!0-9]*)
			die "cannot resolve the AWS account id (aws sts get-caller-identity);
  refresh credentials, or set HAIKU_GRAVITON_BUCKET to the output bucket" ;;
	esac
	BUCKET="haiku-graviton-$ACCOUNT-$REGION"
fi

[ $# -ge 1 ] || die "usage: ssm-run <instance-id> [-f script] [-t secs] [-q]"
INSTANCE="$1"; shift

while getopts "f:t:q" opt; do
	case "$opt" in
		f) SCRIPT_FILE="$OPTARG" ;;
		t) DEADLINE_SECS="$OPTARG" ;;
		q) QUIET=1 ;;
		*) die "bad option" ;;
	esac
done

req=$(mktemp -t ssm-run.XXXXXX.json) || die "cannot create a temp file"
remote_file=$(mktemp -t ssm-run.XXXXXX.sh) || die "cannot create a temp file"
body=$(mktemp -t ssm-run.XXXXXX.body) || die "cannot create a temp file"
trap 'rm -f "$req" "$remote_file" "$body"' EXIT

# Keep the script itself on disk, not just its base64. The large-payload path
# below has to upload the bytes, and reading stdin twice is not an option.
if [ -n "$SCRIPT_FILE" ]; then
	[ -r "$SCRIPT_FILE" ] || die "cannot read $SCRIPT_FILE"
	cp -- "$SCRIPT_FILE" "$body" || die "cannot read $SCRIPT_FILE"
else
	cat > "$body"
fi
[ -s "$body" ] || die "empty script"
payload=$(base64 -w0 < "$body")

# A unique prefix per run, so concurrent runs never read each other's output.
run_id="run-$$-$(od -An -N3 -tx1 /dev/urandom | tr -d ' \n')"
s3_prefix="$PREFIX/$run_id"

# How much base64 we are willing to put in the SendCommand request itself.
#
# SendCommand caps the document plus all of its parameters at 97 KB server-side,
# and rejects the whole call with MaxDocumentSizeExceeded when the sum goes over.
# 64 KiB of base64 is 48 KiB of script, which is more than any hand-written
# remote step here, and it leaves the rest of the budget for the document and
# the other parameters rather than guessing how large they are.
kInlinePayloadMax=65536

# AWS-RunShellScript runs its commands under /bin/sh, which on Amazon Linux is
# dash: no `set -o pipefail`, and several bashisms a build script will reasonably
# use are missing. So the wrapper stays strictly POSIX and hands the decoded
# script to bash, where pipefail is set for it -- a failing stage in a pipeline
# must not be hidden by a succeeding tail.
if [ "${#payload}" -le "$kInlinePayloadMax" ]; then
	remote="printf '%s' '$payload' | base64 -d > /tmp/$run_id.sh
bash -o pipefail /tmp/$run_id.sh
rc=\$?
rm -f /tmp/$run_id.sh
exit \$rc"
else
	# Too big to inline, so the script travels the same way its output does: via
	# S3, under this run's own prefix, with only a fetch-and-exec in the request.
	#
	# This is the second of two separate size ceilings on this path, and the one
	# that is not local. The first was execve()'s MAX_ARG_STRLEN below; fixing it
	# got the request built, and SendCommand then refused it with
	# MaxDocumentSizeExceeded -- the base64 of the publish bundle is ~112 KB
	# against a 97 KB API limit. No amount of local plumbing moves that, so the
	# payload has to stop being a parameter.
	#
	# The cost is that the far side now needs an S3 client, which rules out Haiku
	# targets (issue 728: the image has awscli nowhere, only single-file
	# `debeos-ssm-agent s3 cp`). That is why this is a size-triggered fallback and
	# not the only path -- every Haiku-side caller stays well under the inline
	# limit, and the callers that do not are the Ubuntu publisher peers, which
	# have awscli by construction.
	script_s3="s3://$BUCKET/$s3_prefix/script.sh"
	chatter "script is $(wc -c < "$body" | tr -d ' ') bytes: too large to inline,"
	chatter "  staging it at $script_s3"
	aws --region "$REGION" s3 cp "$body" "$script_s3" --only-show-errors \
		|| die "cannot stage the script at $script_s3"

	# `|| exit 1` rather than letting bash run a file that is not there: a failed
	# fetch and a script that genuinely exited 1 would otherwise be the same
	# observation, and the stderr above says which happened.
	remote="aws s3 cp '$script_s3' /tmp/$run_id.sh --region '$REGION' --only-show-errors || exit 1
bash -o pipefail /tmp/$run_id.sh
rc=\$?
rm -f /tmp/$run_id.sh
exit \$rc"
fi

# Hand the wrapper to python through a FILE, not through the environment.
#
# This used to be REMOTE="$remote" on the command line below. The environment is
# counted against the same execve() limit as argv, and Linux caps any single
# string there at MAX_ARG_STRLEN -- 32 pages, 128 KiB -- independently of the
# generous total. $remote carries the base64 of the whole script bundle, which is
# 4/3 of its size, so a bundle over about 96 KiB makes execve() fail with E2BIG
# and bash reports "Argument list too long" against /usr/bin/python3. That is
# what it looked like from the outside: a publish that had already launched its
# peer and uploaded its packages died with python3 apparently missing, and the
# only thing that had changed was the coherence gate (issues 708, 754, 772)
# growing the bundle past the limit.
#
# A file has no such ceiling, and it keeps the payload out of /proc/<pid>/environ
# as a side benefit.
printf '%s' "$remote" > "$remote_file" || die "cannot stage the remote script"

INSTANCE="$INSTANCE" REMOTE_FILE="$remote_file" BUCKET="$BUCKET" \
	S3PREFIX="$s3_prefix" TIMEOUT="$DEADLINE_SECS" python3 -c '
import json, os, sys
with open(os.environ["REMOTE_FILE"]) as f:
    remote = f.read()
json.dump({
    "InstanceIds": [os.environ["INSTANCE"]],
    "DocumentName": "AWS-RunShellScript",
    "Parameters": {"commands": [remote],
                   "executionTimeout": [str(max(60, int(os.environ["TIMEOUT"])))]},
    "OutputS3BucketName": os.environ["BUCKET"],
    "OutputS3KeyPrefix": os.environ["S3PREFIX"],
}, open(sys.argv[1], "w"))
' "$req" || die "cannot build the request"

cid=$(aws --region "$REGION" ssm send-command --cli-input-json "file://$req" \
	--query 'Command.CommandId' --output text 2>&1)
case "$cid" in
	""|None|*error*|*Error*) die "send-command failed: $cid" ;;
esac
chatter "command $cid on $INSTANCE (s3://$BUCKET/$s3_prefix)"

status=""
deadline=$((SECONDS + DEADLINE_SECS))
while [ $SECONDS -lt $deadline ]; do
	sleep 5
	status=$(aws --region "$REGION" ssm get-command-invocation \
		--command-id "$cid" --instance-id "$INSTANCE" \
		--query Status --output text 2>/dev/null)
	case "$status" in
		Success|Failed|Cancelled|TimedOut) break ;;
	esac
done

# S3 is the source of truth for the output; the inline copy is only a fallback
# for the case where the instance profile cannot write to the bucket.
out=$(aws --region "$REGION" s3 cp \
	"s3://$BUCKET/$s3_prefix/$cid/$INSTANCE/awsrunShellScript/0.awsrunShellScript/stdout" \
	- 2>/dev/null)
err=$(aws --region "$REGION" s3 cp \
	"s3://$BUCKET/$s3_prefix/$cid/$INSTANCE/awsrunShellScript/0.awsrunShellScript/stderr" \
	- 2>/dev/null)

if [ -z "$out" ] && [ -z "$err" ]; then
	chatter "no S3 output found, falling back to the truncated inline copy"
	out=$(aws --region "$REGION" ssm get-command-invocation --command-id "$cid" \
		--instance-id "$INSTANCE" --query StandardOutputContent --output text 2>/dev/null)
	err=$(aws --region "$REGION" ssm get-command-invocation --command-id "$cid" \
		--instance-id "$INSTANCE" --query StandardErrorContent --output text 2>/dev/null)
fi

[ -n "$out" ] && printf '%s\n' "$out"
[ -n "$err" ] && printf '%s\n' "$err" >&2

case "$status" in
	Success)
		chatter "Success"
		exit 0
		;;
	""|Pending|InProgress|Delayed)
		chatter "still running after ${DEADLINE_SECS}s -- command id $cid"
		exit 1
		;;
	*)
		rc=$(aws --region "$REGION" ssm get-command-invocation --command-id "$cid" \
			--instance-id "$INSTANCE" --query ResponseCode --output text 2>/dev/null)
		chatter "$status (exit ${rc:-unknown})"
		case "$rc" in
			''|*[!0-9-]*) exit 1 ;;
			*) [ "$rc" -gt 0 ] && exit "$rc" || exit 1 ;;
		esac
		;;
esac
