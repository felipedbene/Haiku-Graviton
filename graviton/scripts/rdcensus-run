#!/bin/bash
#
# rdcensus-run -- drive the M2 byte-census / pricing capture matrix (#58).
#
# Runs ON the Graviton instance, against app_server's RemoteHWInterface on
# loopback, so the bytes counted are the bytes app_server actually emits with no
# tunnel, no websockify and no host-side compression in the way.
#
# Each workload is captured TRIALS times.  A single capture of a desktop is not a
# measurement: first paint, the Deskbar clock ticking over a minute boundary and
# whatever the pulse view is doing all move the totals, so the report quotes a
# median and a spread across trials rather than one run's number.
#
# Every capture writes a wire dump, which rdprice.py then prices offline.  The
# capture and the pricing are deliberately separate programs: the pricing arms
# get re-run and argued with many times, and re-capturing to re-price would make
# every pricing change a new experiment with new data.
#
# Usage: rdcensus-run [TRIALS] [SECONDS]

set -u

TRIALS="${1:-3}"
SECONDS_PER="${2:-30}"
PY=python3.10
PORT=10900
COOKIE=/boot/system/settings/remote_desktop/session_cookie.$PORT
W=1200
H=760
OUT=/boot/home/m2
mkdir -p "$OUT"

# The screen size is asserted, not assumed.  RemoteHWInterface takes its mode
# from the client, so --width/--height IS the screen -- but only if the server
# honoured it, and a workload aimed at a screen that is not there is the #525
# failure.  rdcapture refuses off-screen coordinates itself; this line records
# what was asked for so the report can be checked against it.
echo "SCREEN_REQUESTED=${W}x${H} TRIALS=$TRIALS SECONDS=$SECONDS_PER"

run_one() {
	local name="$1" trial="$2"
	local tag="${name}-t${trial}"
	echo "=== $tag ==="
	$PY /boot/home/rdcapture.py \
		--port "$PORT" --cookie-file "$COOKIE" \
		--width "$W" --height "$H" --seconds "$SECONDS_PER" \
		--answer-string-width \
		--workload "$name" \
		--wire-dump "$OUT/$tag.dump" \
		--json "$OUT/$tag.json" \
		--allow-text-estimate \
		> "$OUT/$tag.log" 2>&1
	local rc=$?
	# Report the census lines and the verdict, not the whole log.
	grep -E "^WORKLOAD|^plain stream|^BITMAP_|^COPY_RECT_|^TEXT_PATH_|^OTHER_BYTES|^MESSAGES|^STOP" \
		"$OUT/$tag.log" 2>/dev/null
	echo "rc=$rc"
}

for name in idle menu text scroll window; do
	for t in $(seq 1 "$TRIALS"); do
		run_one "$name" "$t"
		sleep 2
	done
done

# --- the heavy arm -------------------------------------------------------
#
# WebPositive is NOT on this image (the lean base is @minimum-mmc; browsers vend
# from the package repo), so the heavy arm is NetSurf, installed from the repo,
# rendering a local page with real text and real images.  Stated plainly because
# "a browser rendering a page" and "WebPositive rendering a page" are different
# claims and only the first one is being made.
if [ -x /boot/system/apps/NetSurf/NetSurf ]; then
	for t in $(seq 1 "$TRIALS"); do
		echo "=== heavy-t$t ==="
		# GUI apps launched over ssh need TARGET_SCREEN or BApplication exits 0
		# silently -- the app would never appear and the arm would quietly
		# measure an idle desktop under the name 'heavy'.
		TARGET_SCREEN=$PORT /boot/system/apps/NetSurf/NetSurf \
			file:///boot/home/m2/heavy.html >/dev/null 2>&1 &
		nspid=$!
		sleep 6
		$PY /boot/home/rdcapture.py \
			--port "$PORT" --cookie-file "$COOKIE" \
			--width "$W" --height "$H" --seconds "$SECONDS_PER" \
			--answer-string-width \
			--workload scroll \
			--wire-dump "$OUT/heavy-t$t.dump" \
			--json "$OUT/heavy-t$t.json" \
			--allow-text-estimate \
			> "$OUT/heavy-t$t.log" 2>&1
		echo "rc=$?"
		grep -E "^WORKLOAD|^plain stream|^BITMAP_|^COPY_RECT_|^TEXT_PATH_|^OTHER_BYTES" \
			"$OUT/heavy-t$t.log" 2>/dev/null
		kill $nspid 2>/dev/null
		sleep 3
	done
else
	echo "HEAVY_ARM=UNAVAILABLE (no NetSurf at /boot/system/apps/NetSurf/NetSurf)"
fi

echo "=== dumps ==="
ls -la "$OUT"/*.dump 2>/dev/null
