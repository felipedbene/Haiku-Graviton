# DeBeOS #93 — uucore 0.12.0 Haiku portability: fsext statvfs + read_fs_list
#
# `StatFs`/`statfs_fn` are aliased to libc::statvfs only for an enumerated set
# of statvfs OSes; Haiku was in neither the statfs nor the statvfs list, so both
# were undefined and `read_fs_list()` had no Haiku arm. Haiku has POSIX statvfs
# (block-count fields fsblkcnt_t/fsfilcnt_t are SIGNED i64, unlike the unsigned
# fields other 64-bit platforms use), and enumerates mounts through the BeOS
# fs_info API (next_dev/fs_stat_dev), not /proc/mounts or getmntinfo().
#
# Fix:
#   * add target_os = "haiku" to the statvfs StatFs/statfs_fn groups;
#   * give FsUsage::new and the FsMeta count accessors Haiku arms that cast the
#     signed i64 counts to u64 (other 64-bit platforms return them directly);
#   * implement read_fs_list() for Haiku via next_dev/fs_stat_dev. fs_info has
#     no mount-point path (that needs the Storage Kit), so mount_dir is set for
#     the root volume via dev_for_path("/"); df's fs_usage() falls back to
#     statfs(dev_name) for the rest, and `df <path>`/`stat`/`du`/`ls` use the
#     path directly.
#
# Unlocks `ls` (and dir/vdir) to compile, and `df`/`du`/`stat` to build and run.
# Applied with `patch -p1`.
--- a/src/lib/features/fsext/mod.rs
+++ b/src/lib/features/fsext/mod.rs
@@ -69,6 +69,7 @@
     target_os = "solaris",
     target_os = "redox",
     target_os = "cygwin",
+    target_os = "haiku",
 ))]
 pub use libc::statvfs as StatFs;
 
@@ -88,6 +89,7 @@
     target_os = "dragonfly",
     target_os = "redox",
     target_os = "cygwin",
+    target_os = "haiku",
 ))]
 pub use libc::statvfs as statfs_fn;
 
@@ -398,6 +400,53 @@
     {
         windows::read_fs_list()
     }
+    #[cfg(target_os = "haiku")]
+    {
+        // Haiku has neither /proc/mounts nor getmntinfo(); enumerate mounted
+        // volumes with the BeOS `fs_info` API (next_dev/fs_stat_dev). fs_info
+        // carries the device name, volume name and fs-handler name, but NOT the
+        // mount-point path (resolving that needs the Storage Kit / BVolume). We
+        // set mount_dir for the root volume via dev_for_path("/"); for the rest
+        // it is left empty, in which case df's fs_usage() falls back to
+        // statfs(dev_name).
+        let root_dev = unsafe { libc::dev_for_path(c"/".as_ptr()) };
+        let mut mounts = Vec::new();
+        let mut pos: i32 = 0;
+        loop {
+            let dev = unsafe { libc::next_dev(&raw mut pos) };
+            if dev < 0 {
+                break; // B_BAD_VALUE: no more devices
+            }
+            let mut info: libc::fs_info = unsafe { mem::zeroed() };
+            if unsafe { libc::fs_stat_dev(dev, &raw mut info) } != 0 {
+                continue;
+            }
+            let dev_name = unsafe { CStr::from_ptr(info.device_name.as_ptr()) }
+                .to_string_lossy()
+                .into_owned();
+            let fs_type = unsafe { CStr::from_ptr(info.fsh_name.as_ptr()) }
+                .to_string_lossy()
+                .into_owned();
+            let mount_dir = if dev == root_dev {
+                OsString::from("/")
+            } else {
+                OsString::new()
+            };
+            let remote = is_remote_filesystem(&dev_name, &fs_type);
+            let dummy = is_dummy_filesystem(&fs_type, "");
+            mounts.push(MountInfo {
+                dev_id: dev.to_string(),
+                dev_name,
+                fs_type,
+                mount_root: OsString::new(),
+                mount_dir,
+                mount_option: String::new(),
+                remote,
+                dummy,
+            });
+        }
+        Ok(mounts)
+    }
