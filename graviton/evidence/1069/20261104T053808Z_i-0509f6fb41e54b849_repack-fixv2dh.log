syslog_buffer_size 262144
	# The default size of the internal syslog ring buffer - if you often see
	# <DROP> or <TRUNC> messages in your syslog, you might want to increase
	# this value. Defaults to 65536 (bytes). 262144 is the largest the kernel
	# accepts.
	#
	# Raised from the default here because the ring cannot be drained to
	# /var/log/syslog until userland is running, so everything the kernel
	# prints before the boot volume is mounted has to fit in it at once. At
	# 65536 a machine with many PCI devices evicted its own early boot log --
	# including the interrupt controller's summary -- before anything could
	# read it, which made an entire class of regression invisible. Costs
	# 192 KiB of kernel memory.

#syslog_time_stamps true
	# Include time stamps in syslog debug output, defaults to false.

#syslog_max_history 7
	# Maximum number of old syslogs to keep.  The files are named
	# syslog.1, syslog.2, syslog.3,... with syslog.1 being the newest.
	# Defaults to 1, using 0 will disable this and syslog will be recreated
	# when it reaches syslog_max_size.

#syslog_max_size 20MB
	# Sets the maximum syslog file size, default is 512kB.

#bochs_debug_output true
	# Activates Bochs debug output if enabled in the kernel (available on x86
	# as a build option only)

#laplinkll_debug_output true
	# Activates parallel debug output. Requires a laplink cable and a custom
	# driver on the other end.

#qemu_single_step_hack true
	# Activates a hack that allows single-stepping under QEMU to work.

arm64_pmu true
	# arm64 only: enable the PMUv3 at boot so the kernel can measure the core
	# clock (sysinfo shows real MHz instead of 0) and expose the on-demand
	# hardware-counter facility (the "pmu" KDL command: cpu-cycles, inst-retired,
	# cache/TLB-refill MPKI, branch-mispredict, frontend/backend stall). Default
	# OFF upstream because EL2 (a hypervisor) may trap EL1 PMU access
	# (MDCR_EL2.TPM) and fault an unconditional boot-time probe. AWS Graviton
	# deliberately exposes the PMU to guests (Graviton4: 21 PMU events to guests),
	# and boot-enable was hardware-verified safe on a virtualized c7g.large
	# (booted clean, sysinfo read 2598 MHz). Ignored on x86. On other arm64
	# targets whose EL2 traps the PMU (some SoCs), comment this out.
