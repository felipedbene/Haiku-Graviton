# | for i in ext2-1011 ext2-stk; do truncate -s 256M $i.img; mkfs.ext2 -q -F $i.img || exit 1; done
# | dumpe2fs -h ext2-1011.img 2>/dev/null | grep -E "features|Block size|Inode count"
# | mkdir -p m && mount -t ext4 -o loop ext2-1011.img m || exit 1
# | mkdir m/lbig && for i in $(seq -w 1 3000); do : > m/lbig/linux-created-entry-$i; done
# | lsattr -d m/lbig; ls -ld m/lbig; ls m/lbig | wc -l
# | umount m
# | debugfs -R "htree lbig" ext2-1011.img 2>/dev/null | head -8
# | dumpe2fs -h ext2-1011.img 2>/dev/null | grep -E "features"
# | e2fsck -fn ext2-1011.img; echo "e2fsck pristine-1011 rc=$?"
# | e2fsck -fn ext2-stk.img; echo "e2fsck pristine-stk rc=$?"
# | sha256sum ext2-1011.img ext2-stk.img
# | B=s3://haiku-graviton-$(aws sts get-caller-identity --query Account --output text)-us-west-2/fs1011
