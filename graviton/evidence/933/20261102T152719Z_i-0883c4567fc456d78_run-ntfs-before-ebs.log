# evidence: run-ntfs-before-ebs
# instance: i-0883c4567fc456d78   region: us-west-2
# ssm command: 59a30ace-b7e6-4ff3-a6ec-7580b98a3609 (agent status: detached)
# start: 20261102T152719Z   end: 20261102T152731Z   rc: 0   log bytes: 40548
# script sha256: ddd47649757c6180627630f77d006761a7c6732b5043ac2368d5a10b1e929a5f
# ---- script ----
# | # Issue 933 "before" on EBS: the NTFS EBS volume was present at boot, so the DDM
# | # bound it to the boot-loader-preloaded packaged ntfs (KPartition::SetDiskSystem
# | # keeps it loaded). That packaged file is byte-identical to the trunk build
# | # (sha256 2dc15f09...). The unused non-packaged copy from the aborted first run
# | # is removed so nothing else could be meant. atime898/atime933 already compiled
# | # in /boot/home/t933 by that run; atime933 is checked against its source here.
# | set -x
# | uname -a
# | cd /boot/home/t933 || exit 1
# | echo '' | base64 -d > atime933.c.now; [ "$(sha256sum < atime933.c)" = "$(sha256sum < atime933.c.now)" ] || exit 1
# | D=/boot/home/config/non-packaged/add-ons/kernel/file_systems
# | sha256sum $D/ntfs; rm -f $D/ntfs
# | echo "2dc15f09aed3104b6010e5bd875f0e8d13a3dea01d5bf9c4bb701fb6b281f99c  /boot/system/add-ons/kernel/file_systems/ntfs" | sha256sum -c || exit 1
# | echo "--- loaded ntfs image"; listimage 1 | grep -E " ntfs$|file_systems/ntfs"
# | listimage 1 | grep -q "non-packaged/add-ons/kernel/file_systems/ntfs" && { echo "a non-packaged ntfs is loaded: abort"; exit 1; }
# | df /ntfs | grep -E "Mounted|Device No|Volume Name"
# | mkdir -p /ntfs/a933 && ls -ld /ntfs/a933 || exit 1
# | echo "=== atime898 ntfs (trunk, unmodified)"
# | ./atime898 /ntfs/a933; echo "atime898 ntfs rc=$?"
# | echo "=== atime933 ntfs"
# | ./atime933 /ntfs/a933; echo "atime933 ntfs rc=$?"
# | mkdir -p /boot/home/a933 && chmod 0777 /boot/home/a933
# | echo "=== atime933 bfs (control)"
# | ./atime933 /boot/home/a933; echo "atime933 bfs rc=$?"
# | echo "=== direct: coreutils on ntfs"
# | f=/ntfs/a933/demo; rm -f $f; echo x > $f; ls -l $f
# | truncate -s 10 $f; echo "root truncate -s 10 rc=$? size=$(stat -c %s $f)"
# | ./atime898 --as 1002 1002 truncate -s 20 $f; echo "size=$(stat -c %s $f)"
# | touch -d @1000000000 $f
# | ./atime898 --as 1002 1002 touch $f; echo "uid1002 touch (now): $(stat -c '%X %Y' $f)"
# | touch -d @1000000000 $f
# | ./atime898 --as 1002 1002 touch -d @1234567890 $f; echo "uid1002 touch -d (explicit): $(stat -c '%X %Y' $f)"
# | ./atime898 --as 1002 1002 chmod 0644 $f; echo "mode=$(stat -c %a $f)"
# | rm -f $f
# | echo "--- syslog"; grep -aiE "ntfs|panic|assert" /var/log/syslog | tail -20
