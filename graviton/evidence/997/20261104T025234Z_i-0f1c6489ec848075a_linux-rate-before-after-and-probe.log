== measurement script /tmp/m997.sh
# m997.sh <node> <srcdir> <label> <N>   -- issue 997 before/after rates
set -u
NODE=$1; SRC=$2; LABEL=$3; N=$4
T=parallel/test-perf-hooks-sliding-window-histogram
P=/tmp/node-sliding-window-phase.js
cd $SRC || exit 1
echo "## host: $(uname -a)"; echo "## node: $($NODE --version)  label=$LABEL N=$N"
sha256sum test/$T.js
run_variant() {  # $1 = variant name (file already in place)
  v=$1
  echo "######## [$v] alone, sequential x$N"
  ok=0; bad=0; i=0
  while [ $i -lt $N ]; do i=$((i+1))
    if : | timeout 60 $NODE test/$T.js > /tmp/o997.txt 2>&1; then ok=$((ok+1)); else bad=$((bad+1)); [ $bad -le 2 ] && grep -m3 -E "Assertion|!==|at " /tmp/o997.txt; fi
  done
  echo "RESULT [$v] alone: pass=$ok fail=$bad of $N"
  echo "######## [$v] tools/test.py -j 16 --repeat $N"
  : | python3 tools/test.py --shell=$NODE -j 16 -p tap --repeat $N $T > /tmp/rep997.tap 2>&1
  echo "RESULT [$v] -j16: ok=$(grep -c '^ok ' /tmp/rep997.tap) notok=$(grep -c '^not ok ' /tmp/rep997.tap) timeout=$(grep -c '^    timeout$' /tmp/rep997.tap)"
  awk '/^not ok/{p=1;n++} p&&n<=1' /tmp/rep997.tap | grep -m4 -E "not ok|!==|Assertion"
}
cp test/$T.js /tmp/orig997.js
run_variant before-24.22.2
cp /tmp/deflaked997.js test/$T.js; sha256sum test/$T.js
run_variant after-upstream-147ade5ff9
cp /tmp/orig997.js test/$T.js
for args in "200 1" "250 2"; do
  echo "######## probe ($args) x$N, one process per trial"
  i=0; : > /tmp/probe997.txt
  while [ $i -lt $N ]; do i=$((i+1)); timeout 60 $NODE $P $args >> /tmp/probe997.txt 2>&1; done
  echo "RESULT probe ($args): pass=$(grep -c PASS /tmp/probe997.txt) fail=$(grep -c FAIL /tmp/probe997.txt) of $N"
  grep FAIL /tmp/probe997.txt | head -5
  # wake phase histogram: wake_ms - delay, bucketed to 0.25 ms
  awk -v d=${args% *} '{split($1,a,"="); x=a[2]-d; b=sprintf("%.2f", int(x*4)/4); if (x<0 && x*4!=int(x*4)) b=sprintf("%.2f",(int(x*4)-1)/4); c[b]++} END{for (k in c) print "  wake-delay " k " ms: " c[k]}' /tmp/probe997.txt | sort -t' ' -k3 -g | head -40
  awk '{split($2,a,"="); s+=a[2]; n++} END{printf "  mean pair_us=%.1f over %d\n", s/n, n}' /tmp/probe997.txt
done
echo M997_DONE
