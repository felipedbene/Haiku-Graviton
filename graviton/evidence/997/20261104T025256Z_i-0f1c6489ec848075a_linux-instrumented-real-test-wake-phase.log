== measurement script /tmp/m997i.sh
# m997i.sh <node> <srcdir> <label> <N> -- issue 997: the real test, instrumented to print its wakeup phase
set -u
NODE=$1; SRC=$2; LABEL=$3; N=$4
T=test/parallel/test-perf-hooks-sliding-window-histogram.js
cd $SRC || exit 1; cp $T /tmp/orig997.js; cp /tmp/instrumented997.js $T
echo "## host: $(uname -a)"; echo "## node: $($NODE --version) label=$LABEL N=$N"; sha256sum $T
summ() {
  echo "RESULT $2: fail=$(grep -c 'code=[1-9]' $1) of $(grep -c PHASE $1)"
  sed -n 's/.*wake_ms=\([0-9.]*\).*/\1/p' $1 | awk '{print $1-200}' | sort -g > /tmp/w.txt
  awk '{a[NR]=$1} END{n=NR; printf "  wake - 200 ms: min=%.3f p5=%.3f p25=%.3f p50=%.3f p75=%.3f p95=%.3f max=%.3f (n=%d)\n", a[1], a[int(n*.05)+1], a[int(n*.25)+1], a[int(n*.5)+1], a[int(n*.75)+1], a[int(n*.95)+1], a[n], n}' /tmp/w.txt
  awk '{if ($1>=-0.05 && $1<0.05) near++; if ($1<0) neg++} END{printf "  wakeups before origin+200: %d; within 50 us of origin+200: %d\n", neg, near}' /tmp/w.txt
  sed -n 's/.*origin_at_ms=\([0-9.]*\).*/\1/p' $1 | sort -g | awk '{a[NR]=$1} END{printf "  block start, ms after process start: p50=%.1f p95=%.1f\n", a[int(NR*.5)+1], a[int(NR*.95)+1]}'
  echo "  failing runs:"; grep 'code=[1-9]' $1 | head -8
}
: > /tmp/is.txt; i=0; while [ $i -lt $N ]; do i=$((i+1)); timeout 60 $NODE $T 2>/dev/null | grep PHASE >> /tmp/is.txt; done
summ /tmp/is.txt "instrumented sequential"
: > /tmp/il.txt; r=0; while [ $r -lt $((N/16)) ]; do r=$((r+1)); j=0
  while [ $j -lt 16 ]; do j=$((j+1)); ( timeout 60 $NODE $T 2>/dev/null | grep PHASE > /tmp/il.$j ) & done; wait; cat /tmp/il.[0-9]* >> /tmp/il.txt; rm -f /tmp/il.[0-9]*; done
summ /tmp/il.txt "instrumented 16-way"
cp /tmp/orig997.js $T
echo M997I_DONE
== log /root/m997i.log
