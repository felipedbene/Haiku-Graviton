#!/bin/sh
# node-sliding-window-wake-phase -- issue 997: where the REAL test's wakeup lands.
#
# Makes an instrumented copy of Node 24.22.x's
# test/parallel/test-perf-hooks-sliding-window-histogram.js and runs it N times
# sequentially and N times 16-way, then prints the distribution of
# (wakeup - origin) - 200 ms and the failing runs. Instrumentation is two lines:
# an hrtime stamp just before the time-based block creates its histogram (its
# origin_, to within a microsecond), and one right after `await delay(200)`,
# printed from an 'exit' handler so failing runs report too.
#
# node-sliding-window-phase.js is a standalone replay of the same block, but it
# starts a few ms after process start instead of ~35 ms, lands its wakeup in a
# different place in the millisecond, and so rarely fails. This one measures the
# test as tools/test.py runs it.
#
# usage: node-sliding-window-wake-phase <node> <node-24.22.x source dir> [N]
#   N defaults to 320. The test file is restored on exit.

set -u
NODE=$1; SRC=$2; N=${3:-320}
T=$SRC/test/parallel/test-perf-hooks-sliding-window-histogram.js
I=$SRC/test/parallel/test-perf-hooks-sliding-window-histogram-wakephase.js
[ -f "$T" ] || { echo "no $T" >&2; exit 2; }
trap 'rm -f "$I"' EXIT

# Insert the two stamps with node itself, failing loudly if the anchors moved.
"$NODE" -e '
const fs = require("fs");
let s = fs.readFileSync(process.argv[1], "utf8");
const a = "(async () => {\n  const histogram = createSlidingWindowHistogram({\n    chunks: 1,";
const b = "  await delay(common.platformTimeout(200));\n";
if (!s.includes(a) || !s.includes(b)) { console.error("anchors not found: not the 24.22.x test"); process.exit(2); }
s = s.replace(a, a.replace("(async () => {\n", "(async () => {\n  const __o = process.hrtime.bigint(); const __po = performance.now();\n"));
s = s.replace(b, b + "  const __w = process.hrtime.bigint();\n" +
  "  process.on(\"exit\", (c) => console.log(`PHASE wake_ms=${(Number(__w - __o) / 1e6).toFixed(3)} origin_at_ms=${__po.toFixed(1)} code=${c}`));\n");
fs.writeFileSync(process.argv[2], s);
' "$T" "$I" || exit 2

echo "## host: $(uname -a)"; echo "## node: $("$NODE" --version) N=$N"
sha256sum "$T" "$I"

summ() {
	echo "RESULT $2: fail=$(grep -c 'code=[1-9]' $1) of $(grep -c PHASE $1)"
	sed -n 's/.*wake_ms=\([0-9.]*\).*/\1/p' $1 | awk '{print $1-200}' | sort -g > /tmp/wp-w.txt
	awk '{a[NR]=$1} END{n=NR; printf "  wake - 200 ms: min=%.3f p5=%.3f p25=%.3f p50=%.3f p75=%.3f p95=%.3f max=%.3f (n=%d)\n", a[1], a[int(n*.05)+1], a[int(n*.25)+1], a[int(n*.5)+1], a[int(n*.75)+1], a[int(n*.95)+1], a[n], n}' /tmp/wp-w.txt
	awk '{if ($1>=-0.05 && $1<0.05) near++; if ($1<0) neg++} END{printf "  wakeups before origin+200: %d; within 50 us of origin+200: %d\n", neg, near}' /tmp/wp-w.txt
	sed -n 's/.*origin_at_ms=\([0-9.]*\).*/\1/p' $1 | sort -g | awk '{a[NR]=$1} END{printf "  block start, ms after process start: p50=%.1f p95=%.1f\n", a[int(NR*.5)+1], a[int(NR*.95)+1]}'
	echo "  failing runs:"; grep 'code=[1-9]' $1 | head -8
}

: > /tmp/wp-s.txt; i=0
while [ $i -lt $N ]; do i=$((i+1)); timeout 60 "$NODE" "$I" 2>/dev/null | grep PHASE >> /tmp/wp-s.txt; done
summ /tmp/wp-s.txt "instrumented sequential"

: > /tmp/wp-l.txt; r=0
while [ $r -lt $((N/16)) ]; do r=$((r+1)); j=0
	while [ $j -lt 16 ]; do j=$((j+1)); ( timeout 60 "$NODE" "$I" 2>/dev/null | grep PHASE > /tmp/wp-l.$j ) & done
	wait; cat /tmp/wp-l.[0-9]* >> /tmp/wp-l.txt; rm -f /tmp/wp-l.[0-9]*
done
summ /tmp/wp-l.txt "instrumented 16-way"
