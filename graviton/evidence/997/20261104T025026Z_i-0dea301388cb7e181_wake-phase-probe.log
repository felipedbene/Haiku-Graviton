== measurement script /tmp/m997p.sh
# m997p.sh <node> <label> <N>  -- issue 997: where the delay(200) wakeup lands vs the window origin
set -u
NODE=$1; LABEL=$2; N=$3; P=/tmp/node-sliding-window-phase.js
echo "## host: $(uname -a)"; echo "## node: $($NODE --version) label=$LABEL N=$N"; sha256sum $P
stats() {  # $1 file, $2 delay
  echo "RESULT $3: pass=$(grep -c PASS $1) fail=$(grep -c FAIL $1) of $(grep -c wake_ms $1)"
  sed -n 's/^wake_ms=\([0-9.]*\).*/\1/p' $1 | awk -v d=$2 '{print $1-d}' | sort -g > /tmp/w.txt
  awk '{a[NR]=$1} END{n=NR; printf "  wake - %d ms: min=%.3f p5=%.3f p25=%.3f p50=%.3f p75=%.3f p95=%.3f max=%.3f (ms, n=%d)\n", d, a[1], a[int(n*.05)+1], a[int(n*.25)+1], a[int(n*.5)+1], a[int(n*.75)+1], a[int(n*.95)+1], a[n], n}' d=$2 /tmp/w.txt
  awk '{if ($1<0) neg++; if ($1>=-0.05 && $1<0.05) near++} END{printf "  woke before origin+delay: %d; within 50 us of the boundary: %d\n", neg, near}' /tmp/w.txt
  awk '{split($2,a,"="); s+=a[2]; if (a[2]>m) m=a[2]} END{printf "  record..snapshot: mean %.1f us, max %.1f us\n", s/NR, m}' $1
  grep FAIL $1 | head -5
}
for args in "200 1" "250 2"; do d=${args% *}
  : > /tmp/ps.txt; i=0; while [ $i -lt $N ]; do i=$((i+1)); timeout 60 $NODE $P $args >> /tmp/ps.txt 2>&1; done
  stats /tmp/ps.txt $d "probe($args) sequential"
  : > /tmp/pl.txt; r=0; while [ $r -lt $((N/16)) ]; do r=$((r+1)); j=0
    while [ $j -lt 16 ]; do j=$((j+1)); timeout 60 $NODE $P $args > /tmp/pl.$j 2>&1 & done; wait; cat /tmp/pl.[0-9]* >> /tmp/pl.txt; rm -f /tmp/pl.[0-9]*; done
  stats /tmp/pl.txt $d "probe($args) 16-way"
done
echo M997P_DONE
