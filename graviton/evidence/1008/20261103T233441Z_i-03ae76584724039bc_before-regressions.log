# | 	/* explicit: the file system may round to its resolution, allow 1 ms */
# | 	long diff = got->tv_nsec - asked->tv_nsec;
# | 	return got->tv_sec == asked->tv_sec && diff > -1000000 && diff < 1000000;
# | }
