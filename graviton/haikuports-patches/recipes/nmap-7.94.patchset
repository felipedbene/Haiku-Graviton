From bb7f4247efc3d019c5c89426562194bfd25036fc Mon Sep 17 00:00:00 2001
From: Augustin Cavalier <waddlesplash@gmail.com>
Date: Fri, 22 Sep 2023 17:37:28 -0400
Subject: [PATCH 1/2] Build fixes for Haiku.

---
 libdnet-stripped/include/dnet/route.h | 3 +++
 libdnet-stripped/src/addr.c           | 2 ++
 libnetutil/netutil.cc                 | 5 +++++
 ncat/sockaddr_u.h                     | 5 +++++
 struct_ip.h                           | 2 ++
 5 files changed, 17 insertions(+)

diff --git a/libdnet-stripped/include/dnet/route.h b/libdnet-stripped/include/dnet/route.h
index b4bd4cc..2095151 100644
--- a/libdnet-stripped/include/dnet/route.h
+++ b/libdnet-stripped/include/dnet/route.h
@@ -14,6 +14,9 @@
 /*
  * Routing table entry
  */
+#ifdef __HAIKU__
+#define route_entry dnet_route_entry
+#endif
 struct route_entry {
 	char		intf_name[INTF_NAME_LEN];	/* interface name */
 	struct addr	route_dst;	/* destination address */
diff --git a/libdnet-stripped/src/addr.c b/libdnet-stripped/src/addr.c
index 7008966..628cc19 100644
--- a/libdnet-stripped/src/addr.c
+++ b/libdnet-stripped/src/addr.c
@@ -319,12 +319,14 @@ addr_ston(const struct sockaddr *sa, struct addr *a)
 # endif
 #endif
 	case AF_UNSPEC:
+#ifndef __HAIKU__
 	case ARP_HRD_ETH:	/* XXX- Linux arp(7) */
 	case ARP_HRD_APPLETALK: /* AppleTalk DDP */
 	case ARP_HRD_INFINIBAND: /* InfiniBand */
 	case ARP_HDR_IEEE80211: /* IEEE 802.11 */
 	case ARP_HRD_IEEE80211_PRISM: /* IEEE 802.11 + prism header */
 	case ARP_HRD_IEEE80211_RADIOTAP: /* IEEE 802.11 + radiotap header */
+#endif
 		a->addr_type = ADDR_TYPE_ETH;
 		a->addr_bits = ETH_ADDR_BITS;
 		memcpy(&a->addr_eth, sa->sa_data, ETH_ADDR_LEN);
diff --git a/libnetutil/netutil.cc b/libnetutil/netutil.cc
index ff7279e..4e05237 100644
--- a/libnetutil/netutil.cc
+++ b/libnetutil/netutil.cc
@@ -130,7 +130,12 @@ typedef unsigned __int8 u_int8_t;
 #include <netinet/ip.h>
 #define NETINET_IP_H
 #endif
+
+#ifndef __HAIKU__
 #include <net/if_arp.h>
+#else
+#define ARPHRD_ETHER 	1	/* ethernet hardware format */
+#endif
 
 #if HAVE_SYS_RESOURCE_H
 #include <sys/resource.h>
diff --git a/ncat/sockaddr_u.h b/ncat/sockaddr_u.h
index 069e2c2..353b00a 100644
--- a/ncat/sockaddr_u.h
+++ b/ncat/sockaddr_u.h
@@ -74,6 +74,11 @@
 #endif
 #if HAVE_SYS_UN_H
 # include <sys/un.h>
+
+#ifndef SUN_LEN
+#define SUN_LEN(ptr) ((sizeof(*(ptr)) - sizeof((ptr)->sun_path))    \
+                      + strlen((ptr)->sun_path))
+#endif
 #endif
 #if HAVE_LINUX_VM_SOCKETS_H
 #include <linux/vm_sockets.h>
diff --git a/struct_ip.h b/struct_ip.h
index 34c2602..cd47296 100644
--- a/struct_ip.h
+++ b/struct_ip.h
@@ -50,7 +50,9 @@ typedef unsigned __int8 u_int8_t;
 #include <netinet/ip.h>
 #define NETINET_IP_H
 #endif
+#ifndef __HAIKU__
 #include <net/if_arp.h>
+#endif
 
 #ifndef WIN32
 #include <netinet/ip_icmp.h>
-- 
2.54.0 (Apple Git-157)


From cd7afa50a32b3b710406eb532d1d2d889a078606 Mon Sep 17 00:00:00 2001
From: Felipe De Bene <benfelip@amazon.com>
Date: Tue, 3 Nov 2026 20:36:17 -0600
Subject: [PATCH 2/2] libdnet: add a Haiku route backend

Haiku has neither a BSD routing socket nor /proc/net/route, so configure
picked route-none.c, route_open() failed with ENOSYS, and every nmap scan
died in route_dst_generic(). route-haiku.c reads the table through the
per-domain SIOCGRTSIZE/SIOCGRTTABLE ioctls that route(8) uses, and changes
it with SIOCADDRT/SIOCDELRT.
---
 libdnet-stripped/configure         |   8 +
 libdnet-stripped/configure.in      |   3 +
 libdnet-stripped/src/route-haiku.c | 461 +++++++++++++++++++++++++++++
 3 files changed, 472 insertions(+)
 create mode 100644 libdnet-stripped/src/route-haiku.c

diff --git a/libdnet-stripped/configure b/libdnet-stripped/configure
index dc74081..3a86761 100755
--- a/libdnet-stripped/configure
+++ b/libdnet-stripped/configure
@@ -12173,6 +12173,14 @@ if test "$ac_cv_header_Iphlpapi_h" = yes ; then
  ;;
 esac
 
+elif test "$ac_cv_header_sys_sockio_h" = yes && \
+     echo "$host_os" | grep -q haiku ; then
+	case " $LIBOBJS " in
+  *" route-haiku.$ac_objext "* ) ;;
+  *) LIBOBJS="$LIBOBJS route-haiku.$ac_objext"
+ ;;
+esac
+
 elif test "$ac_cv_dnet_route_h_has_rt_msghdr" = yes ; then
 	case " $LIBOBJS " in
   *" route-bsd.$ac_objext "* ) ;;
diff --git a/libdnet-stripped/configure.in b/libdnet-stripped/configure.in
index 6235dc2..9e50809 100644
--- a/libdnet-stripped/configure.in
+++ b/libdnet-stripped/configure.in
@@ -275,6 +275,9 @@ fi
 dnl Check for routing interface.
 if test "$ac_cv_header_Iphlpapi_h" = yes ; then
 	AC_LIBOBJ([route-win32])
+elif test "$ac_cv_header_sys_sockio_h" = yes && \
+     echo "$host_os" | grep -q haiku ; then
+	AC_LIBOBJ([route-haiku])
 elif test "$ac_cv_dnet_route_h_has_rt_msghdr" = yes ; then
 	AC_LIBOBJ([route-bsd])
 elif test "$ac_cv_dnet_linux_procfs" = yes ; then
diff --git a/libdnet-stripped/src/route-haiku.c b/libdnet-stripped/src/route-haiku.c
new file mode 100644
index 0000000..b63721d
--- /dev/null
+++ b/libdnet-stripped/src/route-haiku.c
@@ -0,0 +1,461 @@
+/*
+ * route-haiku.c
+ *
+ * Haiku routing table access, through the per-domain SIOCGRTSIZE and
+ * SIOCGRTTABLE ioctls (the interface route(8) and BNetworkRoster use) and
+ * SIOCADDRT/SIOCDELRT. Haiku has neither a BSD routing socket nor
+ * /proc/net/route, so without this file libdnet falls back to route-none.c
+ * and route_open() always fails with ENOSYS.
+ *
+ * Copyright (c) 2000 Dug Song <dugsong@monkey.org>
+ */
+
+#include "config.h"
+
+#include <sys/types.h>
+#include <sys/ioctl.h>
+#include <sys/socket.h>
+#include <sys/sockio.h>
+
+/* Haiku's <net/route.h> declares its own struct route_entry, which <net/if.h>
+ * embeds in struct ifreq as ifr_route. Both must be seen before dnet.h, whose
+ * <dnet/route.h> renames libdnet's struct route_entry to dnet_route_entry on
+ * Haiku. Past that point the token route_entry means libdnet's struct, so the
+ * kernel's entry is reached only through ifr_route. */
+#include <net/if.h>
+#include <net/route.h>
+#include <netinet/in.h>
+
+#include <errno.h>
+#include <stddef.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "dnet.h"
+
+/* Each SIOCGRTTABLE record is an interface name, the kernel's route entry,
+ * then the destination, mask and gateway sockaddrs that are present, packed
+ * back to back (list_routes() in the network stack's routes.cpp). */
+#define RT_RECORD_BASE	(IF_NAMESIZE + sizeof(((struct ifreq *)0)->ifr_route))
+
+/* The table can grow between sizing it and reading it. */
+#define RT_READ_TRIES	4
+
+struct route_handle {
+	int	 fd;	/* AF_INET */
+	int	 fd6;	/* AF_INET6, or -1 if the stack has no IPv6 */
+};
+
+route_t *
+route_open(void)
+{
+	route_t *r;
+
+	if ((r = calloc(1, sizeof(*r))) == NULL)
+		return (NULL);
+	r->fd = r->fd6 = -1;
+
+	if ((r->fd = socket(AF_INET, SOCK_DGRAM, 0)) < 0)
+		return (route_close(r));
+
+	/* IPv6 is optional: without it in the stack, route_loop() reports
+	 * IPv4 routes only, rather than failing outright. */
+	if ((r->fd6 = socket(AF_INET6, SOCK_DGRAM, 0)) >= 0) {
+		struct ifconf ifc;
+
+		memset(&ifc, 0, sizeof(ifc));
+		ifc.ifc_len = sizeof(ifc.ifc_value);
+		if (ioctl(r->fd6, SIOCGRTSIZE, &ifc, sizeof(ifc)) < 0) {
+			close(r->fd6);
+			r->fd6 = -1;
+		}
+	}
+
+	return (r);
+}
+
+static int
+_family_len(int family)
+{
+	switch (family) {
+	case AF_INET:
+		return (sizeof(struct sockaddr_in));
+	case AF_INET6:
+		return (sizeof(struct sockaddr_in6));
+	}
+	return (-1);
+}
+
+/* Fills ss with the network address a, sa_len set to the full length the
+ * stack expects. Returns the family, or -1. */
+static int
+_addr_to_ss(const struct addr *a, struct sockaddr_storage *ss)
+{
+	struct sockaddr *sa = (struct sockaddr *)ss;
+
+	memset(ss, 0, sizeof(*ss));
+	if (addr_ntos(a, sa) < 0 || _family_len(sa->sa_family) < 0) {
+		errno = EINVAL;
+		return (-1);
+	}
+	sa->sa_len = _family_len(sa->sa_family);
+	return (sa->sa_family);
+}
+
+static int
+_bits_to_ss(int family, uint16_t bits, struct sockaddr_storage *ss)
+{
+	struct sockaddr *sa = (struct sockaddr *)ss;
+
+	memset(ss, 0, sizeof(*ss));
+	sa->sa_family = family;
+	sa->sa_len = _family_len(family);
+	if (family == AF_INET)
+		return (addr_btom(bits,
+		    &((struct sockaddr_in *)ss)->sin_addr, IP_ADDR_LEN));
+	return (addr_btom(bits,
+	    &((struct sockaddr_in6 *)ss)->sin6_addr, IP6_ADDR_LEN));
+}
+
+static int
+_route_fd(route_t *r, int family)
+{
+	int fd = (family == AF_INET6) ? r->fd6 : r->fd;
+
+	if (fd < 0)
+		errno = EAFNOSUPPORT;
+	return (fd);
+}
+
+/* A gateway that is absent or the unspecified address means "direct". */
+static int
+_has_gateway(const struct addr *gw)
+{
+	struct addr any;
+
+	if (gw->addr_type != ADDR_TYPE_IP && gw->addr_type != ADDR_TYPE_IP6)
+		return (0);
+	memset(&any, 0, sizeof(any));
+	any.addr_type = gw->addr_type;
+	any.addr_bits = gw->addr_bits;
+	return (addr_cmp(gw, &any) != 0);
+}
+
+static int
+_route_change(route_t *r, const struct route_entry *entry, int request)
+{
+	struct sockaddr_storage dst, mask, gw;
+	struct route_entry rtent;
+	struct addr net;
+	struct ifreq ifr;
+	int family, fd, full;
+
+	memcpy(&rtent, entry, sizeof(rtent));
+
+	if (addr_net(&rtent.route_dst, &net) < 0 ||
+	    (family = _addr_to_ss(&net, &dst)) < 0)
+		return (-1);
+	if ((fd = _route_fd(r, family)) < 0)
+		return (-1);
+
+	/* SIOCADDRT/SIOCDELRT act on one interface. Without a name, take the
+	 * interface the gateway (or the destination) is reached through. */
+	if (rtent.intf_name[0] == '\0') {
+		struct route_entry via;
+
+		memset(&via, 0, sizeof(via));
+		if (_has_gateway(&rtent.route_gw))
+			memcpy(&via.route_dst, &rtent.route_gw, sizeof(via.route_dst));
+		else
+			memcpy(&via.route_dst, &rtent.route_dst, sizeof(via.route_dst));
+		if (route_get(r, &via) < 0)
+			return (-1);
+		strlcpy(rtent.intf_name, via.intf_name, sizeof(rtent.intf_name));
+	}
+
+	memset(&ifr, 0, sizeof(ifr));
+	strlcpy(ifr.ifr_name, rtent.intf_name, sizeof(ifr.ifr_name));
+	ifr.ifr_route.flags = RTF_STATIC;
+
+	full = (family == AF_INET) ? IP_ADDR_BITS : IP6_ADDR_BITS;
+	if (rtent.route_dst.addr_bits == 0) {
+		ifr.ifr_route.flags |= RTF_DEFAULT;
+	} else if (rtent.route_dst.addr_bits >= full) {
+		ifr.ifr_route.flags |= RTF_HOST;
+	} else {
+		if (_bits_to_ss(family, rtent.route_dst.addr_bits, &mask) < 0)
+			return (-1);
+		ifr.ifr_route.mask = (struct sockaddr *)&mask;
+	}
+	if ((ifr.ifr_route.flags & RTF_DEFAULT) == 0)
+		ifr.ifr_route.destination = (struct sockaddr *)&dst;
+
+	if (_has_gateway(&rtent.route_gw)) {
+		if (_addr_to_ss(&rtent.route_gw, &gw) != family) {
+			errno = EINVAL;
+			return (-1);
+		}
+		ifr.ifr_route.gateway = (struct sockaddr *)&gw;
+		ifr.ifr_route.flags |= RTF_GATEWAY;
+	}
+
+	return (ioctl(fd, request, &ifr, sizeof(ifr)));
+}
+
+int
+route_add(route_t *r, const struct route_entry *entry)
+{
+	return (_route_change(r, entry, SIOCADDRT));
+}
+
+int
+route_delete(route_t *r, const struct route_entry *entry)
+{
+	return (_route_change(r, entry, SIOCDELRT));
+}
+
+/* Copies out one sockaddr of a table record, which must lie inside
+ * [base, end). */
+static int
+_record_addr(const struct sockaddr *sa, const u_char *base,
+    const u_char *end, struct sockaddr_storage *ss)
+{
+	const u_char *p = (const u_char *)sa;
+	u_char len;
+
+	if (p < base || p + offsetof(struct sockaddr, sa_data) > end)
+		return (-1);
+	len = ((const struct sockaddr *)p)->sa_len;
+	if (len < offsetof(struct sockaddr, sa_data) || p + len > end ||
+	    len > sizeof(*ss))
+		return (-1);
+
+	memset(ss, 0, sizeof(*ss));
+	memcpy(ss, p, len);
+	return (0);
+}
+
+static int
+_is_family(const struct sockaddr_storage *ss, int family)
+{
+	return (ss->ss_family == family && ss->ss_len >= _family_len(family));
+}
+
+static int
+_loop_family(int fd, int family, route_handler callback, void *arg)
+{
+	struct route_entry entry;
+	struct sockaddr_storage ss;
+	struct ifconf ifc;
+	struct ifreq ifr;
+	u_char *buf = NULL, *p, *end;
+	size_t size, need;
+	uint16_t bits;
+	int i, ret, full, usable;
+
+	/* SIOCGRTTABLE fails with ENOBUFS if routes were added after
+	 * SIOCGRTSIZE; size it again and retry. */
+	for (i = 0; ; i++) {
+		memset(&ifc, 0, sizeof(ifc));
+		ifc.ifc_len = sizeof(ifc.ifc_value);
+		if (ioctl(fd, SIOCGRTSIZE, &ifc, sizeof(ifc)) < 0) {
+			free(buf);
+			return (-1);
+		}
+		if (ifc.ifc_value <= 0) {
+			free(buf);
+			return (0);
+		}
+		size = (size_t)ifc.ifc_value;
+
+		/* calloc: a table that shrank in between leaves zeroed space
+		 * behind the last record, which ends the walk below. */
+		free(buf);
+		if ((buf = calloc(1, size)) == NULL)
+			return (-1);
+
+		ifc.ifc_len = size;
+		ifc.ifc_buf = buf;
+		if (ioctl(fd, SIOCGRTTABLE, &ifc, sizeof(ifc)) == 0)
+			break;
+		if (errno != ENOBUFS || i + 1 >= RT_READ_TRIES) {
+			free(buf);
+			return (-1);
+		}
+	}
+
+	full = (family == AF_INET) ? IP_ADDR_BITS : IP6_ADDR_BITS;
+	ret = 0;
+	end = buf + size;
+	for (p = buf; p + RT_RECORD_BASE <= end; p += need) {
+		/* Records are packed, so a record need not be aligned. */
+		memset(&ifr, 0, sizeof(ifr));
+		memcpy(&ifr, p, RT_RECORD_BASE);
+		if (ifr.ifr_name[0] == '\0')
+			break;
+
+		need = RT_RECORD_BASE;
+		usable = 1;
+		memset(&entry, 0, sizeof(entry));
+		strlcpy(entry.intf_name, ifr.ifr_name, sizeof(entry.intf_name));
+		entry.route_dst.addr_type = entry.route_gw.addr_type =
+		    (family == AF_INET) ? ADDR_TYPE_IP : ADDR_TYPE_IP6;
+		/* With no mask, a route is a host route (RTF_HOST, and the
+		 * RTF_LOCAL routes to our own addresses) unless it is the
+		 * default route. A missing destination or gateway reads as the
+		 * unspecified address: the default route may carry no
+		 * destination, and a directly connected route has no gateway,
+		 * which route-linux.c and route-bsd.c report the same way. */
+		entry.route_dst.addr_bits =
+		    (ifr.ifr_route.flags & RTF_DEFAULT) != 0 ? 0 : full;
+		entry.route_gw.addr_bits = full;
+
+		/* Account for every address present before deciding to skip
+		 * the record, so the walk stays in step with the packing. */
+		if (ifr.ifr_route.destination != NULL) {
+			if (_record_addr(ifr.ifr_route.destination, buf, end,
+			    &ss) < 0)
+				break;
+			need += ss.ss_len;
+			if (_is_family(&ss, family)) {
+				bits = entry.route_dst.addr_bits;
+				addr_ston((struct sockaddr *)&ss, &entry.route_dst);
+				entry.route_dst.addr_bits = bits;
+			} else
+				usable = 0;
+		}
+		if (ifr.ifr_route.mask != NULL) {
+			if (_record_addr(ifr.ifr_route.mask, buf, end, &ss) < 0)
+				break;
+			need += ss.ss_len;
+			/* Only the address bytes of a mask matter; a short one
+			 * reads as zero past its end. */
+			if (family == AF_INET)
+				addr_mtob(&((struct sockaddr_in *)&ss)->sin_addr,
+				    IP_ADDR_LEN, &entry.route_dst.addr_bits);
+			else
+				addr_mtob(&((struct sockaddr_in6 *)&ss)->sin6_addr,
+				    IP6_ADDR_LEN, &entry.route_dst.addr_bits);
+		}
+		if (ifr.ifr_route.gateway != NULL) {
+			if (_record_addr(ifr.ifr_route.gateway, buf, end, &ss) < 0)
+				break;
+			need += ss.ss_len;
+			if ((ifr.ifr_route.flags & RTF_GATEWAY) != 0) {
+				if (_is_family(&ss, family))
+					addr_ston((struct sockaddr *)&ss,
+					    &entry.route_gw);
+				else
+					usable = 0;
+			}
+		}
+
+		if (!usable ||
+		    (ifr.ifr_route.flags & (RTF_REJECT | RTF_BLACKHOLE)) != 0)
+			continue;
+
+		entry.metric = 0;
+
+		if ((ret = callback(&entry, arg)) != 0)
+			break;
+	}
+	free(buf);
+
+	return (ret);
+}
+
+int
+route_loop(route_t *r, route_handler callback, void *arg)
+{
+	int ret;
+
+	if ((ret = _loop_family(r->fd, AF_INET, callback, arg)) != 0)
+		return (ret);
+	if (r->fd6 >= 0)
+		ret = _loop_family(r->fd6, AF_INET6, callback, arg);
+
+	return (ret);
+}
+
+struct route_get_arg {
+	struct route_entry	*want;
+	struct route_entry	 best;
+	int			 found;
+};
+
+static int
+_route_get_match(const struct route_entry *entry, void *arg)
+{
+	struct route_get_arg *g = arg;
+	struct addr dst;
+
+	if (entry->route_dst.addr_type != g->want->route_dst.addr_type)
+		return (0);
+	if (g->found && entry->route_dst.addr_bits <= g->best.route_dst.addr_bits)
+		return (0);
+
+	/* Does the wanted address fall inside this route's prefix? addr_cmp()
+	 * compares only the first addr_bits bits once both lengths agree. */
+	memcpy(&dst, &g->want->route_dst, sizeof(dst));
+	dst.addr_bits = entry->route_dst.addr_bits;
+	if (addr_cmp(&dst, &entry->route_dst) != 0)
+		return (0);
+
+	memcpy(&g->best, entry, sizeof(g->best));
+	g->found = 1;
+	return (0);
+}
+
+int
+route_get(route_t *r, struct route_entry *entry)
+{
+	struct route_get_arg g;
+	struct route_entry want;
+	int fd, family;
+
+	switch (entry->route_dst.addr_type) {
+	case ADDR_TYPE_IP:
+		family = AF_INET;
+		break;
+	case ADDR_TYPE_IP6:
+		family = AF_INET6;
+		break;
+	default:
+		errno = EINVAL;
+		return (-1);
+	}
+	if ((fd = _route_fd(r, family)) < 0)
+		return (-1);
+
+	/* Longest-prefix match over the table, done here rather than with
+	 * SIOCGETRT, which reports no interface name. */
+	memcpy(&want, entry, sizeof(want));
+	memset(&g, 0, sizeof(g));
+	g.want = &want;
+	if (_loop_family(fd, family, _route_get_match, &g) != 0)
+		return (-1);
+	if (!g.found) {
+		errno = ESRCH;
+		return (-1);
+	}
+
+	strlcpy(entry->intf_name, g.best.intf_name, sizeof(entry->intf_name));
+	memcpy(&entry->route_gw, &g.best.route_gw, sizeof(entry->route_gw));
+	entry->metric = g.best.metric;
+
+	return (0);
+}
+
+route_t *
+route_close(route_t *r)
+{
+	if (r != NULL) {
+		if (r->fd >= 0)
+			close(r->fd);
+		if (r->fd6 >= 0)
+			close(r->fd6);
+		free(r);
+	}
+	return (NULL);
+}
-- 
2.54.0 (Apple Git-157)

