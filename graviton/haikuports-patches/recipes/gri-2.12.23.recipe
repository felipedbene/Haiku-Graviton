SUMMARY="A graphics programming language"
DESCRIPTION="Gri is a language for scientific graphics programming. The word \
'language' is important: Gri is command-driven, not point/click. Gri can make \
x-y graphs, contour graphs, and image graphs, in PostScript and (someday) SVG \
formats. Control is provided over all aspects of drawing, e.g. line widths, \
colors, and fonts. A TeX-like syntax provides common mathematical symbols."
HOMEPAGE="http://gri.sourceforge.net/"
COPYRIGHT="2002-2011 Dan Kelley and Peter Galbraith"
LICENSE="GNU GPL v1"
REVISION="3"
SOURCE_URI="http://downloads.sourceforge.net/project/gri/gri/2.12.23/gri-2.12.23.tar.gz?r=http%3A%2F%2Fsourceforge.net%2Fprojects%2Fgri%2Ffiles%2F&ts=1356118794&use_mirror=ignum"
CHECKSUM_SHA256="a24e703f30250ed705c0a242aa59a24748259ea7355fca52152f367f45bfd2e7"

ARCHITECTURES="?all x86_gcc2"

PROVIDES="
	gri = $portVersion
	"
REQUIRES="
	haiku
	"

# A `tex` that merely EXISTS is not enough -- it has to be a working one.
# `cmd:tex` from app-text/texlive_core is the kpathsea-linked BINARY only;
# the macros, formats and fonts live in the texmf tree shipped by
# app-text/texlive. With texlive_core alone the refcard step got past
# `tex: command not found` and straight into (measured natively on arm64,
# issue 702):
#   warning: kpathsea: configuration file texmf.cnf not found in these
#     directories: .../data/texlive/texmf-dist/web2c:...
#   kpathsea: Running mktexfmt tex.fmt
#   /boot/system/bin/mktexfmt: kpsewhich -var-value=TEXMFROOT failed,
#     aborting early.
#   I can't find the format file 'tex.fmt'!
#   make[2]: *** [Makefile:851: refcard.ps] Error 1
# So declare what the two cards actually consume: plain TeX plus the
# tex.ini/hyphen.tex pair `mktexfmt` needs to dump tex.fmt, the Computer
# Modern fonts they select by name (cmbx10, cmr6, cmsy6, cmr8, cmbx8,
# cmti8, cmtt8, cmsy8 -- refcard.tex:86-95, cmdrefcard.tex:84-93), and
# dvips' config.ps/psfonts.map. All six resolvables come from the
# texlive_basic subpackage. This is the same split dvipng and xindy use:
# the executables as cmd:* in BUILD_PREREQUIRES, the texmf content as
# tex:* in BUILD_REQUIRES.
#
# These notes live ABOVE the assignment, not inside it. A recipe is sourced by
# bash, so `#` inside a double-quoted value is NOT a comment: the whole block
# became literal BUILD_REQUIRES content, and the unpaired backtick in
# "`tex.fmt'" opened a command substitution that ran to end-of-file. The recipe
# then did not parse at all --
#   port.recipe: line 96: unexpected EOF while looking for matching ``'
#   Warning: skipping gri-2.12.23, as the recipe is broken
#   Error: No version of gri can be built
# -- which is a harder failure than the missing provider this was documenting.
BUILD_REQUIRES="
	haiku_devel
	tex:plain
	tex:tex_ini_files
	tex:hyphen_base
	tex:knuth_lib
	tex:cm
	tex:dvips
	"
# cmd:tex / cmd:dvips were MISSING from the upstream recipe, and they are hard
# requirements, not optional doc polish. gri's `doc/Makefile:893` has
#   all-local: refcard.ps cmdrefcard.ps
# and `doc/Makefile:850-856` builds both from `refcard.tex` / `cmdrefcard.tex`
# via `$(TEX)` + `dvips`. Neither `.ps` ships in the release tarball (the
# `.info` files and man pages do), and `install-data-local` installs both into
# $(DOC_DIR) unconditionally -- so they cannot be skipped without cutting
# installed documentation, which this project does not do. Measured natively:
# with the flags undeclared the build dies at `../missing: line 46: tex:
# command not found` / `make[2]: *** [Makefile:851: refcard.ps] Error 1`
# AFTER a fully successful compile and link. Declaring them makes haikuporter
# fail fast and name the real missing dependency instead. See #592 for the
# class-35 and Class-6 triage.
BUILD_PREREQUIRES="
	cmd:gcc
	cmd:ld
	cmd:make
	cmd:perl
	cmd:tex
	cmd:dvips
	cmd:awk
	cmd:makeinfo
	cmd:info
	cmd:convert
	cmd:gs
	devel:libreadline
	"
# cmd:info and cmd:makeinfo are the doc/ `html` target's, and that target is
# not optional: `all-local: refcard.ps cmdrefcard.ps html`
# (doc/Makefile:893-894). doc/Makefile:780-787 runs `$(MAKEINFO) ... gri.texi`
# and then feeds gri.info to three perl index generators, each of which shells
# out to `info`:
#   open(IN, "info -f ./gri.info 'Concept Index' | ")   (make_html_index:5)
# Undeclared, all three printed `sh: line 1: info: command not found` and the
# HTML came out with all three indices EMPTY -- a build that passes and ships
# documentation with no index, which is the worst kind of pass. Declaring
# cmd:info fixed that: measured on arm64, the three generators now run clean.
#
# cmd:makeinfo is declared because ./missing calls it, but be aware it does
# NOT currently work: the base image's texinfo-7.2_bootstrap ships the
# makeinfo driver without its perl modules, so it dies with
#   Can't locate Texinfo/ModulePath.pm in @INC (@INC entries checked:
#     /packages/texinfo_bootstrap-7.2-1/.self/data/texi2any ...)
#     at /boot/system/bin/makeinfo line 115
# That costs gri nothing -- makeinfo only REGENERATES gri.info, and the
# tarball ships one, which is what the three `info` calls above read -- but it
# is a real defect in the image and is tracked separately.
#
# cmd:convert is ImageMagick's, and it is a hard INSTALL requirement, not doc
# polish. The tarball ships 17 example PostScript files and zero PNGs;
# doc/examples/Makefile:379-381 derives every PNG from them with `-convert`,
# and the leading `-` makes make IGNORE the failure:
#   convert logo.ps logo.png
#   make[4]: convert: No such file or directory
#   make[4]: [Makefile:380: logo.png] Error 127 (ignored)
# ... 26 times. install-data-local then installs them unconditionally
# (doc/Makefile:815) and dies on the files that were never made:
#   install: cannot stat 'examples/*.png': No such file or directory
#   make[4]: *** [Makefile:815: html-install] Error 1
# So the generation failure is silent and the INSTALL failure is loud and
# twenty minutes later. cmd:convert comes from the imagemagick_tools
# subpackage (media-gfx/imagemagick, PROVIDES_tools:101).
#
# cmd:gs goes with it: ImageMagick does not decode PostScript itself, it
# delegates to Ghostscript, so declaring cmd:convert alone just moves the
# silence one layer down -- measured, with convert present and gs absent:
#   sh: line 1: gs: command not found      <- 13 times
#   install: cannot stat 'examples/*.png': No such file or directory
# i.e. byte-identical failure to having no convert at all. cmd:gs comes from
# ghostscript_gpl, which this project built on arm64 for the first time as
# part of this same issue-702 chain (ghostscript_gpl-10.08.0-1-arm64,
# PROVIDES cmd:gs).
# cmd:awk is for `mktexfmt`/`mktexpk`, not for gri's own build. dvips has to
# rasterise the Computer Modern fonts the two reference cards select by name,
# and the texlive wrapper it uses to do that reads
#   /boot/system/bin/mktexpk: line 123: awk: command not found
# five times in a build chroot that does not declare it -- once per font it
# has to generate. The pk files came out anyway here, so this is a latent
# dependency rather than a measured hard failure; it is declared because the
# wrapper calls awk unconditionally and `awk` exists on the base image
# (/boot/system/bin/awk, from sys-apps/gawk, which PROVIDES cmd:awk) purely
# because gawk happens to be installed outside the chroot.

BUILD()
{
	# Class 6 (#592): gri's bundled config.guess is timestamp='2009-12-30' and
	# contains no aarch64 or arm64 case at all, so ./configure aborts with
	# "cannot guess build type; you must specify one" before compiling anything.
	# runConfigure supplies --host but not --build, and autoconf derives build
	# from config.guess regardless. The bundled config.sub (2010-01-22) does
	# accept aarch64-unknown-haiku, so replacing just config.guess is enough --
	# the same house fix as llvm12/llvm21/haiku_format/keystone, scoped to arm64
	# so other architectures keep the vendored script.
	if [ "$effectiveTargetArchitecture" = arm64 ]; then
		printf '#!/bin/sh\necho aarch64-unknown-haiku\n' > config.guess
		chmod +x config.guess
	fi

	# Class 35 (#592): `def_word[0] = '\0'` assigns a char to a char*, which
	# gcc 13 reports as `error: invalid conversion from 'char' to 'char*'
	# [-fpermissive]`. def_word is `char *def_word[NCHAR]`, so the null POINTER
	# is what was meant -- chop_into_words() fills the array and the assignment
	# only pre-clears the first slot. Fixed at the call site rather than with
	# -fpermissive, because that flag also demotes `cast ... loses precision`,
	# which on LP64 is a silent pointer truncation (#592, and see the playbook's
	# class 35 for the measurement: this port emits no loses-precision at all).
	sed -i "s|^\tdef_word\[0\] = '\\\\0';$|\tdef_word[0] = NULL;|" src/query.cc
	grep -q 'def_word\[0\] = NULL;' src/query.cc \
		|| { echo "gri: query.cc def_word sed did not apply" >&2; exit 1; }

	# gri predates perl 5.26, which DELETED the perl4 compatibility libraries
	# from core. Three scripts still ask for them, and they fail in two
	# different ways.
	#
	# doc/texinfo2HTML requires them unguarded, so the html target dies and
	# takes the build with it (measured on arm64 with perl-5.42.2, issue 702):
	#   Can't locate ctime.pl in @INC (@INC entries checked: ...) at
	#     ./texinfo2HTML line 57.
	#   make[3]: *** [Makefile:784: html] Error 3
	#   make[2]: *** [Makefile:894: all-local] Error 2
	# ctime() returned the asctime-style string that `scalar localtime` gives,
	# minus ctime's trailing newline -- and line 69 interpolates $date into an
	# HTML comment, where the newline was never wanted.
	sed -i \
		-e 's|^require "ctime\.pl";$|# perl4 ctime.pl/getopts.pl: removed from core in 5.26 (issue 702)|' \
		-e 's|^require "getopts\.pl";$|use Getopt::Std;|' \
		-e "s|^die if !&Getopts('h');\$|die if !getopts('h');|" \
		-e 's|^\$date = &ctime(time);$|$date = scalar localtime(time);|' \
		doc/texinfo2HTML
	grep -q '^use Getopt::Std;$' doc/texinfo2HTML \
		&& grep -q "^die if !getopts('h');\$" doc/texinfo2HTML \
		&& grep -q '^\$date = scalar localtime(time);$' doc/texinfo2HTML \
		&& ! grep -q 'ctime(time)' doc/texinfo2HTML \
		|| { echo "gri: texinfo2HTML perl4 sed did not apply" >&2; exit 1; }

	# src/gri_merge and src/gri_unpage guard their require with an eval and
	# set $use_getopts=0 when it throws (gri_merge:41-42, gri_unpage:13-14),
	# so on any modern perl they BUILD and INSTALL fine and then silently
	# ignore every option they document -- -h/-u/-b for gri_merge, -h/-l for
	# gri_unpage. That is a feature-capped install, not a build failure, which
	# is exactly why it needs fixing here rather than being left to be found
	# by whoever first passes -u. Getopt::Std::getopts resolves $opt_* against
	# caller(), so the fully-qualified call keeps the existing $opt_h/$opt_u/
	# $opt_b reads working untouched; the eval guard stays, now guarding a
	# module that is actually there.
	sed -i \
		-e "s|^eval { require 'getopts\.pl' ; };\$|eval { require Getopt::Std ; };|" \
		-e "s|&Getopts('hu:b:');|Getopt::Std::getopts('hu:b:');|" \
		src/gri_merge
	sed -i \
		-e "s|^eval { require 'getopts\.pl' ; };\$|eval { require Getopt::Std ; };|" \
		-e "s|&Getopts('hl');|Getopt::Std::getopts('hl');|" \
		src/gri_unpage
	for f in src/gri_merge src/gri_unpage; do
		grep -q '^eval { require Getopt::Std ; };$' "$f" \
			&& ! grep -q "&Getopts(" "$f" \
			|| { echo "gri: $f perl4 sed did not apply" >&2; exit 1; }
	done

	runConfigure ./configure --enable-shared

	# doc/Makefile:850-856 builds refcard.ps and cmdrefcard.ps from the SAME
	# TeX format, and `all-local: refcard.ps cmdrefcard.ps` (Makefile:893) lets
	# `make $jobArgs` start both `tex` runs at once. tex.fmt does not ship --
	# kpathsea dumps it on first use -- so the two runs race to generate it:
	# one wins and writes the format, the other finds the tree half-built and
	# dies with (measured natively on arm64, issue 702, same build, both runs
	# visible interleaved in the log)
	#   kpathsea: Running mktexfmt tex.fmt      <- twice, interleaved
	#   I can't find the format file `tex.fmt'!
	#   make[2]: *** [Makefile:851: refcard.ps] Error 1
	#   make[2]: *** Waiting for unfinished jobs....
	#   mktexfmt: running `tex -ini -jobname=tex -progname=tex tex.ini' ...
	# -- that last line being the OTHER run, which then produced cmdrefcard.ps
	# from identical recipe lines. The chroot was left with cmdrefcard.ps
	# present and refcard.ps absent, which is the signature of a race and not
	# of a missing dependency.
	#
	# One serial tex run warms the format before make forks, which removes the
	# race without serialising the rest of the build. `tex` on a file holding
	# nothing but \end does the whole job: it triggers the same mktexfmt path
	# the winner took, and it fails loudly here rather than as a confusing
	# doc/ error if the format genuinely cannot be built.
	printf '\\end\n' > fmtwarm.tex
	if ! tex -interaction=batchmode fmtwarm.tex > fmtwarm.out 2>&1; then
		echo "gri: could not dump tex.fmt, so doc/ would race on it:" >&2
		sed 's/^/gri:   /' fmtwarm.out >&2
		exit 1
	fi
	rm -f fmtwarm.tex fmtwarm.log fmtwarm.out fmtwarm.dvi

	make $jobArgs
}

INSTALL()
{
	make install
	# No Deskbar symlink. This recipe used to end with
	#   addAppsDeskbarSymlink $appsDir/Gri
	# which was wrong twice over and had never run, because no build had ever
	# got as far as INSTALL() (issue 702). haikuporter's helper is
	# addAppDeskbarSymlink, singular (HaikuPorter/ShellScriptlets.py:720), so
	# the call died with
	#   /port.recipe: line 260: addAppsDeskbarSymlink: command not found
	# and spelling it correctly would only have moved the error: gri is a
	# command-driven graphics LANGUAGE, not a GUI application. `make install`
	# puts bin/gri, bin/gri_merge, bin/gri_unpage, the man pages, the info
	# manual, the HTML docs and an emacs mode into the packaging tree and
	# creates no apps/ directory at all, so $appsDir/Gri does not exist and a
	# Deskbar entry pointing at it would be a dangling link.
}
