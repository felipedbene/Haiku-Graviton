SUMMARY="A graphics programming language"
DESCRIPTION="Gri is a language for scientific graphics programming. The word \
'language' is important: Gri is command-driven, not point/click. Gri can make \
x-y graphs, contour graphs, and image graphs, in PostScript and (someday) SVG \
formats. Control is provided over all aspects of drawing, e.g. line widths, \
colors, and fonts. A TeX-like syntax provides common mathematical symbols."
HOMEPAGE="http://gri.sourceforge.net/"
COPYRIGHT="2002-2011 Dan Kelley and Peter Galbraith"
LICENSE="GNU GPL v1"
REVISION="2"
SOURCE_URI="http://downloads.sourceforge.net/project/gri/gri/2.12.23/gri-2.12.23.tar.gz?r=http%3A%2F%2Fsourceforge.net%2Fprojects%2Fgri%2Ffiles%2F&ts=1356118794&use_mirror=ignum"
CHECKSUM_SHA256="a24e703f30250ed705c0a242aa59a24748259ea7355fca52152f367f45bfd2e7"

ARCHITECTURES="?all x86_gcc2"

PROVIDES="
	gri = $portVersion
	"
REQUIRES="
	haiku
	"

BUILD_REQUIRES="
	haiku_devel
	# A `tex` that merely EXISTS is not enough -- it has to be a working one.
	# `cmd:tex` from app-text/texlive_core is the kpathsea-linked BINARY only;
	# the macros, formats and fonts live in the texmf tree shipped by
	# app-text/texlive. With texlive_core alone the refcard step got past
	# `tex: command not found` and straight into (measured natively on arm64,
	# issue 702):
	#   warning: kpathsea: configuration file texmf.cnf not found in these
	#     directories: .../data/texlive/texmf-dist/web2c:...
	#   kpathsea: Running mktexfmt tex.fmt
	#   /boot/system/bin/mktexfmt: kpsewhich -var-value=TEXMFROOT failed,
	#     aborting early.
	#   I can't find the format file `tex.fmt'!
	#   make[2]: *** [Makefile:851: refcard.ps] Error 1
	# So declare what the two cards actually consume: plain TeX plus the
	# tex.ini/hyphen.tex pair `mktexfmt` needs to dump tex.fmt, the Computer
	# Modern fonts they select by name (cmbx10, cmr6, cmsy6, cmr8, cmbx8,
	# cmti8, cmtt8, cmsy8 -- refcard.tex:86-95, cmdrefcard.tex:84-93), and
	# dvips' config.ps/psfonts.map. All six resolvables come from the
	# texlive_basic subpackage. This is the same split dvipng and xindy use:
	# the executables as cmd:* in BUILD_PREREQUIRES, the texmf content as
	# tex:* in BUILD_REQUIRES.
	tex:plain
	tex:tex_ini_files
	tex:hyphen_base
	tex:knuth_lib
	tex:cm
	tex:dvips
	"
# cmd:tex / cmd:dvips were MISSING from the upstream recipe, and they are hard
# requirements, not optional doc polish. gri's `doc/Makefile:893` has
#   all-local: refcard.ps cmdrefcard.ps
# and `doc/Makefile:850-856` builds both from `refcard.tex` / `cmdrefcard.tex`
# via `$(TEX)` + `dvips`. Neither `.ps` ships in the release tarball (the
# `.info` files and man pages do), and `install-data-local` installs both into
# $(DOC_DIR) unconditionally -- so they cannot be skipped without cutting
# installed documentation, which this project does not do. Measured natively:
# with the flags undeclared the build dies at `../missing: line 46: tex:
# command not found` / `make[2]: *** [Makefile:851: refcard.ps] Error 1`
# AFTER a fully successful compile and link. Declaring them makes haikuporter
# fail fast and name the real missing dependency instead. See #592 for the
# class-35 and Class-6 triage.
BUILD_PREREQUIRES="
	cmd:gcc
	cmd:ld
	cmd:make
	cmd:perl
	cmd:tex
	cmd:dvips
	devel:libreadline
	"

BUILD()
{
	# Class 6 (#592): gri's bundled config.guess is timestamp='2009-12-30' and
	# contains no aarch64 or arm64 case at all, so ./configure aborts with
	# "cannot guess build type; you must specify one" before compiling anything.
	# runConfigure supplies --host but not --build, and autoconf derives build
	# from config.guess regardless. The bundled config.sub (2010-01-22) does
	# accept aarch64-unknown-haiku, so replacing just config.guess is enough --
	# the same house fix as llvm12/llvm21/haiku_format/keystone, scoped to arm64
	# so other architectures keep the vendored script.
	if [ "$effectiveTargetArchitecture" = arm64 ]; then
		printf '#!/bin/sh\necho aarch64-unknown-haiku\n' > config.guess
		chmod +x config.guess
	fi

	# Class 35 (#592): `def_word[0] = '\0'` assigns a char to a char*, which
	# gcc 13 reports as `error: invalid conversion from 'char' to 'char*'
	# [-fpermissive]`. def_word is `char *def_word[NCHAR]`, so the null POINTER
	# is what was meant -- chop_into_words() fills the array and the assignment
	# only pre-clears the first slot. Fixed at the call site rather than with
	# -fpermissive, because that flag also demotes `cast ... loses precision`,
	# which on LP64 is a silent pointer truncation (#592, and see the playbook's
	# class 35 for the measurement: this port emits no loses-precision at all).
	sed -i "s|^\tdef_word\[0\] = '\\\\0';$|\tdef_word[0] = NULL;|" src/query.cc
	grep -q 'def_word\[0\] = NULL;' src/query.cc \
		|| { echo "gri: query.cc def_word sed did not apply" >&2; exit 1; }

	runConfigure ./configure --enable-shared
	make $jobArgs
}

INSTALL()
{
	make install
	addAppsDeskbarSymlink $appsDir/Gri
}
