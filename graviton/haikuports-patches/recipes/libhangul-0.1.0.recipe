SUMMARY="Library to support hangul input method logic"
DESCRIPTION="A library to support hangul input method logic, hanja dictionary and small hangul \
character classification."
HOMEPAGE="https://github.com/libhangul/libhangul"
COPYRIGHT="2004-2021 Hwangjin Choe"
LICENSE="GNU LGPL v2.1"
REVISION="2"
SOURCE_URI="https://github.com/libhangul/libhangul/archive/refs/tags/libhangul-0.1.0.zip"
CHECKSUM_SHA256="e90fb326167f8d54ba637bf5d1d55cbe9956f6b03a7ae9cb0786037b4a2a487b"
SOURCE_DIR="libhangul-libhangul-$portVersion"

ARCHITECTURES="all"

libVersion="1.0.0"
libVersionCompat="$libVersion compat >= ${libVersion%%.*}"

PROVIDES="
	libhangul = $portVersion
	cmd:hangul
	lib:libhangul = $libVersionCompat
	"
REQUIRES="
	haiku
	lib:libiconv
	lib:libintl
	"

PROVIDES_devel="
	libhangul_devel = $portVersion
	devel:libhangul = $libVersionCompat
	"
REQUIRES_devel="
	libhangul == $portVersion base
	"

BUILD_REQUIRES="
	haiku_devel
	devel:libiconv
	devel:libintl
	"
BUILD_PREREQUIRES="
	cmd:autoconf
	cmd:autopoint
	cmd:automake
	cmd:gcc
	cmd:libtoolize
	cmd:make
	cmd:pkg_config
	"

BUILD()
{
	export ACLOCAL_PATH="/boot/system/data/gettext/m4${ACLOCAL_PATH:+:$ACLOCAL_PATH}"
	# GNU-strictness aux file (sibling of playbook class 10): automake runs in its
	# default `gnu` strictness and aborts `required file './ChangeLog' not found`,
	# because the GitHub zip archive omits the git-generated ChangeLog. autoreconf
	# -fi installs install-sh/missing/depcomp but never ChangeLog; provide it.
	touch ChangeLog
	autopoint --force
	autoreconf -fi
	runConfigure ./configure --disable-static
	make $jobArgs
}

INSTALL()
{
	make install

	prepareInstalledDevelLib libhangul
	fixPkgconfig

	packageEntries devel $developDir
}

