SUMMARY="HTTP/2 C Library"
DESCRIPTION="nghttp2 is an implementation of HTTP/2 and its header compression \
algorithm HPACK in C."
HOMEPAGE="https://nghttp2.org/"
COPYRIGHT="2012-2026 Tatsuhiro Tsujikawa & nghttp2 contributors"
LICENSE="MIT"
# DeBeOS: version bump from HaikuPorts' 1.63.0 (issue 991). nodejs24 links the system
# nghttp2 (--shared-nghttp2), but Node 24 bundles and is tested against 1.70.0, and
# its http2 layer relies on library behaviour 1.63.0 lacks: on 24.22.2 three suite
# tests fail against 1.63.0 (http2-misbehaving-flow-control, its -paused variant, and
# http2-sensitive-headers with ERR_INTERNAL_ASSERTION), and pass once only this library
# is swapped; the issue's Linux A/B shows the same for one node binary. 1.70.0, not
# newer, because it is the version Node 24.22.2 ships in deps/nghttp2. The SONAME
# stays libnghttp2.so.14 (libtool 43:5:29), so existing consumers keep loading it.
REVISION="1"
SOURCE_URI="https://github.com/nghttp2/nghttp2/releases/download/v$portVersion/nghttp2-$portVersion.tar.xz"
CHECKSUM_SHA256="e05cb1388eaca3830aded4ccf20044b6e1ac1a61411dcca11b0437c4285c8bc2"

ARCHITECTURES="all"
SECONDARY_ARCHITECTURES="x86"

libVersion="14.29.5"
libVersionCompat="$libVersion compat >= ${libVersion%%.*}"

PROVIDES="
	nghttp2$secondaryArchSuffix = $portVersion
	lib:libnghttp2$secondaryArchSuffix = $libVersionCompat
	"
REQUIRES="
	haiku$secondaryArchSuffix
	"

PROVIDES_devel="
	nghttp2${secondaryArchSuffix}_devel = $portVersion
	devel:libnghttp2$secondaryArchSuffix = $libVersionCompat
	"
REQUIRES_devel="
	nghttp2$secondaryArchSuffix == $portVersion base
	"

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	"
BUILD_PREREQUIRES="
	cmd:aclocal
	cmd:autoconf
	cmd:automake
	cmd:gcc$secondaryArchSuffix
	cmd:make
	cmd:pkg_config$secondaryArchSuffix
	"

defineDebugInfoPackage nghttp2$secondaryArchSuffix \
	"$libDir"/libnghttp2.so.$libVersion

BUILD()
{
	runConfigure ./configure \
		--enable-lib-only \

	make $jobArgs
}

INSTALL()
{
	make install

	rm -f "$libDir"/libnghttp2.la "$libDir"/libnghttp2.a

	rm -rf "$manDir"/man1

	prepareInstalledDevelLib libnghttp2
	fixPkgconfig

	packageEntries devel \
		"$developDir"

	rmdir "$manDir"
}

TEST()
{
	make check
}
