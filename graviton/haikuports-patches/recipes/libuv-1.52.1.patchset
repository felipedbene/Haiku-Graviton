From d533d3150d35c42fb9fb66d6d9aa87bead0c0c11 Mon Sep 17 00:00:00 2001
From: DeBeOS <debeos@debene.dev>
Date: Sat, 31 Oct 2026 20:23:54 -0500
Subject: [PATCH 2/2] test: require fs event filenames on haiku

Haiku now reports the file name for every event, so check it as strictly
as on Linux, macOS and Windows instead of accepting NULL. Also run the
directory variant of fork_fs_events_child, which until now only ran on
macOS and Linux.
---
 test/test-fork.c     |  4 ++--
 test/test-fs-event.c | 12 ++++++++----
 2 files changed, 10 insertions(+), 6 deletions(-)

diff --git a/test/test-fork.c b/test/test-fork.c
index fe42f03..613a3fc 100644
--- a/test/test-fork.c
+++ b/test/test-fork.c
@@ -472,7 +472,7 @@ static void fs_event_cb_file_current_dir(uv_fs_event_t* handle,
   ASSERT_OK(fs_event_cb_called);
   ++fs_event_cb_called;
   ASSERT_OK(status);
-#if defined(__APPLE__) || defined(__linux__)
+#if defined(__APPLE__) || defined(__linux__) || defined(__HAIKU__)
   ASSERT_OK(strcmp(filename, "watch_file"));
 #else
   ASSERT(filename == NULL || strcmp(filename, "watch_file") == 0);
@@ -592,7 +592,7 @@ TEST_IMPL(fork_fs_events_child_dir) {
 #if defined(NO_FS_EVENTS)
   RETURN_SKIP(NO_FS_EVENTS);
 #endif
-#if defined(__APPLE__) || defined (__linux__)
+#if defined(__APPLE__) || defined (__linux__) || defined(__HAIKU__)
   return _do_fork_fs_events_child(FS_TEST_DIR);
 #else
   /* You can't spin up a cfrunloop thread on an apple platform
diff --git a/test/test-fs-event.c b/test/test-fs-event.c
index f224181..62a16e4 100644
--- a/test/test-fs-event.c
+++ b/test/test-fs-event.c
@@ -136,7 +136,8 @@ static void fs_event_cb_dir(uv_fs_event_t* handle, const char* filename,
   ASSERT_PTR_EQ(handle, &fs_event);
   ASSERT_OK(status);
   ASSERT_EQ(events, UV_CHANGE);
-  #if defined(__APPLE__) || defined(_WIN32) || defined(__linux__)
+  #if defined(__APPLE__) || defined(_WIN32) || defined(__linux__) || \
+      defined(__HAIKU__)
   ASSERT_OK(strcmp(filename, "file1"));
   #else
   ASSERT(filename == NULL || strcmp(filename, "file1") == 0);
@@ -232,7 +233,8 @@ static void fs_event_cb_dir_multi_file(uv_fs_event_t* handle,
   ASSERT_PTR_EQ(handle, &fs_event);
   ASSERT_OK(status);
   ASSERT(events == UV_CHANGE || events == UV_RENAME);
-#if defined(__APPLE__) || defined(_WIN32) || defined(__linux__)
+#if defined(__APPLE__) || defined(_WIN32) || defined(__linux__) || \
+    defined(__HAIKU__)
   ASSERT_NOT_NULL(filename);
   ASSERT_MEM_EQ(filename, file_prefix, sizeof(file_prefix) - 1);
 #else
@@ -359,7 +361,8 @@ static void fs_event_cb_file(uv_fs_event_t* handle, const char* filename,
   ASSERT_PTR_EQ(handle, &fs_event);
   ASSERT_OK(status);
   ASSERT_EQ(events, UV_CHANGE);
-  #if defined(__APPLE__) || defined(_WIN32) || defined(__linux__)
+  #if defined(__APPLE__) || defined(_WIN32) || defined(__linux__) || \
+      defined(__HAIKU__)
   ASSERT_OK(strcmp(filename, "file2"));
   #else
   ASSERT(filename == NULL || strcmp(filename, "file2") == 0);
@@ -375,7 +378,8 @@ static void fs_event_cb_file_current_dir(uv_fs_event_t* handle,
   ASSERT_PTR_EQ(handle, &fs_event);
   ASSERT_OK(status);
   ASSERT_EQ(events, UV_CHANGE);
-  #if defined(__APPLE__) || defined(_WIN32) || defined(__linux__)
