SUMMARY="Utilities for working with 'Das U-Boot'"
DESCRIPTION="This package includes the mkimage program, which allows generation
of U-Boot images in various formats."
HOMEPAGE="https://www.denx.de/wiki/U-Boot/Documentation/"
COPYRIGHT="2003 - 2026 U-Boot"
LICENSE="GNU GPL v2"
# 2, not 1: a rebuild against openssl3 3.5.9-3 (issue 930), same source and
# patches as stock HaikuPorts at 1d23c3a's u_boot_tools-2026.07-1. 3.5.9-3 configures arm64 as
# haiku-aarch64, which widens BN_ULONG in the public headers from 32 to 64 bits
# under the same soname (lib:libcrypto = 3). This package six binaries import BN_get_word, BN_set_word,
# so a build against the older headers passes its BN_ULONG argument as 32-bit.
REVISION="2"
SOURCE_URI="https://git.u-boot-project.org/u-boot/u-boot/-/archive/v$portVersion/u-boot-v$portVersion.tar.bz2"
CHECKSUM_SHA256="5be3cddfd5e6ac023dbdc62b2a117231de2c180dcc598f3788e5b482c21fa28c"
SOURCE_DIR="u-boot-v$portVersion"
PATCHES="u_boot_tools-$portVersion.patchset"

ARCHITECTURES="all ?x86_gcc2"

PROVIDES="
	u_boot_tools = $portVersion
	cmd:asn1_compiler
	cmd:dumpimage
	cmd:fdt_add_pubkey
	cmd:fdtgrep
	cmd:fit_info
	cmd:fit_check_sign
	cmd:jtagconsole
	cmd:img2srec
	cmd:ifwitool
	cmd:mkeficapsule
	cmd:mkenvimage
	cmd:mkimage
	cmd:netconsole
	cmd:preload_check_sign
	cmd:proftool
	"
REQUIRES="
	haiku
	lib:libcrypto$secondaryArchSuffix
	lib:libgnutls$secondaryArchSuffix
	lib:libssl$secondaryArchSuffix
	"

BUILD_REQUIRES="
	haiku_devel
	devel:libcrypto$secondaryArchSuffix
	devel:libssl$secondaryArchSuffix
	devel:libgnutls$secondaryArchSuffix
	"
BUILD_PREREQUIRES="
	cmd:awk
	cmd:cmp
	cmd:gcc
	cmd:make
	cmd:bison
	cmd:flex
	"

BUILD()
{
	#cp include/image.h include/uimage.h
	
	make tools-only_defconfig

	#make tools-all
	make tools-only
}

INSTALL()
{
	mkdir -p $binDir
	cp tools/asn1_compiler $binDir
	cp tools/dumpimage $binDir
	cp tools/fdt_add_pubkey $binDir
	cp tools/fdtgrep $binDir
	cp tools/fit_check_sign $binDir
	cp tools/fit_info $binDir
	cp tools/ifwitool $binDir
	cp tools/img2srec $binDir
	cp tools/jtagconsole $binDir
	cp tools/mkeficapsule $binDir
	cp tools/mkenvimage $binDir
	cp tools/mkimage $binDir
	cp tools/netconsole $binDir
	cp tools/preload_check_sign $binDir
	cp tools/proftool $binDir
} 
