SUMMARY="Library to use arbitrary fonts in OpenGL applications"
DESCRIPTION="FTGL is a free cross-platform Open Source C++ library that uses \
Freetype2 to simplify rendering fonts in OpenGL applications."
HOMEPAGE="https://sourceforge.net/projects/ftgl"
COPYRIGHT="2001-2004 Unicode, Inc.
	2001-2009 Henry Maddocks"
LICENSE="MIT"
REVISION="4"
SOURCE_URI="https://sourceforge.net/projects/canvasdraw/files/5.11.1/Docs%20and%20Sources/ftgl-${portVersion}_Sources.tar.gz"
CHECKSUM_SHA256="690a7f80375846765f5cbbc10d0d859bfb62281441ff5878f818ced447fca763"
SOURCE_DIR="ftgl"
PATCHES="ftgl-$portVersion.patchset"

ARCHITECTURES="all"
SECONDARY_ARCHITECTURES="x86_gcc2 x86"

PROVIDES="
	ftgl$secondaryArchSuffix = $portVersion compat >= 2
	lib:libftgl$secondaryArchSuffix = 2.1.3 compat >= 2
	"
REQUIRES="
	haiku$secondaryArchSuffix
	lib:libbz2$secondaryArchSuffix
	lib:libfreetype$secondaryArchSuffix
	lib:libgl$secondaryArchSuffix
	lib:libglu$secondaryArchSuffix
	lib:libpng16$secondaryArchSuffix
	lib:libz$secondaryArchSuffix
	"

PROVIDES_devel="
	ftgl${secondaryArchSuffix}_devel = $portVersion compat >= 1
	devel:libftgl$secondaryArchSuffix = 2.1.3 compat >= 2
	"
REQUIRES_devel="
	ftgl$secondaryArchSuffix == $portVersion base
	devel:libfreetype$secondaryArchSuffix
	"

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	devel:libfreetype$secondaryArchSuffix
	devel:libgl$secondaryArchSuffix
	devel:libglu$secondaryArchSuffix
	"
BUILD_PREREQUIRES="
	cmd:aclocal
	cmd:autoconf
	cmd:automake
	cmd:gcc$secondaryArchSuffix
	cmd:g++$secondaryArchSuffix
	cmd:ld$secondaryArchSuffix
	cmd:libtoolize$secondaryArchSuffix
	cmd:make
	cmd:pkg_config$secondaryArchSuffix
	"

BUILD()
{
	touch src/ftgl.dep

	# Class 35 (#592). The real class-35 site in this port, which the #592
	# cross-compile triage missed and the native build found:
	#
	#   FTVectoriser.cpp:169:25: error: invalid conversion from
	#       'unsigned char*' to 'char*' [-fpermissive]
	#
	# `FT_Outline.tags` is `unsigned char*` (freetype2 `ftimage.h`), while
	# FTGL writes `char* tagList = &outline.tags[startIndex];` and hands it to
	# `FTContour::FTContour(FT_Vector*, char* tags, unsigned int)`, which is
	# declared with a plain `char*`. Since the callee's signature is `char*`,
	# the minimal honest fix is an explicit cast at the one call site rather
	# than retyping the local (which would just move the error to the call).
	#
	# NOT a precision bug: this is a signedness-only reinterpret of a pointer
	# to a byte, identical in width on ILP32 and LP64, and the tag bytes are
	# only ever tested against FT_CURVE_TAG_* masks. Measured on the native
	# arm64 builder: the full compile emits ZERO `loses precision`.
	#
	# `-fpermissive` is also unreachable here even if it were wanted: tecmake
	# composes `CXXFLAGS` with a plain `=` (tecmake.mak), so it overrides the
	# environment, and `make CXXFLAGS=...` would wipe every include and define.
	sed -i \
		's|char\* tagList = &outline\.tags\[startIndex\];|char* tagList = (char*)\&outline.tags[startIndex];|' \
		src/FTVectoriser.cpp
	grep -q '(char\*)&outline.tags' src/FTVectoriser.cpp \
		|| { echo "ftgl: FTVectoriser tag-pointer sed did not apply"; exit 1; }

	# Teach tecmake's own detection what arm64 is, instead of overriding its
	# conclusion from the command line (issue 701).
	#
	# tecmake.mak:212-231 derives byte order and word size from TEC_SYSARCH,
	# and :29-31 singles Haiku out to take TEC_SYSARCH from `uname -p` rather
	# than the `uname -m` every other platform gets. Measured, by pinning
	# TEC_SYSARCH and evaluating that chain:
	#
	#   x86     LITTLEENDIAN 32      arm64    BIGENDIAN    32   <- wrong
	#   x64     LITTLEENDIAN 64      aarch64  BIGENDIAN    32   <- wrong
	#   arm     LITTLEENDIAN 32      other    BIGENDIAN    32   <- wrong
	#   ia64    LITTLEENDIAN 64      ppc      BIGENDIAN    32
	#
	# "arm64" neither contains "x86" nor equals "arm", so byte order falls
	# through to TEC_BIGENDIAN; it does not equal "x64" and BUILD_64 is unset,
	# so word size falls through to TEC_32. Note that "arm64" and "other" land
	# in exactly the same place -- so making `uname -p` truthful (the
	# provisioner now installs the pool coreutils instead of leaving the
	# image's bootstrap one, which is what made it answer "other") does NOT on
	# its own fix this. Both halves are needed and neither is sufficient.
	#
	# The two macros are not merely compile defines: tecmake reads them at
	# :503-530 to choose the be32/le64 object directory and the _be32/_le64
	# filename suffixes, so a build and whatever later looks for its output can
	# disagree. FTGL's own sources never consult them, so FTGL is not
	# miscompiled -- this is a latent class defect that bites the first tecmake
	# port whose sources do.
	#
	# Patching the detection rather than passing TEC_WORDSIZE/TEC_BYTEORDER on
	# the command line (which did work -- a command-line variable beats a
	# makefile `=` and propagates to sub-makes) because the command-line form
	# has to be repeated, correctly, in every tecmake recipe forever, and it
	# leaves tecmake still *believing* the target is big-endian 32-bit
	# everywhere else it asks. Anchored before the first `STDDEFS :=` because
	# that is a `:=` -- immediately expanded -- so an append at end of file
	# would be read too late to matter.
	#
	# Not taking issue 701's option (2), making an unrecognised TEC_SYSARCH
	# fatal: tecmake supports platforms whose arch it legitimately does not
	# enumerate, and they build correctly today on the defaults.
	awk '
		/^STDDEFS[ \t]*:=/ && !done {
			print "ifeq ($(TEC_SYSARCH), arm64)"
			print "  TEC_BYTEORDER = TEC_LITTLEENDIAN"
			print "  TEC_WORDSIZE = TEC_64"
			print "endif"
			print "ifeq ($(TEC_SYSARCH), aarch64)"
			print "  TEC_BYTEORDER = TEC_LITTLEENDIAN"
			print "  TEC_WORDSIZE = TEC_64"
			print "endif"
			done = 1
		}
		{ print }
	' tecmake.mak > tecmake.mak.701 && mv tecmake.mak.701 tecmake.mak
	grep -q 'ifeq ($(TEC_SYSARCH), arm64)' tecmake.mak \
		|| { echo "ftgl: tecmake.mak arm64 detection insert did not apply"; exit 1; }

	make $jobArgs
}

INSTALL()
{
	mkdir -p $libDir
	mkdir -p $includeDir

	# tecmake writes into lib/$(TEC_UNAME), and TEC_UNAME is built from
	# `uname -s` + `uname -r`; on this image that is the 38-character
	# "HaikuR1~beta6+developmentR1~beta6+development", not the "Haiku11" the
	# upstream recipe hardcoded. Hardcoding any single spelling makes the
	# recipe silently x86/BeOS-era-only (the same defect as jam's
	# `bin.haikux86`), so resolve the directory by glob and fail loudly if
	# there is no shared library rather than installing an empty package.
	local ftglLibDir=$(ls -d lib/Haiku*/ 2>/dev/null | head -n 1)
	if [ -z "$ftglLibDir" ] || [ -z "$(ls $ftglLibDir*.so* 2>/dev/null)" ]; then
		echo "ftgl: no libftgl*.so under lib/Haiku*/ -- tecmake did not link" >&2
		ls -la lib/ >&2
		exit 1
	fi
	cp $ftglLibDir*.so* $libDir
	cp -r include/FTGL $includeDir

	prepareInstalledDevelLibs libftgl
	fixPkgconfig

	# devel package
	packageEntries devel \
		$developDir
}
