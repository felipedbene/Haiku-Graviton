SUMMARY="Open Source library project"
DESCRIPTION="FreeImage is an Open Source library project for developers \
who would like to support popular graphics image formats like PNG, BMP, \
JPEG, TIFF and others as needed by today's multimedia applications"
HOMEPAGE="http://freeimage.sourceforge.net"
COPYRIGHT="2003-2018 FreeImage Project"
LICENSE="GNU GPL v2
	GNU GPL v3"
REVISION="3"
SOURCE_URI="https://downloads.sourceforge.net/freeimage/FreeImage${portVersion//.}.zip"
CHECKSUM_SHA256="f41379682f9ada94ea7b34fe86bf9ee00935a3147be41b6569c9605a53e438fd"
SOURCE_DIR="FreeImage"
PATCHES="freeimage-$portVersion.patchset"

ARCHITECTURES="all !x86_gcc2"
SECONDARY_ARCHITECTURES="x86"

PROVIDES="
	freeimage$secondaryArchSuffix = $portVersion
	lib:libfreeimage$secondaryArchSuffix = 3
	lib:libfreeimage_$portVersion$secondaryArchSuffix
	lib:libfreeimageplus$secondaryArchSuffix = 3
	lib:libfreeimageplus_$portVersion$secondaryArchSuffix

	"
REQUIRES="
	haiku$secondaryArchSuffix
	"

PROVIDES_devel="
	freeimage${secondaryArchSuffix}_devel = $portVersion
	devel:libfreeimage$secondaryArchSuffix = 3
	devel:libfreeimage_$portVersion$secondaryArchSuffix
	devel:libfreeimageplus$secondaryArchSuffix = 3
	devel:libfreeimageplus_$portVersion$secondaryArchSuffix
	"
REQUIRES_devel="
	freeimage$secondaryArchSuffix == $portVersion base
	"

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	"
BUILD_PREREQUIRES="
	cmd:gcc$secondaryArchSuffix
	cmd:make
	"

# Hardcoded cross-prefix fix (playbook class 13): FreeImage's Makefile.gnu /
# Makefile.fip pick up CC/CXX from the environment, which resolves to the
# cross triplet aarch64-unknown-haiku-g++ -- a name that does not exist on a
# NATIVE arm64 builder (only unprefixed gcc/g++), so make dies with
# "aarch64-unknown-haiku-g++: No such file or directory (Error 127)". Force the
# native unprefixed compilers on the make command line (command-line
# assignment overrides both the environment and the Makefile). Gated to the
# primary arch so an x86 secondary-arch build keeps haikuporter's compiler.
nativeCC=""
case "$targetArchitecture" in
	x86_gcc2|x86) ;;
	*) nativeCC="CC=gcc CXX=g++" ;;
esac

PATCH()
{
	# Bundled OpenEXR (Source/OpenEXR) still uses the C++ `register` storage
	# keyword, which is *removed* in C++17. FreeImage's Makefiles set no -std, so
	# the compiler default (gnu++17 on our gcc) rejects it. Pin the whole build to
	# gnu++14, where `register` is merely deprecated, by appending to the CXXFLAGS
	# default (kept as ?= so it still yields to an explicit override, which we
	# don't pass). Both makefiles share the identical CXXFLAGS line.
	sed -i 's/^\(CXXFLAGS ?= .*-Wno-ctor-dtor-privacy\)$/\1 -std=gnu++14/' \
		Makefile.gnu Makefile.fip
}

BUILD()
{
	make -f Makefile.gnu $nativeCC \
		INCDIR=$includeDir \
		INSTALLDIR=$libDir

	make -f Makefile.fip $nativeCC \
		INCDIR=$includeDir \
		INSTALLDIR=$libDir
}

INSTALL()
{
	make -f Makefile.gnu install \
		INCDIR=$includeDir \
		INSTALLDIR=$libDir

	make -f Makefile.fip install \
		INCDIR=$includeDir \
		INSTALLDIR=$libDir

	# Static/shared install conflict (playbook class 4): Makefile.gnu/Makefile.fip's
	# own `install` targets drop libfreeimage.a/libfreeimageplus.a into $libDir
	# alongside the .so this recipe wants, so prepareInstalledDevelLibs dies with
	# "there is both a shared and a static library" (or, on a re-run, `rm: cannot
	# remove '...la'` if a stale .la is already gone). Drop the static archives --
	# tolerantly, since their presence is a build-to-build artifact, not a
	# guarantee -- before prepareInstalledDevelLibs ever looks at $libDir.
	rm -f $libDir/lib*.a $libDir/*.la || true

	prepareInstalledDevelLibs libfreeimage libfreeimage-$portVersion \
		libfreeimageplus libfreeimageplus-$portVersion

	ln -s $libDir/libfreeimage-"$portVersion".so \
		$libDir/libfreeimage.so.${portVersion%.*.*}
	ln -s $libDir/libfreeimageplus-"$portVersion".so \
		$libDir/libfreeimageplus.so.${portVersion%.*.*}

	mkdir -p "$developLibDir"/pkgconfig
	cat > "$developLibDir"/pkgconfig/freeimage.pc << EOF
prefix=${prefix}
exec_prefix=${prefix}
libdir=${libDir}
includedir=${includeDir}

Name: freeimage
Description: FreeImage
Version: ${portVersion}
Libs: -L${developLibDir} -lfreeimage
Cflags: -I${includeDir}
EOF

	packageEntries devel \
		$developDir
}
