From 783bc10d8c643049b6630873341c84aabafc10f7 Mon Sep 17 00:00:00 2001
From: DeBeOS <debeos@debene.dev>
Date: Mon, 19 Oct 2026 00:00:00 +0000
Subject: [PATCH 2/3] vendor/golang.org/x/term: use the haiku termios ioctls

Haiku's termios ioctls are the SysV TCGETA/TCSETA, not TCGETS/TCSETS.
Without this x/term falls back to term_unsupported.go and every
password/raw-mode prompt reports 'not supported'.
---
 vendor/golang.org/x/term/term_unix.go        |  2 +-
 vendor/golang.org/x/term/term_unix_haiku.go  | 12 ++++++++++++
 vendor/golang.org/x/term/term_unsupported.go |  2 +-
 3 files changed, 14 insertions(+), 2 deletions(-)
 create mode 100644 vendor/golang.org/x/term/term_unix_haiku.go

diff --git a/vendor/golang.org/x/term/term_unix.go b/vendor/golang.org/x/term/term_unix.go
index 1ad0ddfe..5b904a7a 100644
--- a/vendor/golang.org/x/term/term_unix.go
+++ b/vendor/golang.org/x/term/term_unix.go
@@ -2,7 +2,7 @@
 // Use of this source code is governed by a BSD-style
 // license that can be found in the LICENSE file.
 
-//go:build aix || darwin || dragonfly || freebsd || linux || netbsd || openbsd || solaris || zos
+//go:build aix || darwin || dragonfly || freebsd || haiku || linux || netbsd || openbsd || solaris || zos
 
 package term
 
diff --git a/vendor/golang.org/x/term/term_unix_haiku.go b/vendor/golang.org/x/term/term_unix_haiku.go
new file mode 100644
index 00000000..acf7a22e
--- /dev/null
+++ b/vendor/golang.org/x/term/term_unix_haiku.go
@@ -0,0 +1,12 @@
+// Copyright 2013 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//go:build haiku
+
+package term
+
+import "golang.org/x/sys/unix"
+
+const ioctlReadTermios = unix.TCGETA
+const ioctlWriteTermios = unix.TCSETA
diff --git a/vendor/golang.org/x/term/term_unsupported.go b/vendor/golang.org/x/term/term_unsupported.go
index 3c409e58..e6eae2ff 100644
--- a/vendor/golang.org/x/term/term_unsupported.go
+++ b/vendor/golang.org/x/term/term_unsupported.go
@@ -2,7 +2,7 @@
 // Use of this source code is governed by a BSD-style
 // license that can be found in the LICENSE file.
 
-//go:build !aix && !darwin && !dragonfly && !freebsd && !linux && !netbsd && !openbsd && !zos && !windows && !solaris && !plan9
+//go:build !aix && !darwin && !dragonfly && !freebsd && !haiku && !linux && !netbsd && !openbsd && !zos && !windows && !solaris && !plan9
 
 package term
 
-- 
2.50.1


From b2b437f9128935f65a0c13fe72014c5bb2090949 Mon Sep 17 00:00:00 2001
From: DeBeOS <debeos@debene.dev>
Date: Mon, 19 Oct 2026 00:00:00 +0000
Subject: [PATCH 3/3] vendor/github.com/moby/term: use the haiku termios ioctls

The non-BSD arm reaches for TCGETS/TCSETS, which Haiku does not have;
give haiku its own arm with TCGETA/TCSETA.
---
 vendor/github.com/moby/term/termios_haiku.go  | 14 ++++++++++++++
 vendor/github.com/moby/term/termios_nonbsd.go |  4 ++--
 2 files changed, 16 insertions(+), 2 deletions(-)
 create mode 100644 vendor/github.com/moby/term/termios_haiku.go

diff --git a/vendor/github.com/moby/term/termios_haiku.go b/vendor/github.com/moby/term/termios_haiku.go
new file mode 100644
index 00000000..d826b84d
--- /dev/null
+++ b/vendor/github.com/moby/term/termios_haiku.go
@@ -0,0 +1,14 @@
+//go:build haiku
+// +build haiku
+
+package term
+
+import (
+	"golang.org/x/sys/unix"
+)
+
+// Haiku has no TCGETS/TCSETS; its termios ioctls are the SysV TCGETA/TCSETA.
+const (
+	getTermios = unix.TCGETA
+	setTermios = unix.TCSETA
+)
diff --git a/vendor/github.com/moby/term/termios_nonbsd.go b/vendor/github.com/moby/term/termios_nonbsd.go
index 88b7b215..fadcf857 100644
--- a/vendor/github.com/moby/term/termios_nonbsd.go
+++ b/vendor/github.com/moby/term/termios_nonbsd.go
@@ -1,5 +1,5 @@
-//go:build !darwin && !freebsd && !netbsd && !openbsd && !windows
-// +build !darwin,!freebsd,!netbsd,!openbsd,!windows
+//go:build !darwin && !freebsd && !haiku && !netbsd && !openbsd && !windows
+// +build !darwin,!freebsd,!haiku,!netbsd,!openbsd,!windows
 
 package term
 
-- 
2.50.1

