+
+//go:build unix && !(haiku && arm64)
+
+package runtime
+
+// sigInLibroot is only meaningful on haiku/arm64, where g lives solely in
+// R28 and C code in libroot may hold something else there. See
+// signal_haiku_arm64.go.
+//
+//go:nosplit
+func sigInLibroot(c *sigctxt) bool { return false }
diff --git a/src/runtime/signal_unix.go b/src/runtime/signal_unix.go
index f352cb3..f47b728 100644
--- a/src/runtime/signal_unix.go
+++ b/src/runtime/signal_unix.go
@@ -399,19 +399,44 @@ func preemptM(mp *m) {
 func sigFetchG(c *sigctxt) *g {
 	switch GOARCH {
 	case "arm", "arm64", "loong64", "ppc64", "ppc64le", "riscv64", "s390x":
-		if !iscgo && inVDSOPage(c.sigpc()) {
+		if !iscgo && (inVDSOPage(c.sigpc()) || sigInLibroot(c)) {
 			// When using cgo, we save the g on TLS and load it from there
 			// in sigtramp. Just use that.
 			// Otherwise, before making a VDSO call we save the g to the
 			// bottom of the signal stack. Fetch from there.
 			// TODO: in efence mode, stack is sysAlloc'd, so this wouldn't
 			// work.
+			//
+			// haiku/arm64 has the same problem with libroot: it keeps g
+			// only in R28 (there is no TLS copy without cgo), and R28 is
+			// an ordinary callee-saved register to the C code in libroot
+			// -- malloc, for one, uses it as a scratch register while it
+			// runs. libroot is only ever called on g0 (asmcgocall switches
+			// to it), or from the signal handler itself with every signal
+			// blocked, so minit stores the M's g0 at the bottom of the
+			// signal stack and a signal that interrupted libroot fetches
+			// it here (see sigInLibroot for what counts as that).
 			sp := sys.GetCallerSP()
 			s := spanOf(sp)
 			if s != nil && s.state.get() == mSpanManual && s.base() < sp && sp < s.limit {
-				gp := *(**g)(unsafe.Pointer(s.base()))
+				// The word lives at gsignal.stack.lo. That is s.base() only
+				// while the signal stack has the span to itself; a stack
+				// carved from a stackpool span shares it with others of
+				// the same size, so step to the start of the element that
+				// holds sp.
+				lo := s.base()
+				if s.elemsize != 0 {
+					lo += (sp - lo) / s.elemsize * s.elemsize
+				}
+				gp := *(**g)(unsafe.Pointer(lo))
 				return gp
 			}
+			// No heap span to read g0 from (GODEBUG=efence=1 or
+			// stackFromSystem sysAllocs the signal stack). Return nil
+			// rather than the R28 g: on haiku/arm64 that value is exactly
+			// what libroot may have clobbered (issue 843). sigtrampgo
+			// already drops a SIGPROF or SIGURG that arrives with no g,
+			// so only a synchronous fault in libroot reaches badsignal.
 			return nil
 		}
 	}
