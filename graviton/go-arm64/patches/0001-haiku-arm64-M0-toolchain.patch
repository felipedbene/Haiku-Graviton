+
+//go:build gc
+// +build gc
+
+#include "textflag.h"
+
+//
+// System calls for arm64, Haiku are implemented in runtime/syscall_haiku.go
+//
+
+TEXT ·sysvicall6(SB),NOSPLIT,$0-88
+	JMP	syscall·sysvicall6(SB)
+
+TEXT ·rawSysvicall6(SB),NOSPLIT,$0-88
+	JMP	syscall·rawSysvicall6(SB)
