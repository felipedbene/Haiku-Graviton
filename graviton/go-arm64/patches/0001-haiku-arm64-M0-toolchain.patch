+// license that can be found in the LICENSE file.
+
+package runtime
+
+//go:nosplit
+func cputicks() int64 {
+	// nanotime() is a poor approximation of CPU ticks that is enough for the
+	// profiler. Matches the other arm64 libc-hosted ports (Darwin, the BSDs),
+	// which likewise avoid reading CNTVCT_EL0 directly here.
+	return nanotime()
+}
