diff --git a/src/cmd/link/internal/ld/sym.go b/src/cmd/link/internal/ld/sym.go
index 62963be..0b3c6f4 100644
--- a/src/cmd/link/internal/ld/sym.go
+++ b/src/cmd/link/internal/ld/sym.go
@@ -125,6 +125,13 @@ func (ctxt *Link) computeTLSOffset() {
 			// on 64-bit we use the last two regular TLS slots
 			ctxt.Tlsoffset = (64 - 2) * 8
 
+		case sys.ARM64:
+			// Haiku arm64 is ELF and keeps g in R28; the tls_g slot sits
+			// one pointer below the TPIDR_EL0 thread pointer, matching the
+			// other ELF arm64 targets. Only consulted on the cgo/c-shared
+			// path; pure-Go binaries keep g in R28 and never read it.
+			ctxt.Tlsoffset = -1 * ctxt.Arch.PtrSize
+
 		}
 
 
