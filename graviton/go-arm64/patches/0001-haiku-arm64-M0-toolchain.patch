+// Copyright 2014 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+#include "textflag.h"
+
+// Haiku's runtime_loader enters the program with argc in R0 and argv in R1
+// (the AAPCS64 convention libroot uses for the image entry point), so there
+// is no need to route through _rt0_arm64 like the bare-metal Linux path does.
+// This mirrors the Darwin arm64 entry, which is also a libc-hosted platform.
+TEXT _rt0_arm64_haiku(SB),NOSPLIT,$0
+	JMP	runtime·rt0_go(SB)
+
+// When building with -buildmode=c-shared, this symbol is called when the
+// shared library is loaded.
+TEXT _rt0_arm64_haiku_lib(SB),NOSPLIT,$0
+	JMP	_rt0_arm64_lib(SB)
