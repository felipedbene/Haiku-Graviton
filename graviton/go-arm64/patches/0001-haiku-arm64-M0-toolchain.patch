+
+func (c *sigctxt) sigcode() uint64 { return uint64(c.info.si_code) }
+func (c *sigctxt) sigaddr() uint64 { return uint64(c.info.si_addr) }
+
+func (c *sigctxt) set_pc(x uint64)  { c.regs().elr = x }
+func (c *sigctxt) set_sp(x uint64)  { c.regs().sp = x }
+func (c *sigctxt) set_lr(x uint64)  { c.regs().lr = x }
+func (c *sigctxt) set_r28(x uint64) { c.regs().x[28] = x }
+
+func (c *sigctxt) set_sigcode(x uint64) { c.info.si_code = int32(x) }
+func (c *sigctxt) set_sigaddr(x uint64) { c.info.si_addr = uintptr(x) }
diff --git a/src/runtime/sys_haiku_arm64.s b/src/runtime/sys_haiku_arm64.s
new file mode 100644
index 0000000..dba83c6
--- /dev/null
+++ b/src/runtime/sys_haiku_arm64.s
@@ -0,0 +1,163 @@
+// Copyright 2014 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+//
+// System calls and other sys.stuff for ARM64, Haiku.
+//
+// Haiku has no stable raw-syscall ABI, so like the amd64 port every OS
+// service is reached by calling a libroot.so function through the generic
+// asmsysvicall6 dispatcher (the Solaris/AIX model). This file is the arm64
+// (AAPCS64) translation of sys_haiku_amd64.s: integer arguments go in
+// R0..R7 and results come back in R0/R1, and g lives permanently in R28.
+
+#include "go_asm.h"
+#include "go_tls.h"
+#include "textflag.h"
+#include "cgo/abi_arm64.h"
+
+// void libc_miniterrno(void *(*_errnop)(void));
+//
+// Set the TLS errno pointer in M. Called via runtime·asmcgocall from
+// osinit/minit, so the single argument (the address of the _errnop libroot
+// stub) arrives in R0. NOT USING GO CALLING CONVENTION.
+TEXT runtime·miniterrno(SB),NOSPLIT,$0
+	MOVD	R0, R1
+	BL	(R1)			// _errnop() -> R0 = &errno
+	MOVD	g_m(g), R1
+	MOVD	R0, (m_mOS+mOS_perrno)(R1)
+	RET
+
+// pipe(2) wrapper that returns the two fds in R0 and R1 so that
+// asmsysvicall6 can copy them into libcall.r1/libcall.r2.
+// NOT USING GO CALLING CONVENTION.
+TEXT runtime·pipe1(SB),NOSPLIT,$16
+	MOVD	RSP, R0			// &fds[0]
+	MOVD	$libc_pipe(SB), R1
+	BL	(R1)
+	MOVW	0(RSP), R0		// fds[0]
+	MOVW	4(RSP), R1		// fds[1]
+	RET
+
+// Call a libroot function using the AAPCS64 calling convention. The called
+// function takes at most 6 integer-class arguments. Reached through
+// runtime·asmcgocall, so the *libcall lands in R0.
+// NOT USING GO CALLING CONVENTION.
+TEXT runtime·asmsysvicall6(SB),NOSPLIT,$32
+	MOVD	R19, 8(RSP)		// preserve caller's R19 (callee-saved)
+	MOVD	R0, R19			// R19 survives the C call
+	MOVD	libcall_fn(R19), R11
+	MOVD	libcall_args(R19), R12
+	MOVD	libcall_n(R19), R13
+
+	// Clear errno before the call, if we have a g and a perrno pointer.
+	CBZ	g, skiperrno1
+	MOVD	g_m(g), R1
+	MOVD	(m_mOS+mOS_perrno)(R1), R2
+	CBZ	R2, skiperrno1
+	MOVW	ZR, (R2)
+
+skiperrno1:
+	CBZ	R12, skipargs
+	MOVD	0(R12), R0
+	MOVD	8(R12), R1
+	MOVD	16(R12), R2
+	MOVD	24(R12), R3
+	MOVD	32(R12), R4
+	MOVD	40(R12), R5
+
+skipargs:
+	BL	(R11)			// call libroot function
+
+	MOVD	R0, libcall_r1(R19)
+	MOVD	R1, libcall_r2(R19)
+
+	// Read errno into libcall.err, if we have a g and a perrno pointer.
+	CBZ	g, skiperrno2
+	MOVD	g_m(g), R1
+	MOVD	(m_mOS+mOS_perrno)(R1), R2
+	CBZ	R2, skiperrno2
+	MOVW	(R2), R2
+	MOVD	R2, libcall_err(R19)
+
+skiperrno2:
+	MOVD	8(RSP), R19		// restore caller's R19
+	RET
+
+// uint32 tstart_sysvicall(M *newm);
+// pthread thread entry: newm arrives in R0 (AAPCS64 arg 0).
+TEXT runtime·tstart_sysvicall(SB),NOSPLIT,$0
+	MOVD	m_g0(R0), g		// g (R28) = newm.g0
+	MOVD	R0, g_m(g)		// g.m = newm
+
+	// Lay out the new m's scheduler stack on the OS thread stack.
+	MOVD	RSP, R1
+	MOVD	R1, (g_stack+stack_hi)(g)
+	SUB	$(0x100000), R1		// stack size (1 MiB)
+	MOVD	R1, (g_stack+stack_lo)(g)
+	ADD	$const_stackGuard, R1
+	MOVD	R1, g_stackguard0(g)
+	MOVD	R1, g_stackguard1(g)
+
+	// arm64 has no runtime·stackcheck (it is an amd64/386-only sanity
+	// check), so unlike the amd64 port we go straight to mstart.
+	BL	runtime·mstart(SB)
+
+	MOVD	$0, R0			// return 0 == success
+	MOVD	R0, ret+8(FP)
+	RET
+
+// Signal trampoline installed via sigaction. Haiku's libroot calls it with
+// the POSIX SA_SIGINFO signature handler(int sig, siginfo_t *info,
+// ucontext_t *ctx) -> R0=sig, R1=info, R2=ctx. Follows the modern arm64 libc
+// idiom (OpenBSD/Darwin): save the AAPCS64 callee-saved registers for signal
+// forwarding, recover g, then hand off to sigtrampgo.
+TEXT runtime·sigtramp(SB),NOSPLIT|TOPFRAME,$176
+	// Save callee-save registers in the case of signal forwarding.
+	// Please refer to https://golang.org/issue/31827 .
+	SAVE_R19_TO_R28(8*4)
+	SAVE_F8_TO_F15(8*14)
+
+	// This might be called on a non-Go (libroot) thread, where g is unset.
+	// runtime·load_g clobbers R0, so stash the signal number first.
+	MOVW	R0, 8(RSP)
+	BL	runtime·load_g(SB)
+	MOVW	8(RSP), R0
+	// R1 (info) and R2 (ctx) are already where sigtrampgo wants them.
+	BL	runtime·sigtrampgo<ABIInternal>(SB)
+
+	RESTORE_R19_TO_R28(8*4)
+	RESTORE_F8_TO_F15(8*14)
+	RET
+
+// Called from runtime·usleep_no_g, i.e. without a g. The sysvicall path
+// (os2_haiku.go usleep) handles the g0-stack switch itself, so this only ever
+// runs on a system stack and can call libroot directly.
+//
+// func usleep1(usec uint32)
+TEXT runtime·usleep1(SB),NOSPLIT,$0
+	MOVWU	usec+0(FP), R0
+	MOVD	$usleep2<>(SB), R1
+	BL	(R1)
+	RET
+
+// Runs on the OS stack. Duration (µs) is in R0.
+TEXT usleep2<>(SB),NOSPLIT,$0
+	MOVD	$libc_usleep(SB), R1
+	BL	(R1)
+	RET
+
+// Runs on the OS stack, called from runtime·osyield_no_g.
+TEXT runtime·osyield1(SB),NOSPLIT,$0
+	MOVD	$libc_sched_yield(SB), R0
+	BL	(R0)
+	RET
+
+// func sigfwd(fn uintptr, sig uint32, info *siginfo, ctx unsafe.Pointer)
+// Forward a signal to a non-Go handler, using the POSIX SA_SIGINFO ABI.
+TEXT runtime·sigfwd(SB),NOSPLIT,$0-32
+	MOVW	sig+8(FP), R0
+	MOVD	info+16(FP), R1
+	MOVD	ctx+24(FP), R2
+	MOVD	fn+0(FP), R11
+	BL	(R11)
+	RET
