# Legacy provenance record (issue #846) for an hpkg built BEFORE build-hpkg.sh
# stamped a source digest into the package. The file name is the sha256 of the
# hpkg itself; the body (every non-comment line) is the source manifest it was
# built from, exactly as graviton/scripts/hpkg-source-manifest prints it.
#
#   file:    amazon_ssm_agent-3.3.3270.0-2-arm64.hpkg (36,811,697 bytes)
#   source:  the tree at d35adbd92a (PR #848): the agent patch with the #553
#            ssm-user fix and the creack/pty Haiku backend, on korli/go
#            go1.26.1-haiku1 with patches 0001-0004. Patch 0005 (#851) came
#            later and is NOT in these binaries.
#   baked:   canonical ami-058776e58bd902fba
#
# haiku-hpkg-provenance check-pool accepts this hpkg with a WARNING while its
# manifest differs from trunk. This is a grace record so the next bake does not
# break. It is not a waiver. Delete this file once every bake pool carries a
# stamped rebuild (-3 or later).
debeos-source-manifest 1
package amazon_ssm_agent
upstream github.com/aws/amazon-ssm-agent 3.3.3270.0
toolchain github.com/korli/go go1.26.1-haiku1
