diff --git a/agent/fileutil/advisorylock/advisorylock_haiku.go b/agent/fileutil/advisorylock/advisorylock_haiku.go
new file mode 100644
index 0000000..138c031
--- /dev/null
+++ b/agent/fileutil/advisorylock/advisorylock_haiku.go
@@ -0,0 +1,66 @@
+// Copyright 2025 Amazon.com, Inc. or its affiliates. All Rights Reserved.
+//
+// Licensed under the Apache License, Version 2.0 (the "License"). You may not
+// use this file except in compliance with the License. A copy of the
+// License is located at
+//
+// http://aws.amazon.com/apache2.0/
+//
+// or in the "license" file accompanying this file. This file is distributed
+// on an "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND,
+// either express or implied. See the License for the specific language governing
+// permissions and limitations under the License.
+//go:build haiku
+// +build haiku
+
+// Haiku has no flock(2) in libroot; advisory whole-file locking is done with
+// fcntl(F_SETLK) via syscall.FcntlFlock, which the Haiku Go port exposes.
+package advisorylock
+
+import (
+	"errors"
+	"os"
+	"syscall"
+	"time"
+)
+
+type lockType int16
+
+const (
+	readLock  lockType = syscall.F_RDLCK
+	writeLock lockType = syscall.F_WRLCK
+)
+
+func lock(f *os.File, lt lockType, timeout time.Duration) (err error) {
+	fl := &syscall.Flock_t{
+		Type:   int16(lt),
+		Whence: 0, // SEEK_SET
+		Start:  0,
+		Len:    0, // whole file
+	}
+	startTime := time.Now()
+	for {
+		// F_SETLK is non-blocking: EAGAIN/EACCES means another holder.
+		err = syscall.FcntlFlock(f.Fd(), syscall.F_SETLK, fl)
+		if err != syscall.EINTR && err != syscall.EAGAIN && err != syscall.EACCES {
+			break
+		}
+
+		if time.Since(startTime) > timeout {
+			return wrapErr(lt.String(), f, errors.New("timed out"))
+		}
+
+		time.Sleep(10 * time.Millisecond)
+	}
+	return wrapErr(lt.String(), f, err)
+}
+
+func unlock(f *os.File) error {
+	fl := &syscall.Flock_t{
+		Type:   syscall.F_UNLCK,
+		Whence: 0,
+		Start:  0,
+		Len:    0,
+	}
+	return wrapErr("Unlock", f, syscall.FcntlFlock(f.Fd(), syscall.F_SETLK, fl))
+}
diff --git a/agent/fileutil/fileutil_diskspace_haiku.go b/agent/fileutil/fileutil_diskspace_haiku.go
new file mode 100644
index 0000000..f7ddb48
--- /dev/null
+++ b/agent/fileutil/fileutil_diskspace_haiku.go
@@ -0,0 +1,33 @@
+// Copyright 2025 Amazon.com, Inc. or its affiliates. All Rights Reserved.
+//
+// Licensed under the Apache License, Version 2.0 (the "License"). You may not
+// use this file except in compliance with the License. A copy of the
+// License is located at
+//
+// http://aws.amazon.com/apache2.0/
+//
+// or in the "license" file accompanying this file. This file is distributed
+// on an "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND,
+// either express or implied. See the License for the specific language governing
+// permissions and limitations under the License.
+//go:build haiku
+// +build haiku
+
+package fileutil
+
+// The Haiku Go port's syscall package does not expose Statfs/Statfs_t (Haiku
+// libroot reports filesystem statistics through statvfs(3)/fs_stat_dev, which
+// the fork has not wrapped yet). Until a statvfs wrapper is added to the
+// toolchain, report an ample amount of free space so that the agent's
+// pre-download disk-space guards do not spuriously block. This degrades
+// gracefully: it only affects the accuracy of the space check, not correctness
+// of any transfer. TODO(go-arm64): back this with a real statvfs call once the
+// Haiku syscall package grows one.
+func GetDiskSpaceInfo() (diskSpaceInfo DiskSpaceInfo, err error) {
+	const ample = int64(1) << 40 // 1 TiB sentinel
+	return DiskSpaceInfo{
+		AvailBytes: ample,
+		FreeBytes:  ample,
+		TotalBytes: ample,
+	}, nil
+}
diff --git a/agent/fileutil/fileutil_diskspace_statfs.go b/agent/fileutil/fileutil_diskspace_statfs.go
