+
+// The Linux/BSD detailed-instance gatherer parses lscpu(1) and reads the kernel
+// version via unix.Uname (golang.org/x/sys/unix). Neither lscpu nor an x/sys
+// Uname wrapper is available on the Haiku Go port, so this gatherer degrades to
+// reporting no detailed CPU information (the core control path does not depend
+// on it). TODO(go-arm64): populate from Haiku's get_system_info / sysinfo once
+// a native source is wired up.
+package instancedetailedinformation
+
+import (
+	"github.com/aws/amazon-ssm-agent/agent/context"
+	"github.com/aws/amazon-ssm-agent/agent/plugins/inventory/model"
+)
+
+func collectPlatformDependentInstanceData(context context.T) (appData []model.InstanceDetailedInformation) {
+	context.Log().Infof("Detailed instance information gatherer is not supported on this platform")
+	return []model.InstanceDetailedInformation{}
+}
