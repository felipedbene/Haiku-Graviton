diff --git a/vendor/github.com/fsnotify/fsnotify/haiku.go b/vendor/github.com/fsnotify/fsnotify/haiku.go
new file mode 100644
index 0000000..7d1c190
--- /dev/null
+++ b/vendor/github.com/fsnotify/fsnotify/haiku.go
@@ -0,0 +1,60 @@
+//go:build haiku
+// +build haiku
+
+// Package fsnotify: Haiku stub backend.
+//
+// fsnotify v1.5.1 ships backends for inotify (Linux), kqueue (BSD/macOS), FEN
+// (Solaris) and ReadDirectoryChangesW (Windows); Haiku has none of these.
+// Haiku's native mechanism is node monitoring (watch_node(3) / B_NODE_MONITOR),
+// which is a separate, larger port. This stub provides the exported Watcher API
+// so that packages depending on fsnotify compile and run on haiku/arm64; it
+// simply never delivers filesystem events (the Events/Errors channels stay
+// open and idle). TODO(go-arm64): replace with a watch_node-backed watcher.
+package fsnotify
+
+import "errors"
+
+// Watcher watches a set of paths, delivering events on a channel.
+type Watcher struct {
+	Events chan Event
+	Errors chan error
+
+	done chan struct{}
+}
+
+// NewWatcher creates a new stub watcher.
+func NewWatcher() (*Watcher, error) {
+	return &Watcher{
+		Events: make(chan Event),
+		Errors: make(chan error),
+		done:   make(chan struct{}),
+	}, nil
+}
+
+// Close removes all watches and closes the events channel.
+func (w *Watcher) Close() error {
+	select {
+	case <-w.done:
+		return nil
+	default:
+	}
+	close(w.done)
+	close(w.Events)
+	close(w.Errors)
+	return nil
+}
+
+// Add starts watching the named file or directory (no-op on Haiku).
+func (w *Watcher) Add(name string) error {
+	select {
+	case <-w.done:
+		return errors.New("fsnotify: watcher already closed")
+	default:
+		return nil
+	}
+}
+
+// Remove stops watching the named file or directory (no-op on Haiku).
+func (w *Watcher) Remove(name string) error {
+	return nil
+}
diff --git a/vendor/github.com/go-git/go-billy/v5/osfs/os_haiku.go b/vendor/github.com/go-git/go-billy/v5/osfs/os_haiku.go
new file mode 100644
index 0000000..866d7da
--- /dev/null
+++ b/vendor/github.com/go-git/go-billy/v5/osfs/os_haiku.go
@@ -0,0 +1,41 @@
+//go:build haiku
+// +build haiku
+
+// Haiku file-locking arm for go-billy's osfs. Haiku's Go port does not expose
+// flock(2)/x/sys/unix; advisory whole-file locking uses fcntl(F_SETLKW) via
+// syscall.FcntlFlock instead. rename/umask are identical to the POSIX arm.
+package osfs
+
+import (
+	"os"
+	"syscall"
+)
+
+func (f *file) Lock() error {
+	f.m.Lock()
+	defer f.m.Unlock()
+
+	fl := &syscall.Flock_t{Type: syscall.F_WRLCK, Whence: 0, Start: 0, Len: 0}
+	return syscall.FcntlFlock(f.File.Fd(), syscall.F_SETLKW, fl)
+}
+
+func (f *file) Unlock() error {
+	f.m.Lock()
+	defer f.m.Unlock()
+
+	fl := &syscall.Flock_t{Type: syscall.F_UNLCK, Whence: 0, Start: 0, Len: 0}
+	return syscall.FcntlFlock(f.File.Fd(), syscall.F_SETLK, fl)
+}
+
+func rename(from, to string) error {
+	return os.Rename(from, to)
+}
+
+// umask sets umask to a new value, and returns a func which allows the
+// caller to reset it back to what it was originally.
+func umask(new int) func() {
+	old := syscall.Umask(new)
+	return func() {
+		syscall.Umask(old)
+	}
+}
