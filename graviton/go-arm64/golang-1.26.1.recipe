SUMMARY="Reference compiler for the Go programming language"
DESCRIPTION="The Go programming language is an open source project to make \
programmers more productive.

Go is expressive, concise, clean, and efficient. Its concurrency \
mechanisms make it easy to write programs that get the most out of multicore \
and networked machines, while its novel type system enables flexible and \
modular program construction. Go compiles quickly to machine code yet has the \
convenience of garbage collection and the power of run-time reflection. It's a \
fast, statically typed, compiled language that feels like a dynamically typed, \
interpreted language.

DeBeOS overlay: extends the x86_64-only korli/go Haiku fork to haiku/arm64
(AWS Graviton). The arm64 arch half of the runtime/syscall packages plus the
arm64 linker wiring are supplied by the patchset in ./patches; the arm64
bootstrap toolchain is a fresh artifact cross-built from a Linux host (there is
no upstream arm64 bootstrap)."
HOMEPAGE="https://github.com/korli/go/"
COPYRIGHT="2009-2026 The Go Authors"
LICENSE="BSD (3-clause)"
REVISION="1"
srcGitRev="go1.26.1-haiku1"
SOURCE_URI="https://github.com/korli/go/archive/$srcGitRev.tar.gz"
SOURCE_DIR="go-$srcGitRev"
SOURCE_FILENAME="golang-$srcGitRev.tar.gz"
CHECKSUM_SHA256="d6e813864304d4a77c2359af9d7f0a4f06fc8778f64ceaae1b7930f728419e95"

# amd64 bootstrap (unchanged from upstream), used when building for x86_64.
SOURCE_URI_2="https://github.com/korli/go/releases/download/$srcGitRev/go-1.26.1-haiku-amd64-bootstrap.tbz"
CHECKSUM_SHA256_2="b739784c8301a050c6aad7865b883ad06de5a6363fe0f2170cc9b502c728005b"
SOURCE_DIR_2="go-haiku-amd64-bootstrap"

# arm64 bootstrap, produced by cross-building this same tree (plus the patchset)
# from a Linux host with `GOOS=haiku GOARCH=arm64 ./bootstrap.bash`. Host it in
# the DeBeOS package/artifact store and set the URI here. Checksum/size below
# are for the tarball produced by the M0 bring-up (see ./README.md).
SOURCE_URI_3="https://REPLACE-WITH-DEBEOS-ARTIFACT-HOST/go-1.26.1-haiku-arm64-bootstrap.tbz"
CHECKSUM_SHA256_3="2fe368b44cdb4789016499ccf5d5308ad4d6cdd1aa176001e9617baff5e8d667"
SOURCE_DIR_3="go-haiku-arm64-bootstrap"

# Apply the haiku/arm64 arch patchset on top of the fork tarball.
PATCHES="0001-haiku-arm64-M0-toolchain.patch"

ARCHITECTURES="x86_64 arm64"

PROVIDES="
	golang = $portVersion
	cmd:go$secondaryArchSuffix = $portVersion
	cmd:gofmt$secondaryArchSuffix = $portVersion
	"
REQUIRES="
	haiku$secondaryArchSuffix
	"

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	"
BUILD_PREREQUIRES="
	cmd:gcc$secondaryArchSuffix
	"

BUILD()
{
	export GOMAXPROCS=1
	# Pick the architecture-matched bootstrap toolchain.
	case "$targetArchitecture" in
		arm64)
			export GOROOT_BOOTSTRAP=$sourceDir3
			;;
		*)
			export GOROOT_BOOTSTRAP=$sourceDir2
			;;
	esac
	export GOROOT_FINAL=$developLibDir/go
	export GOCACHE=/tmp
	# The fork's go.mod pins a toolchain line; keep the build hermetic.
	export GOTOOLCHAIN=local
	cd src && ./make.bash
}

INSTALL()
{
	mkdir -p $binDir $developLibDir/go/
	cp -a bin src pkg lib misc api test doc $developLibDir/go/
	ln -sf $developLibDir/go/bin/go $binDir/
	ln -sf $developLibDir/go/bin/gofmt $binDir/
	install -Dm644 VERSION $developLibDir/go/
}

TEST()
{
	cd src && ./run.bash --no-rebuild -v -v -v
}
