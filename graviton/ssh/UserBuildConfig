# UserBuildConfig -- Haiku on AWS Graviton: put OpenSSH into the arm64 image.
#
# Copy (or symlink) this file to $HAIKU_OUTPUT_DIR/UserBuildConfig, i.e.
#   /opt/haiku/haiku/generated.arm64/UserBuildConfig
# It is picked up automatically by Jamrules and is the build system's own
# supported extension point, so no Haiku source file has to be patched.
#
# It expects the artefacts produced by ssh/build-openssh-arm64.sh:
#   $HG_SSH_DIR/openssh-10.4p1-1-arm64.hpkg   cross-built OpenSSH package
#   $HG_SSH_DIR/image/sshd_config             our sshd configuration
#   $HG_SSH_DIR/image/ssh_config              client configuration
#   $HG_SSH_DIR/image/launch-sshd             launch_daemon job -> settings/launch/sshd
#   $HG_SSH_DIR/image/services                replacement network services file
#   $HG_SSH_DIR/image/authorized_keys         baked-in public key (fallback)
#   $HG_SSH_DIR/image/launch-cloud-init       launch_daemon job -> settings/launch/cloud_init_lite
#   $HG_SSH_DIR/image/remote-desktop.sh       remote desktop session bringup
#   $HG_SSH_DIR/image/launch-remote-desktop   launch_daemon job -> settings/launch/remote_desktop
#
# HG_SSH_DIR defaults to /opt/haiku/ssh (see below).

HG_SSH_DIR ?= /opt/haiku/ssh ;
HG_SSH_IMAGE_DIR = $(HG_SSH_DIR)/image ;
HG_SSH_PACKAGE = openssh-10.4p1-1-arm64.hpkg ;

rule UserBuildConfigRulePreImage
{
	# The hook fires more than once for an MMC build (each image definition
	# invokes it), which would duplicate the passwd/group entries. Run once.
	if $(HG_SSH_PRE_IMAGE_DONE) {
		return ;
	}
	HG_SSH_PRE_IMAGE_DONE = 1 ;

	Echo "haiku-graviton: adding OpenSSH to the image" ;

	# --- the package -------------------------------------------------------
	# A locally cross-built hpkg, added straight to system/packages so it is
	# pre-activated in the image. Using a package (rather than dropping the
	# binaries into system/non-packaged/bin) is what preserves the executable
	# bits: packagefs stores the mode, whereas the image copy step does not
	# reliably carry it.
	local sshPackage = <haiku-graviton>$(HG_SSH_PACKAGE) ;
	SEARCH on $(sshPackage) = $(HG_SSH_DIR) ;
	AddPackageFilesToHaikuImage system packages : $(sshPackage) ;

	# --- configuration ------------------------------------------------------
	# /boot/system/settings is a packagefs "shine through" directory, i.e. a
	# real writable BFS directory, so these are plain image files.
	local sshdConfig = <haiku-graviton-ssh>sshd_config ;
	local sshConfig  = <haiku-graviton-ssh>ssh_config ;
	SEARCH on $(sshdConfig) $(sshConfig) = $(HG_SSH_IMAGE_DIR) ;
	AddFilesToHaikuImage system settings ssh : $(sshdConfig) $(sshConfig) ;

	# launch_daemon job. The system launch_daemon reads
	# B_FIND_PATH_SETTINGS_DIRECTORY/launch, so this lands as
	# /boot/system/settings/launch/sshd.
	local sshdLaunch = <haiku-graviton-ssh>launch-sshd ;
	SEARCH on $(sshdLaunch) = $(HG_SSH_IMAGE_DIR) ;
	AddFilesToHaikuImage system settings launch : $(sshdLaunch) : sshd ;

	# --- cloud_init_lite: the instance's own SSH key ------------------------
	# This is the TODO(ENA/IMDS) that used to live below, now done: with ENA
	# working there is a network at boot, so cloud_init_lite fetches the key pair
	# the instance was launched with from the metadata service and *merges* it
	# into authorized_keys. The baked-in key below stays as the fallback, which
	# is what keeps an image usable when it is launched with no key pair, or with
	# IMDS blocked by an instance-profile policy.
	#
	# The program itself is a normal Haiku command (src/bin/cloud_init_lite),
	# added to the Haiku package rather than dropped into the image, so its
	# executable bit survives -- the same reason OpenSSH is packaged above.
	local cloudInitLaunch = <haiku-graviton-ssh>launch-cloud-init ;
	SEARCH on $(cloudInitLaunch) = $(HG_SSH_IMAGE_DIR) ;
	AddFilesToHaikuImage system settings launch
		: $(cloudInitLaunch) : cloud_init_lite ;

	# --- partition_grow: fill a larger EBS on first boot --------------------
	# The image is baked at a fixed size; on a larger root volume the GPT still
	# describes the small baked partition, so the BFS mount-time grow engine
	# (which grows the FS when its backing device is bigger than the FS) never
	# sees partition > FS and never fires. partition_grow closes that gap on
	# first boot by growing the root GPT partition entry to fill the disk and
	# relocating the secondary GPT header to the new end. It is a normal Haiku
	# command (src/bin/partition_grow) already in the Haiku package -- like
	# cloud_init_lite above -- so only its launch_daemon job is placed here.
	#
	# The launch_daemon job runs a wrapper (partition-grow.sh), not the binary
	# directly: the wrapper defers the grow off the first-boot critical path, so
	# partition_grow's device rescan cannot race the network-gated launch jobs
	# (sshd/EICE and the SSM agent) on a larger-than-baked root (issue #254). The
	# script goes to system/non-packaged/bin -- like remote-desktop.sh, and for
	# the same reason: system/bin is packagefs and cannot take image files. It is
	# invoked as "/bin/sh <path>", so the executable bit does not matter.
	local partitionGrowLaunch = <haiku-graviton-ssh>launch-partition-grow ;
	local partitionGrowScript = <haiku-graviton-ssh>partition-grow.sh ;
	SEARCH on $(partitionGrowLaunch) $(partitionGrowScript) = $(HG_SSH_IMAGE_DIR) ;
	AddFilesToHaikuImage system non-packaged bin : $(partitionGrowScript) ;
	AddFilesToHaikuImage system settings launch
		: $(partitionGrowLaunch) : partition_grow ;

	# --- desktop in a browser -----------------------------------------------
	# TARGET_SCREEN, for the whole user session. This is the load-bearing half:
	# data/launch/user launches Tracker and Deskbar as services under
	# `env /system/boot/SetupEnvironment`, and SetupEnvironment sources this file
	# (its lines 48-49), so it is the only place that reaches every service in the
	# session. Without it those services ask app_server for a Desktop with a NULL
	# target, which on a machine with no framebuffer cannot be created at all, and
	# they crash-loop forever without drawing anything. The full chain is in the
	# file's own header; the short version is that a Desktop is keyed on
	# (uid, TARGET_SCREEN).
	local setupEnv = <haiku-graviton-ssh>UserSetupEnvironment ;
	SEARCH on $(setupEnv) = $(HG_SSH_IMAGE_DIR) ;
	AddFilesToHaikuImage home config settings boot : $(setupEnv) ;

	# A launch_daemon service that brings up the parts of the session that
	# launch_daemon does not own: input_server first, because Tracker and Deskbar
	# segfault in BKeymap without a published keymap. The order is load-bearing --
	# see the header of remote-desktop.sh and docs/stage-b-remote-desktop.md.
	#
	# The script goes to system/non-packaged/bin rather than system/bin because
	# the latter is packagefs and cannot take image files. It is invoked as
	# "/bin/sh <path>", so the executable bit does not matter -- which is what
	# lets it be a plain image file instead of needing its own package.
	local desktopScript = <haiku-graviton-ssh>remote-desktop.sh ;
	local desktopLaunch = <haiku-graviton-ssh>launch-remote-desktop ;
	SEARCH on $(desktopScript) $(desktopLaunch) = $(HG_SSH_IMAGE_DIR) ;
	AddFilesToHaikuImage system non-packaged bin : $(desktopScript) ;
	AddFilesToHaikuImage system settings launch
		: $(desktopLaunch) : remote_desktop ;

	# --- baked-in authorized key, now the fallback -------------------------
	local authorizedKeys = <haiku-graviton-ssh>authorized_keys ;
	SEARCH on $(authorizedKeys) = $(HG_SSH_IMAGE_DIR) ;
	AddFilesToHaikuImage home config settings ssh : $(authorizedKeys) ;

	# --- DeBeOS native SSM management agent --------------------------------
	# Baked into system/packages as a prebuilt hpkg, exactly like the OpenSSH
	# package above -- AddPackageFilesToHaikuImage, deliberately NOT
	# AddHaikuImageSystemPackages. That distinction is the whole fix. The lean
	# arm64 image has no DeBeOS repository as a HAIKU_REPOSITORIES member, so a
	# by-name add has to be resolved out of the HaikuPortsLocal companion cache,
	# and building that cache runs `package_repo create`, which validates every
	# package against the HaikuPorts repo-info vendor ("Haiku Project") and
	# rejects this DeBeOS-vendored package with "unexpected vendor 'DeBeOS'" --
	# failing the bake. (Declaring it in repositories/HaikuPortsLocal/arm64 does
	# not help for the same reason: that list is the HaikuPorts repo.) Dropping
	# the hpkg as a file skips the solver and the vendor check entirely, while
	# still keeping it a package: packagefs preserves the executable bit and
	# activates it on first boot, and the agent's own launch_daemon job (bundled
	# inside the hpkg) starts the service, which self-registers the instance as
	# an SSM managed node and seeds the clock from IMDS. This retires the
	# ssh-keepalive fragility for driving the fleet.
	#
	# Runtime prerequisite (not a build gate): the launch template / run-instances
	# must attach an instance profile carrying AmazonSSMManagedInstanceCore -- the
	# AMI cannot supply its own IAM role, so without it the agent starts but
	# cannot register.
	#
	# Version-agnostic on purpose: the glob matches ONLY debeos_ssm_agent-*
	# (binary /boot/system/bin/debeos-ssm-agent), so swapping in a newer-version
	# hpkg needs no edit here. It deliberately does NOT match the legacy
	# haiku_mgmt_agent-* name: Jam's Glob returns readdir order, so matching both
	# names is non-deterministic and a bake could pick a stale/incompatible hpkg.
	# Guarded on HG_POOL_DIR so an SSH-only bake (no pool) is unaffected.
	if $(HG_POOL_DIR) {
		local agentGlob = [ Glob $(HG_POOL_DIR) :
			debeos_ssm_agent-*-arm64.hpkg ] ;
		if $(agentGlob) {
			local agentFileName = $(agentGlob[1]:G=:D=) ;
			local agentPackage = <hg-pool>$(agentFileName) ;
			SEARCH on $(agentPackage) = $(HG_POOL_DIR) ;
			Echo "haiku-graviton: baking SSM management agent" $(agentFileName)
				"into system/packages" ;
			AddPackageFilesToHaikuImage system packages : $(agentPackage) ;
		} else {
			Echo "haiku-graviton: no SSM management agent hpkg in pool"
				"(skipping; SSH-only image)" ;
		}
	}

	# --- DeBeOS CloudWatch host-metrics daemon -----------------------------
	# Baked as a prebuilt hpkg the same way as the SSM agent above (straight
	# into system/packages, bypassing the solver + DeBeOS-vendor check). This is
	# the standalone debeos-cloudwatch daemon (F7/#119): it publishes host
	# metrics (CPU/memory/disk/network/threads) to CloudWatch namespace
	# DeBeOS/Host every 60s from Haiku's own kernel counters -- a true CPU busy%,
	# not the hypervisor number that under-reports a Haiku/arm64 guest by ~55x
	# (#140). Its launch_daemon job (bundled in the hpkg) starts it on every
	# boot, so the metrics are default-on with no configuration.
	#
	# It is a SEPARATE binary from the SSM agent and makes NO SSM calls (no node
	# registration, no heartbeat, no command channel). That separation is
	# deliberate: two processes heartbeating the same instance wedge Run Command,
	# so the metrics feature must not live inside a second SSM-registering
	# daemon. It therefore coexists safely with whatever owns SSM -- the
	# amazon-ssm-agent, or the DeBeOS agent above.
	#
	# Runtime prerequisite (not a build gate): the metrics need
	# cloudwatch:PutMetricData on the instance role; the fleet's
	# ssm-instance-profile already grants it via CloudWatchAgentServerPolicy (see
	# graviton/docs/cloudwatch-metrics-bake.md for a leaner-profile note).
	#
	# Version-agnostic glob, exactly like the agent: match ONLY
	# debeos_cloudwatch-* (binary /boot/system/bin/debeos-cloudwatch); the pool
	# must hold exactly one (readdir-order Glob), so staging REPLACES the old
	# one. Guarded on HG_POOL_DIR so an SSH-only bake (no pool) is unaffected.
	if $(HG_POOL_DIR) {
		local cwGlob = [ Glob $(HG_POOL_DIR) :
			debeos_cloudwatch-*-arm64.hpkg ] ;
		if $(cwGlob) {
			local cwFileName = $(cwGlob[1]:G=:D=) ;
			local cwPackage = <hg-pool>$(cwFileName) ;
			SEARCH on $(cwPackage) = $(HG_POOL_DIR) ;
			Echo "haiku-graviton: baking CloudWatch metrics daemon" $(cwFileName)
				"into system/packages" ;
			AddPackageFilesToHaikuImage system packages : $(cwPackage) ;
		} else {
			Echo "haiku-graviton: no CloudWatch metrics daemon hpkg in pool"
				"(skipping)" ;
		}
	}

	# --- exactly one thing must own port 22 --------------------------------
	# data/settings/network/services already contains
	#     service ssh { launch /boot/system/bin/sshd -D  stand_alone }
	# so net_server would spawn a second sshd, which loses the race for port 22
	# and dies. net_server also never restarts a stand_alone service it started
	# (Services::_LaunchService has no child reaping), which is why we drive
	# sshd from launch_daemon instead. Redirect the existing jam target for the
	# services file at our copy, which has that entry commented out.
	SEARCH on <network-settings>services = $(HG_SSH_IMAGE_DIR) ;

	# --- make the box actually usable over ssh -----------------------------
	# @minimum only ships bash + coreutils, so a remote shell has no grep, sed,
	# find or less. These all exist as arm64 bootstrap packages in
	# build/jam/repositories/HaikuPorts/arm64, so they cost nothing but space.
	AddHaikuImageSystemPackages
		findutils
		grep
		less
		sed
		;

	# --- privilege separation ----------------------------------------------
	# sshd is built --with-privsep-user=sshd; privilege separation is mandatory
	# in OpenSSH >= 7.5, so the account has to exist. /boot/system/var/empty is
	# created by build/jam/images/definitions/common-tail.
	AddUserToHaikuImage sshd : 999 : 999 : /boot/system/var/empty
		: /bin/true : "sshd privilege separation user" ;
	AddGroupToHaikuImage sshd : 999 : ;

	# --- Full canonical closure: WebPositive + HaikuWebKit + Rust ----------
	# Added only for a FATTY bake (HG_FATTY set by the CI cross-build alongside a
	# full hpkg pool). With HG_FATTY this reproduces the full canonical image
	# (WebPositive/HaikuWebKit, the PNG/JPEG/TIFF/JPEG2000 translators via the
	# now-enabled build features, and the native Rust toolchain). A LEAN modular
	# bake leaves HG_FATTY unset: it still stages the small openssl pool (so the
	# openssl/TLS build feature turns on) but force-adds NONE of these, keeping
	# the image at ~@minimum footprint -- every feature below is then installed
	# on demand from the baked DeBeOS repo. The translator runtime libs
	# (libpng16/libjpeg_turbo/tiff/jasper) are omitted here on purpose -- their
	# build features place them.
	if $(HG_FATTY) {
		Echo "haiku-graviton: adding WebPositive + HaikuWebKit + Rust from $(HG_POOL_DIR)" ;

		# WebPositive, built from this tree by the (staged) webkit build feature.
		AddPackageFilesToHaikuImage system packages
			: webpositive.hpkg : nameFromMetaInfo ;

		# HaikuWebKit's measured runtime closure + the native aarch64-unknown-haiku
		# Rust toolchain: rustc/cargo and the C linker it drives (gcc) plus cargo's
		# HTTPS closure (curl/nghttp2/libssh2 + CA bundle), so `cargo` and
		# `cargo install` work online out of the box. openssl3 and its zstd
		# dependency are NOT pooled here: they are declared in
		# repositories/HaikuPortsLocal/arm64 and installed by the minimum
		# profile's by-name `AddHaikuImageSystemPackages openssl3` (which also
		# turns on the `openssl` build feature). Pooling them too would double-add
		# openssl3/zstd and make the image solver "would need to uninstall" them.
		# gcc is pooled because the
		# arm64 mirror does not serve a bare `gcc` compiler; gcc_syslibs and
		# gcc_syslibs_devel are NOT pooled -- the mirror serves newer, non-bootstrap
		# builds of them, so pooling the older _bootstrap ones made the solver want
		# to uninstall them (rust_bin/HaikuWebKit require gcc_syslibs[_devel] >=, and
		# the mirror copies satisfy that and avoid the bootstrap dangling-libgcc_s
		# quirk). They resolve automatically as dependencies from the mirror.
		local poolPkgs =
			<hg-pool>haikuwebkit-1.10.0-2-arm64.hpkg
			<hg-pool>jasper-2.0.33-2-arm64.hpkg
			<hg-pool>libjpeg_turbo-3.1.4.1-1-arm64.hpkg
			<hg-pool>libpng16-1.6.53-1-arm64.hpkg
			<hg-pool>tiff-4.7.0-1-arm64.hpkg
			<hg-pool>brotli-1.2.0-1-arm64.hpkg
			<hg-pool>ca_root_certificates-2026_07_16-1-any.hpkg
			<hg-pool>curl-8.21.0-1-arm64.hpkg
			<hg-pool>gettext_libintl-1.0-1-arm64.hpkg
			<hg-pool>giflib-5.2.2-1-arm64.hpkg
			<hg-pool>lcms-2.19.1-1-arm64.hpkg
			<hg-pool>libexecinfo-1.1-6-arm64.hpkg
			<hg-pool>libglvnd-1.7.0-4-arm64.hpkg
			<hg-pool>libgpg_error-1.61-2-arm64.hpkg
			<hg-pool>libiconv-1.18-1-arm64.hpkg
			<hg-pool>libpsl-0.21.5-2-arm64.hpkg
			<hg-pool>libssh2-1.11.1-1-arm64.hpkg
			<hg-pool>libunistring-1.3-1-arm64.hpkg
			<hg-pool>libwebp-1.6.0-3-arm64.hpkg
			<hg-pool>libxml2-2.15.3-1-arm64.hpkg
			<hg-pool>libxslt-1.1.45-2-arm64.hpkg
			<hg-pool>ncurses6-6.6_bootstrap-1-arm64.hpkg
			<hg-pool>nghttp2-1.63.0-1-arm64.hpkg
			<hg-pool>readline-8.3.003-1-arm64.hpkg
			<hg-pool>sqlite-3.50.4.0-1-arm64.hpkg
			<hg-pool>woff2-1.0.2-3-arm64.hpkg
			<hg-pool>rust_bin-1.100.0~nightly_787af2b8c-2-arm64.hpkg
			<hg-pool>gcc-13.3.0_2026_03_29_bootstrap-1-arm64.hpkg
			# Archiving tools (cargo/dev workflows expect them, and the arm64
			# mirror does not serve tar/gzip). Built natively; pooled like gcc.
			<hg-pool>tar-1.35-2-arm64.hpkg
			<hg-pool>gzip-1.14-1-arm64.hpkg
			;
		SEARCH on $(poolPkgs) = $(HG_POOL_DIR) ;
		AddPackageFilesToHaikuImage system packages : $(poolPkgs) ;

		# Developer toolchain + its closure. These are natively-built packages the
		# arm64 build-packages mirror does not serve, so they are pooled and
		# force-added (their mirror-served deps -- bash/curl/icu/... -- resolve
		# normally). The set was computed as the full dependency closure of the
		# top-level tools (git, cmake, ninja, autotools, python3, perl, ruby, vim,
		# nano, diffutils, which, xz/bzip2/zip) against the mirror, keeping only
		# what the mirror lacks; get_package_dependencies resolved the whole set
		# cleanly. make/m4/less come from the mirror (added below / already added).
		local devPkgs =
			<hg-pool>git-2.54.0-1-arm64.hpkg
			<hg-pool>cmake-4.1.6-1-arm64.hpkg
			<hg-pool>ninja-1.13.2-3-arm64.hpkg
			<hg-pool>autoconf-2.72-1-arm64.hpkg
			<hg-pool>automake-1.18.1-1-arm64.hpkg
			<hg-pool>libtool-2.5.4-1-arm64.hpkg
			<hg-pool>libtool_libltdl-2.5.4-1-arm64.hpkg
			<hg-pool>python3.14-3.14.7-1-arm64.hpkg
			<hg-pool>perl-5.42.2-1-arm64.hpkg
			<hg-pool>ruby-3.2.9-1-arm64.hpkg
			<hg-pool>vim-9.1.1618-1-arm64.hpkg
			<hg-pool>nano-9.1-1-arm64.hpkg
			<hg-pool>diffutils-3.12-1-arm64.hpkg
			<hg-pool>which-2.21-6-arm64.hpkg
			<hg-pool>xz_utils-5.8.3-1-arm64.hpkg
			<hg-pool>zip-3.0-4-arm64.hpkg
			# closure deps the mirror does not serve
			<hg-pool>file-5.43-2-arm64.hpkg
			<hg-pool>file_data-5.43-2-any.hpkg
			<hg-pool>gdbm-1.26-1-arm64.hpkg
			<hg-pool>gmp-6.3.0-1-arm64.hpkg
			<hg-pool>libedit-20230828_3.1-1-arm64.hpkg
			<hg-pool>libpcre2-10.45-1-arm64.hpkg
			<hg-pool>libuv-1.52.1-1-arm64.hpkg
			<hg-pool>libyaml-0.2.5-2-arm64.hpkg
			<hg-pool>mandoc-1.14.6-1-arm64.hpkg
			<hg-pool>openssl3_man-3.5.7-1-any.hpkg
			<hg-pool>rhash-1.4.6-2-arm64.hpkg
			<hg-pool>bzip2-1.0.8-3-arm64.hpkg
			# newer libffi than the mirror's bootstrap one (python3.14/ruby need
			# lib:libffi>=8.1.4); pooled because the mirror copy is too old.
			<hg-pool>libffi-3.4.6-1-arm64.hpkg
			;
		SEARCH on $(devPkgs) = $(HG_POOL_DIR) ;
		AddPackageFilesToHaikuImage system packages : $(devPkgs) ;

		# Build tools the mirror DOES serve -- add by name so the mirror version
		# is used (avoids the bootstrap-vs-mirror version conflict class).
		AddHaikuImageSystemPackages make m4 ;

		# haiku_devel is the linchpin for native compilation: it provides the C
		# runtime startup objects (crti.o/crtn.o/start_dyn.o/init_term_dyn.o), the
		# unversioned dev .so symlinks (libroot.so/libbe.so/libnetwork.so/... in
		# develop/lib) and the system headers (develop/headers/{posix,os,...}).
		# Without it rustc's `cc`/ld link fails: cannot find crti.o, then -lroot,
		# then stdint.h. It is built into this tree (Haiku repo), but the only
		# in-tree wiring that installs it -- the DevelopmentMin optional package --
		# is gated to x86/x86_64, so on arm64 nothing adds it. Force-add the built
		# hpkg exactly as WebPositive above (same packages dir, nameFromMetaInfo).
		AddPackageFilesToHaikuImage system packages
			: haiku_devel.hpkg : nameFromMetaInfo ;

		# Global cargo config: rustflags for the aarch64-unknown-haiku target so
		# cargo build/run link out of the box despite the ld 2.41 --gc-sections
		# stub bug (see the file header). Installed at /boot/home/.cargo/config.toml.
		local cargoConfig = <haiku-graviton-ssh>cargo-config.toml ;
		SEARCH on $(cargoConfig) = $(HG_SSH_IMAGE_DIR) ;
		AddFilesToHaikuImage home ".cargo" : $(cargoConfig) : config.toml ;

		# The linker rustc drives gcc into (`cc` -> collect2 -> ld). rust_bin does
		# not list binutils in its requires, so nothing pulled ld in and cargo
		# failed with "collect2: fatal error: cannot find 'ld'". The arm64 mirror
		# DOES serve binutils (provides cmd:ld), so resolve it by name rather than
		# pooling it.
		AddHaikuImageSystemPackages binutils ;
	}
}
