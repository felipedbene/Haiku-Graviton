{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-/local/home/benfelip/Projects/Haiku-Graviton}/graviton/scripts/haiku-status-hook\"",
            "timeout": 120,
            "statusMessage": "Checking Graviton builder + guest state..."
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-/local/home/benfelip/Projects/Haiku-Graviton}/graviton/scripts/haiku-drift-hook-session-start\"",
            "timeout": 90,
            "statusMessage": "Checking MD/GitHub drift..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-/local/home/benfelip/Projects/Haiku-Graviton}/graviton/scripts/haiku-drift-hook-md-edit\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
