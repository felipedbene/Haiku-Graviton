SubDir HAIKU_TOP src apps midiplayer ;

UsePrivateHeaders interface ;

# Same guard as src/apps/patchbay/Jamfile: this links libmidi.so, which
# src/kits/midi/Jamfile declares only when the fluidlite build feature is
# enabled. A MIDI player without the synth library has nothing to play, so
# sharing libmidi.so's condition loses nothing.
local architectureObject ;
for architectureObject in [ MultiArchSubDirSetup ] {
	on $(architectureObject) {
		if ! [ FIsBuildFeatureEnabled fluidlite ] {
			continue ;
		}

		Application MidiPlayer :
			MidiPlayerApp.cpp
			MidiPlayerWindow.cpp
			ScopeView.cpp
			SynthBridge.cpp
			: be midi midi2 [ TargetLibsupc++ ] localestub
			: MidiPlayer.rdef
		;

		DoCatalogs MidiPlayer :
			x-vnd.Haiku-MidiPlayer
			:
			MidiPlayerApp.cpp
			MidiPlayerWindow.cpp
			ScopeView.cpp
		;
	}
}
