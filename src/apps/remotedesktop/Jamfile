SubDir HAIKU_TOP src apps remotedesktop ;

local defines = [ FDefines CLIENT_COMPILE ] ;
local serverDir = [ FDirName $(HAIKU_TOP) src servers app drawing interface
	remote ] ;
local brokerDir = [ FDirName $(HAIKU_TOP) src servers remote_broker ] ;

SubDirC++Flags $(defines) ;

UsePrivateHeaders interface shared ;
UseHeaders $(serverDir) ;

# URP/1 wire compression. Without the zstd build feature RemoteWireReader still
# builds; it just advertises no compression capability, so the server never
# negotiates it and the inbound stream stays plain.
local compressionLibraries = ;
if [ FIsBuildFeatureEnabled zstd ] {
	SubDirC++Flags [ FDefines ZSTD_ENABLED ] ;
	UseBuildFeatureHeaders zstd ;
	compressionLibraries = [ BuildFeatureAttribute zstd : library ] ;

	Includes [ FGristFiles RemoteWireReader.cpp ]
		: [ BuildFeatureAttribute zstd : headers ] ;
}

local tlsSources = ;
local tlsLibraries = ;
if [ FIsBuildFeatureEnabled openssl ] {
	# The broker transport: TLS + WebSocket + token authentication, shared
	# with the remote_broker daemon.
	SubDirC++Flags [ FDefines REMOTE_DESKTOP_TLS ] ;
	UseHeaders $(brokerDir) ;
	UseBuildFeatureHeaders openssl ;

	tlsSources = WsTunnel.cpp TLSStream.cpp WebSocketStream.cpp ;
	tlsLibraries = [ BuildFeatureAttribute openssl : libraries ] ;

	Includes [ FGristFiles $(tlsSources) ]
		: [ BuildFeatureAttribute openssl : headers ] ;
}

Application RemoteDesktop :
	RemoteDesktop.cpp
	RemoteMessage.cpp
	RemoteView.cpp

	NetReceiver.cpp
	NetSender.cpp
	RemoteWireReader.cpp
	StreamingRingBuffer.cpp

	$(tlsSources)

	: be bnetapi network $(tlsLibraries) $(compressionLibraries)
		[ TargetLibsupc++ ]
	: RemoteDesktop.rdef
;

SEARCH on [ FGristFiles NetReceiver.cpp NetSender.cpp RemoteMessage.cpp
	RemoteWireReader.cpp StreamingRingBuffer.cpp ] = $(serverDir) ;
SEARCH on [ FGristFiles TLSStream.cpp WebSocketStream.cpp ] = $(brokerDir) ;
