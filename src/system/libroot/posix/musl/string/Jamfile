SubDir HAIKU_TOP src system libroot posix musl string ;

SubDirSysHdrs [ FDirName $(SUBDIR) .. include ] ;
UseHeaders [ FDirName $(SUBDIR) .. internal ] ;

SubDirCcFlags -fno-builtin ;

local architectureObject ;
for architectureObject in [ MultiArchSubDirSetup ] {
	on $(architectureObject) {
		local architecture = $(TARGET_PACKAGING_ARCH) ;

		local sources =
			index.c
			memccpy.c
			memchr.c
			memmem.c
			memmove.c
			memrchr.c
			stpcpy.c
			stpncpy.c
			strcat.c
			strchr.c
			strchrnul.c
			strcpy.c
			strcspn.c
			strlcat.c
			strlcpy.c
			strlen.c
			strncat.c
			strnlen.c
			strpbrk.c
			strspn.c
			strstr.c
			strtok_r.c
			swab.c
			;

		if $(TARGET_PACKAGING_ARCH) = arm64 {
			# arm64 gets these from posix_string_arch_arm64.o (vendored Arm
			# optimized-routines + memmove); drop the musl C versions to avoid a
			# duplicate definition in the merge.
			sources = [ FFilter $(sources) : memchr.c memmove.c strchr.c
				strchrnul.c strcpy.c strlen.c ] ;
		}

		MergeObject <$(architecture)>posix_musl_string.o : $(sources) ;
	}
}
