SubDir HAIKU_TOP src bin sve_test ;

# Both tests are written in bare aarch64 inline asm (rdvl, .arch_extension sve),
# so they only compile for arm64. Gate them on the target architecture the same
# way src/tests/system/libroot/posix/Jamfile gates its x86-only setjmp_test2 --
# without this, a riscv64 or x86 build of src/bin fails in the assembler.
if $(TARGET_ARCH) = arm64 {
	# EL0 SVE save/restore exercise for #88. Verification instrument, but it is
	# in the image: build/jam/packages/Haiku installs it into bin. The SVE
	# instructions live in inline asm gated by ".arch_extension sve", so no
	# special -march is needed here.
	Application sve_test :
		sve_test.c
		: libroot.so
	;

	# fork() FP/SIMD preservation regression test (SVE d8-d15 across fork).
	# Verification instrument, built but deliberately not packaged -- copy it to
	# the target by hand when running it.
	Application sve_fork_test :
		sve_fork_test.c
		: libroot.so
	;
}
