SubDir HAIKU_TOP src servers app drawing interface remote ;

UseLibraryHeaders agg ;
UsePrivateHeaders app graphics interface shared ;
UsePrivateHeaders [ FDirName graphics common ] ;
UsePrivateSystemHeaders ;

UseHeaders [ FDirName $(HAIKU_TOP) src servers app ] ;
UseHeaders [ FDirName $(HAIKU_TOP) src servers app font ] ;
UseHeaders [ FDirName $(HAIKU_TOP) src servers app drawing ] ;
UseHeaders [ FDirName $(HAIKU_TOP) src servers app drawing Painter ] ;
UseHeaders [ FDirName $(HAIKU_TOP) src servers app drawing Painter drawing_modes ] ;
UseHeaders [ FDirName $(HAIKU_TOP) src servers app drawing Painter font_support ] ;
UseBuildFeatureHeaders freetype ;

Includes [ FGristFiles RemoteDrawingEngine.cpp RemoteMessage.cpp
		RemoteHWInterface.cpp ]
	: [ BuildFeatureAttribute freetype : headers ] ;

# URP/1 wire compression. Without the zstd build feature RemoteWireWriter still
# builds and still works -- it just reports no compression capability, so nothing
# is ever negotiated and the wire stays exactly as it was.
if [ FIsBuildFeatureEnabled zstd ] {
	SubDirC++Flags -DZSTD_ENABLED ;
	UseBuildFeatureHeaders zstd ;
	Includes [ FGristFiles RemoteWireReader.cpp RemoteWireWriter.cpp ]
		: [ BuildFeatureAttribute zstd : headers ] ;
}

StaticLibrary libasremote.a :
	NetReceiver.cpp
	NetSender.cpp

	RemoteDrawingEngine.cpp
	RemoteEventStream.cpp
	RemoteFlowQueue.cpp
	RemoteHWInterface.cpp
	RemoteMessage.cpp
	RemoteWireReader.cpp
		# The reader is the client's half of the wire, but NetReceiver.cpp is
		# shared with the clients and calls into it unconditionally, so the
		# server links it too. On this side it is never instantiated: the
		# inbound direction is always plain.
	RemoteWireWriter.cpp

	StreamingRingBuffer.cpp
;
