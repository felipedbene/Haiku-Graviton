SubDir HAIKU_TOP src servers remote_broker ;

UsePrivateHeaders shared support ;

# TLS is the whole point of this daemon; it only exists when the openssl
# build feature is available (it is in every DeBeOS image -- the https
# package fetch path already depends on it).
if [ FIsBuildFeatureEnabled openssl ] {
	UseBuildFeatureHeaders openssl ;

	Includes [ FGristFiles RemoteBroker.cpp QuicStream.cpp TLSStream.cpp
		WebSocketStream.cpp ]
		: [ BuildFeatureAttribute openssl : headers ] ;

	# QuicStream.cpp needs openssl3 >= 3.5.9-2 (#790, #792): it refuses to
	# compile against an older one and to start QUIC on an unpatched one.
	# build/jam/repositories/HaikuPortsLocal/arm64 pins that build.

	Application remote_broker :
		QuicStream.cpp
		RemoteBroker.cpp
		TLSStream.cpp
		WebSocketStream.cpp

		: be network libbnetapi.so
			[ BuildFeatureAttribute openssl : libraries ]
			[ TargetLibsupc++ ]
	;
}
